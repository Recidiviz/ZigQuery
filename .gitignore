# Bazel output symlinks (the shim build roots here now)
/bazel-*

.idea/
.DS_Store

# tools/spec_import.py imports tools/zon.py as a sibling module.
__pycache__/

# uv's environments for the tools in tools/ and the suite in test/python/;
# each directory's pyproject.toml and uv.lock are the tracked half.
/.venv/
/test/python/.venv/
.pytest_cache/