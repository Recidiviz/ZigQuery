// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/information_schema/tables",
    .dialect = .googlesql,
    .upstream = "https://cloud.google.com/bigquery/docs/information-schema-tables",
    .cases = .{
        .{
            .desc = "TABLES lists every table in the dataset",
            .setup = .{
                "CREATE TABLE tables_demo_ds.tables_demo_a (a INT64, b STRING)",
                "CREATE TABLE tables_demo_ds.tables_demo_b (c FLOAT64)",
            },
            .sql =
            \\SELECT table_name
            \\FROM tables_demo_ds.INFORMATION_SCHEMA.TABLES
            \\WHERE table_name IN ('tables_demo_a', 'tables_demo_b')
            \\ORDER BY table_name
            ,
            .rows = .{
                .{"tables_demo_a"},
                .{"tables_demo_b"},
            },
        },
    },
}
