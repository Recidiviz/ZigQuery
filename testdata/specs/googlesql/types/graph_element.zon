.{
    .spec = "googlesql/types/graph_element",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/data-types.md#graph-element-type",
    .cases = .{
        .{
            .desc = "upstream example 1",
            .sql =
            \\GRAPH FinGraph
            \\MATCH (n:Person)
            \\RETURN TYPEOF(n) AS t
            \\LIMIT 1
            ,
            .rows = .{
                .{"GRAPH_NODE(FinGraph)<Id INT64, ..., DYNAMIC>"},
            },
        },
    },
}
