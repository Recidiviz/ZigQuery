// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/types/datetime",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/data-types.md#datetime-type",
    .cases = .{
        .{
            .desc = "cast string to DATETIME",
            .sql = "SELECT CAST('2020-12-25 15:30:00' AS DATETIME) AS dt",
            .rows = .{
                .{"2020-12-25T15:30:00"},
            },
        },
        .{
            .desc = "DATETIME literal",
            .sql = "SELECT DATETIME '2020-12-25 15:30:00' AS dt",
            .rows = .{
                .{"2020-12-25T15:30:00"},
            },
        },
    },
}
