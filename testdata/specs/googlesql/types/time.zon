// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/types/time",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/data-types.md#time-type",
    .cases = .{
        .{
            .desc = "cast string to TIME",
            .sql = "SELECT CAST('15:30:00' AS TIME) AS t",
            .rows = .{
                .{"15:30:00"},
            },
        },
        .{
            .desc = "TIME literal",
            .sql = "SELECT TIME '15:30:00' AS t",
            .rows = .{
                .{"15:30:00"},
            },
        },
    },
}
