// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/types/geography",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/data-types.md#geography-type",
    .cases = .{
        .{
            .desc = "round-trip point through WKT",
            .sql = "SELECT ST_ASTEXT(ST_GEOGFROMTEXT('POINT(1 2)')) AS wkt",
            .rows = .{
                // ST_ASTEXT has no space between the tag and the coordinate list.
                // (recidiviz-bigquery-sandbox, 2026-08-25)
                .{"POINT(1 2)"},
            },
        },
    },
}
