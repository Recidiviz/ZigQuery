.{
    .spec = "googlesql/types/timestamp",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/data-types.md#timestamp-type",
    .cases = .{
        .{
            .desc = "FORMAT_TIMESTAMP UTC",
            .sql = "SELECT FORMAT_TIMESTAMP('%Y-%m-%d %H:%M:%S+00', TIMESTAMP '2020-12-25 15:30:00 UTC', 'UTC') AS s",
            .rows = .{
                .{"2020-12-25 15:30:00+00"},
            },
        },
    },
}
