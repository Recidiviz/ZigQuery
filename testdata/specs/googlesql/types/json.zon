// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/types/json",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/data-types.md#json-type",
    .cases = .{
        .{
            .desc = "JSON literal scalar",
            .sql = "SELECT JSON '42' AS j",
            .rows = .{
                .{"42"},
            },
        },
        .{
            .desc = "JSON literal string",
            .sql = "SELECT JSON '\"hello\"' AS j",
            .rows = .{
                .{"\"hello\""},
            },
        },
    },
}
