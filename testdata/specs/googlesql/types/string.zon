// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/types/string",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/data-types.md#string-type",
    .cases = .{
        .{
            .desc = "simple string literal",
            .sql = "SELECT \"abc\" AS s",
            .rows = .{
                .{"abc"},
            },
        },
        .{
            .desc = "single-quoted string literal",
            .sql = "SELECT 'hello' AS s",
            .rows = .{
                .{"hello"},
            },
        },
    },
}
