// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/types/interval",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/data-types.md#interval-type",
    .cases = .{
        .{
            .desc = "INTERVAL literal year-month",
            .sql = "SELECT INTERVAL '1' YEAR AS i",
            .rows = .{
                .{"1-0 0 0:0:0"},
            },
        },
        .{
            .desc = "INTERVAL literal day",
            .sql = "SELECT INTERVAL '5' DAY AS i",
            .rows = .{
                .{"0-0 5 0:0:0"},
            },
        },
    },
}
