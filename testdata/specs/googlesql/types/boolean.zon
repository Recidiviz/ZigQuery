// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/types/boolean",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/data-types.md#boolean-type",
    .cases = .{
        .{
            .desc = "cast true to BOOL",
            .sql = "SELECT CAST(true AS BOOL) AS bool_val",
            .rows = .{
                .{true},
            },
        },
        .{
            .desc = "bool literal true",
            .sql = "SELECT TRUE AS bool_val",
            .rows = .{
                .{true},
            },
        },
        .{
            .desc = "bool literal false",
            .sql = "SELECT FALSE AS bool_val",
            .rows = .{
                .{false},
            },
        },
    },
}
