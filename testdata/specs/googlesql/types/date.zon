// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/types/date",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/data-types.md#date-type",
    .cases = .{
        .{
            .desc = "cast string to DATE",
            .sql = "SELECT CAST('2020-12-25' AS DATE) AS d",
            .rows = .{
                .{"2020-12-25"},
            },
        },
        .{
            .desc = "DATE literal",
            .sql = "SELECT DATE '2020-12-25' AS d",
            .rows = .{
                .{"2020-12-25"},
            },
        },
    },
}
