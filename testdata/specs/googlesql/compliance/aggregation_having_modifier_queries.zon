            \\              STRUCT(true AS f),
            \\              STRUCT(NULL AS f),
            \\              STRUCT(true AS f),
            \\              STRUCT(true AS f),
            \\              STRUCT(NULL AS f),
            \\              STRUCT(false AS f)
            \\            ]) AS a
