// Imported from GoogleSQL's own compliance-testdata suite
// (third_party/googlesql/googlesql/compliance/testdata, Apache-2.0).
.{
    .spec = "googlesql/compliance/analytic_min_max",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/googlesql/compliance/testdata/analytic_min_max.test",
    .cases = .{
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TABLE TestTable AS
            \\SELECT cast(1 as int64) as row_id,
            \\       cast(null as bool) as bool_val,
            \\       cast(null as int64) as int64_val,
            \\       cast(null as uint64) as uint64_val,
            \\       cast(null as double) as double_val,
            \\       cast(null as string) as str_val UNION ALL
            \\  SELECT 2,  true,  2,    3,    1.5,  "A"   UNION ALL
            \\  SELECT 3,  false, 1,    6,    1.5,  "A"   UNION ALL
            \\  SELECT 4,  true,  null, 2,    2.5,  "B"   UNION ALL
            \\  SELECT 5,  false, 1,    null, 3.5,  "A"   UNION ALL
            \\  SELECT 6,  true,  2,    2,    null, "C"   UNION ALL
            \\  SELECT 7,  false, 1,    5,    -0.5,  null UNION ALL
            \\  SELECT 8,  true,  4,    2,    -1.5,  "A"  UNION ALL
            \\  SELECT 9,  false, 2,    3,    1.5,   "B"  UNION ALL
            \\  SELECT 10, true,  3,    1,    2.5,   "B"
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TABLE TableDateTimeBytes AS
            \\SELECT cast(1 as int64) as row_id,
            \\       cast(null as date) as date_val,
            \\       cast(null as timestamp) as timestamp_val,
            \\       cast(null as bytes) as bytes_val UNION ALL
            \\SELECT 2,
            \\       cast('2014-01-01' as date),
            \\       TIMESTAMP '2014-01-01 00:00:01.011011-08',
            \\       cast("1" as bytes) UNION ALL
            \\SELECT 3,
            \\       cast('2014-01-01' as date),
            \\       TIMESTAMP '2014-01-01 00:00:01.011011-08',
            \\       cast("2" as bytes) UNION ALL
            \\SELECT 4,
            \\       cast('2015-01-01' as date),
            \\       TIMESTAMP '2014-01-01 00:00:01.011011-08',
            \\       cast("1" as bytes) UNION ALL
            \\SELECT 5,
            \\       cast('2015-01-01' as date),
            \\       TIMESTAMP '2013-01-01 00:00:01.011011-08',
            \\       cast("2" as bytes) UNION ALL
            \\SELECT 6,
            \\       cast('2014-01-01' as date),
            \\       TIMESTAMP '2015-01-01 00:00:01.011011-08',
            \\       cast("5" as bytes)
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TABLE TableAllNullRanges AS
            \\SELECT CAST(1 as int64) as row_id,
            \\       CAST(NULL AS RANGE<DATE>) as range_date_val,
            \\       CAST(NULL AS RANGE<TIMESTAMP>) as range_timestamp_val
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TABLE TableAllNullDatetimeRange AS
            \\SELECT CAST(1 as int64) as row_id,
            \\       CAST(NULL AS RANGE<DATETIME>) as range_datetime_val
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TABLE TableOneValueRanges AS
            \\SELECT CAST(1 as int64) as row_id,
            \\       RANGE<DATE> '[2020-01-01, 2020-12-31)' as range_date_val,
            \\       RANGE<TIMESTAMP> '[2020-01-01, 2020-12-31)' as range_timestamp_val
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TABLE TableOneValueDatetimeRange AS
            \\SELECT CAST(1 as int64) as row_id,
            \\       RANGE<DATETIME> '[2020-01-01, 2020-12-31)' as range_datetime_val
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TABLE TableRangeTypes AS
            \\SELECT CAST(1 AS int64) as row_id,
            \\       true AS bool_val,
            \\       CAST(NULL AS RANGE<DATE>) AS range_date_val,
            \\       CAST(NULL AS RANGE<TIMESTAMP>) AS range_timestamp_val UNION ALL
            \\SELECT 2, true, RANGE<DATE> '[UNBOUNDED, 0001-01-01)', RANGE<TIMESTAMP> '[UNBOUNDED, 0001-01-01 00:00:00+00)' UNION ALL
            \\SELECT 3, true, RANGE<DATE> '[UNBOUNDED, 2020-01-01)', RANGE<TIMESTAMP> '[UNBOUNDED, 2020-01-01 00:00:00+00)' UNION ALL
            \\SELECT 4, true, RANGE<DATE> '[UNBOUNDED, 9999-12-31)', RANGE<TIMESTAMP> '[UNBOUNDED, 9999-12-31 23:59:59.999999+00)' UNION ALL
            \\SELECT 5, false, RANGE<DATE> '[UNBOUNDED, UNBOUNDED)', RANGE<TIMESTAMP> '[UNBOUNDED, UNBOUNDED)' UNION ALL
            \\SELECT 6, false, RANGE<DATE> '[0001-01-01, 2020-01-01)', RANGE<TIMESTAMP> '[0001-01-01 00:00:00+00, 2020-01-01 00:00:00+00)' UNION ALL
            \\SELECT 7, false, RANGE<DATE> '[2020-01-01, 9999-12-31)', RANGE<TIMESTAMP> '[2020-01-01 00:00:00+00, 9999-12-31 23:59:59.999999+00)' UNION ALL
            \\SELECT 8, false, RANGE<DATE> '[9999-12-31, UNBOUNDED)', RANGE<TIMESTAMP> '[9999-12-31 23:59:59.999999+00, UNBOUNDED)'
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TABLE TableDatetimeRangeTypes AS
            \\SELECT CAST(1 AS int64) as row_id,
            \\       true AS bool_val,
            \\       CAST(NULL AS RANGE<DATETIME>) AS range_datetime_val UNION ALL
            \\SELECT 2, true, RANGE<DATETIME> '[UNBOUNDED, 0001-01-01)' UNION ALL
            \\SELECT 3, true, RANGE<DATETIME> '[UNBOUNDED, 2020-01-01)' UNION ALL
            \\SELECT 4, true, RANGE<DATETIME> '[UNBOUNDED, 9999-12-31 23:59:59.999999)' UNION ALL
            \\SELECT 5, false, RANGE<DATETIME> '[UNBOUNDED, UNBOUNDED)' UNION ALL
            \\SELECT 6, false, RANGE<DATETIME> '[0001-01-01, 2020-01-01)' UNION ALL
            \\SELECT 7, false, RANGE<DATETIME> '[2020-01-01, 9999-12-31 23:59:59.999999)' UNION ALL
            \\SELECT 8, false, RANGE<DATETIME> '[9999-12-31 23:59:59.999999, UNBOUNDED)'
            ,
        },
        .{
            .desc = "analytic_min_int64_uint64",
            .sql =
            \\# ----------------------------------------------------------------------------
            \\# MIN
            \\# ----------------------------------------------------------------------------
            \\SELECT row_id, int64_val, uint64_val,
            \\       MIN(int64_val) OVER (ORDER BY row_id)
            \\From TestTable
            ,
            .unordered = true,
            .rows = .{
                .{ 1, null, null, null },
                .{ 2, 2, 3, 2 },
                .{ 3, 1, 6, 1 },
                .{ 4, null, 2, 1 },
                .{ 5, 1, null, 1 },
                .{ 6, 2, 2, 1 },
                .{ 7, 1, 5, 1 },
                .{ 8, 4, 2, 1 },
                .{ 9, 2, 3, 1 },
                .{ 10, 3, 1, 1 },
            },
        },
        .{
            .desc = "analytic_min_int32_uint32",
            .sql =
            \\SELECT row_id, int64_val,
            \\       MIN(CAST(int64_val as int32)) OVER (ORDER BY row_id ROWS 4 PRECEDING),
            \\       MIN(CAST(int64_val as uint32)) OVER (ORDER BY row_id RANGE 2 PRECEDING)
            \\FROM TestTable
            ,
            .unordered = true,
            .rows = .{
                .{ 1, null, null, null },
                .{ 2, 2, 2, 2 },
                .{ 3, 1, 1, 1 },
                .{ 4, null, 1, 1 },
                .{ 5, 1, 1, 1 },
                .{ 6, 2, 1, 1 },
                .{ 7, 1, 1, 1 },
                .{ 8, 4, 1, 1 },
                .{ 9, 2, 1, 1 },
                .{ 10, 3, 1, 2 },
            },
        },
        .{
            .desc = "analytic_min_float_double_1",
            .sql =
            \\SELECT row_id, double_val,
            \\       MIN(double_val * 2.0) OVER (ORDER BY row_id RANGE 2 PRECEDING),
            \\       MIN(CAST(double_val as float)) OVER (ORDER BY row_id DESC
            \\                                            RANGE BETWEEN 2 PRECEDING AND
            \\                                                          UNBOUNDED FOLLOWING)
            \\FROM TestTable
            ,
            .unordered = true,
            .rows = .{
                .{ 10, 2.5, -3, -1.5 },
                .{ 9, 1.5, -3, -1.5 },
                .{ 8, -1.5, -3, -1.5 },
                .{ 7, -0.5, -1, -1.5 },
                .{ 6, null, 5, -1.5 },
                .{ 5, 3.5, 3, -0.5 },
                .{ 4, 2.5, 3, 1.5 },
                .{ 3, 1.5, 3, 1.5 },
                .{ 2, 1.5, 3, 1.5 },
                .{ 1, null, null, 1.5 },
            },
        },
        .{
            .desc = "analytic_min_float_double_2",
            .sql =
            \\SELECT row_id,
            \\       MIN(double_val) OVER (ORDER BY row_id),
            \\       MIN(double_val) OVER (ORDER BY row_id DESC)
            \\FROM (SELECT 1 row_id, CAST(null as double) double_val UNION ALL
            \\      SELECT 2, 2.0 UNION ALL
            \\      SELECT 3, CAST(null as double) UNION ALL
            \\      SELECT 4, CAST("INF" as double) UNION ALL
            \\      SELECT 5, CAST("NaN" as double) UNION ALL
            \\      SELECT 6, CAST("NaN" as double) UNION ALL
            \\      SELECT 7, CAST("-INF" as double))
            ,
            .unordered = true,
            .rows = .{
                .{ 7, nan, -inf },
                .{ 6, nan, nan },
                .{ 5, nan, nan },
                .{ 4, 2, nan },
                .{ 3, 2, nan },
                .{ 2, 2, nan },
                .{ 1, null, nan },
            },
        },
        .{
            .desc = "analytic_min_string",
            .sql =
            \\SELECT row_id, str_val, MIN(str_val) OVER (ORDER BY row_id)
            \\FROM TestTable
            ,
            .unordered = true,
            .rows = .{
                .{ 1, null, null },
                .{ 2, "A", "A" },
                .{ 3, "A", "A" },
                .{ 4, "B", "A" },
                .{ 5, "A", "A" },
                .{ 6, "C", "A" },
                .{ 7, null, "A" },
                .{ 8, "A", "A" },
                .{ 9, "B", "A" },
                .{ 10, "B", "A" },
            },
        },
        .{
            .desc = "analytic_min_date_timestamp",
            .sql =
            \\SELECT row_id, date_val, timestamp_val,
            \\       MIN(date_val) OVER (ORDER BY row_id DESC),
            \\       MIN(timestamp_val) OVER (ORDER BY row_id)
            \\FROM TableDateTimeBytes
            ,
            .unordered = true,
            .rows = .{
                .{ 1, null, null, "2014-01-01", null },
                .{ 2, "2014-01-01", "2014-01-01 08:00:01.011011+00", "2014-01-01", "2014-01-01 08:00:01.011011+00" },
                .{ 3, "2014-01-01", "2014-01-01 08:00:01.011011+00", "2014-01-01", "2014-01-01 08:00:01.011011+00" },
                .{ 4, "2015-01-01", "2014-01-01 08:00:01.011011+00", "2014-01-01", "2014-01-01 08:00:01.011011+00" },
                .{ 5, "2015-01-01", "2013-01-01 08:00:01.011011+00", "2014-01-01", "2013-01-01 08:00:01.011011+00" },
                .{ 6, "2014-01-01", "2015-01-01 08:00:01.011011+00", "2014-01-01", "2013-01-01 08:00:01.011011+00" },
            },
        },
        .{
            .desc = "analytic_min_bytes",
            .sql =
            \\SELECT row_id, bytes_val,
            \\       MIN(bytes_val) OVER (ORDER BY row_id)
            \\FROM TableDateTimeBytes
            ,
            .unordered = true,
            .rows = .{
                .{ 1, null, null },
                .{ 2, "\x31", "\x31" },
                .{ 3, "\x32", "\x31" },
                .{ 4, "\x31", "\x31" },
                .{ 5, "\x32", "\x31" },
                .{ 6, "\x35", "\x31" },
            },
        },
        .{
            .desc = "analytic_min_distinct_1",
            .sql =
            \\SELECT row_id, int64_val,
            \\       MIN(DISTINCT int64_val) OVER ()
            \\FROM TestTable
            ,
            .unordered = true,
            .rows = .{
                .{ 2, 2, 1 },
                .{ 4, null, 1 },
                .{ 6, 2, 1 },
                .{ 8, 4, 1 },
                .{ 10, 3, 1 },
                .{ 1, null, 1 },
                .{ 3, 1, 1 },
                .{ 5, 1, 1 },
                .{ 7, 1, 1 },
                .{ 9, 2, 1 },
            },
        },
        .{
            .desc = "analytic_min_distinct_2",
            .sql =
            \\SELECT row_id, double_val,
            \\       MIN(DISTINCT double_val) OVER ()
            \\FROM (SELECT 1 row_id, 1.0 double_val UNION ALL
            \\      SELECT 2, 2.0 UNION ALL
            \\      SELECT 3, CAST(null as double) UNION ALL
            \\      SELECT 4, 2.0 UNION ALL
            \\      SELECT 5, CAST("INF" as double) UNION ALL
            \\      SELECT 6, CAST("NaN" as double) UNION ALL
            \\      SELECT 7, CAST("NaN" as double) UNION ALL
            \\      SELECT 8, CAST("INF" as double) UNION ALL
            \\      SELECT 9, CAST("-INF" as double) UNION ALL
            \\      SELECT 10, CAST("-INF" as double))
            ,
            .unordered = true,
            .rows = .{
                .{ 2, 2, nan },
                .{ 4, 2, nan },
                .{ 6, nan, nan },
                .{ 8, inf, nan },
                .{ 10, -inf, nan },
                .{ 1, 1, nan },
                .{ 3, null, nan },
                .{ 5, inf, nan },
                .{ 7, nan, nan },
                .{ 9, -inf, nan },
            },
        },
        .{
            .desc = "analytic_min_distinct_3",
            .sql =
            \\SELECT row_id,
            \\       MIN(DISTINCT bool_val) OVER test_window,
            \\       MIN(DISTINCT CAST(int64_val as int32)) OVER test_window,
            \\       MIN(DISTINCT int64_val) OVER test_window,
            \\       MIN(DISTINCT CAST(uint64_val as uint32)) OVER test_window,
            \\       MIN(DISTINCT uint64_val) OVER test_window,
            \\       MIN(DISTINCT str_val) OVER test_window
            \\FROM TestTable
            \\WINDOW test_window AS (PARTITION BY bool_val)
            ,
            .unordered = true,
            .rows = .{
                .{ 1, null, null, null, null, null, null },
                .{ 5, false, 1, 1, 3, 3, "A" },
                .{ 9, false, 1, 1, 3, 3, "A" },
                .{ 3, false, 1, 1, 3, 3, "A" },
                .{ 7, false, 1, 1, 3, 3, "A" },
                .{ 4, true, 2, 2, 1, 1, "A" },
                .{ 8, true, 2, 2, 1, 1, "A" },
                .{ 2, true, 2, 2, 1, 1, "A" },
                .{ 6, true, 2, 2, 1, 1, "A" },
                .{ 10, true, 2, 2, 1, 1, "A" },
            },
        },
        .{
            .desc = "analytic_min_distinct_4",
            .sql =
            \\SELECT row_id,
            \\       MIN(DISTINCT double_val) OVER test_window,
            \\       MIN(DISTINCT CAST(double_val as float)) OVER test_window
            \\FROM TestTable
            \\WINDOW test_window AS (PARTITION BY bool_val)
            ,
            .unordered = true,
            .rows = .{
                .{ 1, null, null },
                .{ 5, -0.5, -0.5 },
                .{ 9, -0.5, -0.5 },
                .{ 3, -0.5, -0.5 },
                .{ 7, -0.5, -0.5 },
                .{ 4, -1.5, -1.5 },
                .{ 8, -1.5, -1.5 },
                .{ 2, -1.5, -1.5 },
                .{ 6, -1.5, -1.5 },
                .{ 10, -1.5, -1.5 },
            },
        },
        .{
            .desc = "analytic_min_distinct_5",
            .sql =
            \\SELECT row_id,
            \\       MIN(DISTINCT bytes_val) OVER (),
            \\       MIN(DISTINCT date_val) OVER (),
            \\       MIN(DISTINCT timestamp_val) OVER ()
            \\FROM TableDateTimeBytes
            ,
            .unordered = true,
            .rows = .{
                .{ 2, "\x31", "2014-01-01", "2013-01-01 08:00:01.011011+00" },
                .{ 4, "\x31", "2014-01-01", "2013-01-01 08:00:01.011011+00" },
                .{ 6, "\x31", "2014-01-01", "2013-01-01 08:00:01.011011+00" },
                .{ 1, "\x31", "2014-01-01", "2013-01-01 08:00:01.011011+00" },
                .{ 3, "\x31", "2014-01-01", "2013-01-01 08:00:01.011011+00" },
                .{ 5, "\x31", "2014-01-01", "2013-01-01 08:00:01.011011+00" },
            },
        },
        .{
            .desc = "analytic_min_range_null_date_timestamp",
            .sql =
            \\SELECT row_id,
            \\MIN(range_date_val) OVER (ORDER BY row_id),
            \\MIN(range_timestamp_val) OVER (ORDER BY row_id)
            \\FROM TableAllNullRanges
            ,
            .rows = .{
                .{ 1, null, null },
            },
        },
        .{
            .desc = "analytic_min_range_null_datetime",
            .sql =
            \\SELECT row_id,
            \\MIN(range_datetime_val) OVER (ORDER BY row_id)
            \\FROM TableAllNullDatetimeRange
            ,
            .rows = .{
                .{ 1, null },
            },
        },
        .{
            .desc = "analytic_min_range_multiple_ids",
            .sql =
            \\SELECT row_id, range_date_val, range_timestamp_val,
            \\MIN(range_date_val) OVER (ORDER BY row_id),
            \\MIN(range_timestamp_val) OVER (ORDER BY row_id)
            \\FROM TableRangeTypes
            ,
            .unordered = true,
            .rows = .{
                .{ 1, null, null, null, null },
                .{ 2, "[NULL, 0001-01-01)", "[NULL, 0001-01-01 00:00:00+00)", "[NULL, 0001-01-01)", "[NULL, 0001-01-01 00:00:00+00)" },
                .{ 3, "[NULL, 2020-01-01)", "[NULL, 2020-01-01 00:00:00+00)", "[NULL, 0001-01-01)", "[NULL, 0001-01-01 00:00:00+00)" },
                .{ 4, "[NULL, 9999-12-31)", "[NULL, 9999-12-31 23:59:59.999999+00)", "[NULL, 0001-01-01)", "[NULL, 0001-01-01 00:00:00+00)" },
                .{ 5, "[NULL, NULL)", "[NULL, NULL)", "[NULL, 0001-01-01)", "[NULL, 0001-01-01 00:00:00+00)" },
                .{ 6, "[0001-01-01, 2020-01-01)", "[0001-01-01 00:00:00+00, 2020-01-01 00:00:00+00)", "[NULL, 0001-01-01)", "[NULL, 0001-01-01 00:00:00+00)" },
                .{ 7, "[2020-01-01, 9999-12-31)", "[2020-01-01 00:00:00+00, 9999-12-31 23:59:59.999999+00)", "[NULL, 0001-01-01)", "[NULL, 0001-01-01 00:00:00+00)" },
                .{ 8, "[9999-12-31, NULL)", "[9999-12-31 23:59:59.999999+00, NULL)", "[NULL, 0001-01-01)", "[NULL, 0001-01-01 00:00:00+00)" },
            },
        },
        .{
            .desc = "analytic_min_range_datetime_multiple_ids",
            .sql =
            \\SELECT row_id, range_datetime_val,
            \\MIN(range_datetime_val) OVER (ORDER BY row_id)
            \\FROM TableDatetimeRangeTypes
            ,
            .unordered = true,
            .rows = .{
                .{ 1, null, null },
                .{ 2, "[NULL, 0001-01-01 00:00:00)", "[NULL, 0001-01-01 00:00:00)" },
                .{ 3, "[NULL, 2020-01-01 00:00:00)", "[NULL, 0001-01-01 00:00:00)" },
                .{ 4, "[NULL, 9999-12-31 23:59:59.999999)", "[NULL, 0001-01-01 00:00:00)" },
                .{ 5, "[NULL, NULL)", "[NULL, 0001-01-01 00:00:00)" },
                .{ 6, "[0001-01-01 00:00:00, 2020-01-01 00:00:00)", "[NULL, 0001-01-01 00:00:00)" },
                .{ 7, "[2020-01-01 00:00:00, 9999-12-31 23:59:59.999999)", "[NULL, 0001-01-01 00:00:00)" },
                .{ 8, "[9999-12-31 23:59:59.999999, NULL)", "[NULL, 0001-01-01 00:00:00)" },
            },
        },
        .{
            .desc = "analytic_min_range_bounded_start",
            .sql =
            \\SELECT row_id, range_date_val, range_timestamp_val,
            \\MIN(range_date_val) OVER (ORDER BY row_id ROWS 4 PRECEDING),
            \\MIN(range_date_val) OVER (ORDER BY row_id ROWS 2 PRECEDING),
            \\MIN(range_timestamp_val) OVER (ORDER BY row_id ROWS 4 PRECEDING),
            \\MIN(range_timestamp_val) OVER (ORDER BY row_id ROWS 2 PRECEDING)
            \\FROM TableRangeTypes
            ,
            .unordered = true,
            .rows = .{
                .{ 1, null, null, null, null, null, null },
                .{ 2, "[NULL, 0001-01-01)", "[NULL, 0001-01-01 00:00:00+00)", "[NULL, 0001-01-01)", "[NULL, 0001-01-01)", "[NULL, 0001-01-01 00:00:00+00)", "[NULL, 0001-01-01 00:00:00+00)" },
                .{ 3, "[NULL, 2020-01-01)", "[NULL, 2020-01-01 00:00:00+00)", "[NULL, 0001-01-01)", "[NULL, 0001-01-01)", "[NULL, 0001-01-01 00:00:00+00)", "[NULL, 0001-01-01 00:00:00+00)" },
                .{ 4, "[NULL, 9999-12-31)", "[NULL, 9999-12-31 23:59:59.999999+00)", "[NULL, 0001-01-01)", "[NULL, 0001-01-01)", "[NULL, 0001-01-01 00:00:00+00)", "[NULL, 0001-01-01 00:00:00+00)" },
                .{ 5, "[NULL, NULL)", "[NULL, NULL)", "[NULL, 0001-01-01)", "[NULL, 2020-01-01)", "[NULL, 0001-01-01 00:00:00+00)", "[NULL, 2020-01-01 00:00:00+00)" },
                .{ 6, "[0001-01-01, 2020-01-01)", "[0001-01-01 00:00:00+00, 2020-01-01 00:00:00+00)", "[NULL, 0001-01-01)", "[NULL, 9999-12-31)", "[NULL, 0001-01-01 00:00:00+00)", "[NULL, 9999-12-31 23:59:59.999999+00)" },
                .{ 7, "[2020-01-01, 9999-12-31)", "[2020-01-01 00:00:00+00, 9999-12-31 23:59:59.999999+00)", "[NULL, 2020-01-01)", "[NULL, NULL)", "[NULL, 2020-01-01 00:00:00+00)", "[NULL, NULL)" },
                .{ 8, "[9999-12-31, NULL)", "[9999-12-31 23:59:59.999999+00, NULL)", "[NULL, 9999-12-31)", "[0001-01-01, 2020-01-01)", "[NULL, 9999-12-31 23:59:59.999999+00)", "[0001-01-01 00:00:00+00, 2020-01-01 00:00:00+00)" },
            },
        },
        .{
            .desc = "analytic_min_range_datetime_bounded_start",
            .sql =
            \\SELECT row_id, range_datetime_val,
            \\MIN(range_datetime_val) OVER (ORDER BY row_id ROWS 4 PRECEDING),
            \\MIN(range_datetime_val) OVER (ORDER BY row_id ROWS 2 PRECEDING)
            \\FROM TableDatetimeRangeTypes
            ,
            .unordered = true,
            .rows = .{
                .{ 1, null, null, null },
                .{ 2, "[NULL, 0001-01-01 00:00:00)", "[NULL, 0001-01-01 00:00:00)", "[NULL, 0001-01-01 00:00:00)" },
                .{ 3, "[NULL, 2020-01-01 00:00:00)", "[NULL, 0001-01-01 00:00:00)", "[NULL, 0001-01-01 00:00:00)" },
                .{ 4, "[NULL, 9999-12-31 23:59:59.999999)", "[NULL, 0001-01-01 00:00:00)", "[NULL, 0001-01-01 00:00:00)" },
                .{ 5, "[NULL, NULL)", "[NULL, 0001-01-01 00:00:00)", "[NULL, 2020-01-01 00:00:00)" },
                .{ 6, "[0001-01-01 00:00:00, 2020-01-01 00:00:00)", "[NULL, 0001-01-01 00:00:00)", "[NULL, 9999-12-31 23:59:59.999999)" },
                .{ 7, "[2020-01-01 00:00:00, 9999-12-31 23:59:59.999999)", "[NULL, 2020-01-01 00:00:00)", "[NULL, NULL)" },
                .{ 8, "[9999-12-31 23:59:59.999999, NULL)", "[NULL, 9999-12-31 23:59:59.999999)", "[0001-01-01 00:00:00, 2020-01-01 00:00:00)" },
            },
        },
        .{
            .desc = "analytic_max_int64_uint64",
            .sql =
            \\# ----------------------------------------------------------------------------
            \\# MAX
            \\# ----------------------------------------------------------------------------
            \\# The following queries repeat those for MIN, with the function name replaced
            \\# with MAX.
            \\SELECT row_id, int64_val, uint64_val,
            \\       MAX(int64_val) OVER (ORDER BY row_id)
            \\From TestTable
            ,
            .unordered = true,
            .rows = .{
                .{ 1, null, null, null },
                .{ 2, 2, 3, 2 },
                .{ 3, 1, 6, 2 },
                .{ 4, null, 2, 2 },
                .{ 5, 1, null, 2 },
                .{ 6, 2, 2, 2 },
                .{ 7, 1, 5, 2 },
                .{ 8, 4, 2, 4 },
                .{ 9, 2, 3, 4 },
                .{ 10, 3, 1, 4 },
            },
        },
        .{
            .desc = "analytic_max_int32_uint32",
            .sql =
            \\SELECT row_id, int64_val,
            \\       MAX(CAST(int64_val as int32)) OVER (ORDER BY row_id ROWS 4 PRECEDING),
            \\       MAX(CAST(int64_val as uint32)) OVER (ORDER BY row_id RANGE 2 PRECEDING)
            \\FROM TestTable
            ,
            .unordered = true,
            .rows = .{
                .{ 1, null, null, null },
                .{ 2, 2, 2, 2 },
                .{ 3, 1, 2, 2 },
                .{ 4, null, 2, 2 },
                .{ 5, 1, 2, 1 },
                .{ 6, 2, 2, 2 },
                .{ 7, 1, 2, 2 },
                .{ 8, 4, 4, 4 },
                .{ 9, 2, 4, 4 },
                .{ 10, 3, 4, 4 },
            },
        },
        .{
            .desc = "analytic_max_float_double_1",
            .sql =
            \\SELECT row_id, double_val,
            \\       MAX(double_val * 2.0) OVER (ORDER BY row_id RANGE 2 PRECEDING),
            \\       MAX(CAST(double_val as float)) OVER (ORDER BY row_id DESC
            \\                                            RANGE BETWEEN 2 PRECEDING AND
            \\                                                          UNBOUNDED FOLLOWING)
            \\FROM TestTable
            ,
            .unordered = true,
            .rows = .{
                .{ 10, 2.5, 5, 3.5 },
                .{ 9, 1.5, 3, 3.5 },
                .{ 8, -1.5, -1, 3.5 },
                .{ 7, -0.5, 7, 3.5 },
                .{ 6, null, 7, 3.5 },
                .{ 5, 3.5, 7, 3.5 },
                .{ 4, 2.5, 5, 3.5 },
                .{ 3, 1.5, 3, 3.5 },
                .{ 2, 1.5, 3, 2.5 },
                .{ 1, null, null, 1.5 },
            },
        },
        .{
            .desc = "analytic_max_float_double_2",
            .sql =
            \\SELECT row_id,
            \\       MAX(double_val) OVER (ORDER BY row_id),
            \\       MAX(double_val) OVER (ORDER BY row_id DESC)
            \\FROM (SELECT 1 row_id, CAST(null as double) double_val UNION ALL
            \\      SELECT 2, 2.0 UNION ALL
            \\      SELECT 3, CAST(null as double) UNION ALL
            \\      SELECT 4, CAST("INF" as double) UNION ALL
            \\      SELECT 5, CAST("NaN" as double) UNION ALL
            \\      SELECT 6, CAST("NaN" as double) UNION ALL
            \\      SELECT 7, CAST("-INF" as double))
            ,
            .unordered = true,
            .rows = .{
                .{ 7, nan, -inf },
                .{ 6, nan, nan },
                .{ 5, nan, nan },
                .{ 4, inf, nan },
                .{ 3, 2, nan },
                .{ 2, 2, nan },
                .{ 1, null, nan },
            },
        },
        .{
            .desc = "analytic_max_string",
            .sql =
            \\SELECT row_id, str_val, MAX(str_val) OVER (ORDER BY row_id)
            \\FROM TestTable
            ,
            .unordered = true,
            .rows = .{
                .{ 1, null, null },
                .{ 2, "A", "A" },
                .{ 3, "A", "A" },
                .{ 4, "B", "B" },
                .{ 5, "A", "B" },
                .{ 6, "C", "C" },
                .{ 7, null, "C" },
                .{ 8, "A", "C" },
                .{ 9, "B", "C" },
                .{ 10, "B", "C" },
            },
        },
        .{
            .desc = "analytic_max_date_timestamp",
            .sql =
            \\SELECT row_id, date_val, timestamp_val,
            \\       MAX(date_val) OVER (ORDER BY row_id DESC),
            \\       MAX(timestamp_val) OVER (ORDER BY row_id)
            \\FROM TableDateTimeBytes
            ,
            .unordered = true,
            .rows = .{
                .{ 1, null, null, "2015-01-01", null },
                .{ 2, "2014-01-01", "2014-01-01 08:00:01.011011+00", "2015-01-01", "2014-01-01 08:00:01.011011+00" },
                .{ 3, "2014-01-01", "2014-01-01 08:00:01.011011+00", "2015-01-01", "2014-01-01 08:00:01.011011+00" },
                .{ 4, "2015-01-01", "2014-01-01 08:00:01.011011+00", "2015-01-01", "2014-01-01 08:00:01.011011+00" },
                .{ 5, "2015-01-01", "2013-01-01 08:00:01.011011+00", "2015-01-01", "2014-01-01 08:00:01.011011+00" },
                .{ 6, "2014-01-01", "2015-01-01 08:00:01.011011+00", "2014-01-01", "2015-01-01 08:00:01.011011+00" },
            },
        },
        .{
            .desc = "analytic_max_bytes",
            .sql =
            \\SELECT row_id, bytes_val,
            \\       MAX(bytes_val) OVER (ORDER BY row_id)
            \\FROM TableDateTimeBytes
            ,
            .unordered = true,
            .rows = .{
                .{ 1, null, null },
                .{ 2, "\x31", "\x31" },
                .{ 3, "\x32", "\x32" },
                .{ 4, "\x31", "\x32" },
                .{ 5, "\x32", "\x32" },
                .{ 6, "\x35", "\x35" },
            },
        },
        .{
            .desc = "analytic_max_distinct_1",
            .sql =
            \\SELECT row_id, int64_val,
            \\       MAX(DISTINCT int64_val) OVER ()
            \\FROM TestTable
            ,
            .unordered = true,
            .rows = .{
                .{ 2, 2, 4 },
                .{ 4, null, 4 },
                .{ 6, 2, 4 },
                .{ 8, 4, 4 },
                .{ 10, 3, 4 },
                .{ 1, null, 4 },
                .{ 3, 1, 4 },
                .{ 5, 1, 4 },
                .{ 7, 1, 4 },
                .{ 9, 2, 4 },
            },
        },
        .{
            .desc = "analytic_max_distinct_2",
            .sql =
            \\SELECT row_id, double_val,
            \\       MAX(DISTINCT double_val) OVER ()
            \\FROM (SELECT 1 row_id, 1.0 double_val UNION ALL
            \\      SELECT 2, 2.0 UNION ALL
            \\      SELECT 3, CAST(null as double) UNION ALL
            \\      SELECT 4, 2.0 UNION ALL
            \\      SELECT 5, CAST("INF" as double) UNION ALL
            \\      SELECT 6, CAST("NaN" as double) UNION ALL
            \\      SELECT 7, CAST("NaN" as double) UNION ALL
            \\      SELECT 8, CAST("INF" as double) UNION ALL
            \\      SELECT 9, CAST("-INF" as double) UNION ALL
            \\      SELECT 10, CAST("-INF" as double))
            ,
            .unordered = true,
            .rows = .{
                .{ 2, 2, nan },
                .{ 4, 2, nan },
                .{ 6, nan, nan },
                .{ 8, inf, nan },
                .{ 10, -inf, nan },
                .{ 1, 1, nan },
                .{ 3, null, nan },
                .{ 5, inf, nan },
                .{ 7, nan, nan },
                .{ 9, -inf, nan },
            },
        },
        .{
            .desc = "analytic_max_distinct_3",
            .sql =
            \\SELECT row_id,
            \\       MAX(DISTINCT bool_val) OVER test_window,
            \\       MAX(DISTINCT CAST(int64_val as int32)) OVER test_window,
            \\       MAX(DISTINCT int64_val) OVER test_window,
            \\       MAX(DISTINCT CAST(uint64_val as uint32)) OVER test_window,
            \\       MAX(DISTINCT uint64_val) OVER test_window,
            \\       MAX(DISTINCT str_val) OVER test_window
            \\FROM TestTable
            \\WINDOW test_window AS (PARTITION BY bool_val)
            ,
            .unordered = true,
            .rows = .{
                .{ 1, null, null, null, null, null, null },
                .{ 5, false, 2, 2, 6, 6, "B" },
                .{ 9, false, 2, 2, 6, 6, "B" },
                .{ 3, false, 2, 2, 6, 6, "B" },
                .{ 7, false, 2, 2, 6, 6, "B" },
                .{ 4, true, 4, 4, 3, 3, "C" },
                .{ 8, true, 4, 4, 3, 3, "C" },
                .{ 2, true, 4, 4, 3, 3, "C" },
                .{ 6, true, 4, 4, 3, 3, "C" },
                .{ 10, true, 4, 4, 3, 3, "C" },
            },
        },
        .{
            .desc = "analytic_max_distinct_4",
            .sql =
            \\SELECT row_id,
            \\       MAX(DISTINCT double_val) OVER test_window,
            \\       MAX(DISTINCT CAST(double_val as float)) OVER test_window
            \\FROM TestTable
            \\WINDOW test_window AS (PARTITION BY bool_val)
            ,
            .unordered = true,
            .rows = .{
                .{ 1, null, null },
                .{ 5, 3.5, 3.5 },
                .{ 9, 3.5, 3.5 },
                .{ 3, 3.5, 3.5 },
                .{ 7, 3.5, 3.5 },
                .{ 4, 2.5, 2.5 },
                .{ 8, 2.5, 2.5 },
                .{ 2, 2.5, 2.5 },
                .{ 6, 2.5, 2.5 },
                .{ 10, 2.5, 2.5 },
            },
        },
        .{
            .desc = "analytic_max_distinct_5",
            .sql =
            \\SELECT row_id,
            \\       MAX(DISTINCT bytes_val) OVER (),
            \\       MAX(DISTINCT date_val) OVER (),
            \\       MAX(DISTINCT timestamp_val) OVER ()
            \\FROM TableDateTimeBytes
            ,
            .unordered = true,
            .rows = .{
                .{ 2, "\x35", "2015-01-01", "2015-01-01 08:00:01.011011+00" },
                .{ 4, "\x35", "2015-01-01", "2015-01-01 08:00:01.011011+00" },
                .{ 6, "\x35", "2015-01-01", "2015-01-01 08:00:01.011011+00" },
                .{ 1, "\x35", "2015-01-01", "2015-01-01 08:00:01.011011+00" },
                .{ 3, "\x35", "2015-01-01", "2015-01-01 08:00:01.011011+00" },
                .{ 5, "\x35", "2015-01-01", "2015-01-01 08:00:01.011011+00" },
            },
        },
        .{
            .desc = "analytic_max_with_nan_offset_following",
            .sql =
            \\select row_id, val,
            \\       max(val) over (order by row_id ROWS BETWEEN 1 FOLLOWING
            \\                                               AND 4 FOLLOWING)
            \\FROM (SELECT 3 row_id, 3 val UNION ALL
            \\      SELECT 13, NULL        UNION ALL
            \\      SELECT 14, IEEE_DIVIDE(5, 0)           UNION ALL
            \\      SELECT 12, 1           UNION ALL
            \\      SELECT 11, 2           UNION ALL
            \\      SELECT 10, NULL        UNION ALL
            \\      SELECT 8, 2            UNION ALL
            \\      SELECT 9, 6            UNION ALL
            \\      SELECT 7, IEEE_DIVIDE(0, 0)            UNION ALL
            \\      SELECT 6, NULL         UNION ALL
            \\      SELECT 5, 2            UNION ALL
            \\      SELECT 1, NULL         UNION ALL
            \\      SELECT 2, IEEE_DIVIDE(0, 0)            UNION ALL
            \\      SELECT 4, 4)
            \\order by row_id
            ,
            .rows = .{
                .{ 1, null, nan },
                .{ 2, nan, 4 },
                .{ 3, 3, nan },
                .{ 4, 4, nan },
                .{ 5, 2, nan },
                .{ 6, null, nan },
                .{ 7, nan, 6 },
                .{ 8, 2, 6 },
                .{ 9, 6, 2 },
                .{ 10, null, inf },
                .{ 11, 2, inf },
                .{ 12, 1, inf },
                .{ 13, null, inf },
                .{ 14, inf, null },
            },
        },
        .{
            .desc = "analytic_max_with_nan_offset_preceding_following",
            .sql =
            \\select row_id, val,
            \\       max(val) over (order by row_id ROWS BETWEEN 1 PRECEDING
            \\                                               AND 4 FOLLOWING)
            \\FROM (SELECT 3 row_id, 3 val UNION ALL
            \\      SELECT 13, NULL        UNION ALL
            \\      SELECT 14, IEEE_DIVIDE(5, 0)           UNION ALL
            \\      SELECT 12, 1           UNION ALL
            \\      SELECT 11, 2           UNION ALL
            \\      SELECT 10, NULL        UNION ALL
            \\      SELECT 8, 2            UNION ALL
            \\      SELECT 9, 6            UNION ALL
            \\      SELECT 7, IEEE_DIVIDE(0, 0)            UNION ALL
            \\      SELECT 6, NULL         UNION ALL
            \\      SELECT 5, 2            UNION ALL
            \\      SELECT 1, NULL         UNION ALL
            \\      SELECT 2, IEEE_DIVIDE(0, 0)            UNION ALL
            \\      SELECT 4, 4)
            \\order by row_id
            ,
            .rows = .{
                .{ 1, null, nan },
                .{ 2, nan, nan },
                .{ 3, 3, nan },
                .{ 4, 4, nan },
                .{ 5, 2, nan },
                .{ 6, null, nan },
                .{ 7, nan, nan },
                .{ 8, 2, nan },
                .{ 9, 6, 6 },
                .{ 10, null, inf },
                .{ 11, 2, inf },
                .{ 12, 1, inf },
                .{ 13, null, inf },
                .{ 14, inf, inf },
            },
        },
        .{
            .desc = "analytic_max_with_nan_offset_preceding",
            .sql =
            \\select row_id, val,
            \\       max(val) over (order by row_id ROWS BETWEEN 2 PRECEDING
            \\                                               AND 1 PRECEDING)
            \\FROM (SELECT 3 row_id, 3 val UNION ALL
            \\      SELECT 13, NULL        UNION ALL
            \\      SELECT 14, IEEE_DIVIDE(5, 0)           UNION ALL
            \\      SELECT 12, 1           UNION ALL
            \\      SELECT 11, 2           UNION ALL
            \\      SELECT 10, NULL        UNION ALL
            \\      SELECT 8, 2            UNION ALL
            \\      SELECT 9, 6            UNION ALL
            \\      SELECT 7, IEEE_DIVIDE(0, 0)            UNION ALL
            \\      SELECT 6, NULL         UNION ALL
            \\      SELECT 5, 2            UNION ALL
            \\      SELECT 1, NULL         UNION ALL
            \\      SELECT 2, IEEE_DIVIDE(0, 0)            UNION ALL
            \\      SELECT 4, 4)
            \\order by row_id
            ,
            .rows = .{
                .{ 1, null, null },
                .{ 2, nan, null },
                .{ 3, 3, nan },
                .{ 4, 4, nan },
                .{ 5, 2, 4 },
                .{ 6, null, 4 },
                .{ 7, nan, 2 },
                .{ 8, 2, nan },
                .{ 9, 6, nan },
                .{ 10, null, 6 },
                .{ 11, 2, 6 },
                .{ 12, 1, 2 },
                .{ 13, null, 2 },
                .{ 14, inf, 1 },
            },
        },
        .{
            .desc = "analytic_max_with_nan_offset_current_following",
            .sql =
            \\select row_id, val,
            \\       max(val) over (order by row_id ROWS BETWEEN CURRENT ROW
            \\                                               AND 1 FOLLOWING)
            \\FROM (SELECT 3 row_id, 3 val UNION ALL
            \\      SELECT 13, NULL        UNION ALL
            \\      SELECT 14, IEEE_DIVIDE(5, 0)           UNION ALL
            \\      SELECT 12, 1           UNION ALL
            \\      SELECT 11, 2           UNION ALL
            \\      SELECT 10, NULL        UNION ALL
            \\      SELECT 8, 2            UNION ALL
            \\      SELECT 9, 6            UNION ALL
            \\      SELECT 7, IEEE_DIVIDE(0, 0)            UNION ALL
            \\      SELECT 6, NULL         UNION ALL
            \\      SELECT 5, 2            UNION ALL
            \\      SELECT 1, NULL         UNION ALL
            \\      SELECT 2, IEEE_DIVIDE(0, 0)            UNION ALL
            \\      SELECT 4, 4)
            \\order by row_id
            ,
            .rows = .{
                .{ 1, null, nan },
                .{ 2, nan, nan },
                .{ 3, 3, 4 },
                .{ 4, 4, 4 },
                .{ 5, 2, 2 },
                .{ 6, null, nan },
                .{ 7, nan, nan },
                .{ 8, 2, 6 },
                .{ 9, 6, 6 },
                .{ 10, null, 2 },
                .{ 11, 2, 2 },
                .{ 12, 1, 1 },
                .{ 13, null, inf },
                .{ 14, inf, inf },
            },
        },
        .{
            .desc = "analytic_min_max_arr_with_nan_offset_current_and_3_following",
            .sql =
            \\select row_id, val,
            \\     min(val) over (order by row_id ROWS BETWEEN CURRENT ROW AND 3 FOLLOWING),
            \\     max(val) over (order by row_id ROWS BETWEEN CURRENT ROW AND 3 FOLLOWING)
            \\FROM (
            \\  SELECT 1 row_id, ARRAY<FLOAT64>[] val UNION ALL
            \\  SELECT 4, ARRAY<FLOAT64>[CAST("-Inf" AS FLOAT64)] UNION ALL
            \\  SELECT 2, ARRAY<FLOAT64>[NULL] UNION ALL
            \\  SELECT 3, ARRAY<FLOAT64>[CAST("NaN" AS FLOAT64)] UNION ALL
            \\  SELECT 5, ARRAY<FLOAT64>[CAST("+Inf" AS FLOAT64)] UNION ALL
            \\  SELECT 6 row_id, ARRAY<FLOAT64>[] val
            \\)
            \\order by row_id
            ,
            .rows = .{
                .{ 1, .{}, .{}, .{-inf} },
                .{ 2, .{null}, .{null}, .{inf} },
                .{ 3, .{nan}, .{}, .{inf} },
                .{ 4, .{-inf}, .{}, .{inf} },
                .{ 5, .{inf}, .{}, .{inf} },
                .{ 6, .{}, .{}, .{} },
            },
        },
        .{
            .desc = "analytic_max_range_null_date_timestamp",
            .sql =
            \\SELECT row_id,
            \\MAX(range_date_val) OVER (ORDER BY row_id),
            \\MAX(range_timestamp_val) OVER (ORDER BY row_id)
            \\FROM TableAllNullRanges
            ,
            .rows = .{
                .{ 1, null, null },
            },
        },
        .{
            .desc = "analytic_max_range_null_datetime",
            .sql =
            \\SELECT row_id,
            \\MAX(range_datetime_val) OVER (ORDER BY row_id)
            \\FROM TableAllNullDatetimeRange
            ,
            .rows = .{
                .{ 1, null },
            },
        },
        .{
            .desc = "analytic_max_range_multiple_ids",
            .sql =
            \\SELECT row_id, range_date_val, range_timestamp_val,
            \\MAX(range_date_val) OVER (ORDER BY row_id),
            \\MAX(range_timestamp_val) OVER (ORDER BY row_id)
            \\FROM TableRangeTypes
            ,
            .unordered = true,
            .rows = .{
                .{ 1, null, null, null, null },
                .{ 2, "[NULL, 0001-01-01)", "[NULL, 0001-01-01 00:00:00+00)", "[NULL, 0001-01-01)", "[NULL, 0001-01-01 00:00:00+00)" },
                .{ 3, "[NULL, 2020-01-01)", "[NULL, 2020-01-01 00:00:00+00)", "[NULL, 2020-01-01)", "[NULL, 2020-01-01 00:00:00+00)" },
                .{ 4, "[NULL, 9999-12-31)", "[NULL, 9999-12-31 23:59:59.999999+00)", "[NULL, 9999-12-31)", "[NULL, 9999-12-31 23:59:59.999999+00)" },
                .{ 5, "[NULL, NULL)", "[NULL, NULL)", "[NULL, NULL)", "[NULL, NULL)" },
                .{ 6, "[0001-01-01, 2020-01-01)", "[0001-01-01 00:00:00+00, 2020-01-01 00:00:00+00)", "[0001-01-01, 2020-01-01)", "[0001-01-01 00:00:00+00, 2020-01-01 00:00:00+00)" },
                .{ 7, "[2020-01-01, 9999-12-31)", "[2020-01-01 00:00:00+00, 9999-12-31 23:59:59.999999+00)", "[2020-01-01, 9999-12-31)", "[2020-01-01 00:00:00+00, 9999-12-31 23:59:59.999999+00)" },
                .{ 8, "[9999-12-31, NULL)", "[9999-12-31 23:59:59.999999+00, NULL)", "[9999-12-31, NULL)", "[9999-12-31 23:59:59.999999+00, NULL)" },
            },
        },
        .{
            .desc = "analytic_max_range_datetime_multiple_ids",
            .sql =
            \\SELECT row_id, range_datetime_val,
            \\MAX(range_datetime_val) OVER (ORDER BY row_id)
            \\FROM TableDatetimeRangeTypes
            ,
            .unordered = true,
            .rows = .{
                .{ 1, null, null },
                .{ 2, "[NULL, 0001-01-01 00:00:00)", "[NULL, 0001-01-01 00:00:00)" },
                .{ 3, "[NULL, 2020-01-01 00:00:00)", "[NULL, 2020-01-01 00:00:00)" },
                .{ 4, "[NULL, 9999-12-31 23:59:59.999999)", "[NULL, 9999-12-31 23:59:59.999999)" },
                .{ 5, "[NULL, NULL)", "[NULL, NULL)" },
                .{ 6, "[0001-01-01 00:00:00, 2020-01-01 00:00:00)", "[0001-01-01 00:00:00, 2020-01-01 00:00:00)" },
                .{ 7, "[2020-01-01 00:00:00, 9999-12-31 23:59:59.999999)", "[2020-01-01 00:00:00, 9999-12-31 23:59:59.999999)" },
                .{ 8, "[9999-12-31 23:59:59.999999, NULL)", "[9999-12-31 23:59:59.999999, NULL)" },
            },
        },
        .{
            .desc = "analytic_max_range_datetime_bounded_start",
            .sql =
            \\SELECT row_id, range_datetime_val,
            \\MAX(range_datetime_val) OVER (ORDER BY row_id ROWS 4 PRECEDING),
            \\MAX(range_datetime_val) OVER (ORDER BY row_id ROWS 2 PRECEDING),
            \\FROM TableDatetimeRangeTypes
            ,
            .unordered = true,
            .rows = .{
                .{ 1, null, null, null },
                .{ 2, "[NULL, 0001-01-01 00:00:00)", "[NULL, 0001-01-01 00:00:00)", "[NULL, 0001-01-01 00:00:00)" },
                .{ 3, "[NULL, 2020-01-01 00:00:00)", "[NULL, 2020-01-01 00:00:00)", "[NULL, 2020-01-01 00:00:00)" },
                .{ 4, "[NULL, 9999-12-31 23:59:59.999999)", "[NULL, 9999-12-31 23:59:59.999999)", "[NULL, 9999-12-31 23:59:59.999999)" },
                .{ 5, "[NULL, NULL)", "[NULL, NULL)", "[NULL, NULL)" },
                .{ 6, "[0001-01-01 00:00:00, 2020-01-01 00:00:00)", "[0001-01-01 00:00:00, 2020-01-01 00:00:00)", "[0001-01-01 00:00:00, 2020-01-01 00:00:00)" },
                .{ 7, "[2020-01-01 00:00:00, 9999-12-31 23:59:59.999999)", "[2020-01-01 00:00:00, 9999-12-31 23:59:59.999999)", "[2020-01-01 00:00:00, 9999-12-31 23:59:59.999999)" },
                .{ 8, "[9999-12-31 23:59:59.999999, NULL)", "[9999-12-31 23:59:59.999999, NULL)", "[9999-12-31 23:59:59.999999, NULL)" },
            },
        },
    },
