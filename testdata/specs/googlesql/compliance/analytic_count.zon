            \\       )
            \\FROM TestTable
            \\ORDER BY 1, 2, 3, 4
            ,
            .rows = .{
                .{ null, null, null, null, 3, 1, 2, 1 },
                .{ null, null, 1, -0.5, 3, 1, 2, 1 },
                .{ null, "B", null, 2.5, 3, 1, 3, 3 },
