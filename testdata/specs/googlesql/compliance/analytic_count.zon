                .{ null, null, 1, 1 },
                .{ null, true, 1, 1 },
            },
        },
        .{
            .desc = "analytic_count_over_range_between_preceding_and_following_order_by_double_asc",
            .sql =
            \\SELECT double_val, int64_val,
            \\       COUNT(int64_val + double_val) OVER (
            \\         ORDER BY double_val
            \\         RANGE BETWEEN 1.5 PRECEDING AND 1.5 FOLLOWING
            \\       ),
            \\       COUNT(*) OVER (
            \\         ORDER BY double_val
            \\         RANGE BETWEEN 2.5 PRECEDING AND 1.0 FOLLOWING
            \\       )
            \\FROM TestTable
            \\ORDER BY 1
            ,
            .unordered = true,
            .rows = .{
                .{ null, 2, 0, 2 },
                .{ null, null, 0, 2 },
                .{ -1.5, 4, 2, 2 },
                .{ -0.5, 1, 2, 2 },
                .{ 1.5, 2, 4, 6 },
                .{ 1.5, 1, 4, 6 },
                .{ 1.5, 2, 4, 6 },
                .{ 2.5, 3, 5, 6 },
                .{ 2.5, null, 5, 6 },
                .{ 3.5, 1, 2, 6 },
            },
        },
        .{
            .desc = "analytic_count_over_range_between_preceding_and_following_order_by_double_desc",
            .sql =
            \\SELECT double_val, int64_val,
            \\       COUNT(int64_val + double_val) OVER (
            \\         ORDER BY double_val DESC
            \\         RANGE BETWEEN 1.5 PRECEDING AND 1.5 FOLLOWING
            \\       ),
            \\       COUNT(*) OVER (
            \\         ORDER BY double_val DESC
            \\         RANGE BETWEEN 2.5 PRECEDING AND 1.0 FOLLOWING
            \\       )
            \\FROM TestTable
            \\ORDER BY 1 DESC
            ,
            .unordered = true,
            .rows = .{
                .{ 3.5, 1, 2, 3 },
                .{ 2.5, 3, 5, 6 },
                .{ 2.5, null, 5, 6 },
                .{ 1.5, 1, 4, 6 },
                .{ 1.5, 2, 4, 6 },
                .{ 1.5, 2, 4, 6 },
                .{ -0.5, 1, 2, 5 },
                .{ -1.5, 4, 2, 2 },
                .{ null, 2, 0, 2 },
                .{ null, null, 0, 2 },
            },
        },
        .{
            .desc = "analytic_count_over_range_between_preceding_and_following_order_by_int64_asc",
            .sql =
            \\SELECT int64_val, double_val,
            \\       COUNT(int64_val + double_val) OVER (
            \\         ORDER BY int64_val
            \\         RANGE BETWEEN 0 PRECEDING AND 100 FOLLOWING
            \\       ),
            \\       COUNT(int64_val + double_val) OVER (
            \\         ORDER BY int64_val
            \\         RANGE BETWEEN 2 PRECEDING AND 3 FOLLOWING
            \\       ),
            \\       COUNT(*) OVER (
            \\         ORDER BY int64_val
            \\         RANGE BETWEEN 100 PRECEDING AND 0 FOLLOWING
            \\       ),
            \\       COUNT(*) OVER (
            \\         ORDER BY int64_val
            \\         RANGE BETWEEN 3 PRECEDING AND 1 FOLLOWING
            \\       )
            \\FROM TestTable
            \\ORDER BY 1
            ,
            .unordered = true,
            .rows = .{
                .{ null, 2.5, 0, 0, 2, 2 },
                .{ null, null, 0, 0, 2, 2 },
                .{ 1, 1.5, 7, 7, 3, 6 },
                .{ 1, 3.5, 7, 7, 3, 6 },
                .{ 1, -0.5, 7, 7, 3, 6 },
                .{ 2, null, 4, 7, 6, 7 },
                .{ 2, 1.5, 4, 7, 6, 7 },
                .{ 2, 1.5, 4, 7, 6, 7 },
                .{ 3, 2.5, 2, 7, 7, 8 },
                .{ 4, -1.5, 1, 4, 8, 8 },
            },
        },
        .{
            .desc = "analytic_count_over_range_between_preceding_and_following_order_by_int64_desc",
            .sql =
            \\SELECT int64_val, double_val,
            \\       COUNT(int64_val + double_val) OVER (
            \\         ORDER BY int64_val DESC
            \\         RANGE BETWEEN 0 PRECEDING AND 100 FOLLOWING
            \\       ),
            \\       COUNT(int64_val + double_val) OVER (
            \\         ORDER BY int64_val DESC
            \\         RANGE BETWEEN 2 PRECEDING AND 3 FOLLOWING
            \\       ),
            \\       COUNT(*) OVER (
            \\         ORDER BY int64_val DESC
            \\         RANGE BETWEEN 100 PRECEDING AND 0 FOLLOWING
            \\       ),
            \\       COUNT(*) OVER (
            \\         ORDER BY int64_val DESC
            \\         RANGE BETWEEN 3 PRECEDING AND 1 FOLLOWING
            \\       )
            \\FROM TestTable
            \\ORDER BY 1 DESC
            ,
            .unordered = true,
            .rows = .{
                .{ 4, -1.5, 7, 7, 1, 2 },
                .{ 3, 2.5, 6, 7, 2, 5 },
                .{ 2, 1.5, 5, 7, 5, 8 },
                .{ 2, null, 5, 7, 5, 8 },
                .{ 2, 1.5, 5, 7, 5, 8 },
                .{ 1, 3.5, 3, 6, 8, 8 },
                .{ 1, -0.5, 3, 6, 8, 8 },
                .{ 1, 1.5, 3, 6, 8, 8 },
                .{ null, 2.5, 0, 0, 2, 2 },
                .{ null, null, 0, 0, 2, 2 },
            },
        },
        .{
            .desc = "analytic_count_over_range_between_preceding_and_following_with_partition_by",
            .sql =
            \\SELECT bool_val, int64_val, double_val,
            \\       COUNT(*) OVER (
            \\         PARTITION BY bool_val
            \\         ORDER BY int64_val
            \\         RANGE BETWEEN 3 PRECEDING AND 4 FOLLOWING
            \\       ),
            \\       COUNT(double_val) OVER (
            \\         PARTITION BY bool_val
            \\         ORDER BY int64_val
            \\         RANGE BETWEEN 2 PRECEDING AND 1 FOLLOWING
            \\       ),
            \\       COUNT(double_val) OVER (
            \\         PARTITION BY bool_val
            \\         ORDER BY int64_val
            \\         RANGE BETWEEN 0 PRECEDING AND 0 FOLLOWING
            \\       )
            \\FROM TestTable
            \\ORDER BY 1, 2, 3
            ,
            .rows = .{
                .{ null, null, null, 2, 1, 1 },
                .{ null, null, 2.5, 2, 1, 1 },
                .{ null, 1, -0.5, 1, 1, 1 },
                .{ false, 1, 1.5, 3, 3, 2 },
                .{ false, 1, 3.5, 3, 3, 2 },
                .{ false, 2, 1.5, 3, 3, 1 },
                .{ true, 2, null, 4, 2, 1 },
                .{ true, 2, 1.5, 4, 2, 1 },
                .{ true, 3, 2.5, 4, 3, 1 },
                .{ true, 4, -1.5, 4, 3, 1 },
            },
        },
        .{
            .desc = "analytic_count_over_range_between_preceding_and_following_orderby_uint32_desc_with_small_values",
            .sql =
            \\SELECT uint32_val, double_val,
            \\       COUNT(double_val) OVER (
            \\         ORDER BY uint32_val DESC
            \\         RANGE BETWEEN 1 PRECEDING AND 2 FOLLOWING
            \\       ),
            \\       COUNT(*) OVER (
            \\         ORDER BY uint32_val DESC
            \\         RANGE BETWEEN 1 PRECEDING AND 2 FOLLOWING
            \\       )
            \\FROM (SELECT CAST(0 AS uint32) uint32_val, NULL double_val UNION ALL
            \\      SELECT CAST(1 AS uint32),            1.0 UNION ALL
            \\      SELECT CAST(2 AS uint32),            2.0 UNION ALL
            \\      SELECT CAST(3 AS uint32),            3.0 UNION ALL
            \\      SELECT NULL,                         4.0)
            \\ORDER BY 1 DESC
            ,
            .rows = .{
                .{ 3, 3, 3, 3 },
                .{ 2, 2, 3, 4 },
                .{ 1, 1, 2, 3 },
                .{ 0, null, 1, 2 },
                .{ null, 4, 1, 1 },
            },
        },
    },
}
