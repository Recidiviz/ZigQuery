            \\       ),
            \\       COUNT(bool_val) OVER (
            \\         PARTITION BY str_val
            \\         RANGE BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
            \\       )
            \\FROM TestTable
            \\ORDER BY 1, 2, 3
            ,
            .rows = .{
                .{ null, null, null, 2, 1, 1, 0, 0 },
