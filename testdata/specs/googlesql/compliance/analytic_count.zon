                .{ "B", 2, 1.5, 3, 2, 3, 3, 2 },
                .{ "B", 3, 2.5, 3, 2, 3, 3, 2 },
                .{ "C", 2, null, 1, 1, 0, 1, 1 },
            },
        },
        .{
            .desc = "analytic_count_star_and_expr_subtotal_3",
            .sql =
            \\SELECT bool_val, str_val, int64_val, double_val,
            \\       COUNT(*) OVER (
            \\         PARTITION BY bool_val
            \\         RANGE BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
            \\       ),
            \\       COUNT(int64_val) OVER (
            \\         PARTITION BY bool_val
            \\         RANGE BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
