        .{
            .desc = "analytic_count_star_total_1",
            .sql =
            \\SELECT int64_val,
            \\       COUNT(*) OVER ()
            \\FROM TestTable
            \\ORDER BY 1
            ,
            .rows = .{
                .{ null, 10 },
                .{ null, 10 },
                .{ 1, 10 },
                .{ 1, 10 },
                .{ 1, 10 },
                .{ 2, 10 },
                .{ 2, 10 },
                .{ 2, 10 },
                .{ 3, 10 },
                .{ 4, 10 },
            },
        },
        .{
            .desc = "analytic_count_star_total_2a",
            .sql =
            \\# These tests analytic_count_star_total_2[a,b,c,d] are semantically equivalent
            \\# to the previous test.  Since the window frame is the entire data set, the
            \\# OVER clause ORDER BY is irrelevant and ROWS/RANGE behave the same.
            \\SELECT int64_val,
            \\       COUNT(*) OVER (
            \\         ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
            \\       )
            \\FROM TestTable
            \\ORDER BY 1
