        },
        .{
            .desc = "analytic_count_expr_total_6",
            .sql =
            \\# Count of more interesting expressions, with and without final projections
            \\SELECT int64_val, double_val,
            \\       COUNT(int64_val + double_val) OVER (
            \\         RANGE BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
            \\       ),
            \\       COUNT(int64_val + double_val) OVER (
            \\         ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
            \\       ) + 2
            \\FROM TestTable
            \\ORDER BY 1, 2
            ,
            .rows = .{
                .{ null, null, 7, 9 },
                .{ null, 2.5, 7, 9 },
                .{ 1, -0.5, 7, 9 },
                .{ 1, 1.5, 7, 9 },
                .{ 1, 3.5, 7, 9 },
                .{ 2, null, 7, 9 },
                .{ 2, 1.5, 7, 9 },
                .{ 2, 1.5, 7, 9 },
                .{ 3, 2.5, 7, 9 },
                .{ 4, -1.5, 7, 9 },
            },
        },
        .{
            .desc = "analytic_count_star_and_expr_subtotal_1",
            .sql =
            \\# Subtotal counts, with PARTITION BY
            \\SELECT bool_val, int64_val, double_val,
            \\       COUNT(*) OVER (
            \\         PARTITION BY bool_val
            \\         RANGE BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
            \\       ),
            \\       COUNT(int64_val) OVER (
            \\         PARTITION BY bool_val
            \\         RANGE BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
            \\       ),
            \\       COUNT(double_val) OVER (
            \\         PARTITION BY bool_val
            \\         RANGE BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
            \\       )
            \\FROM TestTable
            \\ORDER BY 1, 2, 3
            ,
            .rows = .{
                .{ null, null, null, 3, 1, 2 },
                .{ null, null, 2.5, 3, 1, 2 },
                .{ null, 1, -0.5, 3, 1, 2 },
                .{ false, 1, 1.5, 3, 3, 3 },
                .{ false, 1, 3.5, 3, 3, 3 },
                .{ false, 2, 1.5, 3, 3, 3 },
                .{ true, 2, null, 4, 4, 3 },
                .{ true, 2, 1.5, 4, 4, 3 },
                .{ true, 3, 2.5, 4, 4, 3 },
                .{ true, 4, -1.5, 4, 4, 3 },
            },
        },
        .{
            .desc = "analytic_count_star_and_expr_subtotal_2",
            .sql =
            \\SELECT str_val, int64_val, double_val,
            \\       COUNT(*) OVER (
            \\         PARTITION BY str_val
            \\       ),
            \\       COUNT(int64_val) OVER (
            \\         PARTITION BY str_val
            \\         RANGE BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING
            \\       ),
            \\       COUNT(double_val) OVER (
            \\         PARTITION BY str_val
