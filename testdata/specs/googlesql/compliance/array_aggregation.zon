            .unsupported_in_bigquery = "\"nested arrays are not supported\" (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  ARRAY_AGG(array_concat_agg([arr1, arr2]) GROUP BY arr2[OFFSET(0)][OFFSET(0)] ORDER BY MIN(arr1[OFFSET(0)][OFFSET(0)])) AS multilevel_agg
            \\FROM (
            \\  SELECT [[1,2], [3,4]] AS arr1,
            \\         [[5,6], [7,8]] AS arr2,
            \\)
            ,
            .rows = .{
