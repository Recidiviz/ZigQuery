            \\order by row_id
            ,
            .rows = .{
                .{ 1, null, 0.5 },
                .{ 2, 2, 0.5 },
                .{ 3, 3, null },
                .{ 4, 4, null },
            },
        },
        .{
            .desc = "analytic_stats_double_column_rows_offset_following_unbounded",
            .sql =
            \\select row_id, val,
            \\       covar_pop(val, val) over (order by row_id ROWS BETWEEN 1 FOLLOWING
            \\                                               AND UNBOUNDED FOLLOWING)
            \\FROM (SELECT 3 row_id, 3 val UNION ALL
            \\      SELECT 1, NULL         UNION ALL
            \\      SELECT 2, 2            UNION ALL
            \\      SELECT 4, 4)
            \\order by row_id
            ,
            .rows = .{
                .{ 1, null, 0.66666666666666663 },
                .{ 2, 2, 0.25 },
                .{ 3, 3, 0 },
                .{ 4, 4, null },
            },
        },
        .{
            .desc = "analytic_stats_double_column_range_unbounded",
            .sql =
            \\# RANGE window frames are currently supported for cumulative var_pop.
            \\select row_id, val,
            \\       covar_pop(val, val) over (order by row_id
            \\                          RANGE UNBOUNDED PRECEDING)
            \\FROM (SELECT 3 row_id, 3 val UNION ALL
            \\      SELECT 1, NULL         UNION ALL
            \\      SELECT 2, 2            UNION ALL
            \\      SELECT 4, 4)
            \\order by row_id
            ,
            .rows = .{
                .{ 1, null, null },
                .{ 2, 2, 0 },
                .{ 3, 3, 0.25 },
                .{ 4, 4, 0.66666666666666663 },
            },
        },
        .{
            .desc = "analytic_stats_double_column_range_unbounded_current_row",
            .sql =
            \\# Tests with various duplication of peer tuples (with the same ORDER BY value).
            \\# All peers get the same cumulative covariance value.
            \\select row_id, val,
            \\       covar_samp(val, val) over (order by row_id
            \\                           RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
            \\FROM (SELECT 1 row_id, 1 val UNION ALL
            \\      SELECT 1, 3            UNION ALL
            \\      SELECT 1, NULL         UNION ALL
            \\      SELECT 1, 4            UNION ALL
            \\      SELECT 1, 2            UNION ALL
            \\      SELECT 1, 5)
            \\order by row_id, val
            ,
            .rows = .{
                .{ 1, null, 2.5 },
                .{ 1, 1, 2.5 },
                .{ 1, 2, 2.5 },
                .{ 1, 3, 2.5 },
                .{ 1, 4, 2.5 },
                .{ 1, 5, 2.5 },
            },
        },
        .{
            .desc = "analytic_stats_double_column_range_unbounded_current_row_2",
            .sql =
            \\select row_id, val,
            \\       covar_pop(val, val) over (order by row_id
            \\                      RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
            \\FROM (SELECT 4 row_id, 10 val UNION ALL
            \\      SELECT 1, NULL          UNION ALL
            \\      SELECT 2, NULL          UNION ALL
            \\      SELECT 6, NULL          UNION ALL
            \\      SELECT 7, NULL          UNION ALL
            \\      SELECT 1, NULL          UNION ALL
            \\      SELECT 8, 1000          UNION ALL
            \\      SELECT 3, NULL          UNION ALL
            \\      SELECT 9, NULL          UNION ALL
            \\      SELECT 3, 1             UNION ALL
            \\      SELECT 6, 100           UNION ALL
            \\      SELECT 4, NULL          UNION ALL
            \\      SELECT 4, 10            UNION ALL
            \\      SELECT 7, NULL          UNION ALL
            \\      SELECT 4, 10            UNION ALL
            \\      SELECT 5, NULL)
            \\order by row_id, val
            ,
            .rows = .{
                .{ 1, null, null },
                .{ 1, null, null },
                .{ 2, null, null },
                .{ 3, null, 0 },
                .{ 3, 1, 0 },
                .{ 4, null, 15.1875 },
                .{ 4, 10, 15.1875 },
                .{ 4, 10, 15.1875 },
                .{ 4, 10, 15.1875 },
                .{ 5, null, 15.1875 },
                .{ 6, null, 1373.76 },
                .{ 6, 100, 1373.76 },
                .{ 7, null, 1373.76 },
                .{ 7, null, 1373.76 },
                .{ 8, 1000, 132851.25 },
                .{ 9, null, 132851.25 },
            },
        },
        .{
            .desc = "analytic_stats_double_column_range_partition",
            .sql =
            \\# Test with duplication of peer tuple values across partitions.
            \\# All peers in the same partition get the same cumulative stddev_samp value, but
            \\# tuples in different partitions are completely unrelated.
            \\select row_id, value,
            \\       covar_samp(value, value) over (partition by row_id order by value)
            \\FROM (SELECT 1 row_id, 3 value UNION ALL
            \\      SELECT 2, 3 UNION ALL
            \\      SELECT 3, 4 UNION ALL
            \\      SELECT 4, 4 UNION ALL
            \\      SELECT 5, 4 UNION ALL
            \\      SELECT 5, 5)
            \\order by row_id, value
            ,
            .rows = .{
                .{ 1, 3, null },
                .{ 2, 3, null },
                .{ 3, 4, null },
                .{ 4, 4, null },
                .{ 5, 4, null },
                .{ 5, 5, 0.5 },
            },
        },
        .{
            .desc = "analytic_stats_double_column_range_unbounded_offset_preceding",
            .sql =
            \\select row_id, val,
            \\       covar_pop(val, val) over (order by row_id
            \\                      RANGE BETWEEN UNBOUNDED PRECEDING
            \\                                AND 1 PRECEDING)
            \\FROM (SELECT 3 row_id, 3 val UNION ALL
            \\      SELECT 1, NULL         UNION ALL
            \\      SELECT 2, 2            UNION ALL
            \\      SELECT 4, 4)
            \\order by row_id
            ,
            .rows = .{
                .{ 1, null, null },
                .{ 2, 2, null },
                .{ 3, 3, 0 },
                .{ 4, 4, 0.25 },
            },
        },
        .{
            .desc = "analytic_stats_double_column_range_unbounded_offset_following",
            .sql =
            \\select row_id, val,
            \\       covar_samp(val, val) over (order by row_id
            \\                      RANGE BETWEEN UNBOUNDED PRECEDING
            \\                                AND 1 FOLLOWING)
            \\FROM (SELECT 3 row_id, 3 val UNION ALL
            \\      SELECT 1, NULL         UNION ALL
            \\      SELECT 2, 2            UNION ALL
            \\      SELECT 4, 4)
            \\order by row_id
            ,
            .rows = .{
                .{ 1, null, null },
                .{ 2, 2, 0.5 },
                .{ 3, 3, 1 },
                .{ 4, 4, 1 },
            },
        },
        .{
            .desc = "analytic_stats_double_column_range_unbounded_unbounded",
            .sql =
            \\select row_id, val,
            \\       covar_pop(val, val) over (order by row_id
            \\                      RANGE BETWEEN UNBOUNDED PRECEDING
            \\                                AND UNBOUNDED FOLLOWING)
            \\FROM (SELECT 3 row_id, 3 val UNION ALL
            \\      SELECT 1, NULL         UNION ALL
            \\      SELECT 2, 2            UNION ALL
            \\      SELECT 4, 4)
            \\order by row_id
            ,
            .rows = .{
                .{ 1, null, 0.66666666666666663 },
                .{ 2, 2, 0.66666666666666663 },
                .{ 3, 3, 0.66666666666666663 },
                .{ 4, 4, 0.66666666666666663 },
            },
        },
        .{
            .desc = "analytic_stats_double_column_range_offset_preceding_offset_preceding",
            .sql =
            \\select row_id, val,
            \\       covar_samp(val, val) over (order by row_id
            \\                      RANGE BETWEEN 2 PRECEDING
            \\                                AND 1 PRECEDING)
            \\FROM (SELECT 3 row_id, 3 val UNION ALL
            \\      SELECT 1, NULL         UNION ALL
            \\      SELECT 2, 2            UNION ALL
            \\      SELECT 4, 4)
            \\order by row_id
            ,
            .rows = .{
                .{ 1, null, null },
                .{ 2, 2, null },
                .{ 3, 3, null },
                .{ 4, 4, 0.5 },
            },
        },
        .{
            .desc = "analytic_stats_double_column_range_offset_preceding_current_row",
            .sql =
            \\select row_id, val,
            \\       covar_pop(val, val) over (order by row_id
            \\                      RANGE BETWEEN 1 PRECEDING
            \\                                AND CURRENT ROW)
            \\FROM (SELECT 3 row_id, 3 val UNION ALL
            \\      SELECT 1, NULL         UNION ALL
            \\      SELECT 2, 2            UNION ALL
            \\      SELECT 4, 4)
            \\order by row_id
            ,
            .rows = .{
                .{ 1, null, null },
                .{ 2, 2, 0 },
                .{ 3, 3, 0.25 },
                .{ 4, 4, 0.25 },
            },
        },
        .{
            .desc = "analytic_stats_double_column_range_offset_preceding_unbounded_following",
            .sql =
            \\select row_id, val,
            \\       covar_samp(val, val) over (order by row_id
            \\                      RANGE BETWEEN 1 PRECEDING
            \\                                AND UNBOUNDED FOLLOWING)
            \\FROM (SELECT 3 row_id, 3 val UNION ALL
            \\      SELECT 1, NULL         UNION ALL
            \\      SELECT 2, 2            UNION ALL
            \\      SELECT 4, 4)
            \\order by row_id
            ,
            .rows = .{
                .{ 1, null, 1 },
                .{ 2, 2, 1 },
                .{ 3, 3, 1 },
                .{ 4, 4, 0.5 },
            },
        },
        .{
            .desc = "analytic_stats_double_column_range_current_row",
            .sql =
            \\select row_id, val,
            \\       covar_pop(val, val) over (order by row_id
            \\                      RANGE BETWEEN CURRENT ROW AND CURRENT ROW)
            \\FROM (SELECT 3 row_id, 3 val UNION ALL
            \\      SELECT 1, NULL         UNION ALL
            \\      SELECT 2, 2            UNION ALL
            \\      SELECT 4, 4)
            \\order by row_id
            ,
            .rows = .{
                .{ 1, null, null },
                .{ 2, 2, 0 },
                .{ 3, 3, 0 },
                .{ 4, 4, 0 },
            },
        },
        .{
            .desc = "analytic_stats_double_column_range_current_row_unbounded",
            .sql =
            \\select row_id, val,
            \\       covar_samp(val, val) over (order by row_id
            \\                      RANGE BETWEEN CURRENT ROW
            \\                                AND UNBOUNDED FOLLOWING)
            \\FROM (SELECT 3 row_id, 3 val UNION ALL
            \\      SELECT 1, NULL         UNION ALL
            \\      SELECT 2, 2            UNION ALL
            \\      SELECT 4, 4)
            \\order by row_id
            ,
            .rows = .{
                .{ 1, null, 1 },
                .{ 2, 2, 1 },
                .{ 3, 3, 0.5 },
                .{ 4, 4, null },
            },
        },
        .{
            .desc = "analytic_stats_double_column_range_offset_following_offset_following",
            .sql =
            \\select row_id, val,
            \\       covar_pop(val, val) over (order by row_id
            \\                      RANGE BETWEEN 1 FOLLOWING
            \\                                AND 2 FOLLOWING)
            \\FROM (SELECT 3 row_id, 3 val UNION ALL
            \\      SELECT 1, NULL         UNION ALL
            \\      SELECT 2, 2            UNION ALL
            \\      SELECT 4, 4)
            \\order by row_id
            ,
            .rows = .{
                .{ 1, null, 0.25 },
                .{ 2, 2, 0.25 },
                .{ 3, 3, 0 },
                .{ 4, 4, null },
            },
        },
        .{
            .desc = "analytic_stats_double_column_range_offset_following_unbounded",
            .sql =
            \\select row_id, val,
            \\       covar_samp(val, val) over (order by row_id
            \\                      RANGE BETWEEN 1 FOLLOWING
            \\                                AND UNBOUNDED FOLLOWING)
            \\FROM (SELECT 3 row_id, 3 val UNION ALL
            \\      SELECT 1, NULL         UNION ALL
            \\      SELECT 2, 2            UNION ALL
            \\      SELECT 4, 4)
            \\order by row_id
            ,
            .rows = .{
                .{ 1, null, 1 },
                .{ 2, 2, 0.5 },
                .{ 3, 3, null },
                .{ 4, 4, null },
            },
        },
        .{
            .desc = "analytic_stats_double_column_corr_return_nan_value_1",
            .sql =
            \\SELECT a,
            \\       CORR(a, - 942.24663687266877) OVER ()
            \\FROM (
            \\  select 1 a union all
            \\  select 2 union all
            \\  select 3 union all
            \\  select 4 union all
            \\  select 5 union all
            \\  select 6 union all
            \\  select 7 union all
            \\  select 8)
            \\order by a
            ,
            .rows = .{
                .{ 1, nan },
                .{ 2, nan },
                .{ 3, nan },
                .{ 4, nan },
                .{ 5, nan },
                .{ 6, nan },
                .{ 7, nan },
                .{ 8, nan },
            },
        },
        .{
            .desc = "analytic_stats_double_column_corr_return_nan_value_2",
            .sql =
            \\SELECT a,
            \\       CORR(-749.83751175908083, - 943.04501418685186) OVER ()
            \\FROM (
            \\  select 1 a union all
            \\  select 2 union all
            \\  select 3 union all
            \\  select 4 union all
            \\  select 5 union all
            \\  select 6 union all
            \\  select 7 union all
            \\  select 8)
            \\order by a
            ,
            .rows = .{
                .{ 1, nan },
                .{ 2, nan },
                .{ 3, nan },
                .{ 4, nan },
                .{ 5, nan },
                .{ 6, nan },
                .{ 7, nan },
