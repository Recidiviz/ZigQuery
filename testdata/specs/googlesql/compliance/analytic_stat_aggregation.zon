                .{ 3, 1.7142857142857144, 1.7142857142857142, 2, 2, 1.3093073414159544, 1.4142135623730951, 1.4142135623730951 },
                .{ 0, 1.7142857142857144, 1.7142857142857142, 2, 2, 1.3093073414159544, 1.4142135623730951, 1.4142135623730951 },
            },
