            .sql =
            \\SELECT a,
            \\       CORR(99.203917203408537, -235.84828348474082) OVER ()
            \\FROM (
            \\  select 1 a union all
            \\  select 2 union all
            \\  select 3 union all
            \\  select 4 union all
            \\  select 5 union all
            \\  select 6 union all
            \\  select 7 union all
