            \\         COVAR_POP(val_1, val_2)     OVER (partition by part_id),
            \\         COVAR_SAMP(val_1, val_2)    OVER (partition by part_id)
            \\FROM (SELECT 3 part_id, 1 row_id, NUMERIC '30' val_1, NUMERIC '33' val_2 UNION ALL
