            \\       covar_pop(cast(val as INT32),  cast(val as INT32)) over window1,
            \\       covar_pop(cast(val as INT64),  cast(val as INT64)) over window1,
            \\       covar_pop(cast(val as UINT32), cast(val as UINT32)) over window1,
