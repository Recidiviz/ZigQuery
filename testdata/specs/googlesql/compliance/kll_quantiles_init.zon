.{
    .spec = "googlesql/compliance/kll_quantiles_init",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/googlesql/compliance/testdata/kll_quantiles_init.test",
    .cases = .{
        .{
            .desc = "init_int64_no_input_rows_input",
            .sql =
            \\# The function KLL_QUANTILES.INIT has different signatures depending whether the
            \\# language feature FEATURE_KLL_WEIGHTS is enabled. If enabled, the INIT
            \\# function can take in an optional named argument `weight`.
            \\# Start section: KLL INIT no input rows. Test cases are
            \\# repeated for four types of concrete signatures:
            \\# - input only
            \\# - input + precision
            \\# - input + weight
            \\# - input + precision + weight
            \\# All test cases should return NULL.
            \\SELECT
            \\  KLL_QUANTILES.INIT_INT64(x) AS sketch
            \\FROM
            \\  UNNEST(ARRAY< INT64 >[]) AS x
            ,
            .rows = .{
                .{null},
            },
        },
        .{
            .desc = "init_uint64_no_input_rows_input",
            .unsupported_in_bigquery = "KLL_QUANTILES.INIT resolves only the INT64 form; UINT64/DOUBLE forms unresolvable (recidiviz-bigquery-sandbox, 2026-08-23)",
            .sql =
            \\SELECT
            \\  KLL_QUANTILES.INIT_UINT64(x) AS sketch
            \\FROM
            \\  UNNEST(ARRAY< UINT64 >[]) AS x
            ,
            .rows = .{
                .{null},
            },
        },
        .{
            .desc = "init_double_no_input_rows_input",
            .unsupported_in_bigquery = "KLL_QUANTILES.INIT resolves only the INT64 form; UINT64/DOUBLE forms unresolvable (recidiviz-bigquery-sandbox, 2026-08-23)",
