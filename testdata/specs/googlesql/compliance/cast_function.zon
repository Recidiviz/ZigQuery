            },
        },
        .{
            .desc = "roundtrip_cast_negative_integer_zero_to_string",
            .sql =
            \\# Test case for CAST-ing and FORMAT-ing to canonicalized integer-type 0.
            \\SELECT
            \\  CAST(-0 AS STRING),
            \\  CAST(-0 AS INT32),
            \\  CAST(-0 AS INT64),
            \\  CAST(CAST('-0' AS INT32) AS STRING),
            \\  CAST(-CAST('0' AS INT32) AS STRING),
            \\  CAST(CAST('-0' AS INT64) AS STRING),
            \\  CAST(-CAST('0' AS INT64) AS STRING)
            ,
            .rows = .{
                .{ "0", 0, 0, "0", "0", "0", "0" },
            },
        },
