            \\# INT64_MAX + 1 => 9223372036854775808
            \\select cast(9223372036854775808 as int64), 9223372036854775808
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "safe_cast_overflowing_literal_into_int64",
