        .{
            .desc = "cast_map_with_floats_in_different_fields",
            .unsupported_in_bigquery = "\"MAP datatype is not supported\" (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\# This case should be marked as non-deterministic because the DOUBLE in the
            \\# value field potentially contains precision loss that is encoded in the string.
            \\SELECT CAST(MAP_FROM_ARRAY([STRUCT<STRING, DOUBLE>("1.1", 1.0 + 0.1)]) AS MAP<DOUBLE, STRING>)
            ,
            .nondeterministic = true,
        },
