            \\  CAST(-CAST(0 AS NUMERIC) AS STRING),
            \\  CAST(CAST(-0 AS BIGNUMERIC) AS STRING),
            \\  CAST(-CAST(0 AS BIGNUMERIC) AS STRING)
            ,
            .rows = .{
