        },
        .{
            .desc = "cast_timestamp_to_string_invalid_format",
            .sql = "SELECT CAST(TIMESTAMP'1234-05-06' as string FORMAT 'a' || 'b')",
            .expect_error_any = true,
        },
        .{
            .desc = "cast_number_to_string_null",
            .sql =
            \\# Test that when casting number to string, the output is null is the input is null, or
            \\# the format string is null.
            \\SELECT CAST(CAST(null as INT64) as string FORMAT '99'),
            \\       CAST(1.23 as string FORMAT CAST(NULL as STRING))
            ,
            .rows = .{
                .{ null, null },
            },
        },
        .{
            .desc = "cast_number_to_string_simple",
            .sql =
            \\# Test that the implementation is invoked.
            \\select cast(cast(1.23 as int32) as STRING format '99.9'),
            \\       cast(cast(1.23 as uint32) as STRING format '99.9'),
            \\       cast(cast(1.23 as int64) as STRING format '99.9'),
            \\       cast(cast(1.23 as uint64) as STRING format '99.9'),
            \\       cast(cast(1.23 as float) as STRING format '99.9'),
            \\       cast(cast(1.23 as double) as STRING format '99.9'),
            \\       cast(cast(1.23 as numeric) as STRING format '99.9'),
            \\       cast(cast(1.23 as bignumeric) as STRING format '99.9')
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "cast_struct_type_parameters_valid_input",
            .sql =
            \\# Casting with type parameters succeeds.
            \\select cast(([(BIGNUMERIC '0.12345', 'hey', null), (0.9876, 'hi', NUMERIC '0.55')], b'hello')
            \\as STRUCT<ARRAY<STRUCT<BIGNUMERIC(2, 2), STRING(4), NUMERIC(2, 1)>>, BYTES(5)>)
            ,
            .rows = .{
                .{.{ .{ .{ 0.12, "hey", null }, .{ 0.99, "hi", 0.6 } }, "\x68\x65\x6c\x6c\x6f" }},
            },
        },
        .{
            .desc = "cast_string_type_parameters_invalid_input",
            .sql =
            \\# Casting to STRING(L) fails if the casted string is longer than L.
            \\select cast(123456 as STRING(5))
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "cast_numeric_type_parameters_invalid_input",
            .sql =
            \\# Casting to NUMERIC(P) fails if the casted numeric has more than P digits.
            \\select cast(123456 as NUMERIC(5))
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "cast_array_type_parameters_invalid_input",
            .sql =
            \\# Casting to an ARRAY fails if the elements of the ARRAY have type parameters
            \\# that are violated.
            \\select cast(['hello', 'hi'] as ARRAY<STRING(2)>)
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "cast_struct_type_parameters_invalid_input",
            .sql = "select cast((b'hey', 2) as STRUCT<BYTES(2), INT64>)",
            .expect_error_any = true,
        },
        .{
            .desc = "cast_large_numeric_succeeds",
            .sql = "select CAST(9999999999999999999999999999.999999999 as numeric)",
            .rows = .{
                .{9999999999999999999999999999.999999999},
            },
        },
        .{
            .desc = "cast_numeric_max_value_succeeds",
            .sql = "select CAST(99999999999999999999999999999.999999999 as numeric)",
            .rows = .{
                .{99999999999999999999999999999.999999999},
            },
        },
        .{
            .desc = "cast_struct_with_large_floating_point",
            .sql =
            \\# Struct fields with large floating points are not implicitly coerced.
            \\select cast((99999999999999999999999999.999999999, 99999999999999999999999999.999999999) as struct<numeric, bignumeric>)
            ,
            .rows = .{
                .{.{ 100000000000000004764729344, 100000000000000004764729344 }},
            },
        },
        .{
            .desc = "cast_struct_with_large_floating_point_with_type_parameters",
            .sql =
            \\# Struct fields with large floating points and type parameters are not
            \\# implicitly coerced.
            \\select cast((99999999999999999999999999.999999999, 99999999999999999999999999.999999999) as struct<numeric(29,1), bignumeric(29,1)>)
            ,
            .rows = .{
                .{.{ 100000000000000004764729344, 100000000000000004764729344 }},
            },
        },
        .{
            .desc = "cast_array_with_large_floating_point",
            .sql =
            \\# Arrays containing large floating point elements are implicitly coerced.
            \\select cast([numeric '99999999999999999999999999.999999999'] as array<numeric>)
            ,
            .rows = .{
                .{.{99999999999999999999999999.999999999}},
            },
        },
        .{
            .desc = "cast_array_with_large_floating_point_with_type_parameters",
            .sql =
            \\# Arrays containing large floating point elements with type parameters are
            \\# implicitly coerced.
            \\select cast([numeric '99999999999999999999999999.999999999'] as array<numeric(29,1)>)
            ,
            .rows = .{
                .{.{100000000000000000000000000}},
            },
        },
        .{
            .desc = "cast_numeric_max_value_with_type_parameters_invalid_input",
            .sql = "select CAST(9999999999999999999999999999.999999999 as numeric(29, 1))",
            .expect_error_any = true,
        },
        .{
            .desc = "cast_bytes_as_proto_overwrites_singular_numeric_field",
            .sql =
            \\# When a singular numeric field appears more than once in an encoded proto, the
            \\# last occurrence should be accepted.
            \\SELECT CAST(
            \\  CONCAT(
            \\    CAST(CAST("int64_key_1:11 int64_key_2:22" AS googlesql_test.KitchenSinkPB) AS BYTES),
            \\    CAST(CAST("int64_key_1:1111 int64_key_2:2222" AS googlesql_test.KitchenSinkPB) AS BYTES)
            \\  )
            \\AS googlesql_test.KitchenSinkPB).int64_key_1
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "cast_bytes_as_proto_merges_singular_nested_proto_non_repeated_field",
            .sql =
            \\# When a singular embedded message field appears more than once in a serialized
            \\# proto, the multiple occurrences should be merged.
            \\SELECT CAST(
            \\  CONCAT(
            \\    CAST(CAST("int64_key_1:11 int64_key_2:22 nested_value: {nested_int64: 123}" AS googlesql_test.KitchenSinkPB) AS BYTES),
            \\    CAST(CAST("int64_key_1:1111 int64_key_2:2222 nested_value: {}" AS googlesql_test.KitchenSinkPB) AS BYTES)
            \\  )
            \\AS googlesql_test.KitchenSinkPB).nested_value.nested_int64
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "cast_bytes_as_proto_merges_singular_nested_proto_repeated_field",
            .sql =
            \\# When a singular embedded message field appears more than once in a serialized
            \\# proto, the multiple occurrences should be merged.
            \\SELECT CAST(
            \\  CONCAT(
            \\    CAST(CAST("int64_key_1:11 int64_key_2:22 nested_value: {nested_repeated_int64: 100 nested_repeated_int64: 200}" AS googlesql_test.KitchenSinkPB) AS BYTES),
            \\    CAST(CAST("int64_key_1:1111 int64_key_2:2222 nested_value: {nested_repeated_int64: 300 nested_repeated_int64: 400}" AS googlesql_test.KitchenSinkPB) AS BYTES)
            \\  )
            \\AS googlesql_test.KitchenSinkPB).nested_value.nested_repeated_int64
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "cast_bytes_as_proto_merges_singular_group_non_repeated_field",
            .sql =
            \\# When a singular group appears more than once in a serialized proto, the
            \\# multiple occurrences should be merged.
            \\SELECT CAST(
            \\  CONCAT(
            \\    CAST(CAST("int64_key_1:11 int64_key_2:22 OptionalGroup: {int64_val: 123 string_val: 'a'}" AS googlesql_test.KitchenSinkPB) AS BYTES),
            \\    CAST(CAST("int64_key_1:1111 int64_key_2:2222 OptionalGroup: {int64_val: 123123}" AS googlesql_test.KitchenSinkPB) AS BYTES)
            \\  )
            \\AS googlesql_test.KitchenSinkPB).OptionalGroup.string_val
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "cast_bytes_as_proto_merges_singular_group_repeated_field",
            .sql =
            \\# When a singular group appears more than once in a serialized proto, the
            \\# multiple occurrences should be merged.
            \\SELECT CAST(
            \\  CONCAT(
            \\    CAST(CAST("int64_key_1:11 int64_key_2:22 OptionalGroup: {int64_val: 123 OptionalGroupNested: {int64_val: 12} }" AS googlesql_test.KitchenSinkPB) AS BYTES),
            \\    CAST(CAST("int64_key_1:1111 int64_key_2:2222 OptionalGroup: {int64_val: 123123 OptionalGroupNested: {int64_val: 1212} }" AS googlesql_test.KitchenSinkPB) AS BYTES)
            \\  )
            \\AS googlesql_test.KitchenSinkPB).OptionalGroup.OptionalGroupNested
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "cast_string_as_bool",
            .sql = "select CAST(\"abc\" as BOOL)",
            .expect_error_any = true,
        },
