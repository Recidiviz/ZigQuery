        },
        .{
            .desc = "cast_array_with_literals_larger_than_target_element_type",
            .unsupported_in_bigquery = "\"Type not found: INT32\" (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql = "select cast(ARRAY<INT64>[-21474836480|21474836470] as ARRAY<INT32>)",
            .rows = .{
                .{.{-10}},
            },
        },
        .{
            .desc = "cast_invalid_string_to_int64",
            .sql = "select cast(\"abc\" as INT64)",
            .expect_error_any = true,
        },
        .{
            .desc = "safe_cast_invalid_string_to_int64",
            .sql = "select safe_cast(\"abc\" as INT64)",
