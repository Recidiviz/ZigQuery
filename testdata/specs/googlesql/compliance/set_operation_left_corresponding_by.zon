            .rows = .{
                .{ 1, null },
            },
        },
        .{
            .desc = "left_corresponding_by_second_scan_has_padded_NULL_except_all_2row_2row",
            .unsupported_in_bigquery = "EXCEPT ALL is not supported. Only EXCEPT DISTINCT is supported. (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\# LEFT CORRESPONDING BY the 2nd scan has padded NULL [row, row] EXCEPT ALL [row, row] = []
