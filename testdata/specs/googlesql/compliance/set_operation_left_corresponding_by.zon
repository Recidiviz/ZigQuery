            \\WITH
            \\  Table1 AS (
            \\    SELECT CAST(1 AS INT64) AS a, CAST(NULL AS INT64) AS b
            \\    UNION ALL
            \\    SELECT 1, NULL
            \\  )
            \\SELECT a, b FROM Table1
            \\LEFT EXCEPT ALL CORRESPONDING BY (a, b)
            \\SELECT 1 AS a
