        .{
            .desc = "hash_functions_with_hex",
            .sql =
            \\# Converting hashes to hex is one of the most common use cases for TO_HEX.
            \\SELECT
            \\  input_string,
            \\  TO_HEX(MD5(input_bytes)),
            \\  TO_HEX(MD5(input_string)),
            \\  TO_HEX(SHA1(input_bytes)),
            \\  TO_HEX(SHA1(input_string)),
            \\  TO_HEX(SHA256(input_bytes)),
            \\  TO_HEX(SHA256(input_string)),
            \\  TO_HEX(SHA512(input_bytes)),
            \\  TO_HEX(SHA512(input_string))
            \\FROM (
            \\  SELECT
            \\    CAST(input_string AS BYTES) AS input_bytes,
            \\    input_string,
            \\    off
            \\  FROM UNNEST(['', 'a b c d', 'abcABCжщфЖЩФ', 'a b c d',
            \\               'Моша_öá5ホバークラフト鰻鰻']) AS input_string WITH OFFSET off
            \\)
            \\ORDER BY off
            ,
            .rows = .{
                .{ "", "d41d8cd98f00b204e9800998ecf8427e", "d41d8cd98f00b204e9800998ecf8427e", "da39a3ee5e6b4b0d3255bfef95601890afd80709", "da39a3ee5e6b4b0d3255bfef95601890afd80709", "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855", "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e", "cf83e1357eefb8bdf1542850d66d8007d620e4050b5715dc83f4a921d36ce9ce47d0d13c5d85f2b0ff8318d2877eec2f63b931bd47417a81a538327af927da3e" },
