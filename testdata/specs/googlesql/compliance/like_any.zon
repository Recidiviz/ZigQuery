        .{
            .desc = "like_any_subquery_collation_underscore_error",
            .unsupported_in_bigquery = "\"The LIKE ANY|SOME|ALL operator does not support subquery expression as patterns\" (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\# Runtime error when '_' wildcard in a subquery pattern and collation is present in the LHS.
            \\SELECT
            \\  collate('Google', 'und:ci') LIKE ANY (SELECT 'G__gle')
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "not_like_any_subquery_collation_underscore_error",
            .unsupported_in_bigquery = "\"The LIKE ANY|SOME|ALL operator does not support subquery expression as patterns\" (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\# Runtime error when '_' wildcard in a subquery pattern and collation is present in the RHS.
            \\SELECT
            \\  'Google' NOT LIKE ANY (SELECT collate('G__gle', 'und:ci'))
            ,
            .expect_error_any = true,
        },
    },
}
