        .{
            .desc = "prepare_database",
            .sql =
            \\# Table with special values including null, min and max values.
            \\CREATE TABLE AnalyticTableWithSpecialValues AS
            \\SELECT CAST(1 AS INT64) as row_id,
            \\       CAST(null AS BIGNUMERIC) as bignumeric_val UNION ALL
            \\  SELECT 2, null UNION ALL
            \\  SELECT 3, BIGNUMERIC '-578960446186580977117854925043439539266.34992332820282019728792003956564819968' UNION ALL
            \\  SELECT 4, BIGNUMERIC '-578960446186580977117854925043439539266.34992332820282019728792003956564819968' UNION ALL
