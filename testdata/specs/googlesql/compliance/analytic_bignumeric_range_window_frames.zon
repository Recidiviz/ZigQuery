            \\  SELECT 7, BIGNUMERIC '-1e38' UNION ALL
            \\  SELECT 8, -10 UNION ALL
            \\  SELECT 9, BIGNUMERIC '-1.00000000000000000000000000000000000001' UNION ALL
            \\  SELECT 10, -1 UNION ALL
            \\  SELECT 11, BIGNUMERIC '-1e-38' UNION ALL
            \\  SELECT 12, 0 UNION ALL
            \\  SELECT 13, BIGNUMERIC '1e-38' UNION ALL
