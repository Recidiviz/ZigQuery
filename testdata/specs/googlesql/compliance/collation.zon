            \\SELECT 1 primary_Key, "hello" col_ci, "a" col_binary, "HELLO" UNION ALL
            \\SELECT 2, "Case sensitive", "a", "b" UNION ALL
            \\SELECT 3, "case sensitive", "a", "c" UNION ALL
            \\SELECT 4, "Hello", "a", "B" UNION ALL
            \\SELECT 5, "h܏ello", "a", "Case Sensitive"
            ,
        },
