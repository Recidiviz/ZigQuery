        .{
            .desc = "repeated_enum_fields2",
            .sql =
            \\select key, e
            \\from Table1 t, t.value.repeated_test_enum e
            \\where key in (1,2,4)
            \\order by 1,2
            ,
            .rows = .{
                .{ 4, "ENUM0" },
                .{ 4, "ENUM1" },
                .{ 4, "ENUM2" },
                .{ 4, "ENUM2" },
                .{ 4, "ENUM2" },
                .{ 4, "ENUM2147483647" },
            },
        },
        .{
            .desc = "repeated_enum_fields2_from_table_name_array_path",
            .sql =
            \\select e
            \\from Table1.value.repeated_test_enum e
            \\order by 1
            ,
            .rows = .{
                .{"ENUM0"},
                .{"ENUM1"},
                .{"ENUM2"},
                .{"ENUM2"},
                .{"ENUM2"},
                .{"ENUM2147483647"},
            },
        },
        .{
            .desc = "insert_bad_proto_enum_int_value",
            .sql =
            \\select as googlesql_test.Proto3KitchenSink
            \\  coalesce(1234) as test_enum  # non-const enum value
            ,
            .rows = .{
                .{"test_enum: 1234"},
            },
        },
        .{
            .desc = "insert_bad_proto_enum_string_value",
            .sql =
            \\select as googlesql_test.Proto3KitchenSink
            \\  coalesce("bad enum string") as test_enum  # non-const enum value
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "string_cast_invalid_proto_enum_field_value",
            .sql = "SELECT CAST(\"test_enum: 7\" AS googlesql_test.Proto3KitchenSink) AS pb",
            .rows = .{
                .{.{"test_enum: 7"}},
            },
        },
        .{
            .desc = "bytes_cast_invalid_proto_enum_field_value",
            .sql = "SELECT CAST(b\"\\x90\\x03\\x07\" AS googlesql_test.Proto3KitchenSink) AS pb",
            .rows = .{
                .{.{"test_enum: 7"}},
            },
        },
        .{
            .desc = "roundtrip_string_cast_invalid_proto_enum_field_value",
            .sql = "SELECT CAST(CAST(\"test_enum: 7\" AS googlesql_test.Proto3KitchenSink) AS STRING) AS s",
            .nondeterministic = true,
        },
        .{
            .desc = "back_to_proto_through_bytes_cast_invalid_proto_enum_field_value",
            .sql = "SELECT CAST(CAST(CAST(\"test_enum: 7\" AS googlesql_test.Proto3KitchenSink) AS BYTES) as googlesql_test.Proto3KitchenSink) AS pb",
            .nondeterministic = true,
        },
