            \\       value.repeated_sfixed64_val,
            \\       value.repeated_sint32_val,
            \\       value.repeated_sint64_val
            \\from Table1 where key!=3 order by key
            ,
            .rows = .{
                .{ 1, .{}, .{}, .{}, .{}, .{}, .{} },
                .{ 2, null, null, null, null, null, null },
                .{ 4, .{13}, .{13}, .{13}, .{13}, .{13}, .{13} },
            },
        },
        .{
            .desc = "enum_fields",
