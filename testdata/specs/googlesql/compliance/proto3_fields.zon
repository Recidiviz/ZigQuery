                .{ 2, null, null, null, null, null, null },
                .{ 3, false, false, false, false, false, false },
                .{ 4, true, true, true, true, true, true },
            },
        },
        .{
            .desc = "repeated_scalar_fields_encoded",
            .sql =
            \\select key,
            \\       value.repeated_fixed32_val,
