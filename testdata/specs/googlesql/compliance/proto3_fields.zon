// Imported from GoogleSQL's own compliance-testdata suite
// (third_party/googlesql/googlesql/compliance/testdata, Apache-2.0).
.{
    .spec = "googlesql/compliance/proto3_fields",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/googlesql/compliance/testdata/proto3_fields.test",
    .cases = .{
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TABLE Table0 AS
            \\select 0 key
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TABLE MessageWithNulls AS
            \\SELECT 1 key, cast("" as googlesql_test.Proto3MessageWithNulls) as value
            \\union all
            \\SELECT 2 key, """i1: 5 i2: 5"""
            \\union all
            \\SELECT 3, NULL
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TABLE TableWithNulls AS
            \\SELECT cast(1 as int64) as primary_key,
            \\       cast(null as int64) as int64_val UNION ALL
            \\  SELECT 2,  null UNION ALL
            \\  SELECT 3, null UNION ALL
            \\  SELECT 4, null UNION ALL
            \\  SELECT 5, 4 UNION ALL
            \\  SELECT 6, 5 UNION ALL
            \\  SELECT 7, 6
            ,
        },
        .{
            .desc = "select_small_proto",
            .sql = "select key, value from Table1 where key=1",
            .rows = .{
                .{ 1, "{}" },
            },
        },
        .{
            .desc = "select_null_proto",
            .sql = "select key, value from Table1 where key=2",
            .rows = .{
                .{ 2, null },
            },
        },
        .{
            .desc = "empty_message_field",
            .sql =
            \\select value.empty_message from Table1
            \\where key in (1,2,4) order by key
            ,
            .rows = .{
                .{null},
                .{null},
                .{"{}"},
            },
        },
        .{
            .desc = "scalar_fields",
            .sql =
            \\# Note that we're getting proto defaults for some of these columns.
            \\select key,
            \\       value.int32_val,
            \\       value.uint32_val,
            \\       value.int64_val,
            \\       value.uint64_val,
            \\       value.string_val,
            \\       value.float_val,
            \\       value.double_val,
            \\       value.bytes_val,
            \\       value.bool_val
            \\from Table1 order by key
            ,
            .rows = .{
                .{ 1, 0, 0, 0, 0, "", 0, 0, "", false },
                .{ 2, null, null, null, null, null, null, null, null, null },
                .{ 3, 6, 0, 0, 0, "", 0, 0, "", true },
                .{ 4, 12, 12, 12, 12, "sss", 12.5, 12.5, "\x62\x62\x62", true },
            },
        },
        .{
            .desc = "has_scalar_fields",
            .sql =
            \\select key,
            \\       value.has_int32_val,
            \\       value.has_uint32_val,
            \\       value.has_int64_val,
            \\       value.has_uint64_val,
            \\       value.has_string_val,
            \\       value.has_float_val,
            \\       value.has_double_val,
            \\       value.has_bytes_val,
            \\       value.has_bool_val
            \\from Table1 order by key
            ,
            .rows = .{
                .{ 1, false, false, false, false, false, false, false, false, false },
                .{ 2, null, null, null, null, null, null, null, null, null },
                .{ 3, true, false, false, false, false, false, false, false, true },
                .{ 4, true, true, true, true, true, true, true, true, true },
            },
        },
        .{
            .desc = "repeated_scalar_fields",
            .sql =
            \\select key,
            \\       value.repeated_int32_val,
            \\       value.repeated_uint32_val,
            \\       value.repeated_int64_val,
            \\       value.repeated_uint64_val,
            \\       value.repeated_string_val,
            \\       value.repeated_float_val,
            \\       value.repeated_double_val,
            \\       value.repeated_bytes_val,
            \\       value.repeated_bool_val
            \\from Table1 order by key
            ,
            .rows = .{
                .{ 1, .{}, .{}, .{}, .{}, .{}, .{}, .{}, .{}, .{} },
                .{ 2, null, null, null, null, null, null, null, null, null },
                .{ 3, .{}, .{ 7, 8, 9 }, .{}, .{}, .{}, .{}, .{}, .{}, .{} },
                .{ 4, .{13}, .{13}, .{13}, .{13}, .{"sss"}, .{13.5}, .{13.5}, .{"\x62\x62\x62"}, .{true} },
            },
        },
        .{
            .desc = "has_repeated_scalar_fields",
            .sql =
            \\select key,
            \\       value.has_repeated_int32_val
            \\from Table1 order by key
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "scalar_fields_encoded",
