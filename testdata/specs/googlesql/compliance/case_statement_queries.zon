            \\    WHEN CAST(1.23 AS NUMERIC) THEN 2
            \\  ELSE 3 END
            \\FROM (
            \\  SELECT CAST(-1 AS NUMERIC) AS x UNION ALL
            \\  SELECT CAST(1.23 AS NUMERIC) AS x UNION ALL
            \\  SELECT CAST(NULL AS NUMERIC) AS x
            \\)
            \\ORDER BY x
