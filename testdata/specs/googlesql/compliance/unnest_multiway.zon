            .desc = "multiway_unnest_with_join_expr",
            .sql =
            \\# b/423700272
            \\SELECT a FROM (SELECT NULL)
            \\LEFT JOIN UNNEST(ARRAY[1] AS a, ARRAY[0] AS b) ON false
            ,
