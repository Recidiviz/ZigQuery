            \\       ANY_VALUE(DISTINCT str_val), ANY_VALUE(DISTINCT int32_val), ANY_VALUE(DISTINCT uint32_val),
            \\       ANY_VALUE(DISTINCT int64_val), ANY_VALUE(DISTINCT uint64_val), ANY_VALUE(DISTINCT date_val),
            \\       ANY_VALUE(DISTINCT bytes_val), ANY_VALUE(DISTINCT timestamp_val)
            \\  FROM TableOneValue
            ,
            .rows = .{
                .{ true, 1, 1, "1", 1, 1, 1, 1, "2001-01-01", "\x31", "2001-01-01 00:00:00+00" },
            },
        },
        .{
            .desc = "aggregation_distinct_any_value_3",
            .sql =
            \\SELECT ANY_VALUE(DISTINCT bool_val), ANY_VALUE(DISTINCT double_val), ANY_VALUE(DISTINCT float_val),
            \\       ANY_VALUE(DISTINCT str_val), ANY_VALUE(DISTINCT int32_val), ANY_VALUE(DISTINCT uint32_val),
            \\       ANY_VALUE(DISTINCT int64_val), ANY_VALUE(DISTINCT uint64_val), ANY_VALUE(DISTINCT date_val),
            \\       ANY_VALUE(DISTINCT bytes_val), ANY_VALUE(DISTINCT timestamp_val)
            \\  FROM TableAllNull
            ,
            .rows = .{
                .{ null, null, null, null, null, null, null, null, null, null, null },
            },
        },
        .{
            .desc = "aggregation_distinct_any_value_group_by",
            .sql =
            \\SELECT ANY_VALUE(DISTINCT date_val), bool_val
            \\FROM TableOneValue GROUP BY bool_val ORDER BY bool_val
            ,
            .rows = .{
                .{ "2001-01-01", true },
            },
        },
        .{
            .desc = "aggregation_distinct_any_value_group_by_and_having",
            .sql =
            \\SELECT ANY_VALUE(DISTINCT date_val), bool_val
            \\FROM TableOneValue GROUP BY bool_val HAVING bool_val ORDER BY bool_val
            ,
            .rows = .{
                .{ "2001-01-01", true },
            },
        },
        .{
            .desc = "aggregation_distinct_any_value_empty",
            .sql = "SELECT ANY_VALUE(DISTINCT val) FROM TableEmpty",
            .rows = .{
                .{null},
            },
        },
        .{
            .desc = "aggregation_distinct_any_value_double_INF",
            .sql =
            \\SELECT ANY_VALUE(DISTINCT double_val) IN (CAST("Inf" AS float), CAST("-Inf" AS float))
            \\FROM TableAllTypes WHERE IS_INF(double_val)
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "aggregation_distinct_any_value_float_INF",
            .sql =
            \\SELECT ANY_VALUE(DISTINCT float_val) IN (CAST("Inf" AS float), CAST("-Inf" AS float))
            \\FROM TableAllTypes WHERE IS_INF(float_val)
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "aggregation_distinct_any_value_double_NaN",
            .sql =
            \\SELECT ANY_VALUE(DISTINCT double_val)
            \\FROM TableAllTypes WHERE IS_NAN(double_val)
            ,
            .rows = .{
                .{nan},
            },
        },
        .{
            .desc = "aggregation_distinct_any_value_float_NaN",
            .sql = "SELECT ANY_VALUE(DISTINCT float_val) FROM TableAllTypes WHERE IS_NAN(float_val)",
            .rows = .{
                .{nan},
            },
        },
        .{
            .desc = "aggregation_distinct_any_value_range",
            .sql =
            \\SELECT ANY_VALUE(DISTINCT range_date_val), ANY_VALUE(DISTINCT range_timestamp_val)
            \\FROM (
            \\  SELECT RANGE<DATE> '[2020-01-01, 2020-12-31)' range_date_val,
            \\  RANGE<TIMESTAMP> '[2020-01-01, 2020-12-31)' AS range_timestamp_val UNION ALL
            \\  SELECT RANGE<DATE> '[2020-01-01, 2020-12-31)' range_date_val,
            \\  RANGE<TIMESTAMP> '[2020-01-01, 2020-12-31)' AS range_timestamp_val
            \\)
            ,
            .rows = .{
                .{ "[2020-01-01, 2020-12-31)", "[2020-01-01 08:00:00+00, 2020-12-31 08:00:00+00)" },
            },
        },
        .{
            .desc = "aggregation_distinct_any_value_range_datetime",
            .sql =
            \\SELECT ANY_VALUE(DISTINCT range_datetime_val)
            \\FROM (
            \\  SELECT RANGE<DATETIME> '[2020-01-01, 2020-12-31)' range_datetime_val UNION ALL
            \\  SELECT RANGE<DATETIME> '[2020-01-01, 2020-12-31)' range_datetime_val
            \\)
            ,
            .rows = .{
                .{"[2020-01-01 00:00:00, 2020-12-31 00:00:00)"},
            },
        },
        .{
            .desc = "aggregation_distinct_any_value_range_date_group_by",
            .sql =
            \\SELECT bool_val, ANY_VALUE(DISTINCT range_date_val)
            \\FROM (
            \\  SELECT true bool_val, RANGE<DATE> '[2020-01-01, 2020-02-01)' range_date_val UNION ALL
            \\  SELECT true bool_val, RANGE<DATE> '[2020-01-01, 2020-02-01)' range_date_val UNION ALL
            \\  SELECT false bool_val, RANGE<DATE> '[2020-02-01, 2020-03-01)' range_date_val UNION ALL
            \\  SELECT false bool_val, RANGE<DATE> '[2020-02-01, 2020-03-01)' range_date_val
            \\)
            \\GROUP BY bool_val
            ,
            .unordered = true,
            .rows = .{
                .{ false, "[2020-02-01, 2020-03-01)" },
                .{ true, "[2020-01-01, 2020-02-01)" },
            },
        },
        .{
            .desc = "aggregation_distinct_any_value_range_timestamp_group_by",
            .sql =
            \\SELECT bool_val, ANY_VALUE(DISTINCT range_timestamp_val)
            \\FROM (
            \\  SELECT true bool_val, RANGE<TIMESTAMP> '[2020-01-01, 2020-02-01)' range_timestamp_val UNION ALL
            \\  SELECT true bool_val, RANGE<TIMESTAMP> '[2020-01-01, 2020-02-01)' range_timestamp_val UNION ALL
            \\  SELECT false bool_val, RANGE<TIMESTAMP> '[2020-02-01, 2020-03-01)' range_timestamp_val UNION ALL
            \\  SELECT false bool_val, RANGE<TIMESTAMP> '[2020-02-01, 2020-03-01)' range_timestamp_val
            \\)
            \\GROUP BY bool_val
            ,
            .unordered = true,
            .rows = .{
                .{ false, "[2020-02-01 08:00:00+00, 2020-03-01 08:00:00+00)" },
                .{ true, "[2020-01-01 08:00:00+00, 2020-02-01 08:00:00+00)" },
            },
        },
        .{
            .desc = "aggregation_distinct_any_value_range_datetime_group_by",
            .sql =
            \\SELECT bool_val, ANY_VALUE(DISTINCT range_datetime_val)
            \\FROM (
            \\  SELECT true bool_val, RANGE<DATETIME> '[2020-01-01, 2020-02-01)' range_datetime_val UNION ALL
            \\  SELECT true bool_val, RANGE<DATETIME> '[2020-01-01, 2020-02-01)' range_datetime_val UNION ALL
            \\  SELECT false bool_val, RANGE<DATETIME> '[2020-02-01, 2020-03-01)' range_datetime_val UNION ALL
            \\  SELECT false bool_val, RANGE<DATETIME> '[2020-02-01, 2020-03-01)' range_datetime_val
            \\)
            \\GROUP BY bool_val
            ,
            .unordered = true,
            .rows = .{
                .{ false, "[2020-02-01 00:00:00, 2020-03-01 00:00:00)" },
                .{ true, "[2020-01-01 00:00:00, 2020-02-01 00:00:00)" },
            },
        },
        .{
            .desc = "aggregation_distinct_any_value_range_date_group_by_having",
            .sql =
            \\SELECT bool_val, ANY_VALUE(DISTINCT range_date_val)
            \\FROM (
            \\  SELECT true bool_val, RANGE<DATE> '[2020-01-01, 2020-02-01)' range_date_val UNION ALL
            \\  SELECT true bool_val, RANGE<DATE> '[2020-01-01, 2020-02-01)' range_date_val UNION ALL
            \\  SELECT false bool_val, RANGE<DATE> '[2020-02-01, 2020-03-01)' range_date_val UNION ALL
            \\  SELECT false bool_val, RANGE<DATE> '[2020-02-01, 2020-03-01)' range_date_val
            \\)
            \\GROUP BY bool_val HAVING bool_val
            ,
            .rows = .{
                .{ true, "[2020-01-01, 2020-02-01)" },
            },
        },
        .{
            .desc = "aggregation_distinct_any_value_range_timestamp_group_by_having",
            .sql =
            \\SELECT bool_val, ANY_VALUE(DISTINCT range_timestamp_val)
            \\FROM (
            \\  SELECT true bool_val, RANGE<TIMESTAMP> '[2020-01-01, 2020-02-01)' range_timestamp_val UNION ALL
            \\  SELECT true bool_val, RANGE<TIMESTAMP> '[2020-01-01, 2020-02-01)' range_timestamp_val UNION ALL
            \\  SELECT false bool_val, RANGE<TIMESTAMP> '[2020-02-01, 2020-03-01)' range_timestamp_val UNION ALL
            \\  SELECT false bool_val, RANGE<TIMESTAMP> '[2020-02-01, 2020-03-01)' range_timestamp_val
            \\)
            \\GROUP BY bool_val HAVING bool_val
            ,
            .rows = .{
                .{ true, "[2020-01-01 08:00:00+00, 2020-02-01 08:00:00+00)" },
            },
        },
        .{
            .desc = "aggregation_distinct_any_value_range_datetime_group_by_having",
            .sql =
            \\SELECT bool_val, ANY_VALUE(DISTINCT range_datetime_val)
            \\FROM (
            \\  SELECT true bool_val, RANGE<DATETIME> '[2020-01-01, 2020-02-01)' range_datetime_val UNION ALL
            \\  SELECT true bool_val, RANGE<DATETIME> '[2020-01-01, 2020-02-01)' range_datetime_val UNION ALL
            \\  SELECT false bool_val, RANGE<DATETIME> '[2020-02-01, 2020-03-01)' range_datetime_val UNION ALL
            \\  SELECT false bool_val, RANGE<DATETIME> '[2020-02-01, 2020-03-01)' range_datetime_val
            \\)
            \\GROUP BY bool_val HAVING bool_val
            ,
            .rows = .{
                .{ true, "[2020-01-01 00:00:00, 2020-02-01 00:00:00)" },
            },
        },
        .{
            .desc = "aggregation_distinct_any_value_range_date_group_by_range",
            .sql =
            \\SELECT ANY_VALUE(DISTINCT range_date_val)
            \\FROM (
            \\  SELECT RANGE<DATE> '[2020-01-01, 2020-02-01)' range_date_val UNION ALL
            \\  SELECT RANGE<DATE> '[2020-01-01, 2020-02-01)' range_date_val UNION ALL
            \\  SELECT RANGE<DATE> '[2020-02-01, 2020-03-01)' range_date_val UNION ALL
            \\  SELECT RANGE<DATE> '[2020-02-01, 2020-03-01)' range_date_val
            \\)
            \\GROUP BY range_date_val
            ,
            .unordered = true,
            .rows = .{
                .{"[2020-01-01, 2020-02-01)"},
                .{"[2020-02-01, 2020-03-01)"},
            },
        },
        .{
            .desc = "aggregation_distinct_any_value_range_timestamp_group_by_range",
            .sql =
            \\SELECT ANY_VALUE(DISTINCT range_timestamp_val)
            \\FROM (
            \\  SELECT RANGE<TIMESTAMP> '[2020-01-01, 2020-02-01)' range_timestamp_val UNION ALL
            \\  SELECT RANGE<TIMESTAMP> '[2020-01-01, 2020-02-01)' range_timestamp_val UNION ALL
            \\  SELECT RANGE<TIMESTAMP> '[2020-02-01, 2020-03-01)' range_timestamp_val UNION ALL
            \\  SELECT RANGE<TIMESTAMP> '[2020-02-01, 2020-03-01)' range_timestamp_val
            \\)
            \\GROUP BY range_timestamp_val
            ,
            .unordered = true,
            .rows = .{
                .{"[2020-01-01 08:00:00+00, 2020-02-01 08:00:00+00)"},
                .{"[2020-02-01 08:00:00+00, 2020-03-01 08:00:00+00)"},
            },
        },
        .{
            .desc = "aggregation_distinct_any_value_range_datetime_group_by_range",
            .sql =
            \\SELECT ANY_VALUE(DISTINCT range_datetime_val)
            \\FROM (
            \\  SELECT RANGE<DATETIME> '[2020-01-01, 2020-02-01)' range_datetime_val UNION ALL
            \\  SELECT RANGE<DATETIME> '[2020-01-01, 2020-02-01)' range_datetime_val UNION ALL
            \\  SELECT RANGE<DATETIME> '[2020-02-01, 2020-03-01)' range_datetime_val UNION ALL
            \\  SELECT RANGE<DATETIME> '[2020-02-01, 2020-03-01)' range_datetime_val
            \\)
            \\GROUP BY range_datetime_val
            ,
            .unordered = true,
            .rows = .{
                .{"[2020-01-01 00:00:00, 2020-02-01 00:00:00)"},
                .{"[2020-02-01 00:00:00, 2020-03-01 00:00:00)"},
            },
        },
        .{
            .desc = "aggregation_distinct_sum_9_with_group_by",
            .sql =
            \\# Overflow double.
            \\SELECT 1 as a, SUM(DISTINCT x) FROM (SELECT 1.1e+308 x UNION ALL SELECT 1.2e+308) GROUP BY 1
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "aggregation_distinct_sum_7_with_group_by",
            .sql =
            \\# Overflow int64.
            \\SELECT 1 as a, SUM(DISTINCT x) FROM (SELECT 9223372036854775807 x UNION ALL SELECT 1) GROUP BY 1
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "aggregation_distinct_sum_8_with_group_by",
            .sql =
            \\# Overflow uint64.
            \\SELECT 1 as a, SUM(DISTINCT x) FROM (SELECT 18446744073709551615 x UNION ALL SELECT CAST(1 AS uint64) as x) GROUP BY 1
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "aggregation_distinct_sum_9",
            .sql =
            \\# Overflow double.
            \\SELECT SUM(DISTINCT x) FROM (SELECT 1.1e+308 x UNION ALL SELECT 1.2e+308)
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "aggregation_distinct_sum_7",
            .sql =
            \\# Overflow int64.
            \\SELECT SUM(DISTINCT x) FROM (SELECT 9223372036854775807 x UNION ALL SELECT 1)
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "aggregation_distinct_sum_8",
            .sql =
            \\# Overflow uint64.
            \\SELECT SUM(DISTINCT x) FROM (SELECT 18446744073709551615 x UNION ALL SELECT CAST(1 AS uint64) as x)
            ,
            .expect_error_any = true,
        },
    },
}
