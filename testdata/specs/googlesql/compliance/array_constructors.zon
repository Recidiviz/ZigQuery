            ,
            .rows = .{
                .{.{ 0, 0, 100 }},
            },
        },
        .{
            .desc = "construct_FLOAT_array_from_non_literals",
            .sql =
            \\SELECT ARRAY<FLOAT>[CAST(1.1 * 1000 AS FLOAT), a]
