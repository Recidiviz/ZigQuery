            },
        },
        .{
            .desc = "construct_INT32_array_from_non_literals",
            .sql = "SELECT ARRAY<INT32>[CAST(1 + 1 AS INT32), a] FROM (SELECT cast(1 as int32) a)",
            .rows = .{
                .{.{ 2, 1 }},
            },
        },
        .{
            .desc = "construct_UINT32_array_from_non_literals",
            .sql =
            \\SELECT ARRAY<UINT32>[CAST(0 * 0 AS UINT32), CAST(99 + 1 - 100 AS UINT32), a]
