        .{
            .desc = "select_string_array_constructed_unnest_explicit",
            .sql =
            \\##
            \\## Queries that tests explicit unnest. This time we do not require a full
            \\## matrix.
            \\##
            \\SELECT elem FROM UNNEST(ARRAY<STRING>["σ", NULL, "⨝"]) AS elem
            ,
            .unordered = true,
            .rows = .{
                .{"σ"},
                .{null},
                .{"⨝"},
            },
        },
        .{
            .desc = "select_unnest_explicit_of_empty_array",
            .sql = "SELECT elem FROM UNNEST(ARRAY<STRING>[]) AS elem",
            .rows = .{},
        },
        .{
            .desc = "select_unnest_explicit_of_null_array",
            .sql = "SELECT elem FROM UNNEST(CAST(NULL AS ARRAY<STRING>)) AS elem",
            .rows = .{},
        },
        .{
            .desc = "select_string_array_constructed_unnest_with_offset",
            .sql =
            \\##
            \\## From here, several queries to test offset/ordinality without joins.
            \\##
            \\SELECT elem, offset FROM UNNEST(ARRAY<STRING>["σ", NULL, "⨝"]) elem WITH OFFSET
            ,
            .unordered = true,
            .rows = .{
                .{ "σ", 0 },
                .{ null, 1 },
                .{ "⨝", 2 },
            },
        },
        .{
            .desc = "select_string_array_constructed_unnest_with_offset_aliased",
            .sql = "SELECT elem, off FROM UNNEST(ARRAY<STRING>[\"σ\", NULL, \"⨝\"]) elem WITH OFFSET off",
            .unordered = true,
            .rows = .{
                .{ "σ", 0 },
                .{ null, 1 },
                .{ "⨝", 2 },
            },
        },
        .{
            .desc = "select_string_array_constructed_unnest_with_offset_sorted",
            .sql =
            \\SELECT elem, offset
            \\FROM UNNEST(ARRAY<STRING>["σ", NULL, "⨝"]) elem WITH OFFSET
            \\ORDER BY offset desc
            ,
            .rows = .{
                .{ "⨝", 2 },
                .{ null, 1 },
                .{ "σ", 0 },
            },
        },
        .{
            .desc = "select_string_array_constructed_unnest_with_offset_alaised_sorted",
            .sql =
            \\SELECT elem, off
            \\FROM UNNEST(ARRAY<STRING>["σ", NULL, "⨝"]) elem WITH OFFSET off
            \\ORDER BY off desc
            ,
            .rows = .{
                .{ "⨝", 2 },
                .{ null, 1 },
                .{ "σ", 0 },
            },
        },
        .{
            .desc = "string_with_length_and_collation",
            // A parameterized type (STRING(5)) can't head an ARRAY literal's element
            // type: "Parameterized types are not supported in literal value
            // construction" (recidiviz-bigquery-sandbox, 2026-08-25).
            .unsupported_in_bigquery = "parameterized types in literals (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\select
            \\  distinct str
            \\FROM
            \\  UNNEST(ARRAY<STRING(5) COLLATE "und:ci">["abc", "ABC", "def"]) as str
            ,
            .unordered = true,
            .rows = .{
                .{"ABC"},
                .{"def"},
            },
        },
        .{
            .desc = "string_with_length_and_collation_error_case",
            .unsupported_in_bigquery = "parameterized types in literals (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\select
            \\  ARRAY<STRING(5) COLLATE "und:ci">["123456"]
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "numeric_with_parameters",
            .unsupported_in_bigquery = "parameterized types in literals (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql = "select ARRAY<NUMERIC(10, 1)>[NUMERIC \"1234.12\", NUMERIC \"1234.2345\", 1234.3456]",
            .rows = .{
                .{.{ 1234.1, 1234.2, 1234.3 }},
            },
        },
        .{
            .desc = "timestamp_with_parameters",
            .unsupported_in_bigquery = "parameterized types in literals (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\select ARRAY<TIMESTAMP(6)>[
            \\  TIMESTAMP "2020-01-01 1:2:3.123",
            \\  TIMESTAMP "2020-01-02 1:2:3.123456",
            \\  TIMESTAMP "2020-01-03 1:2:3.123456789012"]
            ,
            .rows = .{
                .{.{ "2020-01-01 09:02:03.123+00", "2020-01-02 09:02:03.123456+00", "2020-01-03 09:02:03.123456+00" }},
            },
        },
        .{
            .desc = "struct_with_type_modifiers",
            .unsupported_in_bigquery = "parameterized types in literals (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT distinct v
            \\FROM
            \\  UNNEST(ARRAY<STRUCT<STRING(5) COLLATE "und:ci", NUMERIC(10, 1), TIMESTAMP(6)>>[
            \\    ("abc", NUMERIC "123.12", TIMESTAMP "2020-01-01 1:2:3.123456789012"),
            \\    ("ABC", NUMERIC "123.13", TIMESTAMP "2020-01-01 1:2:3.123456789"),
            \\    ("def", NUMERIC "123.23", TIMESTAMP "2020-01-02 1:2:3.123456789012")
            \\    ]) as v
            ,
            .unordered = true,
            .rows = .{
                .{.{ "ABC", 123.1, "2020-01-01 09:02:03.123456+00" }},
                .{.{ "def", 123.2, "2020-01-02 09:02:03.123456+00" }},
            },
        },
        .{
            .desc = "struct_with_type_modifiers_cannot_truncate_string",
            .unsupported_in_bigquery = "parameterized types in literals (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  ARRAY<STRUCT<STRING(5)>>[
