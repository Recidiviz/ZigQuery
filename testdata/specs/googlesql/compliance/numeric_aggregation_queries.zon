            \\UNION ALL
            \\SELECT CAST(2 as int64) as row_id, CAST(2 AS NUMERIC) as val
            \\UNION ALL
            \\SELECT CAST(3 as int64) as row_id, CAST(3 AS NUMERIC) as val
            \\UNION ALL
