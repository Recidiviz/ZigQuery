            \\       CAST('NaN' as DOUBLE) NOT BETWEEN NULL AND CAST('NaN' as DOUBLE),
            \\       CAST('NaN' as DOUBLE) NOT BETWEEN CAST('NaN' as DOUBLE) AND NULL,
