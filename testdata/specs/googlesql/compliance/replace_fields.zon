// Imported from GoogleSQL's own compliance-testdata suite
// (third_party/googlesql/googlesql/compliance/testdata, Apache-2.0).
.{
    .spec = "googlesql/compliance/replace_fields",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/googlesql/compliance/testdata/replace_fields.test",
    .cases = .{
        .{
            .desc = "replace_fields_proto_null",
            .unsupported_in_bigquery = "REPLACE_FIELDS() is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  REPLACE_FIELDS(
            \\    CAST(NULL as googlesql_test.KitchenSinkPB),
            \\    11 as int64_val, "abc" as string_val, true as bool_val,
            \\    13 as nested_value.nested_int64
            \\  )
            ,
            .rows = .{
                .{null},
            },
        },
        .{
            .desc = "replace_fields_proto_repeated_append",
            .sql =
            \\WITH KitchenSinkTable as (SELECT CAST(
            \\      "int64_key_1:13, int64_key_2:123, repeated_int64_val:[3,2,1]"
            \\        as googlesql_test.KitchenSinkPB
            \\   ) foo)
            \\SELECT
            \\  REPLACE_FIELDS(
            \\    foo, ARRAY_CONCAT(foo.repeated_int64_val, [0, -1]) as repeated_int64_val
            \\  )
            \\FROM KitchenSinkTable
            ,
            .rows = .{
                .{.{"int64_key_1: 13 int64_key_2: 123 repeated_int64_val: 3 repeated_int64_val: 2 repeated_int64_val: 1 repeated_int64_val: 0 repeated_int64_val: -1"}},
            },
        },
        .{
            .desc = "replace_fields_proto_array_of_protos",
            .sql =
            \\SELECT
            \\  ARRAY(
            \\    SELECT
            \\      REPLACE_FIELDS(array_element, array_element.int32_val1 + 5 as int32_val1)
            \\    FROM
            \\      UNNEST(
            \\        ARRAY<googlesql_test.TestExtraPB> ["int32_val1:1",
            \\        "int32_val1:2",
            \\        "int32_val1:3"]
            \\      ) array_element
            \\    ORDER BY array_element.int32_val1
            \\  )
            ,
            .rows = .{
                .{.{ .{"int32_val1: 6"}, .{"int32_val1: 7"}, .{"int32_val1: 8"} }},
            },
        },
        .{
            .desc = "replace_fields_proto_clear_required",
            .unsupported_in_bigquery = "REPLACE_FIELDS() is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  REPLACE_FIELDS(
            \\    CAST(
            \\      "int64_key_1:13, int64_key_2:123"
            \\        as googlesql_test.KitchenSinkPB
            \\    ),
            \\    NULL as int64_key_1
            \\  )
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "replace_fields_proto_clear_required_subfield",
            .unsupported_in_bigquery = "REPLACE_FIELDS() is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  REPLACE_FIELDS(
            \\    CAST(
            \\      "required_field:13, required_nested:{required_field:34432}"
            \\        as googlesql_test.TestNullabilityMiddlePB
            \\    ),
            \\    NULL as required_nested.required_field
            \\  )
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "replace_fields_proto_modify_unset_subfield",
            .unsupported_in_bigquery = "REPLACE_FIELDS() is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  REPLACE_FIELDS(
            \\    CAST(
            \\      "int64_key_1:13, int64_key_2:123"
            \\        as googlesql_test.KitchenSinkPB
            \\    ),
            \\    500 as nested_value.nested_int64
            \\  )
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "replace_fields_proto_oneofs",
            .unsupported_in_bigquery = "REPLACE_FIELDS() is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  REPLACE_FIELDS(
            \\    CAST(
            \\      "int64_key_1:13, int64_key_2:123, int64_one_of:1111"
            \\        as googlesql_test.KitchenSinkPB
            \\    ),
            \\    22222 as int64_one_of, "oneof_field" as string_one_of
            \\  )
            ,
            .rows = .{
                .{.{"int64_key_1: 13 int64_key_2: 123 string_one_of: \"oneof_field\" int64_one_of: 22222"}},
            },
        },
        .{
            .desc = "replace_fields_proto_null_oneofs",
            .unsupported_in_bigquery = "REPLACE_FIELDS() is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\# All oneof fields are NULL. The oneof in the input is cleared only if the oneof
            \\# case is specified in the replace_fields.
            \\SELECT
            \\  REPLACE_FIELDS(
            \\    CAST(
            \\      "non_oneof: 1 int32_one_of: 2"
            \\        as googlesql_test.OneofProto
            \\    ),
            \\    NULL as string_one_of, NULL as bool_one_of
            \\  ),
            \\  REPLACE_FIELDS(
            \\    CAST(
            \\      "non_oneof: 1 int32_one_of: 2"
            \\        as googlesql_test.OneofProto
            \\    ),
            \\    NULL as string_one_of, NULL as int32_one_of, NULL as bool_one_of
            \\  ),
            ,
            .rows = .{
                .{ .{"non_oneof: 1 int32_one_of: 2"}, .{"non_oneof: 1"} },
            },
        },
        .{
            .desc = "replace_fields_proto_msg_oneof_after_other_oneof",
            .unsupported_in_bigquery = "REPLACE_FIELDS() is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\# We cannot update recursive_oneof.non_oneof because recursive_oneof is unset
            \\# by the preceding string_one_of update.
            \\SELECT
            \\  REPLACE_FIELDS(
            \\    CAST(
            \\      "non_oneof: 1 recursive_oneof { non_oneof: 1 }"
            \\        as googlesql_test.OneofProtoRecursive
            \\    ),
            \\    'oneof_string' as string_one_of, 2 as recursive_oneof.non_oneof
            \\  )
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "replace_fields_proto_msg_oneof_before_another_oneof",
            .unsupported_in_bigquery = "REPLACE_FIELDS() is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\# The change to recursive_oneof is discarded after int32_one_of is set in
            \\# the output.
            \\SELECT
            \\  REPLACE_FIELDS(
            \\    CAST(
            \\      "non_oneof: 1 recursive_oneof { non_oneof: 1 }"
            \\        as googlesql_test.OneofProtoRecursive
            \\    ),
            \\    NULL as string_one_of, 2 as recursive_oneof.non_oneof, 2 as int32_one_of
            \\  )
            ,
            .rows = .{
                .{.{"non_oneof: 1 int32_one_of: 2"}},
            },
        },
        .{
            .desc = "replace_fields_proto_multi_msg_oneofs",
            .unsupported_in_bigquery = "REPLACE_FIELDS() is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\# Cannot update children of multiple message-type oneof fields because
            \\# at least one must be NULL.
            \\SELECT
            \\  REPLACE_FIELDS(
            \\    CAST(
            \\      "non_oneof: 1 recursive_oneof { non_oneof: 1 }"
            \\        as googlesql_test.OneofProtoRecursive
            \\    ),
            \\    2 as recursive_oneof.non_oneof, 1 as kitchen_sink_oneof.int64_key_1, 2 as kitchen_sink_oneof.int64_key_2
            \\  )
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "replace_fields_proto_multi_msg_oneofs_null_input",
            .unsupported_in_bigquery = "REPLACE_FIELDS() is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  REPLACE_FIELDS(
            \\    CAST(NULL as googlesql_test.OneofProtoRecursive),
            \\    2 as recursive_oneof.non_oneof, 1 as kitchen_sink_oneof.int64_key_1, 2 as kitchen_sink_oneof.int64_key_2
            \\  )
            ,
            .rows = .{
                .{null},
            },
        },
        .{
            .desc = "replace_fields_proto_multi_oneof_in_input",
            .unsupported_in_bigquery = "REPLACE_FIELDS() is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\# The input contains multiple instances of recursive_oneof.
            \\# int64_repeated should be updated only once.
            \\SELECT
            \\  REPLACE_FIELDS(
            \\    CAST(
            \\      CONCAT(
            \\        CAST(
            \\          CAST(
            \\            'non_oneof: 1 recursive_oneof { non_oneof: 10 }'
            \\            AS googlesql_test.OneofProtoRecursive)
            \\          AS BYTES),
            \\        CAST(
            \\          CAST(
            \\            'non_oneof: 1 recursive_oneof { int64_repeated: 1 int64_repeated: 2 }'
            \\            AS googlesql_test.OneofProtoRecursive)
            \\          AS BYTES))
            \\      AS googlesql_test.OneofProtoRecursive),
            \\    [3, 4, 5] AS recursive_oneof.int64_repeated)
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "replace_fields_struct_top_level",
            .unsupported_in_bigquery = "REPLACE_FIELDS() is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  REPLACE_FIELDS(
            \\    STRUCT(
            \\      7 as unmodified_field,
            \\      123 as int64_val,
            \\      "def" as string_val,
            \\      false as bool_val,
            \\      [3,2,1] as repeated_int64_val,
            \\      STRUCT(123 as nested_struct_field) as nested_struct
            \\    ),
            \\      11 as int64_val,
            \\      "abc" as string_val,
            \\      true as bool_val,
            \\      [1,2,3] as repeated_int64_val,
            \\      STRUCT(321 as nested_structed_field) as nested_struct
            \\  )
            ,
            .rows = .{
                .{.{ 7, 11, "abc", true, .{ 1, 2, 3 }, .{321} }},
            },
        },
        .{
            .desc = "replace_fields_struct_nested",
            .unsupported_in_bigquery = "REPLACE_FIELDS() is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  REPLACE_FIELDS(
            \\    STRUCT(
            \\      STRUCT(
            \\        7 as unmodified_field,
            \\        123 as int64_val,
            \\        "def" as string_val,
            \\        false as bool_val,
            \\        [3,2,1] as repeated_int64_val
            \\      ) as nested_struct
            \\    ),
            \\      11 as nested_struct.int64_val,
            \\      "abc" as nested_struct.string_val,
            \\      true as nested_struct.bool_val,
            \\      [1,2,3] as nested_struct.repeated_int64_val
            \\  )
            ,
            .rows = .{
                .{.{.{ 7, 11, "abc", true, .{ 1, 2, 3 } }}},
            },
        },
        .{
            .desc = "replace_fields_struct_null",
            .unsupported_in_bigquery = "REPLACE_FIELDS() is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  REPLACE_FIELDS(
            \\    CAST(NULL as STRUCT<int64_val INT64, bool_val BOOL, struct_val STRUCT<int64_val INT64>>),
            \\    1 as int64_val, 2 as struct_val.int64_val
            \\  )
            ,
            .rows = .{
                .{null},
            },
        },
        .{
            .desc = "replace_fields_struct_clear",
            .unsupported_in_bigquery = "REPLACE_FIELDS() is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  REPLACE_FIELDS(
            \\    STRUCT(
            \\      7 as unmodified_field,
            \\      123 as int64_val,
            \\      [3,2,1] as repeated_int64_val,
            \\      STRUCT(123 as nested_int64, "abcdefg" as nested_string) as nested_struct1,
            \\      STRUCT(321 as nested_struct_field) as nested_struct2
            \\    ),
            \\      NULL as int64_val,
            \\      NULL as repeated_int64_val,
            \\      NULL as nested_struct1.nested_int64,
            \\      NULL as nested_struct2
            \\  )
            ,
            .rows = .{
                .{.{ 7, null, null, .{ null, "abcdefg" }, null }},
            },
        },
        .{
            .desc = "replace_fields_struct_proto_top_level",
            .unsupported_in_bigquery = "REPLACE_FIELDS() is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  REPLACE_FIELDS(
            \\    STRUCT(
            \\      CAST(
            \\        "int64_key_1:13, int64_key_2:123, string_val:'sample'"
            \\          as googlesql_test.KitchenSinkPB
            \\      ) as nested_proto
            \\    ),
            \\      11 as nested_proto.int64_val,
            \\      "abc" as nested_proto.string_val,
            \\      true as nested_proto.bool_val,
            \\      [1,2,3] as nested_proto.repeated_int64_val,
            \\      321 as nested_proto.int64_key_2
            \\  )
            ,
            .rows = .{
                .{.{.{"int64_key_1: 13 int64_key_2: 321 int64_val: 11 string_val: \"abc\" bool_val: true repeated_int64_val: 1 repeated_int64_val: 2 repeated_int64_val: 3"}}},
            },
        },
        .{
            .desc = "replace_fields_struct_proto_clear_required",
            .unsupported_in_bigquery = "REPLACE_FIELDS() is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  REPLACE_FIELDS(
            \\    STRUCT(CAST(
            \\      "int64_key_1:13, int64_key_2:123"
            \\        as googlesql_test.KitchenSinkPB
            \\    ) as nested_proto),
            \\    NULL as nested_proto.int64_key_1
            \\  )
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "replace_fields_struct_proto_modify_unset_subfield",
            .unsupported_in_bigquery = "REPLACE_FIELDS() is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  REPLACE_FIELDS(
            \\    STRUCT(CAST(
            \\      "int64_key_1:13, int64_key_2:123"
            \\        as googlesql_test.KitchenSinkPB
            \\    ) as nested_proto),
            \\    313 as nested_proto.nested_value.nested_int64
            \\  )
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "replace_map_field_key_null",
            .unsupported_in_bigquery = "REPLACE_FIELDS() is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  REPLACE_FIELDS(
            \\    CAST("" as googlesql_test.MessageWithMapField),
            \\    [NEW googlesql_test.MessageWithMapField.StringInt32MapEntry(CAST(NULL as STRING) AS key, 123 AS value)] as string_int32_map
            \\  )
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "replace_map_field_value_null",
            .unsupported_in_bigquery = "REPLACE_FIELDS() is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  REPLACE_FIELDS(
            \\    CAST("" as googlesql_test.MessageWithMapField),
            \\    [NEW googlesql_test.MessageWithMapField.StringInt32MapEntry("foo" AS key, CAST(NULL as INT32) AS value)] as string_int32_map
            \\  )
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "replace_map_field_entry_key",
            .unsupported_in_bigquery = "REPLACE_FIELDS() is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  REPLACE_FIELDS(
            \\    CAST("key: 'foo' value: 123" as googlesql_test.MessageWithMapField.StringInt32MapEntry),
            \\    "bar" as key
            \\  )
            ,
            .rows = .{
                .{.{"key: \"bar\" value: 123"}},
            },
        },
        .{
            .desc = "replace_map_field_entry_value",
            .unsupported_in_bigquery = "REPLACE_FIELDS() is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  REPLACE_FIELDS(
            \\    CAST("key: 'foo' value: 123" as googlesql_test.MessageWithMapField.StringInt32MapEntry),
            \\    456 as value
            \\  )
            ,
            .rows = .{
                .{.{"key: \"foo\" value: 456"}},
            },
        },
        .{
            .desc = "replace_map_field_entry_key_null",
            .unsupported_in_bigquery = "REPLACE_FIELDS() is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  REPLACE_FIELDS(
            \\    CAST("key: 'foo' value: 123" as googlesql_test.MessageWithMapField.StringInt32MapEntry),
            \\    NULL as key
            \\  )
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "replace_map_field_entry_value_null",
            .unsupported_in_bigquery = "REPLACE_FIELDS() is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  REPLACE_FIELDS(
            \\    CAST("key: 'foo' value: 123" as googlesql_test.MessageWithMapField.StringInt32MapEntry),
            \\    NULL as value
            \\  )
            ,
            .expect_error_any = true,
        },
    },
}
