            \\SELECT CAST(1 AS INT64) AS a, 1 AS b, 1 AS c
            \\UNION ALL STRICT CORRESPONDING
            \\SELECT 1 AS b, CAST(1 AS FLOAT) AS a, 1 AS c
            \\UNION ALL STRICT CORRESPONDING
            \\SELECT 1 AS c, CAST(1 AS INT32) AS a, 1 AS b
            ,
            .unordered = true,
            .rows = .{
                .{ 1, 1, 1 },
                .{ 1, 1, 1 },
                .{ 1, 1, 1 },
            },
        },
        .{
            .desc = "type_coercion_strict_subquery",
