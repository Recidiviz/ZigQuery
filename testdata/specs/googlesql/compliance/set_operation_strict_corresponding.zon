            .sql =
            \\# Type coercion STRICT mode basic type coercion
            \\SELECT CAST(1 AS INT64) AS a, 1 AS b
            \\UNION ALL STRICT CORRESPONDING
            \\SELECT 1 AS b, CAST(1 AS FLOAT) AS a
            ,
            .unordered = true,
            .rows = .{
                .{ 1, 1 },
                .{ 1, 1 },
            },
