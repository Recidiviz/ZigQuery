            \\WITH
            \\  Table1 AS (
            \\    SELECT CAST(1 AS INT64) AS a, CAST(1 AS INT64) AS b UNION ALL SELECT 1, 1
            \\  )
            \\SELECT a, b FROM Table1
            \\INTERSECT ALL STRICT CORRESPONDING
