.{
    .spec = "googlesql/compliance/set_operation_strict_corresponding",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/googlesql/compliance/testdata/set_operation_strict_corresponding.test",
    .cases = .{
        .{
            .desc = "literal_coercion_strict",
            .unsupported_in_bigquery = "Type not found: INT32 (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\# This file contains the compliance test cases for LEFT CORRESPONDING. Test
            \\# cases are divided into multiple sections.
            \\## ===== Start section: literal and type coercion for STRICT =====  ##
            \\# Literal coercion STRICT mode
            \\SELECT 1 AS b, 1 AS a
            \\UNION ALL STRICT CORRESPONDING
            \\SELECT 1 AS a, CAST(1 AS INT32) AS b
            ,
            .unordered = true,
            .rows = .{
                .{ 1, 1 },
                .{ 1, 1 },
            },
        },
        .{
            .desc = "literal_coercion_strict_coercion_with_subquery",
            .unsupported_in_bigquery = "Type not found: INT32 (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\# Literal coercion STRICT mode literal cocercion with subquery
            \\(
            \\  SELECT 1 AS a, 1 AS b
            \\  UNION ALL STRICT CORRESPONDING
            \\  SELECT 1 AS b, NULL AS a
            \\)
            \\UNION ALL STRICT CORRESPONDING
            \\SELECT 1 AS b, CAST(1 AS INT32) AS a
            ,
            .unordered = true,
            .rows = .{
                .{ null, 1 },
                .{ 1, 1 },
                .{ 1, 1 },
            },
        },
        .{
            .desc = "literal_coercion_strict_three_inputs",
            .unsupported_in_bigquery = "Type not found: FLOAT (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\# Literal coercion STRICT mode with three inputs.
            \\SELECT NULL AS a
            \\UNION ALL STRICT CORRESPONDING
            \\SELECT CAST(1 AS FLOAT) AS a
            \\UNION ALL STRICT CORRESPONDING
            \\SELECT CAST(1 AS INT32) AS a
            ,
            .unordered = true,
            .rows = .{
                .{null},
                .{1},
                .{1},
            },
        },
        .{
            .desc = "type_coercion_strict_basic_type_coercion",
