            \\  ) using(int64_val)
            \\GROUP BY int64_val
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "differential_privacy_min_privacy_units_per_group_is_one",
            .unsupported_in_bigquery = "min_privacy_units_per_group is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\# If MIN_PRIVACY_UNITS_PER_GROUP=1 and delta = 1.0, then all groups should
            \\# appear in the output. I.e. in the same way as if MIN_PRIVACY_UNITS_PER_GROUP=1
            \\# were omitted. Clamping is such that no actual clamping occurrs.
            \\SELECT WITH DIFFERENTIAL_PRIVACY OPTIONS(epsilon=1e20, delta=1.0, min_privacy_units_per_group=1, max_groups_contributed=NULL)
            \\  int64_val, SUM(double_val, contribution_bounds_per_group => (-4.0, 4.0))
            \\FROM TestTableWithUid
            \\GROUP BY int64_val
            ,
            .unordered = true,
            .rows = .{
                .{ 1, 4.5 },
                .{ 3, 2.5 },
                .{ null, 2.5 },
                .{ 2, 3 },
                .{ 4, -1.5 },
            },
        },
        .{
            .desc = "differential_privacy_min_privacy_units_per_group_is_2",
            .unsupported_in_bigquery = "min_privacy_units_per_group is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\# If MIN_PRIVACY_UNITS_PER_GROUP=2 and delta = 1.0, then groups should appear
            \\# in the output if and only if >= 2 users contribute. For the TestTableWithUid,
            \\# there are 3 `int64_val` with not less than 2 contributions:
            \\# `1`, `NULL` and `2`.
            \\SELECT WITH DIFFERENTIAL_PRIVACY OPTIONS(epsilon=1e20, delta=1.0, min_privacy_units_per_group=2, max_groups_contributed=NULL)
            \\  int64_val, COUNT(uid,  contribution_bounds_per_group => (0, 1))
            \\FROM TestTableWithUid
            \\GROUP BY int64_val
            ,
            .unordered = true,
            .rows = .{
                .{ 1, 3 },
                .{ null, 2 },
                .{ 2, 3 },
            },
        },
        .{
            .desc = "differential_privacy_min_privacy_units_per_group_is_3",
            .unsupported_in_bigquery = "min_privacy_units_per_group is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\# If MIN_PRIVACY_UNITS_PER_GROUP=3 and delta = 1.0, then groups should appear
            \\# in the output if and only if >= 3 users contribute. Compared to the test above
            \\# the null-group is discarded, since only 2 users contribute.
            \\SELECT WITH DIFFERENTIAL_PRIVACY OPTIONS(epsilon=1e20, delta=1.0, min_privacy_units_per_group=3, max_groups_contributed=NULL)
            \\  int64_val, COUNT(uid, contribution_bounds_per_group => (0, 1))
            \\FROM TestTableWithUid
            \\GROUP BY int64_val
            ,
            .unordered = true,
            .rows = .{
                .{ 1, 3 },
                .{ 2, 3 },
            },
        },
        .{
            .desc = "differential_privacy_min_privacy_units_per_group_and_explicit_laplace_thresholding",
            .unsupported_in_bigquery = "min_privacy_units_per_group is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\# This test is the same as the one above, however, now we specify the compatible
            \\# group selection strategy (LAPLACE_THRESHOLDING) directly.
            \\SELECT WITH DIFFERENTIAL_PRIVACY OPTIONS(epsilon=1e20, delta = 1.0, min_privacy_units_per_group=3, group_selection_strategy=LAPLACE_THRESHOLD, max_groups_contributed=NULL)
            \\  int64_val, COUNT(uid, contribution_bounds_per_group => (0, 1))
            \\FROM TestTableWithUid
            \\GROUP BY int64_val
            ,
            .unordered = true,
            .rows = .{
                .{ 1, 3 },
                .{ 2, 3 },
            },
        },
        .{
            .desc = "differential_privacy_min_privacy_units_per_group_is_4",
            .unsupported_in_bigquery = "min_privacy_units_per_group is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\# If MIN_PRIVACY_UNITS_PER_GROUP=4 and delta = 1.0, then groups should appear
            \\# in the output if and only if >= 4 users contribute. Since there are no groups
            \\# with more than 3 users in the dataset, the output should be empty.
            \\SELECT WITH DIFFERENTIAL_PRIVACY OPTIONS(epsilon=1e20, delta=1.0, min_privacy_units_per_group=4, max_groups_contributed=NULL)
            \\  int64_val, COUNT(uid, contribution_bounds_per_group => (0, 1))
            \\FROM TestTableWithUid
            \\GROUP BY int64_val
            ,
            .rows = .{},
        },
        .{
            .desc = "differential_privacy_public_groups_and_min_privacy_units_per_group_set",
            .unsupported_in_bigquery = "min_privacy_units_per_group is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\# Engines should report an error if min_privacy_units_per_group is set
            \\# simultaneously with the PUBLIC_GROUPS groups selection strategy.
            \\SELECT WITH DIFFERENTIAL_PRIVACY OPTIONS(epsilon=1e20, delta = 1.0, min_privacy_units_per_group=2, group_selection_strategy = PUBLIC_GROUPS, max_groups_contributed=NULL)
            \\  SUM(double_val, contribution_bounds_per_group => (0.0, 2.0))
            \\FROM TestTableWithUid
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "differential_privacy_min_privacy_units_per_group_works_with_json_report",
            .unsupported_in_bigquery = "min_privacy_units_per_group is not supported (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\# The min_privacy_units_per_group should work well together with reports of
            \\# type JSON.
            \\SELECT WITH DIFFERENTIAL_PRIVACY OPTIONS(epsilon=1e20, delta=1.0, min_privacy_units_per_group=3, max_groups_contributed=NULL)
            \\  int64_val, COUNT(*, contribution_bounds_per_group => (0, 1), report_format => "JSON")
            \\FROM TestTableWithUid
            \\GROUP BY int64_val
            ,
            .unordered = true,
            .rows = .{
                .{ 1, "{\"result\":{\"noise_confidence_interval\":{\"confidence_level\":0.95,\"lower_bound\":-5.99146454710798e-20,\"upper_bound\":5.99146454710798e-20},\"value\":3}}" },
                .{ 2, "{\"result\":{\"noise_confidence_interval\":{\"confidence_level\":0.95,\"lower_bound\":-5.99146454710798e-20,\"upper_bound\":5.99146454710798e-20},\"value\":3}}" },
            },
        },
        .{
            .desc = "differential_privacy_approx_bounds_on_no_data_returns_null",
            .sql =
            \\# Approx bounds with not enough data returns NULL.
            \\SELECT WITH DIFFERENTIAL_PRIVACY OPTIONS(epsilon=1, delta=0, group_selection_strategy=PUBLIC_GROUPS, max_groups_contributed=3)
            \\  int64_val, COUNT(*)
            \\FROM TestTableWithUid
            \\RIGHT OUTER JOIN (
            \\    SELECT DISTINCT int64_val FROM UNNEST([9999]) AS int64_val
            \\  ) using(int64_val)
            \\GROUP BY int64_val
            ,
            .rows = .{
                .{ 9999, null },
            },
        },
        .{
            .desc = "differential_privacy_per_aggregation_epsilon",
            .unsupported_in_bigquery = "Named argument `epsilon` does not exist in signature (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\# Per-aggregation epsilon produces results.
            \\SELECT WITH DIFFERENTIAL_PRIVACY OPTIONS(epsilon=10e20, delta=1.0, group_selection_epsilon = 1e20)
            \\  int64_val,
            \\  COUNT(*, epsilon => 1e20),
            \\  ROUND(SUM(double_val, epsilon => 1e20), 3),
            \\  ROUND(AVG(double_val, epsilon => 1e20), 3),
            \\  ROUND(VAR_POP(double_val, epsilon => 1e20), 3),
            \\FROM TestTableWithUid
            \\GROUP BY int64_val
            ,
            .unordered = true,
            .rows = .{
                .{ 3, 1, 2.5, 2.5, 1 },
                .{ 2, 3, 3, 1.5, 0 },
                .{ 1, 3, 4.5, 1.5, 2.667 },
                .{ null, 2, 2.5, 2.5, 1 },
                .{ 4, 1, -1.5, -1.5, 0.25 },
            },
        },
        .{
            .desc = "differential_privacy_nested_public_groups",
            .sql =
            \\WITH
            \\  SelectedGroups AS (
            \\    SELECT WITH DIFFERENTIAL_PRIVACY OPTIONS (
            \\      epsilon = 1e20,
            \\      delta = 1.0,
            \\      max_groups_contributed = 1)
            \\    int64_val
            \\    FROM TestTableWithUid
            \\    GROUP BY int64_val)
            \\SELECT WITH DIFFERENTIAL_PRIVACY OPTIONS (
            \\  epsilon = 1e20,
            \\  delta = 1.0,
            \\  max_groups_contributed = NULL,
            \\  group_selection_strategy = PUBLIC_GROUPS)
            \\ int64_val, COUNT(*) AS anon_count
            \\FROM TestTableWithUid
            \\  RIGHT OUTER JOIN SelectedGroups
            \\  USING (int64_val)
            \\GROUP BY int64_val
            ,
            .nondeterministic = true,
        },
    },
}
