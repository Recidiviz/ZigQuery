        },
        .{
            .desc = "differential_privacy_basic_sum_double_implicit_bounds_multi_user",
            .sql =
            \\SELECT WITH DIFFERENTIAL_PRIVACY OPTIONS(epsilon=1e20, delta=1.0)
            \\  SUM(double_val)
            \\FROM TestTableWithUid2
            ,
            .rows = .{
                .{11},
            },
        },
        .{
            .desc = "differential_privacy_basic_avg_double_implicit_bounds",
