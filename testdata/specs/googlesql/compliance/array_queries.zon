            .rows = .{
                .{.{ .{"int64_key_1: 11 int64_key_2: 12"}, .{"int64_key_1: 21 int64_key_2: 22"}, .{"int64_key_1: 31 int64_key_2: 32"} }},
                .{.{ .{"int64_key_1: 11 int64_key_2: 12"}, null, .{"int64_key_1: 31 int64_key_2: 32"} }},
                .{.{ null, .{"int64_key_1: 31 int64_key_2: 32"} }},
                .{.{ .{"int64_key_1: 11 int64_key_2: 12"}, null }},
                .{.{ null, null }},
                .{.{null}},
                .{.{.{"int64_key_1: 11 int64_key_2: 12"}}},
                .{.{}},
                .{null},
            },
        },
        .{
            .desc = "select_proto_array_unnest",
            .sql = "SELECT elem FROM AllArraysTable t, t.proto_arrcol elem",
            .unordered = true,
            .rows = .{
                .{null},
                .{.{"int64_key_1: 11 int64_key_2: 12"}},
                .{.{"int64_key_1: 31 int64_key_2: 32"}},
                .{null},
                .{.{"int64_key_1: 11 int64_key_2: 12"}},
                .{null},
                .{.{"int64_key_1: 21 int64_key_2: 22"}},
                .{.{"int64_key_1: 11 int64_key_2: 12"}},
                .{.{"int64_key_1: 31 int64_key_2: 32"}},
                .{.{"int64_key_1: 31 int64_key_2: 32"}},
                .{null},
                .{null},
                .{null},
                .{.{"int64_key_1: 11 int64_key_2: 12"}},
            },
        },
        .{
            .desc = "select_struct_arrays",
            .sql = "SELECT struct_arrcol FROM AllArraysTable",
            .unordered = true,
            .rows = .{
                .{.{ .{ 11, 12 }, .{ 21, 22 }, .{ 31, 32 } }},
                .{.{ .{ 11, 12 }, null, .{ 31, 32 } }},
                .{.{ null, .{ 31, 32 } }},
                .{.{ .{ 11, 12 }, null }},
                .{.{ null, null }},
                .{.{null}},
                .{.{.{ 11, 12 }}},
                .{.{}},
                .{null},
            },
        },
        .{
            .desc = "select_struct_array_unnest",
            .sql = "SELECT elem FROM AllArraysTable t, t.struct_arrcol elem",
            .unordered = true,
            .rows = .{
                .{null},
                .{.{ 11, 12 }},
                .{.{ 31, 32 }},
                .{null},
                .{.{ 11, 12 }},
                .{null},
                .{.{ 21, 22 }},
                .{.{ 11, 12 }},
                .{.{ 31, 32 }},
                .{.{ 31, 32 }},
                .{null},
                .{null},
                .{null},
                .{.{ 11, 12 }},
            },
        },
        .{
            .desc = "select_string_array_unnest_explicit",
            .sql =
            \\##
            \\## Queries that tests explicit unnest. This time we do not require a full
            \\## matrix.
            \\##
            \\SELECT elem FROM AllArraysTable t, UNNEST(t.string_arrcol) AS elem
            ,
            .unordered = true,
            .rows = .{
                .{null},
                .{"σ"},
                .{"⨝"},
                .{null},
                .{"σ"},
                .{null},
                .{"π"},
                .{"σ"},
                .{"⨝"},
                .{"⨝"},
                .{null},
                .{null},
                .{null},
                .{"σ"},
            },
        },
        .{
            .desc = "select_string_array_unnest_with_offset",
            .sql =
            \\##
            \\## From here, several queries to test offset/ordinality without joins.
            \\##
            \\SELECT elem, offset FROM AllArraysTable t, t.string_arrcol elem WITH OFFSET
            ,
            .unordered = true,
            .rows = .{
                .{ null, 1 },
                .{ "σ", 0 },
                .{ "⨝", 2 },
                .{ null, 1 },
                .{ "σ", 0 },
                .{ null, 0 },
                .{ "π", 1 },
                .{ "σ", 0 },
                .{ "⨝", 2 },
                .{ "⨝", 1 },
                .{ null, 0 },
                .{ null, 1 },
                .{ null, 0 },
                .{ "σ", 0 },
            },
        },
        .{
            .desc = "select_string_array_unnest_with_offset_aliased",
            .sql = "SELECT elem, off FROM AllArraysTable t, t.string_arrcol elem WITH OFFSET off",
            .unordered = true,
            .rows = .{
                .{ null, 1 },
                .{ "σ", 0 },
                .{ "⨝", 2 },
                .{ null, 1 },
                .{ "σ", 0 },
                .{ null, 0 },
                .{ "π", 1 },
                .{ "σ", 0 },
                .{ "⨝", 2 },
                .{ "⨝", 1 },
                .{ null, 0 },
                .{ null, 1 },
                .{ null, 0 },
                .{ "σ", 0 },
            },
        },
        .{
            .desc = "select_string_array_unnest_with_offset_sorted",
            .sql =
            \\SELECT elem, offset
            \\FROM AllArraysTable t, t.string_arrcol elem WITH OFFSET
            \\ORDER BY offset
            ,
            .unordered = true,
            .rows = .{
                .{ "σ", 0 },
                .{ null, 0 },
                .{ "σ", 0 },
                .{ "σ", 0 },
                .{ "σ", 0 },
                .{ null, 0 },
                .{ null, 0 },
                .{ null, 1 },
                .{ "⨝", 1 },
                .{ null, 1 },
                .{ null, 1 },
                .{ "π", 1 },
                .{ "⨝", 2 },
                .{ "⨝", 2 },
            },
        },
        .{
            .desc = "select_string_array_unnest_with_offset_aliased_sorted",
            .sql =
            \\SELECT elem, off
            \\FROM AllArraysTable t, t.string_arrcol elem WITH OFFSET off
            \\ORDER BY off
            ,
            .unordered = true,
            .rows = .{
                .{ "σ", 0 },
                .{ null, 0 },
                .{ "σ", 0 },
                .{ "σ", 0 },
                .{ "σ", 0 },
                .{ null, 0 },
                .{ null, 0 },
                .{ null, 1 },
                .{ "⨝", 1 },
                .{ null, 1 },
                .{ null, 1 },
                .{ "π", 1 },
                .{ "⨝", 2 },
                .{ "⨝", 2 },
            },
        },
        .{
            .desc = "select_array_equality_literals",
            .sql =
            \\# TODO: Introduce these queries to test WITH ORDINALITY
            \\# [name=select_string_array_unnest_with_ordinality]
            \\# SELECT arr
            \\# FROM AllArraysTable t, UNNEST(t.string_arrcol) WITH ORDINALITY arr
            \\# --
            \\# false
            \\# ==
            \\# [name=select_string_array_unnest_with_ordinality_aliased]
            \\# SELECT arr.elem, arr.ord, elem, ord
            \\# FROM AllArraysTable t, UNNEST(t.string_arrcol) WITH ORDINALITY arr(elem, ord)
            \\# --
            \\# false
            \\# ==
            \\# [name=select_string_array_unnest_with_ordinality_sorted]
            \\# SELECT arr
            \\# FROM AllArraysTable t, UNNEST(t.string_arrcol) WITH ORDINALITY arr(elem, ord)
            \\# ORDER BY arr.ord
            \\# --
            \\# false
            \\# ==
            \\# [name=select_string_array_correlated_unnest_with_ordinality_aliased]
            \\# SELECT ARRAY(SELECT arr FROM UNNEST(t.string_arrcol) WITH ORDINALITY arr)
            \\# FROM AllArraysTable t
            \\# --
            \\# false
            \\# ==
            \\SELECT [] = [],
            \\       [1,2,3] = [1,2,3],
            \\       [1,2] = [1,2,3],
            \\       [1,NULL] = [1,2,3],
            \\       [1,NULL,3] = [1,2,3],
            \\       [1,NULL,2] = [1,2,3],
            \\       [1,NULL,2] = [1,NULL,2]
            ,
            .rows = .{
                .{ true, true, false, false, null, false, null },
            },
        },
        .{
            .desc = "select_array_equality_empty_array_null",
            .sql = "SELECT [] = cast(NULL AS ARRAY<INT64>)",
            .rows = .{
                .{null},
            },
        },
        .{
            .desc = "select_array_equality_join_on_array_types",
            .sql =
            \\SELECT *
            \\FROM AllArraysTable a JOIN AllArraysTable b
            \\ON a.bool_arrcol = b.bool_arrcol AND
            \\   a.int32_arrcol = b.int32_arrcol AND
            \\   a.uint32_arrcol = b.uint32_arrcol AND
            \\   a.int64_arrcol = b.int64_arrcol AND
            \\   a.uint64_arrcol = b.uint64_arrcol AND
            \\   a.string_arrcol = b.string_arrcol AND
            \\   a.bytes_arrcol = b.bytes_arrcol AND
            \\   a.date_arrcol = b.date_arrcol AND
            \\   a.micros_arrcol = b.micros_arrcol AND
            \\   a.enum_arrcol = b.enum_arrcol AND
            \\   a.struct_arrcol = b.struct_arrcol
            ,
            .unordered = true,
            .rows = .{
                .{ 8, .{}, .{}, .{}, .{}, .{}, .{}, .{}, .{}, .{}, .{}, .{}, .{}, .{}, .{}, 8, .{}, .{}, .{}, .{}, .{}, .{}, .{}, .{}, .{}, .{}, .{}, .{}, .{}, .{} },
                .{ 1, .{ true, false, true }, .{ 1, 0, -1 }, .{ 2, 1, 0 }, .{ 8589934592, 0, -8589934592 }, .{ 8589934592, 1, 0 }, .{ 1.1, 0, -1.1 }, .{ 1.1, 0, -1.1 }, .{ "σ", "π", "⨝" }, .{ "\x61", "\x62", "\x63" }, .{ "1984-08-02", "2000-01-01", "2014-09-11" }, .{ "1984-08-02 01:01:01.001001+00", "2000-01-01 01:01:01.001001+00", "2014-09-11 01:01:01.001001+00" }, .{ "TESTENUM0", "TESTENUM1", "TESTENUM2" }, .{ .{"int64_key_1: 11 int64_key_2: 12"}, .{"int64_key_1: 21 int64_key_2: 22"}, .{"int64_key_1: 31 int64_key_2: 32"} }, .{ .{ 11, 12 }, .{ 21, 22 }, .{ 31, 32 } }, 1, .{ true, false, true }, .{ 1, 0, -1 }, .{ 2, 1, 0 }, .{ 8589934592, 0, -8589934592 }, .{ 8589934592, 1, 0 }, .{ 1.1, 0, -1.1 }, .{ 1.1, 0, -1.1 }, .{ "σ", "π", "⨝" }, .{ "\x61", "\x62", "\x63" }, .{ "1984-08-02", "2000-01-01", "2014-09-11" }, .{ "1984-08-02 01:01:01.001001+00", "2000-01-01 01:01:01.001001+00", "2014-09-11 01:01:01.001001+00" }, .{ "TESTENUM0", "TESTENUM1", "TESTENUM2" }, .{ .{"int64_key_1: 11 int64_key_2: 12"}, .{"int64_key_1: 21 int64_key_2: 22"}, .{"int64_key_1: 31 int64_key_2: 32"} }, .{ .{ 11, 12 }, .{ 21, 22 }, .{ 31, 32 } } },
                .{ 7, .{true}, .{1}, .{2}, .{8589934592}, .{8589934592}, .{1.1}, .{1.1}, .{"σ"}, .{"\x61"}, .{"1984-08-02"}, .{"1984-08-02 01:01:01.001001+00"}, .{"TESTENUM0"}, .{.{"int64_key_1: 11 int64_key_2: 12"}}, .{.{ 11, 12 }}, 7, .{true}, .{1}, .{2}, .{8589934592}, .{8589934592}, .{1.1}, .{1.1}, .{"σ"}, .{"\x61"}, .{"1984-08-02"}, .{"1984-08-02 01:01:01.001001+00"}, .{"TESTENUM0"}, .{.{"int64_key_1: 11 int64_key_2: 12"}}, .{.{ 11, 12 }} },
            },
        },
        .{
            .desc = "select_array_equality_all_array_types",
            .sql =
            \\SELECT bool_arrcol = bool_arrcol,
            \\       int32_arrcol = int32_arrcol,
            \\       uint32_arrcol = uint32_arrcol,
            \\       int64_arrcol = int64_arrcol,
            \\       uint64_arrcol = uint64_arrcol,
            \\       float_arrcol = float_arrcol,
            \\       double_arrcol = double_arrcol,
            \\       string_arrcol = string_arrcol,
            \\       bytes_arrcol = bytes_arrcol,
            \\       date_arrcol = date_arrcol,
            \\       enum_arrcol = enum_arrcol,
            \\       struct_arrcol = struct_arrcol
            \\FROM AllArraysTable
            ,
            .unordered = true,
            .rows = .{
                .{ null, null, null, null, null, null, null, null, null, null, null, null },
                .{ null, null, null, null, null, null, null, null, null, null, null, null },
                .{ null, null, null, null, null, null, null, null, null, null, null, null },
                .{ true, true, true, true, true, true, true, true, true, true, true, true },
                .{ true, true, true, true, true, true, true, true, true, true, true, true },
                .{ null, null, null, null, null, null, null, null, null, null, null, null },
                .{ null, null, null, null, null, null, null, null, null, null, null, null },
                .{ true, true, true, true, true, true, true, true, true, true, true, true },
                .{ null, null, null, null, null, null, null, null, null, null, null, null },
            },
        },
        .{
            .desc = "array_equality_on_incidentally_different_ordered_arrays",
            .sql =
            \\# In this test, the arrays have no guaranteed order, so the result of equality
            \\# is not knowable. This query should be marked as non-deterministic.
            \\SELECT a, b, a = b
            \\FROM (
            \\  SELECT ARRAY(SELECT e FROM UNNEST([1, 2, 3]) as e) as a,
            \\         ARRAY(SELECT e FROM UNNEST([3, 2, 1]) as e) as b,
            \\)
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "array_distinct_from_on_incidentally_different_ordered_arrays",
            .sql =
            \\# In this test, the arrays have no guaranteed order, so the result of equality
            \\# is not knowable. This query should be marked as non-deterministic.
            \\SELECT a, b, a IS NOT DISTINCT FROM b
            \\FROM (
            \\  SELECT ARRAY(SELECT e FROM UNNEST([1, 2, 3]) as e) as a,
            \\         ARRAY(SELECT e FROM UNNEST([3, 2, 1]) as e) as b,
            \\)
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "array_equality_on_incidentally_different_ordered_arrays_of_different_value_sets",
            .sql =
            \\# In this test, the arrays have no guaranteed order, and the arrays have the
            \\# same length, but the sets of values are different. This is
            \\# deterministic, but its more expensive to compute than we probably want in
            \\# the equality operator, so we let this be a false positive for now.
            \\SELECT a, b, a = b
            \\FROM (
            \\  SELECT ARRAY(SELECT e FROM UNNEST([1, 2, 4]) as e) as a,
            \\         ARRAY(SELECT e FROM UNNEST([3, 2, 1]) as e) as b,
            \\)
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "array_equality_on_incidentally_different_ordered_arrays_nested_in_structs",
            .sql =
            \\# In this test, the arrays have no guaranteed order, so the result of equality
            \\# is not knowable. This query should be marked as non-deterministic.
            \\SELECT a, b, a = b
            \\FROM (
            \\  SELECT STRUCT(1, ARRAY(SELECT e FROM UNNEST([1, 2, 3]) as e) AS f) as a,
            \\         STRUCT(2, ARRAY(SELECT e FROM UNNEST([3, 2, 1]) as e) AS f) as b,
            \\)
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "array_equality_on_incidentally_different_ordered_arrays_embeed_in_ordered_arrays",
            .sql =
            \\# In this test, the arrays have no guaranteed order, so the result of equality
            \\# is not knowable. This query should be marked as non-deterministic.
            \\SELECT a, b, a = b
            \\FROM (
            \\  SELECT [NULL, STRUCT(1, ARRAY(SELECT e FROM UNNEST([1, 2, 3]) as e) AS f)] as a,
            \\         [NULL, STRUCT(2, ARRAY(SELECT e FROM UNNEST([3, 2, 1]) as e) AS f)] as b,
            \\)
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "array_inequality_on_incidentally_different_ordered_arrays",
            .sql =
            \\# In this test, the arrays have no guaranteed order, so the result of inequality
            \\# is not knowable. This query should be marked as non-deterministic.
            \\SELECT a, b, a < b
            \\FROM (
            \\  SELECT ARRAY(SELECT e FROM UNNEST([1, 2, 3]) as e) as a,
            \\         ARRAY(SELECT e FROM UNNEST([3, 2, 1]) as e) as b,
            \\)
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "array_inequality_on_incidentally_different_ordered_arrays_of_different_lenths",
            .sql =
            \\# In this test, the arrays have no guaranteed order and which elements are the
            \\# prefix of the array is unknowable. The result of inequality is likewise
            \\# unknowable. This query should be marked as non-deterministic.
            \\SELECT a, b, a < b
            \\FROM (
            \\  SELECT ARRAY(SELECT e FROM UNNEST([1, 2, 3, 1]) as e) as a,
            \\         ARRAY(SELECT e FROM UNNEST([3, 2, 1]) as e) as b,
            \\)
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "array_lessequal_on_incidentally_different_ordered_arrays_of_different_lenths",
            .sql =
            \\# In this test, the arrays have no guaranteed order and which elements are the
            \\# prefix of the array is unknowable. The result of inequality is likewise
            \\# unknowable. This query should be marked as non-deterministic.
            \\SELECT a, b, a <= b
            \\FROM (
            \\  SELECT ARRAY(SELECT e FROM UNNEST([1, 2, 3, 1]) as e) as a,
            \\         ARRAY(SELECT e FROM UNNEST([3, 2, 1]) as e) as b,
            \\)
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "array_inequality_on_incidentally_different_ordered_arrays_of_disjoint_value_ranges",
            .sql =
            \\# In this test, the arrays have no guaranteed internal order. It happens that
            \\# every element in the second array is larger than any element of the first
            \\# array. In this case, it is possible to know that a < b. So ideally, the
            \\# reference implementation does not report this as non-deterministic. This is
            \\# deterministic, but its more expensive to compute than we probably want in
            \\# the equality operator, so we let this be a false positive for now.
            \\SELECT a, b, a < b
            \\FROM (
            \\  SELECT ARRAY(SELECT e FROM UNNEST([1, 2, 3]) as e) as a,
            \\         ARRAY(SELECT e FROM UNNEST([4, 5, 6]) as e) as b,
            \\)
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "array_group_by_on_incidentally_different_ordered_arrays_nested_in_structs",
            .sql =
            \\# In this test, the arrays have no guarenteed internal order, so whether the two
            \\# rows group  is not knowable.
            \\SELECT a
            \\FROM (
            \\  SELECT ARRAY(SELECT e FROM UNNEST([1, 2, 3]) as e) as a
            \\  UNION ALL
            \\  SELECT ARRAY(SELECT e FROM UNNEST([3, 2, 1]) as e) as a
            \\)
            \\GROUP BY a
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "array_group_by_on_incidentally_different_ordered_arrays_embedded_in_ordered_arrays",
            .sql =
            \\# In this test, the arrays have no guarenteed internal order, so whether the two
            \\# rows group  is not knowable.
            \\SELECT a
            \\FROM (
            \\  SELECT STRUCT(1, ARRAY(SELECT e FROM UNNEST([1, 2, 3]) as e) AS f) as a
            \\  UNION ALL
            \\  SELECT STRUCT(2, ARRAY(SELECT e FROM UNNEST([3, 2, 1]) as e) AS f) as a
            \\)
            \\GROUP BY a
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "array_group_by_on_incidentally_different_ordered_arrays",
            .sql =
            \\# In this test, the arrays have no guarenteed internal order, so whether the two
            \\# rows group  is not knowable.
            \\SELECT a
            \\FROM (
            \\  SELECT [NULL, STRUCT(1, ARRAY(SELECT e FROM UNNEST([1, 2, 3]) as e) AS f)] as a
            \\  UNION ALL
            \\  SELECT [NULL, STRUCT(2, ARRAY(SELECT e FROM UNNEST([3, 2, 1]) as e) AS f)] as a
            \\)
            \\GROUP BY a
            ,
            .nondeterministic = true,
        },
    },
}
