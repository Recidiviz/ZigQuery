.{
    .spec = "googlesql/compliance/set_operation_full_mode",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/googlesql/compliance/testdata/set_operation_full_mode.test",
    .cases = .{
        .{
            .desc = "corresponding_literal_coercion_full",
            .unsupported_in_bigquery = "Type not found: INT32 (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\# This file contains the compliance test cases for FULL CORRESPONDING. Test
            \\# cases are divided into multiple sections.
            \\## ===== Start section: literal and type coercion for FULL =====  ##
            \\# CORRESPONDING literal coercion FULL mode
            \\SELECT 1 AS a, 1 AS b
            \\FULL UNION ALL CORRESPONDING
            \\SELECT CAST(1 AS INT32) AS a
            ,
            .unordered = true,
            .rows = .{
                .{ 1, 1 },
                .{ 1, null },
            },
        },
        .{
            .desc = "corresponding_literal_coercion_full_in_padded_null_scan",
            .sql =
            \\# CORRESPONDING literal coercion FULL mode literal coerced to the correct type, with padded NULL in the same scan containing the literal.
            \\SELECT NULL AS a
            \\FULL UNION ALL CORRESPONDING
            \\SELECT 's' AS a, 1 AS b
            ,
            .unordered = true,
            .rows = .{
                .{ null, null },
                .{ "s", 1 },
            },
        },
        .{
            .desc = "corresponding_literal_coercion_full_coercion_with_subquery",
            .unsupported_in_bigquery = "Type not found: INT32 (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\# CORRESPONDING literal coercion FULL mode literal cocercion with subquery
            \\(SELECT 1 AS a, 1 AS b FULL UNION ALL CORRESPONDING SELECT 1 AS b, NULL AS a)
            \\FULL UNION ALL CORRESPONDING
            \\SELECT 1 AS b, CAST(1 AS INT32) AS a
            ,
            .unordered = true,
            .rows = .{
                .{ null, 1 },
                .{ 1, 1 },
                .{ 1, 1 },
            },
        },
        .{
            .desc = "corresponding_literal_coercion_full_coercion_with_padded_null",
            .unsupported_in_bigquery = "Type not found: INT32 (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\# CORRESPONDING literal coercion FULL mode coercion with padded null
            \\SELECT NULL AS a
            \\FULL UNION ALL CORRESPONDING
            \\SELECT 1 AS b
            \\FULL UNION ALL CORRESPONDING
            \\SELECT 1 AS b, CAST(1 AS INT32) AS a
            ,
            .unordered = true,
            .rows = .{
                .{ null, null },
                .{ null, 1 },
                .{ 1, 1 },
            },
        },
