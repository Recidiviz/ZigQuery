            \\# Verifies that binary collation allows '_' in a subquery.
            \\SELECT
            \\  collate('Google', 'binary') LIKE ALL (SELECT p FROM UNNEST(['Goo_le', 'G%']) p)
            ,
            .rows = .{
                .{true},
            },
        },
    },
}
