            \\    CAST(CAST(DATETIME "2006-01-02 01:2:03" as DATE) as DATETIME),
            \\    CAST(CAST(DATETIME "2006-01-02 1:02:03" as DATE) as DATETIME),
            \\    CAST(CAST(DATETIME "2006-01-2 01:02:03" as DATE) as DATETIME),
