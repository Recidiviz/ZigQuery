    .cases = .{
        .{
            .desc = "civil_time_literals",
            .sql =
            \\# The "civil_time_types_and_functions" label applies to all queries in this
            \\# file related to the GoogleSQL V1.2 civil time types: TIME and DATETIME.
            \\SELECT TIME '01:02:03.123456',
            \\       DATETIME '2006-01-02 03:04:05.123456'
            ,
            .rows = .{
                .{ "01:02:03.123456", "2006-01-02 03:04:05.123456" },
            },
        },
        .{
            .desc = "civil_time_nano_literals",
            .sql =
            \\SELECT TIME '01:02:03.123456789',
            \\       DATETIME '2006-01-02 03:04:05.123456789'
            ,
            .rows = .{
                .{ "01:02:03.123456789", "2006-01-02 03:04:05.123456789" },
            },
        },
        .{
            .desc = "roundtrip_cast_between_string_and_time_common",
            .sql =
            \\SELECT
