            \\FROM (
            \\  SELECT
            \\    TIMESTAMP '2017-02-28 12:34:56' AS t,
            \\    DATETIME '2017-02-28 12:34:56' AS dt,
            \\    DATE '2017-02-28' AS d UNION ALL
            \\  SELECT
