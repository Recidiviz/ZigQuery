// Imported from GoogleSQL's own compliance-testdata suite
// (third_party/googlesql/googlesql/compliance/testdata, Apache-2.0).
.{
    .spec = "googlesql/compliance/qualify",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/googlesql/compliance/testdata/qualify.test",
    .cases = .{
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TABLE t1 AS
            \\  SELECT * FROM UNNEST([
            \\    STRUCT(1 AS i, 'A' AS p, 1 AS o),
            \\    STRUCT(2 AS i, 'A' AS p, 2 AS o),
            \\    STRUCT(3 AS i, 'A' AS p, 3 AS o),
            \\    STRUCT(4 AS i, 'B' AS p, 1 AS o),
            \\    STRUCT(5 AS i, 'B' AS p, 2 AS o),
            \\    STRUCT(6 AS i, 'B' AS p, 3 AS o)
            \\    ])
            ,
        },
        .{
            .desc = "qualify",
            .sql =
            \\SELECT i, p, o FROM t1
            \\  WHERE true
            \\  QUALIFY ROW_NUMBER() OVER (PARTITION BY p ORDER BY o) = 1
            ,
            .unordered = true,
            .rows = .{
                .{ 4, "B", 1 },
                .{ 1, "A", 1 },
            },
        },
        .{
            .desc = "qualify_analytic_function_in_select_list",
            .sql =
            \\SELECT i, p, o, ROW_NUMBER() OVER (PARTITION BY p ORDER BY o) as row_num FROM t1
            \\  WHERE true
            \\  QUALIFY row_num = 1
            ,
            .unordered = true,
            .rows = .{
                .{ 4, "B", 1, 1 },
                .{ 1, "A", 1, 1 },
            },
        },
        .{
            .desc = "qualify_with_analytic_and_column_filter",
            .sql =
            \\SELECT i, p, o, ROW_NUMBER() OVER (PARTITION BY p ORDER BY o) as row_num FROM t1
            \\  WHERE true
            \\  QUALIFY p NOT LIKE 'B' and row_num = 1
            ,
            .rows = .{
                .{ 1, "A", 1, 1 },
            },
        },
        .{
            .desc = "qualify_analytic_function_expression_in_select_list",
            .sql =
            \\# Regression test for b/189237442
            \\SELECT i, p, o, (ROW_NUMBER() OVER (PARTITION BY p ORDER BY o) + 100) as row_num FROM t1
            \\  WHERE true
            \\  QUALIFY p NOT LIKE 'B' and row_num = 101
            ,
            .rows = .{
                .{ 1, "A", 1, 101 },
            },
        },
        .{
            .desc = "qualify_aggregate_with_analytic_filter",
            .sql =
            \\SELECT SUM(i) as sum_i, ROW_NUMBER() OVER (ORDER BY o) as row_num FROM t1
            \\GROUP BY o
            \\QUALIFY row_num = 2
            ,
            .rows = .{
                .{ 7, 2 },
            },
        },
        .{
            .desc = "qualify_aggregate_with_aggregate_filter",
            .sql =
            \\SELECT SUM(i) as sum_i, ROW_NUMBER() OVER (ORDER BY o) as row_num FROM t1
            \\GROUP BY o
            \\QUALIFY sum_i < 6
            ,
            .rows = .{
                .{ 5, 1 },
            },
        },
        .{
            .desc = "qualify_sum_over_unbounded_preceding",
            .sql =
            \\SELECT o
            \\FROM t1
            \\GROUP BY o
            \\QUALIFY SUM(SUM(i)) OVER (ORDER BY o ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) > 5
            ,
            .unordered = true,
            .rows = .{
                .{2},
                .{3},
            },
        },
        .{
            .desc = "qualify_group_by_and_alias",
            .sql =
            \\SELECT o, SUM(i), ROW_NUMBER() OVER (ORDER BY o) as x
            \\FROM t1
            \\GROUP BY o
            \\QUALIFY x > 1
            ,
            .unordered = true,
            .rows = .{
                .{ 2, 7, 2 },
                .{ 3, 9, 3 },
            },
        },
        .{
            .desc = "qualify_group_by",
            .sql =
            \\SELECT o
            \\FROM t1
            \\GROUP BY o
            \\QUALIFY RANK() OVER (ORDER BY SUM(i)) > 1
            ,
            .unordered = true,
            .rows = .{
                .{2},
                .{3},
            },
        },
        .{
            .desc = "qualify_aggregation_and_analytic_in_both_select_and_qualify",
            .sql =
            \\SELECT o, MIN(i), ROW_NUMBER() OVER (ORDER BY o)
            \\FROM t1
            \\GROUP BY o
            \\QUALIFY MAX(i) > 4 AND SUM(SUM(i)) OVER (ORDER BY o ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) > 12
            ,
            .rows = .{
                .{ 3, 3, 3 },
            },
        },
        .{
            .desc = "qualify_reference_pre_grouped_column",
            .sql =
            \\SELECT o, ROW_NUMBER() OVER (ORDER BY o)
            \\FROM t1
            \\GROUP BY o
            \\QUALIFY COUNT(o) > 1
            \\ORDER BY o
            ,
            .rows = .{
                .{ 1, 1 },
                .{ 2, 2 },
                .{ 3, 3 },
            },
        },
        .{
            .desc = "qualify_reference_post_grouped_column",
            .sql =
            \\SELECT o, ROW_NUMBER() OVER (ORDER BY o)
            \\FROM t1
            \\GROUP BY o
            \\QUALIFY o > 1
            \\ORDER BY o
            ,
            .rows = .{
                .{ 2, 2 },
                .{ 3, 3 },
            },
        },
    },
}
