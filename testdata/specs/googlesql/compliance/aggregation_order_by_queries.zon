// Imported from GoogleSQL's own compliance-testdata suite
// (third_party/googlesql/googlesql/compliance/testdata, Apache-2.0).
.{
    .spec = "googlesql/compliance/aggregation_order_by_queries",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/googlesql/compliance/testdata/aggregation_order_by_queries.test",
    .cases = .{
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TABLE TestTable AS
            \\SELECT cast(1 as int64) as row_id,
            \\       cast(null as bool) as bool_val,
            \\       cast(null as int64) as int64_val,
            \\       cast(null as uint64) as uint64_val,
            \\       cast(null as double) as double_val,
            \\       cast(null as string) as string_val UNION ALL
            \\  SELECT 2,  false, 2,    3,    1.5,    "abc"  UNION ALL
            \\  SELECT 3,  null,  1,    6,    1.5,    "def"  UNION ALL
            \\  SELECT 4,  true,  null, 2,    2.5,    "ghi"  UNION ALL
            \\  SELECT 5,  false, 1,    null, 3.5,    "abc"  UNION ALL
            \\  SELECT 6,  true,  2,    2,    null,   "xyz"  UNION ALL
            \\  SELECT 7,  true,  1,    5,    -0.5,   "zyx"  UNION ALL
            \\  SELECT 8,  true,  4,    2,    -1.5,   "ijk"  UNION ALL
            \\  SELECT 9,  null,  2,    3,    2,      "nvm"  UNION ALL
            \\  SELECT 10, true,  3,    1,    2.5,    "goo"
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TABLE TestTableSameValues AS
            \\SELECT cast(1 as int64) as row_id,
            \\       1 as key,
            \\       10 as int64_val,
            \\       "abc" as string_val UNION ALL
            \\  SELECT 2,   1,  10,  "abc"  UNION ALL
            \\  SELECT 3,   1,  10,  "abc"  UNION ALL
            \\  SELECT 4,   1,  10,  "abc"  UNION ALL
            \\  SELECT 5,   1,  10,  "abc"  UNION ALL
            \\  SELECT 6,   2,  10,  "abc"  UNION ALL
            \\  SELECT 7,   2,  10,  "abc"  UNION ALL
            \\  SELECT 8,   2,  10,  "abc"  UNION ALL
            \\  SELECT 9,   2,  10,  "abc"  UNION ALL
            \\  SELECT 10,  2,  10,  "abc"
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TABLE TestTableNumericValues AS
            \\SELECT cast(1 as int64) as row_id,
            \\       "abc" as string_val,
            \\       [1, 2, 3] as array_val,
            \\       cast(1 as numeric) as numeric_val UNION ALL
            \\  SELECT 2,  "def", [4, 5, 6], cast(NULL as numeric) UNION ALL
            \\  SELECT 3,  "ghi", [7, 8, 9], cast(1.123456789 as numeric)   UNION ALL
            \\  SELECT 4,  "abc", [10, 11, 12],  cast(10 as numeric)   UNION ALL
            \\  SELECT 5,  "jkl", [NULL], cast(-0.000000001 as numeric)   UNION ALL
            \\  SELECT 6,  NULL, [16, 17, 18], cast(0 as numeric)   UNION ALL
            \\  SELECT 7,  "jkl", NULL, cast(99999999999999999999999999999.999999999 as numeric)   UNION ALL
            \\  SELECT 8,  "foo", [22, 23, 24], cast(-99999999999999999999999999999.999999999 as numeric)   UNION ALL
            \\  SELECT 9,  "bar", [25, 26, 27], cast(1.000000001 as numeric)   UNION ALL
            \\  SELECT 10, "baz", [28, 29, 30], cast(100 as numeric)
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TABLE TestTableBigNumericValues AS
            \\SELECT cast(1 as int64) as row_id,
            \\       "abc" as string_val,
            \\       [1, 2, 3] as array_val,
            \\       cast(1 as bignumeric) as bignumeric_val UNION ALL
            \\  SELECT 2,  "def", [4, 5, 6], cast(NULL as bignumeric) UNION ALL
            \\  SELECT 3,  "ghi", [7, 8, 9], cast(1.12345678901234567890123456789012345678 as bignumeric)   UNION ALL
            \\  SELECT 4,  "abc", [10, 11, 12],  cast(10 as bignumeric)   UNION ALL
            \\  SELECT 5,  "jkl", [NULL],  cast(-0.00000000000000000000000000000000000001 as bignumeric)   UNION ALL
            \\  SELECT 6,  NULL, [16, 17, 18], cast(0 as bignumeric)   UNION ALL
            \\  SELECT 7,  "jkl", NULL, cast(578960446186580977117854925043439539266.34992332820282019728792003956564819967 as bignumeric)   UNION ALL
            \\  SELECT 8,  "foo", [22, 23, 24], cast(-578960446186580977117854925043439539266.34992332820282019728792003956564819968 as bignumeric)   UNION ALL
            \\  SELECT 9,  "bar", [25, 26, 27], cast(1.00000000000000000000000000000000000001 as bignumeric)   UNION ALL
            \\  SELECT 10, "baz", [28, 29, 30], cast(100 as bignumeric)
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TABLE TestTableRangeValues AS
            \\SELECT cast(1 as int64) as row_id,
            \\       "abc" as string_val,
            \\       [1, 2, 3] as array_val,
            \\       range<date> "[UNBOUNDED, UNBOUNDED)" as range_date_val,
            \\       range<timestamp> "[UNBOUNDED, UNBOUNDED)" as range_timestamp_val union all
            \\SELECT 2,  "def", [4, 5, 6], range<date> "[2020-01-01, 2020-01-02)", range<timestamp> "[2020-01-01 12:00:00+02, 2020-12-31 14:00:00+04)" union all
            \\SELECT 3,  "ghi", [7, 8, 9], range<date> "[2020-01-01, 2020-01-02)", range<timestamp> "[2020-01-01 12:00:00+02, 2020-12-31 14:00:00+04)" union all
            \\SELECT 4,  "abc", [10, 11, 12], range<date> "[2020-01-01, 2020-01-02)", range<timestamp> "[2020-01-01 12:00:00+02, 2020-12-31 14:00:00+04)" union all
            \\SELECT 5,  "jkl", [NULL], range<date> "[UNBOUNDED, 2020-01-02)", range<timestamp> "[UNBOUNDED, 2020-12-31 14:00:00+04)" union all
            \\SELECT 6,  NULL, [16, 17, 18], range<date> "[2020-01-01, UNBOUNDED)", range<timestamp> "[2020-01-01 12:00:00+02, UNBOUNDED)" union all
            \\SELECT 7,  "jkl", NULL, range<date> "[2020-01-01, UNBOUNDED)", range<timestamp> "[2020-01-01 12:00:00+02, UNBOUNDED)" union all
            \\SELECT 8,  "foo", [22, 23, 24], cast(null as range<date>), cast(null as range<timestamp>) union all
            \\select 9,  "bar", [25, 26, 27], cast(null as range<date>), cast(null as range<timestamp>) union all
            \\SELECT 10,  "def", [1, 2, 3], range<date> "[2020-02-01, 2020-03-02)", range<timestamp> "[2020-02-01 12:00:00+02, 2020-12-31 14:00:00+04)" union all
            \\SELECT 11,  "def", [4, 5, 6], range<date> "[2020-02-01, 2020-03-02)", range<timestamp> "[2020-02-01 12:00:00+02, 2020-12-31 14:00:00+04)"
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TABLE TestTableRangeDatetimeValues AS
            \\SELECT cast(1 as int64) as row_id,
            \\       "abc" as string_val,
            \\       [1, 2, 3] as array_val,
            \\       range<datetime> "[UNBOUNDED, UNBOUNDED)" as range_datetime_val union all
            \\SELECT 2,  "def", [4, 5, 6], range<datetime> "[2020-01-01, 2020-01-02)" union all
            \\SELECT 3,  "ghi", [7, 8, 9], range<datetime> "[2020-01-01, 2020-01-02)" union all
            \\SELECT 4,  "abc", [10, 11, 12], range<datetime> "[2020-01-01, 2020-01-02)" union all
            \\SELECT 5,  "jkl", [NULL], range<datetime> "[UNBOUNDED, 2020-01-02)" union all
            \\SELECT 6,  NULL, [16, 17, 18], range<datetime> "[2020-01-01, UNBOUNDED)" union all
            \\SELECT 7,  "jkl", NULL, range<datetime> "[2020-01-01, UNBOUNDED)" union all
            \\SELECT 8,  "foo", [22, 23, 24], cast(null as range<datetime>) union all
            \\select 9,  "bar", [25, 26, 27], cast(null as range<datetime>) union all
            \\SELECT 10,  "def", [4, 5, 6], range<datetime> "[2020-02-01, 2020-03-02)" union all
            \\SELECT 11,  "def", [4, 5, 6], range<datetime> "[2020-02-01, 2020-03-02)"
            ,
        },
        .{
            .desc = "aggregation_order_by_array_agg",
            .sql =
            \\SELECT ARRAY_AGG(x ORDER BY x)
            \\FROM ((SELECT "abc" x) UNION ALL (SELECT "def") UNION ALL (SELECT "xyz"))
            ,
            .rows = .{
                .{.{ "abc", "def", "xyz" }},
            },
        },
        .{
            .desc = "aggregation_order_by_array_agg_desc",
            .sql =
            \\SELECT ARRAY_AGG(x ORDER BY x DESC)
            \\FROM ((SELECT "abc" x) UNION ALL (SELECT "def") UNION ALL (SELECT "xyz"))
            ,
            .rows = .{
                .{.{ "xyz", "def", "abc" }},
            },
        },
        .{
            .desc = "aggregation_order_by_string_agg",
            .sql =
            \\SELECT STRING_AGG(x ORDER BY x)
            \\FROM ((SELECT "abc" x) UNION ALL (SELECT "def") UNION ALL (SELECT "xyz"))
            ,
            .rows = .{
                .{"abc,def,xyz"},
            },
        },
        .{
            .desc = "aggregation_order_by_string_agg_delimiter",
            .sql =
            \\SELECT STRING_AGG(x, "|" ORDER BY x)
            \\FROM ((SELECT "xyz" x) UNION ALL (SELECT "def") UNION ALL(SELECT "abc"))
            ,
            .rows = .{
                .{"abc|def|xyz"},
            },
        },
        .{
            .desc = "aggregation_order_by_array_asc",
            .sql =
            \\SELECT ARRAY_AGG(int64_val ORDER BY array_val asc)
            \\FROM (SELECT 1 AS int64_val, [0] AS array_val
            \\      UNION ALL
            \\      SELECT 2 AS int64_val, [1] AS array_val)
            ,
            .rows = .{
                .{.{ 1, 2 }},
            },
        },
        .{
            .desc = "aggregation_order_by_array_desc",
            .sql =
            \\SELECT ARRAY_AGG(int64_val ORDER BY array_val desc)
            \\FROM (SELECT 1 AS int64_val, [0] AS array_val
            \\      UNION ALL
            \\      SELECT 2 AS int64_val, [1] AS array_val)
            ,
            .rows = .{
                .{.{ 2, 1 }},
            },
        },
        .{
            .desc = "aggregation_order_by_distinct",
            .sql =
            \\SELECT int64_val,
            \\       ARRAY_AGG(DISTINCT uint64_val ORDER BY uint64_val)
            \\FROM TestTable
            \\GROUP BY int64_val
            ,
            .unordered = true,
            .rows = .{
                .{ null, .{ null, 2 } },
                .{ 1, .{ null, 5, 6 } },
                .{ 2, .{ 2, 3 } },
                .{ 3, .{1} },
                .{ 4, .{2} },
            },
        },
        .{
            .desc = "aggregate_order_by_correlated_column_2",
            .sql =
            \\SELECT b, (SELECT ARRAY_AGG(CAST(r AS string) ORDER BY outer_table.b, r)
            \\           FROM outer_table.a.repeated_uint32_val r)
            \\FROM (SELECT NEW googlesql_test.KitchenSinkPB(
            \\                     1 AS int64_key_1,
            \\                     2 AS int64_key_2,
            \\                     ARRAY<uint32>[8, 7, 9]
            \\                         as repeated_uint32_val) AS a, "abc" b UNION ALL
            \\      SELECT NEW googlesql_test.KitchenSinkPB(
            \\                     1 AS int64_key_1,
            \\                     2 AS int64_key_2) AS a, "def" b) AS outer_table
            ,
            .unordered = true,
            .rows = .{
                .{ "def", null },
                .{ "abc", .{ "7", "8", "9" } },
            },
        },
        .{
            .desc = "aggregation_order_by_limit_test_table",
            .sql =
            \\SELECT int64_val,
            \\       ARRAY_AGG(bool_val ORDER BY bool_val LIMIT 0),
            \\       ARRAY_AGG(uint64_val ORDER BY uint64_val LIMIT 2),
            \\       ARRAY_AGG(double_val ORDER BY double_val LIMIT 4),
            \\       STRING_AGG(string_val ORDER BY string_val LIMIT 0),
            \\       STRING_AGG(string_val ORDER BY string_val LIMIT 2),
            \\       STRING_AGG(string_val ORDER BY string_val LIMIT 100)
            \\FROM TestTable
            \\GROUP BY int64_val
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "aggregation_order_by_limit_order_by_different_columns",
            .sql =
            \\SELECT int64_val,
            \\       ARRAY_AGG(bool_val ORDER BY uint64_val LIMIT 1),
            \\       ARRAY_AGG(uint64_val ORDER BY double_val LIMIT 3),
            \\       ARRAY_AGG(double_val ORDER BY string_val LIMIT 2),
            \\       STRING_AGG(string_val ORDER BY bool_val LIMIT 3),
            \\       STRING_AGG(string_val ORDER BY uint64_val LIMIT 1),
            \\       STRING_AGG(string_val ORDER BY double_val LIMIT 3)
            \\FROM TestTable
            \\GROUP BY int64_val
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "aggregation_order_by_limit_without_group_by",
            .sql =
            \\# LIMIT in aggregates will be applied after filtering out NULLs if the
            \\# aggregate function ignores NULL. As shown in the result below,
            \\# ARRAY_AGG keeps NULLs in the output but STRING_AGG does not.
            \\SELECT ARRAY_AGG(int64_val ORDER BY int64_val LIMIT 0),
            \\       ARRAY_AGG(int64_val ORDER BY int64_val LIMIT 2),
            \\       ARRAY_AGG(int64_val ORDER BY int64_val LIMIT 4),
            \\       ARRAY_AGG(string_val ORDER BY string_val LIMIT 0),
            \\       ARRAY_AGG(string_val ORDER BY string_val LIMIT 1),
            \\       ARRAY_AGG(string_val ORDER BY string_val LIMIT 2),
            \\       ARRAY_AGG(string_val ORDER BY string_val LIMIT 100),
            \\       STRING_AGG(string_val ORDER BY string_val LIMIT 0),
            \\       STRING_AGG(string_val ORDER BY string_val LIMIT 1),
            \\       STRING_AGG(string_val ORDER BY string_val LIMIT 2),
            \\       STRING_AGG(string_val ORDER BY string_val LIMIT 100)
            \\FROM TestTable
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "aggregation_order_by_limit_desc",
            .sql =
            \\SELECT ARRAY_AGG(int64_val ORDER BY int64_val DESC LIMIT 0),
            \\       ARRAY_AGG(int64_val ORDER BY int64_val DESC LIMIT 2),
            \\       ARRAY_AGG(int64_val ORDER BY int64_val DESC LIMIT 4),
            \\       STRING_AGG(string_val ORDER BY string_val DESC LIMIT 0),
            \\       STRING_AGG(string_val ORDER BY string_val DESC LIMIT 2),
            \\       STRING_AGG(string_val ORDER BY string_val DESC LIMIT 100)
            \\FROM TestTable
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "aggregation_order_by_limit_computed_order_by_exprs",
            .sql =
            \\SELECT int64_val,
            \\       ARRAY_AGG(uint64_val ORDER BY uint64_val + 10 LIMIT 2),
            \\       ARRAY_AGG(double_val ORDER BY double_val * -2.0 LIMIT 5)
            \\FROM TestTable
            \\GROUP BY int64_val
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "aggregation_order_by_distinct_limit",
            .sql =
            \\SELECT int64_val,
            \\       ARRAY_AGG(DISTINCT uint64_val ORDER BY uint64_val LIMIT 2)
            \\FROM TestTable
            \\GROUP BY int64_val
            ,
            .unordered = true,
            .rows = .{
                .{ null, .{ null, 2 } },
                .{ 1, .{ null, 5 } },
                .{ 2, .{ 2, 3 } },
                .{ 3, .{1} },
                .{ 4, .{2} },
            },
        },
        .{
            .desc = "aggregation_order_by_distinct_limit_2",
            .sql =
            \\SELECT ARRAY_AGG(DISTINCT int64_val ORDER BY int64_val),
            \\       ARRAY_AGG(DISTINCT int64_val ORDER BY int64_val LIMIT 2)
            \\FROM TestTable
            ,
            .rows = .{
                .{ .{ null, 1, 2, 3, 4 }, .{ null, 1 } },
            },
        },
        .{
            .desc = "aggregation_order_by_limit_same_values",
            .sql =
            \\SELECT key,
            \\       ARRAY_AGG(int64_val LIMIT 0),
            \\       ARRAY_AGG(int64_val ORDER BY int64_val LIMIT 0),
            \\       ARRAY_AGG(int64_val LIMIT 2),
            \\       ARRAY_AGG(int64_val ORDER BY int64_val LIMIT 2),
            \\       ARRAY_AGG(int64_val LIMIT 100),
            \\       ARRAY_AGG(int64_val ORDER BY int64_val LIMIT 100),
            \\       STRING_AGG(string_val LIMIT 0),
            \\       STRING_AGG(string_val ORDER BY string_val LIMIT 0),
            \\       STRING_AGG(string_val LIMIT 2),
            \\       STRING_AGG(string_val ORDER BY string_val LIMIT 2),
            \\       STRING_AGG(string_val LIMIT 100),
            \\       STRING_AGG(string_val ORDER BY string_val LIMIT 100)
            \\FROM TestTableSameValues
            \\GROUP BY key
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "aggregation_order_by_limit_only_same_values",
            .sql =
            \\SELECT key,
            \\       ARRAY_AGG(int64_val LIMIT 0),
            \\       ARRAY_AGG(int64_val LIMIT 2),
            \\       ARRAY_AGG(int64_val LIMIT 100),
            \\       STRING_AGG(string_val LIMIT 0),
            \\       STRING_AGG(string_val LIMIT 2),
            \\       STRING_AGG(string_val LIMIT 100)
            \\FROM TestTableSameValues
            \\GROUP BY key
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "aggregation_order_by_range_date",
            .sql =
            \\SELECT ARRAY_AGG(range_date_val ORDER BY range_date_val ASC),
            \\       ARRAY_CONCAT_AGG(array_val ORDER BY range_date_val ASC),
            \\       ARRAY_AGG(range_date_val ORDER BY range_date_val DESC),
            \\       ARRAY_CONCAT_AGG(array_val ORDER BY range_date_val DESC),
            \\       ARRAY_AGG(range_date_val ORDER BY range_date_val LIMIT 0),
            \\       ARRAY_CONCAT_AGG(array_val ORDER BY range_date_val LIMIT 0),
            \\       ARRAY_AGG(range_date_val ORDER BY range_date_val LIMIT 3),
            \\       ARRAY_CONCAT_AGG(array_val ORDER BY range_date_val LIMIT 3),
            \\       ARRAY_AGG(DISTINCT range_date_val ORDER BY range_date_val ASC),
            \\       ARRAY_AGG(DISTINCT range_date_val ORDER BY range_date_val ASC LIMIT 3),
            \\       ARRAY_AGG(DISTINCT range_date_val ORDER BY range_date_val DESC),
            \\       ARRAY_AGG(DISTINCT range_date_val ORDER BY range_date_val DESC LIMIT 3),
            \\       ARRAY_AGG(row_id ORDER BY range_date_val),
            \\       ARRAY_AGG(range_date_val ORDER BY row_id)
            \\FROM TestTableRangeValues
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "aggregation_order_by_range_datetime",
            .sql =
            \\SELECT ARRAY_AGG(range_datetime_val ORDER BY range_datetime_val ASC),
            \\       ARRAY_CONCAT_AGG(array_val ORDER BY range_datetime_val ASC),
            \\       ARRAY_AGG(range_datetime_val ORDER BY range_datetime_val DESC),
            \\       ARRAY_CONCAT_AGG(array_val ORDER BY range_datetime_val DESC),
            \\       ARRAY_AGG(range_datetime_val ORDER BY range_datetime_val LIMIT 0),
            \\       ARRAY_CONCAT_AGG(array_val ORDER BY range_datetime_val LIMIT 0),
            \\       ARRAY_AGG(range_datetime_val ORDER BY range_datetime_val LIMIT 3),
            \\       ARRAY_CONCAT_AGG(array_val ORDER BY range_datetime_val LIMIT 3),
            \\       ARRAY_AGG(DISTINCT range_datetime_val ORDER BY range_datetime_val ASC),
            \\       ARRAY_AGG(DISTINCT range_datetime_val ORDER BY range_datetime_val ASC LIMIT 3),
            \\       ARRAY_AGG(DISTINCT range_datetime_val ORDER BY range_datetime_val DESC),
            \\       ARRAY_AGG(DISTINCT range_datetime_val ORDER BY range_datetime_val DESC LIMIT 3),
            \\       ARRAY_AGG(row_id ORDER BY range_datetime_val),
            \\       ARRAY_AGG(range_datetime_val ORDER BY row_id)
            \\FROM TestTableRangeDatetimeValues
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "aggregation_order_by_range_timestamp",
            .sql =
            \\SELECT ARRAY_AGG(range_timestamp_val ORDER BY range_timestamp_val ASC),
            \\       ARRAY_CONCAT_AGG(array_val ORDER BY range_timestamp_val ASC),
            \\       ARRAY_AGG(range_timestamp_val ORDER BY range_timestamp_val DESC),
            \\       ARRAY_CONCAT_AGG(array_val ORDER BY range_timestamp_val DESC),
            \\       ARRAY_AGG(range_timestamp_val ORDER BY range_timestamp_val LIMIT 0),
            \\       ARRAY_CONCAT_AGG(array_val ORDER BY range_timestamp_val LIMIT 0),
            \\       ARRAY_AGG(range_timestamp_val ORDER BY range_timestamp_val LIMIT 3),
            \\       ARRAY_CONCAT_AGG(array_val ORDER BY range_timestamp_val LIMIT 3),
            \\       ARRAY_AGG(DISTINCT range_timestamp_val ORDER BY range_timestamp_val ASC),
            \\       ARRAY_AGG(DISTINCT range_timestamp_val ORDER BY range_timestamp_val ASC LIMIT 3),
            \\       ARRAY_AGG(DISTINCT range_timestamp_val ORDER BY range_timestamp_val DESC),
            \\       ARRAY_AGG(DISTINCT range_timestamp_val ORDER BY range_timestamp_val DESC LIMIT 3),
            \\       ARRAY_AGG(row_id ORDER BY range_timestamp_val),
            \\       ARRAY_AGG(range_timestamp_val ORDER BY row_id)
            \\FROM TestTableRangeValues
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "b435003883",
            .sql =
            \\WITH t as (SELECT 1 as x)
            \\SELECT
            \\  ARRAY_AGG(DISTINCT x+1 ORDER BY x+1) AS r,
            \\  ARRAY_AGG(DISTINCT x+1 ORDER BY x+1) AS r2
            \\FROM t
            ,
            .rows = .{
                .{ .{2}, .{2} },
            },
        },
    },
}
