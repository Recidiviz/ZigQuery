            },
        },
        .{
            .desc = "regular_group_by_grouping_function_with_pre_and_post_group_by_column_reference_in_order_by",
            .sql =
            \\SELECT a AS a1, GROUPING(a)
            \\FROM simple_table
            \\GROUP BY 1
            \\HAVING GROUPING(a) = 0
            \\ORDER BY GROUPING(a1)
            ,
            .unordered = true,
            .rows = .{
                .{ null, 0 },
                .{ 10, 0 },
                .{ 123, 0 },
            },
        },
    },
}
