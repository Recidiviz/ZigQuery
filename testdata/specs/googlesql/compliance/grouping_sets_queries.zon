                .{ 10, "bar", true, 1 },
                .{ 11, null, null, 1 },
                .{ 11, null, false, 1 },
                .{ 11, "bar", null, 1 },
                .{ 11, "bar", false, 1 },
            },
        },
        .{
            .desc = "rollup_with_analytic_functions",
            .sql =
            \\SELECT a, b,
            \\  COUNT(*) OVER (
            \\    PARTITION BY a
            \\    ORDER BY a
            \\    ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS count,
            \\  SUM(a) OVER (
            \\    PARTITION BY b
            \\    ORDER BY a
            \\    ROWS BETWEEN CURRENT ROW AND CURRENT ROW) AS sum,
            \\  MAX(b) OVER (
            \\    PARTITION BY b
            \\    ORDER BY a
            \\    RANGE BETWEEN 1 PRECEDING AND 1 FOLLOWING) AS max
            \\FROM simple_table
            \\GROUP BY ROLLUP(a, b, a)
            \\ORDER BY 1, 2, 3, 4, 5
            ,
            .rows = .{
                .{ null, null, 4, null, null },
                .{ null, null, 4, null, null },
                .{ null, null, 4, null, null },
                .{ null, null, 4, null, null },
                .{ 10, null, 5, 10, null },
                .{ 10, "bar", 5, 10, "bar" },
                .{ 10, "bar", 5, 10, "bar" },
                .{ 10, "foo", 5, 10, "foo" },
