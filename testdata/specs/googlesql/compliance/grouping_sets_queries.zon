// Imported from GoogleSQL's own compliance-testdata suite
// (third_party/googlesql/googlesql/compliance/testdata, Apache-2.0).
.{
    .spec = "googlesql/compliance/grouping_sets_queries",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/googlesql/compliance/testdata/grouping_sets_queries.test",
    .cases = .{
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TABLE simple_table AS
            \\SELECT 1 AS key, 10 AS a, 'foo' AS b, true AS c, 12.0 AS d
            \\UNION ALL SELECT 2, 123, 'foo', false, CAST("NAN" as FLOAT64)
            \\UNION ALL SELECT 3, 123, 'bar', true, 123.456e-67
            \\UNION ALL SELECT 4, CAST(NULL AS int64), CAST(NULL AS STRING), CAST(NULL AS BOOL), CAST(NULL AS FLOAT64)
            \\UNION ALL SELECT 5, 10, 'bar', CAST(NULL AS BOOL), CAST(NULL AS FLOAT64)
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TABLE simple_collation_table AS
            \\SELECT 'a' AS col_ci, 'a' AS col_binary, 'a' AS col_no_collation, 1 AS col
            \\UNION ALL SELECT 'b', 'b', 'b', 2
            \\UNION ALL SELECT 'B', 'B', 'B', 3
            \\UNION ALL SELECT 'ana', 'ana', 'ana', 4
            \\UNION ALL SELECT 'banana', 'banana', 'banana', 5
            ,
        },
        .{
            .desc = "grouping_sets_single_column_grouping_set",
            .sql =
            \\SELECT a, b, COUNT(*)
            \\FROM simple_table
            \\GROUP BY GROUPING SETS(a, b)
            \\ORDER BY a, b
            ,
            .rows = .{
                .{ null, null, 1 },
                .{ null, null, 1 },
                .{ null, "bar", 2 },
                .{ null, "foo", 2 },
                .{ 10, null, 2 },
                .{ 123, null, 2 },
            },
        },
        .{
            .desc = "grouping_sets_single_column_grouping_set_count_distinct",
            .sql =
            \\SELECT a, b, COUNT(DISTINCT c)
            \\FROM simple_table
            \\GROUP BY GROUPING SETS(a, b)
            \\ORDER BY a, b
            ,
            .rows = .{
                .{ null, null, 0 },
                .{ null, null, 0 },
                .{ null, "bar", 1 },
                .{ null, "foo", 2 },
                .{ 10, null, 1 },
                .{ 123, null, 2 },
            },
        },
        .{
            .desc = "grouping_sets_multi_column_grouping_set",
            .sql =
            \\SELECT a, b, c, d, COUNT(*)
            \\FROM simple_table
            \\GROUP BY GROUPING SETS((a, b), (c, d))
            \\ORDER BY a, b, c, d, COUNT(*)
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "grouping_sets_empty_grouping_set",
            .sql =
            \\SELECT a, b, COUNT(*)
            \\FROM simple_table
            \\GROUP BY GROUPING SETS((a, b), (), ())
            \\ORDER BY a, b, COUNT(*)
            ,
            .rows = .{
                .{ null, null, 1 },
                .{ null, null, 5 },
                .{ null, null, 5 },
                .{ 10, "bar", 1 },
                .{ 10, "foo", 1 },
                .{ 123, "bar", 1 },
                .{ 123, "foo", 1 },
            },
        },
        .{
            .desc = "empty_grouping_sets_select_aggregate_function",
            .sql =
            \\SELECT COUNT(*)
            \\FROM simple_table
            \\GROUP BY GROUPING SETS(())
            ,
            .rows = .{
                .{5},
            },
        },
        .{
            .desc = "empty_grouping_sets_select_literal",
            .sql =
            \\SELECT 1, "a", 1.23
            \\FROM simple_table
            \\GROUP BY GROUPING SETS(())
            ,
            .rows = .{
                .{ 1, "a", 1.23 },
            },
        },
        .{
            .desc = "grouping_sets_expression_columns",
            .sql =
            \\SELECT a+1, UPPER(b), a-1, LOWER(b), COUNT(*), MAX(a), MAX(b)
            \\FROM simple_table
            \\GROUP BY GROUPING SETS((a+1, UPPER(b)), a-1, LOWER(b), ())
            \\ORDER BY MAX(a), MAX(b), COUNT(*)
            ,
            .unordered = true,
            .rows = .{
                .{ null, null, null, null, 1, null, null },
                .{ null, null, null, null, 1, null, null },
                .{ null, null, null, null, 1, null, null },
                .{ 11, "BAR", null, null, 1, 10, "bar" },
                .{ 11, "FOO", null, null, 1, 10, "foo" },
                .{ null, null, 9, null, 2, 10, "foo" },
                .{ 124, "BAR", null, null, 1, 123, "bar" },
                .{ null, null, null, "bar", 2, 123, "bar" },
                .{ 124, "FOO", null, null, 1, 123, "foo" },
                .{ null, null, null, "foo", 2, 123, "foo" },
                .{ null, null, 122, null, 2, 123, "foo" },
                .{ null, null, null, null, 5, 123, "foo" },
            },
        },
        .{
            .desc = "grouping_sets_select_expression_match_to_column_reference",
            .sql =
            \\SELECT a, a+1, COUNT(*)
            \\FROM simple_table
            \\GROUP BY GROUPING SETS(a, a+1)
            \\ORDER BY a, a+1, COUNT(*)
            ,
            .rows = .{
                .{ null, null, 1 },
                .{ null, null, 1 },
                .{ null, null, 2 },
                .{ null, null, 2 },
                .{ 10, 11, 2 },
                .{ 123, 124, 2 },
            },
        },
        .{
            .desc = "grouping_sets_duplicate_keys_in_grouping_set",
            .sql =
            \\SELECT a, b, a+1, UPPER(b), COUNT(*)
            \\FROM simple_table
            \\GROUP BY GROUPING SETS((a, a, b), (a, b, b), (a+1, a+1, a+1), (UPPER(b), UPPER(b)))
            \\ORDER BY a, b, a+1, UPPER(b), COUNT(*)
            ,
            .rows = .{
                .{ null, null, null, null, 1 },
                .{ null, null, null, null, 1 },
                .{ null, null, null, null, 1 },
                .{ null, null, null, null, 1 },
                .{ null, null, null, null, 2 },
                .{ null, null, null, null, 2 },
                .{ null, null, null, null, 2 },
                .{ null, null, null, null, 2 },
                .{ 10, "bar", 11, "BAR", 1 },
                .{ 10, "bar", 11, "BAR", 1 },
                .{ 10, "foo", 11, "FOO", 1 },
                .{ 10, "foo", 11, "FOO", 1 },
                .{ 123, "bar", 124, "BAR", 1 },
                .{ 123, "bar", 124, "BAR", 1 },
                .{ 123, "foo", 124, "FOO", 1 },
                .{ 123, "foo", 124, "FOO", 1 },
            },
        },
        .{
            .desc = "grouping_sets_duplicate_columns_alias_ordinal_index_in_grouping_set",
            .sql =
            \\SELECT a, b, a+1, UPPER(b) AS ub, COUNT(*)
            \\FROM simple_table
            \\GROUP BY GROUPING SETS((a, a, b), (1, b, b), (3, 3, 3), (ub, ub))
            \\ORDER BY 1, 2, 3, 4, 5
            ,
            .rows = .{
                .{ null, null, null, null, 1 },
                .{ null, null, null, null, 1 },
                .{ null, null, null, null, 1 },
                .{ null, null, null, null, 1 },
                .{ null, null, null, "BAR", 2 },
                .{ null, null, null, "FOO", 2 },
                .{ null, null, 11, null, 2 },
                .{ null, null, 124, null, 2 },
                .{ 10, "bar", null, null, 1 },
                .{ 10, "bar", null, null, 1 },
                .{ 10, "foo", null, null, 1 },
                .{ 10, "foo", null, null, 1 },
                .{ 123, "bar", null, null, 1 },
                .{ 123, "bar", null, null, 1 },
                .{ 123, "foo", null, null, 1 },
                .{ 123, "foo", null, null, 1 },
            },
        },
        .{
            .desc = "grouping_sets_duplicate_grouping_sets",
            .sql =
            \\SELECT a, b, COUNT(*)
            \\FROM simple_table
            \\GROUP BY GROUPING SETS((a, b), (a, b), a, a)
            \\ORDER BY a, b, COUNT(*)
            ,
            .rows = .{
                .{ null, null, 1 },
                .{ null, null, 1 },
                .{ null, null, 1 },
                .{ null, null, 1 },
                .{ 10, null, 2 },
                .{ 10, null, 2 },
                .{ 10, "bar", 1 },
                .{ 10, "bar", 1 },
                .{ 10, "foo", 1 },
                .{ 10, "foo", 1 },
                .{ 123, null, 2 },
                .{ 123, null, 2 },
                .{ 123, "bar", 1 },
                .{ 123, "bar", 1 },
                .{ 123, "foo", 1 },
                .{ 123, "foo", 1 },
            },
        },
        .{
            .desc = "grouping_sets_duplicate_grouping_sets_count_distinct",
            .sql =
            \\SELECT a, b, COUNT(distinct c)
            \\FROM simple_table
            \\GROUP BY GROUPING SETS((a, b), (a, b), a, a)
            \\ORDER BY a, b, COUNT(distinct c)
            ,
            .rows = .{
                .{ null, null, 0 },
                .{ null, null, 0 },
                .{ null, null, 0 },
                .{ null, null, 0 },
                .{ 10, null, 1 },
                .{ 10, null, 1 },
                .{ 10, "bar", 0 },
                .{ 10, "bar", 0 },
                .{ 10, "foo", 1 },
                .{ 10, "foo", 1 },
                .{ 123, null, 2 },
                .{ 123, null, 2 },
                .{ 123, "bar", 1 },
                .{ 123, "bar", 1 },
                .{ 123, "foo", 1 },
                .{ 123, "foo", 1 },
            },
        },
        .{
            .desc = "grouping_sets_with_alias",
            .sql =
            \\SELECT a+d AS x, b AS y, c AS z, COUNT(*)
            \\FROM simple_table
            \\GROUP BY GROUPING SETS(x, (y, z), z)
            \\ORDER BY 1, 2, 3, COUNT(*)
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "grouping_sets_with_ordinal_columns",
            .sql =
            \\SELECT a, b, COUNT(*)
            \\FROM simple_table
            \\GROUP BY GROUPING SETS(1, 2, (1, 2))
            \\ORDER BY 1, 2, COUNT(*)
            ,
            .rows = .{
                .{ null, null, 1 },
                .{ null, null, 1 },
                .{ null, null, 1 },
                .{ null, "bar", 2 },
                .{ null, "foo", 2 },
                .{ 10, null, 2 },
                .{ 10, "bar", 1 },
                .{ 10, "foo", 1 },
                .{ 123, null, 2 },
                .{ 123, "bar", 1 },
                .{ 123, "foo", 1 },
            },
        },
        .{
            .desc = "grouping_sets_with_mix_of_column_alias_ordinal_index",
            .sql =
            \\SELECT a+d AS x, UPPER(b), c, COUNT(*)
            \\FROM simple_table
            \\GROUP BY GROUPING SETS(x, (2, c), 3)
            \\ORDER BY 1, 2, 3, COUNT(*)
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "grouping_sets_with_duplicate_simple_expressions",
            .sql =
            \\SELECT a+1, COUNT(*)
            \\FROM simple_table
            \\GROUP BY GROUPING SETS(a+1, a+1, a+1)
            \\ORDER BY ANY_VALUE(a), COUNT(*)
            ,
            .rows = .{
                .{ null, 1 },
                .{ null, 1 },
                .{ null, 1 },
                .{ 11, 2 },
                .{ 11, 2 },
                .{ 11, 2 },
                .{ 124, 2 },
                .{ 124, 2 },
                .{ 124, 2 },
            },
        },
        .{
            .desc = "grouping_sets_with_duplicate_subquery_expressions",
            .sql =
            \\SELECT COUNT(*)
            \\FROM simple_table
            \\GROUP BY GROUPING SETS((SELECT a+1), (SELECT a+1))
            ,
            .unordered = true,
            .rows = .{
                .{1},
                .{1},
                .{2},
                .{2},
                .{2},
                .{2},
            },
        },
        .{
            .desc = "grouping_sets_with_collation_columns",
            .sql =
            \\SELECT
            \\  UPPER(col_ci) AS col1, col_binary AS col_2, col AS col_3,
            \\  COUNT(*) AS count
            \\FROM simple_collation_table
            \\GROUP BY GROUPING SETS(col1, (col_binary, col))
            \\ORDER BY col1, col_2, col_3, count
            ,
            .rows = .{
                .{ null, "B", 3, 1 },
                .{ null, "a", 1, 1 },
                .{ null, "ana", 4, 1 },
                .{ null, "b", 2, 1 },
                .{ null, "banana", 5, 1 },
                .{ "A", null, null, 1 },
                .{ "ANA", null, null, 1 },
                .{ "B", null, null, 2 },
                .{ "BANANA", null, null, 1 },
            },
        },
        .{
            .desc = "grouping_sets_with_aggregate_functions",
            .sql =
            \\SELECT a, b, ANY_VALUE(a), ARRAY_AGG(c),
            \\FROM simple_table
            \\WHERE c IS NOT NULL
            \\GROUP BY GROUPING SETS((a, b), a, ())
            \\HAVING b IS NOT NULL
            \\ORDER BY a, b
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "grouping_sets_with_analytic_functions",
            .sql =
            \\SELECT a, b,
            \\  COUNT(*) OVER (
            \\    PARTITION BY a
            \\    ORDER BY a
            \\    ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS count,
            \\  SUM(a) OVER (
            \\    PARTITION BY b
            \\    ORDER BY a
            \\    ROWS BETWEEN CURRENT ROW AND CURRENT ROW) AS sum,
            \\  MAX(b) OVER (
            \\    PARTITION BY b
            \\    ORDER BY a
            \\    RANGE BETWEEN 1 PRECEDING AND 1 FOLLOWING) AS max
            \\FROM simple_table
            \\GROUP BY GROUPING SETS((a, b), a, ())
            \\ORDER BY 1, 2, 3, 4, 5
            ,
            .rows = .{
                .{ null, null, 3, null, null },
                .{ null, null, 3, null, null },
                .{ null, null, 3, null, null },
                .{ 10, null, 3, 10, null },
                .{ 10, "bar", 3, 10, "bar" },
                .{ 10, "foo", 3, 10, "foo" },
                .{ 123, null, 3, 123, null },
                .{ 123, "bar", 3, 123, "bar" },
                .{ 123, "foo", 3, 123, "foo" },
            },
        },
        .{
            .desc = "grouping_sets_with_subquery_constant",
            .sql =
            \\SELECT SUM(key)
            \\FROM simple_table
            \\GROUP BY GROUPING SETS(
            \\  (SELECT 'abc'),
            \\  (SELECT 1))
            ,
            .unordered = true,
            .rows = .{
                .{15},
                .{15},
            },
        },
        .{
            .desc = "grouping_sets_with_subquery_from_the_table",
            .sql =
            \\SELECT SUM(key)
            \\FROM simple_table
            \\GROUP BY GROUPING SETS(
            \\  (SELECT COUNT(*) FROM simple_table),
            \\  ((SELECT SUM(key) FROM simple_table), (SELECT MAX(key) FROM simple_table))
            \\)
            ,
            .unordered = true,
            .rows = .{
                .{15},
                .{15},
            },
        },
        .{
            .desc = "grouping_sets_with_correlated_subquery",
            .sql =
            \\SELECT SUM(key)
            \\FROM simple_table
            \\GROUP BY GROUPING SETS(
            \\  (SELECT a+1),
            \\  (SELECT b)
            \\)
            \\ORDER BY SUM(key)
            ,
            .rows = .{
                .{3},
                .{4},
                .{4},
                .{5},
                .{6},
                .{8},
            },
        },
        .{
            .desc = "grouping_sets_with_keyword_column_name",
            .sql =
            \\WITH T AS (
            \\  SELECT 10 AS `GROUPING SETS`, "bar" AS `ROLLUP`, true AS `CUBE` UNION ALL
            \\  SELECT 11 AS `GROUPING SETS`, "bar" AS `ROLLUP`, false AS `CUBE`
            \\)
            \\SELECT `GROUPING SETS`, `ROLLUP`, `CUBE`,  COUNT(*)
            \\FROM T
            \\GROUP BY GROUPING SETS(`GROUPING SETS`, `ROLLUP`, `CUBE`)
            \\ORDER BY `GROUPING SETS`, `ROLLUP`, `CUBE`, COUNT(*)
            ,
            .rows = .{
                .{ null, null, false, 1 },
                .{ null, null, true, 1 },
                .{ null, "bar", null, 2 },
                .{ 10, null, null, 1 },
                .{ 11, null, null, 1 },
            },
        },
        .{
            .desc = "grouping_sets_with_rollup_cube",
            .sql =
            \\SELECT a+1, b, c, d, COUNT(*) AS cnt
            \\FROM simple_table
            \\GROUP BY GROUPING SETS(a+1, ROLLUP(b, c), CUBE(d), ())
            \\ORDER BY 1, b, c, d, cnt
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "grouping_sets_with_rollup_cube_on_multi_columns",
            .sql =
            \\SELECT a+1, b, c, d, COUNT(*) AS cnt
            \\FROM simple_table
            \\GROUP BY GROUPING SETS(a+1, ROLLUP(b, (c, d)), CUBE(a+1, (c, b)), ())
            \\ORDER BY 1, b, c, d, cnt
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "grouping_sets_with_rollup_cube_mix_column_alias_ordinal_index",
            .sql =
            \\SELECT a+1, b AS x, c AS y, d, COUNT(*) AS cnt
            \\FROM simple_table
            \\GROUP BY GROUPING SETS(1, ROLLUP(x, (y, d)), CUBE(1, (3, 2)), ())
            \\ORDER BY 1, x, y, d, cnt
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "grouping_sets_with_constant_select_list",
            .sql =
            \\SELECT "a", true, 1.23
            \\FROM simple_table
            \\GROUP BY GROUPING SETS(a, b)
            ,
            .unordered = true,
            .rows = .{
                .{ "a", true, 1.23 },
                .{ "a", true, 1.23 },
                .{ "a", true, 1.23 },
                .{ "a", true, 1.23 },
                .{ "a", true, 1.23 },
                .{ "a", true, 1.23 },
            },
        },
        .{
            .desc = "grouping_sets_with_all_post_aggregate_clauses",
            .sql =
            \\SELECT a, b, c, COUNT(*) OVER() AS cnt
            \\FROM simple_table
            \\GROUP BY GROUPING SETS(a, b, c)
            \\HAVING a IS NULL
            \\QUALIFY c
            \\ORDER BY a, b, c, cnt
            ,
            .rows = .{
                .{ null, null, true, 7 },
            },
        },
        .{
            .desc = "grouping_sets_with_having_clauses",
            .sql =
            \\SELECT a, b, c, COUNT(*)
            \\FROM simple_table
            \\GROUP BY GROUPING SETS(a, b, c)
            \\HAVING GROUPING(a) = 0
            \\ORDER BY 1, 2, 3, 4
            ,
            .rows = .{
                .{ null, null, null, 1 },
                .{ 10, null, null, 2 },
                .{ 123, null, null, 2 },
            },
        },
        .{
            .desc = "grouping_sets_with_qualify_clauses",
            .sql =
            \\SELECT a, b, c, COUNT(*) OVER()
            \\FROM simple_table
            \\GROUP BY GROUPING SETS(a, b, c)
            \\QUALIFY GROUPING(a) = 0
            \\ORDER BY 1, 2, 3, 4
            ,
            .rows = .{
                .{ null, null, null, 9 },
                .{ 10, null, null, 9 },
                .{ 123, null, null, 9 },
            },
        },
        .{
            .desc = "grouping_sets_with_pivot",
            .sql =
            \\SELECT a+1, foo, bar, COUNT(*) AS cnt
            \\FROM simple_table PIVOT(SUM(d) FOR b IN ('foo', 'bar'))
            \\GROUP BY GROUPING SETS(a+1, foo, bar)
            \\ORDER BY 1, foo, bar, cnt
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "grouping_sets_with_unpivot",
            .sql =
            \\SELECT a+1, e, f, COUNT(*) AS cnt
            \\FROM simple_table UNPIVOT(e FOR f in (b))
            \\GROUP BY GROUPING SETS(a+1, e, f)
            \\ORDER BY 1, e, f, cnt
            ,
            .rows = .{
                .{ null, null, "b", 4 },
                .{ null, "bar", null, 2 },
                .{ null, "foo", null, 2 },
                .{ 11, null, null, 2 },
                .{ 124, null, null, 2 },
            },
        },
        .{
            .desc = "grouping_sets_and_with_recursive",
            .sql =
            \\WITH RECURSIVE
            \\  CTE_1 AS (
            \\    (
            \\      SELECT iteration as it, iteration+1 AS it1
            \\      FROM UNNEST([1, 2, 3, 4]) AS iteration
            \\      GROUP BY GROUPING SETS(iteration, iteration+1)
            \\    )
            \\    UNION ALL (
            \\    SELECT it+1 AS it, it1+1 AS it1 FROM CTE_1 WHERE it < 3)
            \\  )
            \\SELECT it, it1 FROM CTE_1
            \\ORDER BY 1, 2 ASC
            ,
            .rows = .{
                .{ null, null },
                .{ null, null },
                .{ null, null },
                .{ null, null },
                .{ 1, 2 },
                .{ 2, 3 },
                .{ 2, 3 },
                .{ 3, 4 },
                .{ 3, 4 },
                .{ 3, 4 },
                .{ 4, 5 },
            },
        },
        .{
            .desc = "rollup_with_single_columns",
            .sql =
            \\SELECT a, b, SUM(key)
            \\FROM simple_table
            \\GROUP BY ROLLUP(a, b)
            \\ORDER BY a, b, SUM(key)
            ,
            .rows = .{
                .{ null, null, 4 },
                .{ null, null, 4 },
                .{ null, null, 15 },
                .{ 10, null, 6 },
                .{ 10, "bar", 5 },
                .{ 10, "foo", 1 },
                .{ 123, null, 5 },
                .{ 123, "bar", 3 },
                .{ 123, "foo", 2 },
            },
        },
        .{
            .desc = "rollup_with_expression_columns",
            .sql =
            \\SELECT a+1, UPPER(b), SUM(key)
            \\FROM simple_table
            \\GROUP BY ROLLUP(a+1, UPPER(b))
            \\ORDER BY 1, 2, SUM(key)
            ,
            .rows = .{
                .{ null, null, 4 },
                .{ null, null, 4 },
                .{ null, null, 15 },
                .{ 11, null, 6 },
                .{ 11, "BAR", 5 },
                .{ 11, "FOO", 1 },
                .{ 124, null, 5 },
                .{ 124, "BAR", 3 },
                .{ 124, "FOO", 2 },
            },
        },
        .{
            .desc = "rollup_with_duplicate_columns",
            .sql =
            \\SELECT a+1, b, SUM(key)
            \\FROM simple_table
            \\GROUP BY ROLLUP(a+1, a+1, a+1, b, b)
            \\ORDER BY 1, 2, 3
            ,
            .rows = .{
                .{ null, null, 4 },
                .{ null, null, 4 },
                .{ null, null, 4 },
                .{ null, null, 4 },
                .{ null, null, 4 },
                .{ null, null, 15 },
                .{ 11, null, 6 },
                .{ 11, null, 6 },
                .{ 11, null, 6 },
                .{ 11, "bar", 5 },
                .{ 11, "bar", 5 },
                .{ 11, "foo", 1 },
                .{ 11, "foo", 1 },
                .{ 124, null, 5 },
                .{ 124, null, 5 },
                .{ 124, null, 5 },
                .{ 124, "bar", 3 },
                .{ 124, "bar", 3 },
                .{ 124, "foo", 2 },
                .{ 124, "foo", 2 },
            },
        },
        .{
            .desc = "rollup_with_duplicate_mix_of_column_alias_ordinal_index",
            .sql =
            \\SELECT a+1 AS a1, b, SUM(key)
            \\FROM simple_table
            \\GROUP BY ROLLUP(a1, 1, 1, b, 2, 2)
            \\ORDER BY 1, 2, 3
            ,
            .rows = .{
                .{ null, null, 4 },
                .{ null, null, 4 },
                .{ null, null, 4 },
                .{ null, null, 4 },
