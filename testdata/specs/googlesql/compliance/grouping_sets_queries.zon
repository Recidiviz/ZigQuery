                .{ 123, null, 5, 123, null },
                .{ 123, "bar", 5, 123, "bar" },
                .{ 123, "bar", 5, 123, "bar" },
                .{ 123, "foo", 5, 123, "foo" },
                .{ 123, "foo", 5, 123, "foo" },
            },
