            .desc = "cube_with_analytic_functions",
            .sql =
            \\SELECT a, b,
            \\  COUNT(*) OVER (
            \\    PARTITION BY a
            \\    ORDER BY a
            \\    ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS count,
            \\  SUM(a) OVER (
            \\    PARTITION BY b
            \\    ORDER BY a
            \\    ROWS BETWEEN CURRENT ROW AND CURRENT ROW) AS sum,
            \\  MAX(b) OVER (
            \\    PARTITION BY b
            \\    ORDER BY a
            \\    RANGE BETWEEN 1 PRECEDING AND 1 FOLLOWING) AS max
            \\FROM simple_table
            \\GROUP BY CUBE(a, b)
            \\ORDER BY 1, 2, 3, 4, 5
