        .{
            .desc = "rollup_with_qualify_clauses",
            .sql =
            \\SELECT a, UPPER(b), c, COUNT(*) OVER() AS cnt
            \\FROM simple_table
            \\GROUP BY ROLLUP(a, UPPER(b), c)
            \\QUALIFY GROUPING(a) = 0
            \\ORDER BY 1, 2, 3, 4
            ,
            .rows = .{
                .{ null, null, null, 14 },
