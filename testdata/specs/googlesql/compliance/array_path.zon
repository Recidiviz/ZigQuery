    .cases = .{
        .{
            .desc = "array_path_top_level_struct_array",
            .sql =
            \\SELECT v
            \\FROM UNNEST([STRUCT(1 AS x), STRUCT(2), STRUCT(3)].x) AS v
            \\ORDER BY v
            ,
            .rows = .{
                .{1},
                .{2},
                .{3},
            },
        },
        .{
            .desc = "array_path_top_level_proto_array",
            .sql =
            \\SELECT v
            \\FROM UNNEST([CAST('int64_val: 1' AS googlesql_test.RecursivePB),
            \\             CAST('int64_val: 2' AS googlesql_test.RecursivePB)].int64_val) AS v
            \\ORDER BY v
            ,
            .rows = .{
                .{1},
                .{2},
            },
        },
        .{
            .desc = "array_path_through_struct_array",
            .sql =
            \\SELECT v
            \\FROM UNNEST(STRUCT([STRUCT(1 AS y), STRUCT(2), STRUCT(3)] AS x).x.y) AS v
            \\ORDER BY v
            ,
            .rows = .{
                .{1},
                .{2},
                .{3},
            },
        },
        .{
