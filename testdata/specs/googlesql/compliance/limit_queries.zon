// Imported from GoogleSQL's own compliance-testdata suite
// (third_party/googlesql/googlesql/compliance/testdata, Apache-2.0).
.{
    .spec = "googlesql/compliance/limit_queries",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/googlesql/compliance/testdata/limit_queries.test",
    .cases = .{
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TABLE Table1 AS
            \\SELECT cast(1 as int64) as primary_key, 1 AS key, ['one'] AS values  UNION ALL
            \\SELECT 2, 2, ['c', 'a']                UNION ALL
            \\SELECT 3, 3, ['y', 'z', 'x']           UNION ALL
            \\SELECT 4, 4, ['w', 'w', 'w', 'w']      UNION ALL
            \\SELECT 5, 0, ARRAY<STRING> []          UNION ALL
            \\SELECT 6, NULL, [CAST(NULL AS STRING)]
            ,
        },
        .{
            .desc = "limit_0",
            .sql =
            \\# -----
            \\# LIMIT
            \\# -----
            \\SELECT a FROM (SELECT 1 a UNION ALL SELECT 2 UNION ALL SELECT 3) LIMIT 0
            ,
            .rows = .{},
        },
        .{
            .desc = "limit_1",
            .sql =
            \\SELECT COUNT(a) FROM (
            \\SELECT a FROM (SELECT 1.2 a UNION ALL SELECT 2.3 UNION ALL SELECT 3.4) LIMIT 1)
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "limit_2",
            .sql =
            \\SELECT COUNT(a) FROM (
            \\SELECT a FROM (SELECT 1.2 a UNION ALL SELECT 2.3 UNION ALL SELECT 3.4) LIMIT 2)
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "limit_1_same_values",
            .sql = "SELECT a FROM (SELECT 'x' a UNION ALL SELECT 'x' UNION ALL SELECT 'x') LIMIT 1",
            .nondeterministic = true,
        },
        .{
            .desc = "limit_10_one_element",
            .sql = "SELECT a FROM (SELECT \"Hello, world!\" a) LIMIT 10",
            .rows = .{
                .{"Hello, world!"},
            },
        },
        .{
            .desc = "limit_10_two_element",
            .sql =
            \\SELECT COUNT(a) FROM (
            \\SELECT a FROM (SELECT 'x' a UNION ALL SELECT 'y') LIMIT 10)
            ,
            .rows = .{
                .{2},
            },
        },
        .{
            .desc = "limit_1_empty_input",
            .sql = "SELECT a FROM (SELECT 1 a) WHERE a > 10 LIMIT 1",
            .rows = .{},
        },
        .{
            .desc = "limit_0_offset_0",
            .sql =
            \\# ------------
            \\# LIMIT OFFSET
            \\# ------------
            \\SELECT a FROM (SELECT 1 a) LIMIT 0 OFFSET 0
            ,
            .rows = .{},
        },
        .{
            .desc = "limit_1_offset_0",
            .sql =
            \\SELECT COUNT(a) FROM (
            \\SELECT a FROM (SELECT 1 a UNION ALL SELECT 2 UNION ALL SELECT 3) LIMIT 0 OFFSET 0)
            ,
            .rows = .{
                .{0},
            },
        },
        .{
            .desc = "limit_3_offset_0",
            .sql =
            \\SELECT COUNT(a) FROM (
            \\SELECT a FROM (SELECT 1 a UNION ALL SELECT 2 UNION ALL SELECT 3) LIMIT 3 OFFSET 0)
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "limit_3_offset_1",
            .sql =
            \\SELECT COUNT(a) FROM (
            \\SELECT a FROM (SELECT 1 a UNION ALL SELECT 2 UNION ALL SELECT 3) LIMIT 3 OFFSET 1)
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "limit_3_offset_2",
            .sql =
            \\SELECT COUNT(a) FROM (
            \\SELECT a FROM (SELECT 1 a UNION ALL SELECT 2 UNION ALL SELECT 3) LIMIT 3 OFFSET 2)
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "limit_3_offset_3",
            .sql = "SELECT a FROM (SELECT 'x' a UNION ALL SELECT 'y' UNION ALL SELECT 'z') LIMIT 3 OFFSET 3",
            .rows = .{},
        },
        .{
            .desc = "limit_3_offset_4",
            .sql = "SELECT a FROM (SELECT 1.1 a UNION ALL SELECT 2.2 UNION ALL SELECT 3.3) LIMIT 3 OFFSET 4",
            .rows = .{},
        },
        .{
            .desc = "orderby_limit_0",
            .sql =
            \\# --------------
            \\# ORDER BY LIMIT
            \\# --------------
            \\SELECT a FROM (SELECT 2.2 a UNION ALL SELECT 1.1 UNION ALL SELECT 3.3) ORDER BY a LIMIT 0
            ,
            .rows = .{},
        },
        .{
            .desc = "orderby_limit_1",
            .sql = "SELECT a FROM (SELECT 2.2 a UNION ALL SELECT 1.1 UNION ALL SELECT 3.3) ORDER BY a LIMIT 1",
            .rows = .{
                .{1.1},
            },
        },
        .{
            .desc = "orderby_limit_2",
            .sql = "SELECT a FROM (SELECT 2.2 a UNION ALL SELECT 1.1 UNION ALL SELECT 3.3) ORDER BY a LIMIT 2",
            .rows = .{
                .{1.1},
                .{2.2},
            },
        },
        .{
            .desc = "orderby_limit_3",
            .sql = "SELECT a FROM (SELECT 3.3 a UNION ALL SELECT 1.1 UNION ALL SELECT 2.2) ORDER BY a LIMIT 3",
            .rows = .{
                .{1.1},
                .{2.2},
                .{3.3},
            },
        },
        .{
            .desc = "orderby_limit_4",
            .sql = "SELECT a FROM (SELECT 3.3 a UNION ALL SELECT 1.1 UNION ALL SELECT 2.2) ORDER BY a LIMIT 4",
            .rows = .{
                .{1.1},
                .{2.2},
                .{3.3},
            },
        },
        .{
            .desc = "orderby_desc_limit_1",
            .sql = "SELECT a FROM (SELECT 3.3 a UNION ALL SELECT 1.1 UNION ALL SELECT 2.2) ORDER BY a DESC LIMIT 1",
            .rows = .{
                .{3.3},
            },
        },
        .{
            .desc = "orderby_limit_1_offset_0",
            .sql =
            \\# ---------------------
            \\# ORDER BY LIMIT OFFSET
            \\# ---------------------
            \\SELECT a FROM (SELECT 'b' a UNION ALL SELECT 'c' UNION ALL SELECT 'a') ORDER BY a LIMIT 1 OFFSET 0
            ,
            .rows = .{
                .{"a"},
            },
        },
        .{
            .desc = "orderby_limit_1_offset_1",
            .sql = "SELECT a FROM (SELECT 'b' a UNION ALL SELECT 'c' UNION ALL SELECT 'a') ORDER BY a LIMIT 1 OFFSET 1",
            .rows = .{
                .{"b"},
            },
        },
        .{
            .desc = "orderby_limit_1_offset_2",
            .sql = "SELECT a FROM (SELECT 'b' a UNION ALL SELECT 'c' UNION ALL SELECT 'a') ORDER BY a LIMIT 1 OFFSET 2",
            .rows = .{
                .{"c"},
            },
        },
        .{
            .desc = "orderby_limit_1_offset_3",
            .sql = "SELECT a FROM (SELECT 'b' a UNION ALL SELECT 'c' UNION ALL SELECT 'a') ORDER BY a LIMIT 1 OFFSET 3",
            .rows = .{},
        },
        .{
            .desc = "orderby_limit_2_offset_0",
            .sql = "SELECT a FROM (SELECT 'b' a UNION ALL SELECT 'c' UNION ALL SELECT 'a') ORDER BY a LIMIT 2 OFFSET 0",
            .rows = .{
                .{"a"},
                .{"b"},
            },
        },
        .{
            .desc = "orderby_limit_2_offset_1",
            .sql = "SELECT a FROM (SELECT 'b' a UNION ALL SELECT 'c' UNION ALL SELECT 'a') ORDER BY a LIMIT 2 OFFSET 1",
            .rows = .{
                .{"b"},
                .{"c"},
            },
        },
        .{
            .desc = "orderby_limit_2_offset_2",
            .sql = "SELECT a FROM (SELECT 'b' a UNION ALL SELECT 'c' UNION ALL SELECT 'a') ORDER BY a LIMIT 2 OFFSET 2",
            .rows = .{
                .{"c"},
            },
        },
        .{
            .desc = "orderby_limit_2_offset_3",
            .sql = "SELECT a FROM (SELECT 'b' a UNION ALL SELECT 'c' UNION ALL SELECT 'a') ORDER BY a LIMIT 2 OFFSET 3",
            .rows = .{},
        },
        .{
            .desc = "cross_apply_limit_0",
            .sql =
            \\# ---------------------------
            \\# LIMIT in map of CROSS APPLY
            \\# ---------------------------
            \\SELECT key, ARRAY(SELECT v FROM t.values v LIMIT 0) FROM Table1 t ORDER BY key
            ,
            .rows = .{
                .{ null, .{} },
                .{ 0, .{} },
                .{ 1, .{} },
                .{ 2, .{} },
                .{ 3, .{} },
                .{ 4, .{} },
            },
        },
        .{
            .desc = "cross_apply_limit_1",
            .sql = "SELECT key, ARRAY(SELECT v FROM t.values v ORDER BY v LIMIT 1) FROM Table1 t ORDER BY key",
            .rows = .{
                .{ null, .{null} },
                .{ 0, .{} },
                .{ 1, .{"one"} },
                .{ 2, .{"a"} },
                .{ 3, .{"x"} },
                .{ 4, .{"w"} },
            },
        },
        .{
            .desc = "cross_apply_limit_2",
            .sql = "SELECT key, ARRAY(SELECT v FROM t.values v ORDER BY v LIMIT 2) FROM Table1 t ORDER BY key",
            .rows = .{
                .{ null, .{null} },
                .{ 0, .{} },
                .{ 1, .{"one"} },
                .{ 2, .{ "a", "c" } },
                .{ 3, .{ "x", "y" } },
                .{ 4, .{ "w", "w" } },
            },
        },
        .{
            .desc = "cross_apply_limit_100",
            .sql = "SELECT key, ARRAY(SELECT v FROM t.values v ORDER BY v LIMIT 100) FROM Table1 t ORDER BY key",
            .rows = .{
                .{ null, .{null} },
                .{ 0, .{} },
                .{ 1, .{"one"} },
                .{ 2, .{ "a", "c" } },
                .{ 3, .{ "x", "y", "z" } },
                .{ 4, .{ "w", "w", "w", "w" } },
            },
        },
        .{
            .desc = "cross_apply_limit_1_offset_1",
            .sql =
            \\# ---------------------------
            \\# LIMIT OFFSET in map of CROSS APPLY
            \\# ---------------------------
            \\SELECT key, ARRAY(SELECT v FROM t.values v ORDER BY v LIMIT 1 OFFSET 1) FROM Table1 t ORDER BY key
            ,
            .rows = .{
                .{ null, .{} },
                .{ 0, .{} },
                .{ 1, .{} },
                .{ 2, .{"c"} },
                .{ 3, .{"y"} },
                .{ 4, .{"w"} },
            },
        },
        .{
            .desc = "cross_apply_limit_100_offset_1",
            .sql = "SELECT key, ARRAY(SELECT v FROM t.values v ORDER BY v LIMIT 100 OFFSET 1) FROM Table1 t ORDER BY key",
            .rows = .{
                .{ null, .{} },
                .{ 0, .{} },
                .{ 1, .{} },
                .{ 2, .{"c"} },
                .{ 3, .{ "y", "z" } },
                .{ 4, .{ "w", "w", "w" } },
            },
        },
        .{
            .desc = "cross_apply_limit_1_offset_100",
            .sql = "SELECT key, ARRAY(SELECT v FROM t.values v ORDER BY v LIMIT 1 OFFSET 100) FROM Table1 t ORDER BY key",
            .rows = .{
                .{ null, .{} },
                .{ 0, .{} },
                .{ 1, .{} },
                .{ 2, .{} },
                .{ 3, .{} },
                .{ 4, .{} },
            },
        },
        .{
            .desc = "type_bool",
            .sql =
            \\# ----------
            \\# Data types
            \\# ----------
            \\SELECT a FROM (SELECT TRUE a) LIMIT 1
            ,
            .rows = .{
                .{true},
            },
        },
        .{
            .desc = "type_int32",
            .sql = "SELECT a FROM (SELECT CAST(-1 AS INT32) a) LIMIT 1",
            .rows = .{
                .{-1},
            },
        },
        .{
            .desc = "type_uint32",
            .sql = "SELECT a FROM (SELECT CAST(1 AS UINT32) a) LIMIT 1",
            .rows = .{
                .{1},
            },
        },
        .{
            .desc = "type_int64",
            .sql = "SELECT a FROM (SELECT CAST(-10000000000 AS INT64) a) LIMIT 1",
            .rows = .{
                .{-10000000000},
            },
        },
        .{
            .desc = "type_uint64",
            .sql = "SELECT a FROM (SELECT CAST(99999999999 AS UINT64) a) LIMIT 1",
            .rows = .{
                .{99999999999},
            },
        },
        .{
            .desc = "type_float",
            .sql = "SELECT a FROM (SELECT CAST(3.14159 AS FLOAT) a) LIMIT 1",
            .rows = .{
                .{3.14159},
            },
        },
        .{
            .desc = "type_double",
            .sql = "SELECT a FROM (SELECT CAST(1.2345e100 AS DOUBLE) a) LIMIT 1",
            .rows = .{
                .{1.2345e+100},
            },
        },
        .{
            .desc = "type_string",
            .sql = "SELECT a FROM (SELECT 'I am a string' a) LIMIT 1",
            .rows = .{
                .{"I am a string"},
            },
        },
        .{
            .desc = "type_bytes",
            .sql = "SELECT a FROM (SELECT b'I am binary' a) LIMIT 1",
            .rows = .{
                .{"\x49\x20\x61\x6d\x20\x62\x69\x6e\x61\x72\x79"},
            },
        },
        .{
            .desc = "type_date",
            .sql = "SELECT a FROM (SELECT DATE '1961-04-12' a) LIMIT 1",
            .rows = .{
                .{"1961-04-12"},
            },
        },
        .{
            .desc = "type_timestamp",
            .sql = "SELECT a FROM (SELECT TIMESTAMP '2000-01-23 12:13:14.123456+00' a) LIMIT 1",
            .rows = .{
                .{"2000-01-23 12:13:14.123456+00"},
            },
        },
        .{
            .desc = "type_array_int64",
            .sql = "SELECT a FROM (SELECT [1,2,3] a) LIMIT 1",
            .rows = .{
                .{.{ 1, 2, 3 }},
            },
        },
        .{
            .desc = "type_struct",
            .sql = "SELECT (SELECT s FROM (SELECT 'x' a, 5 b) s) LIMIT 1",
            .rows = .{
                .{.{ "x", 5 }},
            },
        },
        .{
            .desc = "limit_in_parethesis",
            .sql = "SELECT a FROM (SELECT 1 a) LIMIT (1)",
            .rows = .{
                .{1},
            },
        },
        .{
            .desc = "limit_null",
            .sql = "SELECT a FROM (SELECT 1 a) LIMIT NULL",
            .expect_error_any = true,
        },
        .{
            .desc = "offset_in_parethesis",
            .sql = "SELECT a FROM (SELECT 1 a) LIMIT 1 OFFSET (1)",
            .rows = .{},
        },
        .{
            .desc = "offset_null",
            .sql = "SELECT a FROM (SELECT 1 a) LIMIT 1 OFFSET NULL",
            .expect_error_any = true,
        },
        .{
            .desc = "param_limit_1_offset_0_cast_literals",
            .sql = "SELECT a FROM (SELECT 1 a) LIMIT cast(1 as uint64) OFFSET cast(0 as int32)",
            .rows = .{
                .{1},
            },
        },
        .{
            .desc = "nondeterminism_detected_with_collation",
            .unsupported_in_bigquery = "\"COLLATE is not supported\" (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT count(*)
            \\FROM (
            \\  SELECT s
            \\  FROM UNNEST(["a", "A"]) AS s
            \\  ORDER BY s COLLATE "und:ci"
            \\  LIMIT 1
            \\)
            ,
            .nondeterministic = true,
        },
        .{
            .desc = "collation_does_not_cause_nondeterminism_for_identical_strings",
            .unsupported_in_bigquery = "\"COLLATE is not supported\" (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT count(*)
            \\FROM (
            \\  SELECT s
            \\  FROM UNNEST(["a", "a"]) AS s
            \\  ORDER BY s COLLATE "und:ci"
            \\  LIMIT 1
            \\)
            ,
            .rows = .{
                .{1},
            },
        },
    },
}
