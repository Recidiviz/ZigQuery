            \\SELECT
            \\  3 as row_id,
            \\  cast(3.141592653589793238 AS bignumeric) as bignumeric_val UNION ALL
            \\SELECT
            \\  4 as row_id,
            \\  cast(-345 AS bignumeric) as bignumeric_val UNION ALL
            \\SELECT
            \\  5 as row_id,
            \\  cast(null AS bignumeric) as bignumeric_val UNION ALL
