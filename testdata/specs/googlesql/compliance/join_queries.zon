            .sql =
            \\SELECT COUNT (*) FROM
            \\  (SELECT CAST (10000000000 AS UINT64) AS key
            \\      UNION ALL SELECT 0XFFFFFFFFFFFFD8F0 ) a
            \\  JOIN
            \\  (SELECT CAST (10000000000 AS INT64) AS key
