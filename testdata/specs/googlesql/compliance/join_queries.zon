            \\SELECT
            \\  3 as row_id,
            \\  cast("9d3da323-4c20-360f-bd9b-ec54feec54f0" AS uuid) as uuid_val UNION ALL
            \\SELECT
            \\  4 as row_id,
            \\  cast("ffffffff-ffff-ffff-ffff-ffffffffffff" AS uuid) as uuid_val UNION ALL
            \\SELECT
