// Imported from GoogleSQL's own compliance-testdata suite
// (third_party/googlesql/googlesql/compliance/testdata, Apache-2.0).
.{
    .spec = "googlesql/compliance/range_constructors",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/googlesql/compliance/testdata/range_constructors.test",
    .cases = .{
        .{
            .desc = "range_of_dates_literal_regular",
            .sql = "SELECT RANGE<DATE> '[2014-01-01, 2015-01-01)'",
            .rows = .{
                .{"[2014-01-01, 2015-01-01)"},
            },
        },
        .{
            .desc = "range_of_dates_literal_unbounded_end",
            .sql = "SELECT RANGE<DATE> '[2014-01-01, UNBOUNDED)'",
            .rows = .{
                .{"[2014-01-01, NULL)"},
            },
        },
        .{
            .desc = "range_of_dates_literal_unbounded_start",
            .sql = "SELECT RANGE<DATE> '[UNBOUNDED, 2015-01-01)'",
            .rows = .{
                .{"[NULL, 2015-01-01)"},
            },
        },
        .{
            .desc = "range_of_dates_literal_unbounded_start_and_end",
            .sql = "SELECT RANGE<DATE> '[UNBOUNDED, UNBOUNDED)'",
            .rows = .{
                .{"[NULL, NULL)"},
            },
        },
        .{
            .desc = "range_of_datetimes_literal_regular",
            .sql = "SELECT RANGE<DATETIME> '[2016-01-01 12:00:00, 2017-01-01 12:00:00)'",
            .rows = .{
                .{"[2016-01-01 12:00:00, 2017-01-01 12:00:00)"},
            },
        },
        .{
            .desc = "range_of_datetimes_literal_unbounded_end",
            .sql = "SELECT RANGE<DATETIME> '[2016-01-01 12:00:00, UNBOUNDED)'",
            .rows = .{
                .{"[2016-01-01 12:00:00, NULL)"},
            },
        },
        .{
            .desc = "range_of_datetimes_literal_unbounded_start",
            .sql = "SELECT RANGE<DATETIME> '[UNBOUNDED, 2017-01-01 12:00:00)'",
            .rows = .{
                .{"[NULL, 2017-01-01 12:00:00)"},
            },
        },
        .{
            .desc = "range_of_datetimes_literal_unbounded_start_and_end",
            .sql = "SELECT RANGE<DATETIME> '[UNBOUNDED, UNBOUNDED)'",
            .rows = .{
                .{"[NULL, NULL)"},
            },
        },
        .{
            .desc = "range_of_timestamps_literal_regular",
            .sql = "SELECT RANGE<TIMESTAMP> '[2018-10-01 12:00:00+08, 2019-01-01 12:00:00+08)'",
            .rows = .{
                .{"[2018-10-01 04:00:00+00, 2019-01-01 04:00:00+00)"},
            },
        },
        .{
            .desc = "range_of_timestamps_literal_unbounded_end",
            .sql = "SELECT RANGE<TIMESTAMP> '[2018-10-01 12:00:00+08, UNBOUNDED)'",
            .rows = .{
                .{"[2018-10-01 04:00:00+00, NULL)"},
            },
        },
        .{
            .desc = "range_of_timestamps_literal_unbounded_start",
            .sql = "SELECT RANGE<TIMESTAMP> '[UNBOUNDED, 2019-01-01 12:00:00+08)'",
            .rows = .{
                .{"[NULL, 2019-01-01 04:00:00+00)"},
            },
        },
        .{
            .desc = "range_of_timestamps_literal_unbounded_start_and_end",
            .sql = "SELECT RANGE<TIMESTAMP> '[UNBOUNDED, UNBOUNDED)'",
            .rows = .{
                .{"[NULL, NULL)"},
            },
        },
        .{
            .desc = "range_of_dates_literal_null_end",
            .sql = "SELECT RANGE<DATE> '[2014-01-01, NULL)'",
            .rows = .{
                .{"[2014-01-01, NULL)"},
            },
        },
        .{
            .desc = "range_of_dates_literal_null_start",
            .sql = "SELECT RANGE<DATE> '[NULL, 2015-01-01)'",
            .rows = .{
                .{"[NULL, 2015-01-01)"},
            },
        },
        .{
            .desc = "range_of_dates_literal_null_start_and_end",
            .sql = "SELECT RANGE<DATE> '[NULL, NULL)'",
            .rows = .{
                .{"[NULL, NULL)"},
            },
        },
        .{
            .desc = "range_of_datetimes_literal_null_end",
            .sql = "SELECT RANGE<DATETIME> '[2016-01-01 12:00:00, NULL)'",
            .rows = .{
                .{"[2016-01-01 12:00:00, NULL)"},
            },
        },
        .{
            .desc = "range_of_datetimes_literal_null_start",
            .sql = "SELECT RANGE<DATETIME> '[NULL, 2017-01-01 12:00:00)'",
            .rows = .{
                .{"[NULL, 2017-01-01 12:00:00)"},
            },
        },
        .{
            .desc = "range_of_datetimes_literal_null_start_and_end",
            .sql = "SELECT RANGE<DATETIME> '[NULL, NULL)'",
            .rows = .{
                .{"[NULL, NULL)"},
            },
        },
        .{
            .desc = "range_of_timestamps_literal_null_end",
            .sql = "SELECT RANGE<TIMESTAMP> '[2018-10-01 12:00:00+08, NULL)'",
            .rows = .{
                .{"[2018-10-01 04:00:00+00, NULL)"},
            },
        },
        .{
            .desc = "range_of_timestamps_literal_null_start",
            .sql = "SELECT RANGE<TIMESTAMP> '[NULL, 2019-01-01 12:00:00+08)'",
            .rows = .{
                .{"[NULL, 2019-01-01 04:00:00+00)"},
            },
        },
        .{
            .desc = "range_of_dates_constructor_function_regular",
            .sql = "SELECT RANGE(DATE '2014-01-01', DATE '2015-01-01')",
            .rows = .{
                .{"[2014-01-01, 2015-01-01)"},
            },
        },
        .{
            .desc = "range_of_dates_constructor_function_null_end",
            .sql = "SELECT RANGE(DATE '2014-01-01', NULL)",
            .rows = .{
                .{"[2014-01-01, NULL)"},
            },
        },
        .{
            .desc = "range_of_dates_constructor_function_null_start",
            .sql = "SELECT RANGE(NULL, DATE '2015-01-01')",
            .rows = .{
                .{"[NULL, 2015-01-01)"},
            },
        },
        .{
            .desc = "range_of_dates_constructor_function_null_start_and_end",
            .sql = "SELECT RANGE(CAST(NULL AS DATE), NULL)",
            .rows = .{
                .{"[NULL, NULL)"},
            },
        },
        .{
            .desc = "range_of_datetimes_constructor_function_regular",
            .sql = "SELECT RANGE(DATETIME '2016-01-01 12:00:00', DATETIME '2017-01-01 12:00:00'),",
            .rows = .{
                .{"[2016-01-01 12:00:00, 2017-01-01 12:00:00)"},
            },
        },
        .{
            .desc = "range_of_datetimes_constructor_function_unbounded_end",
            .sql = "SELECT RANGE(DATETIME '2016-01-01 12:00:00', NULL),",
            .rows = .{
                .{"[2016-01-01 12:00:00, NULL)"},
            },
        },
        .{
            .desc = "range_of_datetimes_constructor_function_unbounded_start",
            .sql = "SELECT RANGE(NULL, DATETIME '2017-01-01 12:00:00'),",
            .rows = .{
                .{"[NULL, 2017-01-01 12:00:00)"},
            },
        },
        .{
            .desc = "range_of_datetimes_constructor_function_unbounded_start_and_end",
            .sql = "SELECT RANGE(CAST(NULL AS DATETIME), NULL),",
            .rows = .{
                .{"[NULL, NULL)"},
            },
        },
        .{
            .desc = "range_of_timestamps_constructor_function_regular",
            .sql = "SELECT RANGE(TIMESTAMP '2018-10-01 12:00:00+08', TIMESTAMP '2019-01-01 12:00:00+08')",
            .rows = .{
                .{"[2018-10-01 04:00:00+00, 2019-01-01 04:00:00+00)"},
            },
        },
        .{
            .desc = "range_of_timestamps_constructor_function_unbounded_end",
            .sql = "SELECT RANGE(TIMESTAMP '2018-10-01 12:00:00+08', NULL)",
            .rows = .{
                .{"[2018-10-01 04:00:00+00, NULL)"},
            },
        },
        .{
            .desc = "range_of_timestamps_constructor_function_unbounded_start",
            .sql = "SELECT RANGE(NULL, TIMESTAMP '2019-01-01 12:00:00+08')",
            .rows = .{
                .{"[NULL, 2019-01-01 04:00:00+00)"},
            },
        },
        .{
            .desc = "range_of_timestamps_constructor_function_unbounded_start_and_end",
            .sql = "SELECT RANGE(CAST(NULL AS TIMESTAMP), NULL)",
            .rows = .{
                .{"[NULL, NULL)"},
            },
        },
        .{
            .desc = "range_of_timestamps_constructor_function_with_expression",
            .sql = "SELECT RANGE(PARSE_TIMESTAMP(\"%Y-%m-%d\", \"2001-02-03\", \"UTC\"), PARSE_TIMESTAMP(\"%Y-%m-%d\", \"2002-03-04\", \"UTC\"))",
            .rows = .{
                .{"[2001-02-03 00:00:00+00, 2002-03-04 00:00:00+00)"},
            },
        },
        .{
            .desc = "range_of_dates_constructor_function_end_less_than_start",
            .sql = "SELECT RANGE(DATE '2014-01-01', DATE '2013-01-01')",
            .expect_error_any = true,
        },
        .{
            .desc = "range_of_timestamps_constructor_function_end_less_than_start",
            .sql = "SELECT RANGE(TIMESTAMP '2014-01-01', TIMESTAMP '2013-01-01')",
            .expect_error_any = true,
        },
        .{
            .desc = "range_of_datetimes_constructor_function_end_less_than_start",
            .sql = "SELECT RANGE(DATETIME '2014-01-01', DATETIME '2013-01-01')",
            .expect_error_any = true,
        },
        .{
            .desc = "range_of_dates_constructor_function_start_equals_end",
            .sql = "SELECT RANGE(DATE '2014-01-01', DATE '2014-01-01')",
            .expect_error_any = true,
        },
        .{
            .desc = "range_of_timestamps_constructor_function_start_equals_end",
            .sql = "SELECT RANGE(TIMESTAMP '2014-01-01', TIMESTAMP '2014-01-01')",
            .expect_error_any = true,
        },
        .{
            .desc = "range_of_datetimes_constructor_function_start_equals_end",
            .sql = "SELECT RANGE(DATETIME '2014-01-01', DATETIME '2014-01-01')",
            .expect_error_any = true,
        },
        .{
            .desc = "safe_range_constructor",
            .sql =
            \\SELECT SAFE.RANGE(DATE '2020-01-01', DATE '2020-01-01'),
            \\       SAFE.RANGE(DATE '2030-01-01', DATE '2020-01-01'),
            \\       SAFE.RANGE(TIMESTAMP '2020-01-01', TIMESTAMP '2020-01-01'),
            \\       SAFE.RANGE(TIMESTAMP '2030-01-01', TIMESTAMP '2020-01-01')
            ,
            .rows = .{
                .{ null, null, null, null },
            },
        },
        .{
            .desc = "safe_range_datetime_constructor",
            .sql =
            \\SELECT SAFE.RANGE(DATETIME '2020-01-01', DATETIME '2020-01-01'),
            \\       SAFE.RANGE(DATETIME '2030-01-01', DATETIME '2020-01-01')
            ,
            .rows = .{
                .{ null, null },
            },
        },
        .{
            .desc = "range_literal_with_picoseconds",
            .unsupported_in_bigquery = "picosecond-precision TIMESTAMP literals error \"Invalid TIMESTAMP literal\" (recidiviz-bigquery-sandbox, 2026-08-23)",
            .sql =
            \\SELECT
            \\  RANGE(NULL, TIMESTAMP '2020-12-31 12:00:00.123456789123+08'),
            \\  RANGE(TIMESTAMP '2020-10-01 12:00:00.123456789123+08', NULL),
            \\  RANGE(TIMESTAMP '2020-10-01 12:00:00.123456789123+08', TIMESTAMP '2020-12-31 12:00:00.123456789123+08')
            ,
            .rows = .{
                .{ "[NULL, 2020-12-31 04:00:00.123456789123+00)", "[2020-10-01 04:00:00.123456789123+00, NULL)", "[2020-10-01 04:00:00.123456789123+00, 2020-12-31 04:00:00.123456789123+00)" },
            },
        },
    },
}
