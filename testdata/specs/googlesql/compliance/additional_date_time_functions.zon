            \\  ADD_MONTHS(DATETIME "1925-03-15 03:14:15", CAST(NULL as INT64)),
            \\  ADD_MONTHS(CAST(NULL as DATETIME), CAST(NULL as INT64))
            ,
            .rows = .{
                .{ null, null, null },
