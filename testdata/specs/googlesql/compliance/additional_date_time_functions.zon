            .unsupported_in_bigquery = "Function not found: ADD_MONTHS (recidiviz-bigquery-sandbox, 2026-08-23)",
            .sql = "SELECT ADD_MONTHS(DATETIME \"0001-12-25 01:02:03\", -13)",
            .expect_error_any = true,
        },
        .{
            .desc = "next_day_date_basic",
            .unsupported_in_bigquery = "Function not found: NEXT_DAY (recidiviz-bigquery-sandbox, 2026-08-23)",
            .sql =
