            .sql =
            \\# ROWS window frame ROWS BETWEEN UNBOUNDED PRECEDING AND <offset> FOLLOWING.
            \\select row_id, val,
            \\       sum(val) over (order by row_id ROWS BETWEEN UNBOUNDED PRECEDING
            \\                                               AND 0 FOLLOWING),
            \\       sum(val) over (order by row_id ROWS BETWEEN UNBOUNDED PRECEDING
            \\                                               AND 1 FOLLOWING),
            \\       sum(val) over (order by row_id ROWS BETWEEN UNBOUNDED PRECEDING
