            \\       AVG(int64_val)  > 6.499999 AND AVG(int64_val)  < 6.5000001 AS true2,
            \\       AVG(uint64_val)  > 20.999999 AND AVG(uint64_val)  < 21.0000001 AS true3
            \\FROM TableLarge WHERE NOT IS_INF(double_val) AND NOT IS_NAN(double_val)
            ,
