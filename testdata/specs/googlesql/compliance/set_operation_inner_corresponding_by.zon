.{
    .spec = "googlesql/compliance/set_operation_inner_corresponding_by",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/googlesql/compliance/testdata/set_operation_inner_corresponding_by.test",
    .cases = .{
        .{
            .desc = "corresponding_by_literal_coercion_inner",
            .unsupported_in_bigquery = "BigQuery has no INT32 SQL type: Type not found: INT32 (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\# This file contains the compliance test cases for INNER CORRESPONDING BY. Test
            \\# cases are divided into multiple sections.
            \\## ===== Start section: Literal and type coercion for INNER CORRESPONDING BY =====  ##
            \\# CORRESPONDING BY literal coercion INNER mode
            \\SELECT 1 AS b, 1 AS a
            \\UNION ALL CORRESPONDING BY (b)
            \\SELECT CAST(1 AS INT32) AS b
            ,
            .unordered = true,
            .rows = .{
                .{1},
                .{1},
            },
        },
        .{
            .desc = "corresponding_by_literal_coercion_inner_coercion_with_subquery",
            .unsupported_in_bigquery = "BigQuery has no INT32 SQL type: Type not found: INT32 (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\# CORRESPONDING BY literal coercion INNER mode literal cocercion with subquery
            \\(
            \\  SELECT 1 AS a, 1 AS b
            \\  UNION ALL CORRESPONDING BY (a, b)
            \\  SELECT 1 AS b, NULL AS a
            \\)
            \\UNION ALL CORRESPONDING BY (a, b)
            \\SELECT 1 AS b, CAST(1 AS INT32) AS a
            ,
            .unordered = true,
            .rows = .{
                .{ null, 1 },
                .{ 1, 1 },
                .{ 1, 1 },
            },
        },
        .{
            .desc = "corresponding_by_literal_coercion_inner_three_inputs",
            .unsupported_in_bigquery = "BigQuery has no FLOAT/INT32 SQL type: Type not found: FLOAT (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\# CORRESPONDING BY literal coercion INNER mode with three inputs but without padded NULL in any of the input
            \\SELECT NULL AS a
            \\UNION ALL CORRESPONDING BY (a)
            \\SELECT CAST(1 AS FLOAT) AS a
            \\UNION ALL CORRESPONDING BY (a)
            \\SELECT CAST(1 AS INT32) AS a
            ,
            .unordered = true,
            .rows = .{
                .{null},
                .{1},
                .{1},
            },
        },
        .{
            .desc = "corresponding_by_type_coercion_inner_basic_type_coercion",
