// Imported from GoogleSQL's own compliance-testdata suite
// (third_party/googlesql/googlesql/compliance/testdata, Apache-2.0).
.{
    .spec = "googlesql/compliance/analytic_bit_xor",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/googlesql/compliance/testdata/analytic_bit_xor.test",
    .cases = .{
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TABLE TestTable AS
            \\SELECT cast(1 as int64) as row_id,
            \\       cast(NULL as int32) as int_val UNION ALL
            \\  SELECT 2,  1                        UNION ALL
            \\  SELECT 3,  2                        UNION ALL
            \\  SELECT 4,  12345                    UNION ALL
            \\  SELECT 5,  0                        UNION ALL
            \\  SELECT 6,  171717                   UNION ALL
            \\  SELECT 7,  -322                     UNION ALL
            \\  SELECT 8,  -1                       UNION ALL
            \\  SELECT 9,  -1                       UNION ALL
            \\  SELECT 10, -1                       UNION ALL
            \\  SELECT 11, 7                        UNION ALL
            \\  SELECT 12, 7                        UNION ALL
            \\  SELECT 13, 0                        UNION ALL
            \\  SELECT 14, 0                        UNION ALL
            \\  SELECT 15, NULL                     UNION ALL
            \\  SELECT 16, NULL                     UNION ALL
            \\  SELECT 17, NULL                     UNION ALL
            \\  SELECT 18, 0                        UNION ALL
            \\  SELECT 19, -2                       UNION ALL
            \\  SELECT 20, -2
            ,
        },
        .{
            .desc = "bit_xor_unbounded",
            .sql =
            \\SELECT t.row_id, bit_xor(t.int_val)
            \\OVER()
            \\FROM TestTable t
            \\ORDER BY row_id
            ,
            .rows = .{
                .{ 1, 176062 },
                .{ 2, 176062 },
                .{ 3, 176062 },
                .{ 4, 176062 },
                .{ 5, 176062 },
                .{ 6, 176062 },
                .{ 7, 176062 },
                .{ 8, 176062 },
                .{ 9, 176062 },
                .{ 10, 176062 },
                .{ 11, 176062 },
                .{ 12, 176062 },
                .{ 13, 176062 },
                .{ 14, 176062 },
                .{ 15, 176062 },
                .{ 16, 176062 },
                .{ 17, 176062 },
                .{ 18, 176062 },
                .{ 19, 176062 },
                .{ 20, 176062 },
            },
        },
        .{
            .desc = "bit_xor_one_preceding_one_following",
            .sql =
            \\SELECT t.row_id, bit_xor(t.int_val)
            \\OVER(ORDER BY row_id ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING)
            \\FROM TestTable t
            \\ORDER BY row_id
            ,
            .rows = .{
                .{ 1, 1 },
                .{ 2, 3 },
                .{ 3, 12346 },
                .{ 4, 12347 },
                .{ 5, 175868 },
                .{ 6, -171909 },
                .{ 7, 171908 },
                .{ 8, -322 },
                .{ 9, -1 },
                .{ 10, 7 },
                .{ 11, -1 },
                .{ 12, 0 },
                .{ 13, 7 },
                .{ 14, 0 },
                .{ 15, 0 },
                .{ 16, null },
                .{ 17, 0 },
                .{ 18, -2 },
                .{ 19, 0 },
                .{ 20, 0 },
            },
        },
        .{
            .desc = "bit_xor_current_row_unbounded_following",
            .sql =
            \\SELECT t.row_id, bit_xor(t.int_val)
            \\OVER(ORDER BY row_id ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING)
            \\FROM TestTable t
            \\ORDER BY row_id
            ,
            .rows = .{
                .{ 1, 176062 },
                .{ 2, 176062 },
                .{ 3, 176063 },
                .{ 4, 176061 },
                .{ 5, 171908 },
                .{ 6, 171908 },
                .{ 7, 321 },
                .{ 8, -1 },
                .{ 9, 0 },
                .{ 10, -1 },
                .{ 11, 0 },
                .{ 12, 7 },
                .{ 13, 0 },
                .{ 14, 0 },
                .{ 15, 0 },
                .{ 16, 0 },
                .{ 17, 0 },
                .{ 18, 0 },
                .{ 19, 0 },
                .{ 20, -2 },
            },
        },
        .{
            .desc = "bit_xor_unbounded_preceding_current_row",
            .sql =
            \\SELECT t.row_id, bit_xor(t.int_val)
            \\OVER(ORDER BY row_id ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW)
            \\FROM TestTable t
            \\ORDER BY row_id
            ,
            .rows = .{
                .{ 1, null },
                .{ 2, 1 },
                .{ 3, 3 },
                .{ 4, 12346 },
                .{ 5, 12346 },
                .{ 6, 175871 },
                .{ 7, -176063 },
                .{ 8, 176062 },
                .{ 9, -176063 },
                .{ 10, 176062 },
                .{ 11, 176057 },
                .{ 12, 176062 },
                .{ 13, 176062 },
                .{ 14, 176062 },
                .{ 15, 176062 },
                .{ 16, 176062 },
                .{ 17, 176062 },
                .{ 18, 176062 },
                .{ 19, -176064 },
                .{ 20, 176062 },
            },
        },
    },
}
