// Imported from GoogleSQL's own compliance-testdata suite
// (third_party/googlesql/googlesql/compliance/testdata, Apache-2.0).
.{
    .spec = "googlesql/compliance/aggregate_filter",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/googlesql/compliance/testdata/aggregate_filter.test",
    .cases = .{
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TABLE Employees AS
            \\  SELECT * FROM UNNEST([
            \\    STRUCT(1 AS emp_id, 101 AS dept_id, 45 AS age, 200000 AS salary, "Manager" AS job, 1 AS status_code),
            \\    STRUCT(2 AS emp_id, 102 AS dept_id, 42 AS age, 180000 AS salary, "Manager" AS job, NULL AS status_code),
            \\    STRUCT(3 AS emp_id, 101 AS dept_id, 28 AS age, 150000 AS salary, "Manager" AS job, 2 AS status_code),
            \\    STRUCT(4 AS emp_id, 102 AS dept_id, 25 AS age, 80000 AS salary,  "Analyst" AS job, 1 AS status_code),
            \\    STRUCT(5 AS emp_id, 101 AS dept_id, 29 AS age, 70000 AS salary,  "Analyst" AS job, 2 AS status_code),
            \\    STRUCT(6 AS emp_id, 102 AS dept_id, 37 AS age, 80000 AS salary,  "Analyst" AS job, NULL AS status_code)
            \\  ])
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TABLE TestExamTableWithRowId AS
            \\SELECT cast(1 as int64) as row_id,
            \\       cast("Hansen" as string) as last_name,
            \\       cast("P91" as string) as test_id,
            \\       cast(510 as double) as test_score UNION ALL
            \\SELECT 2, "Wang", "U25", 500 UNION ALL
            \\SELECT 3, "Wang", "C83", 520 UNION ALL
            \\SELECT 4, "Wang", "U25", 460 UNION ALL
            \\SELECT 5, "Hansen", "C83", 420 UNION ALL
            \\SELECT 6, "Hansen", "C83", 560 UNION ALL
            \\SELECT 7, "Devi", "U25", 580 UNION ALL
            \\SELECT 8, "Devi", "P91", 480 UNION ALL
            \\SELECT 9, "Ivanov", "U25", 490 UNION ALL
            \\SELECT 10, "Ivanov", "P91", 540 UNION ALL
            \\SELECT 11, "Silva", "U25", 550
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TEMP FUNCTION TimesTwo(arg1 INT64) AS (
            \\  arg1 * 2
            \\)
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TEMP AGGREGATE FUNCTION CountStar() AS (
            \\  COUNT(*)
            \\)
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TEMP AGGREGATE FUNCTION SumOfAggregateArgs(arg1 INT64) AS (
            \\  SUM(arg1)
            \\)
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TEMP AGGREGATE FUNCTION SumArg1BiggerThanArg2(arg1 INT64, arg2 INT64) AS (
            \\  SUM(arg1 WHERE arg1 > arg2)
            \\)
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TEMP AGGREGATE FUNCTION SumArg1BiggerThanArg2TimesTwo(arg1 INT64, arg2 INT64) AS (
            \\  TimesTwo(SUM(arg1 WHERE arg1 > arg2))
            \\)
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TEMP AGGREGATE FUNCTION TemplatedSumArg1BiggerThanArg2TimesTwo(arg1 ANY TYPE, arg2 ANY TYPE) AS (
            \\  TimesTwo(SUM(arg1 WHERE arg1 > arg2))
            \\)
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TEMP AGGREGATE FUNCTION MaxMinusMin(arg1 INT64) AS (
            \\  MAX(arg1) - MIN(arg1)
            \\)
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TEMP FUNCTION NullaryUdfContainingWhereFilterReturnsZero() AS (
            \\  (SELECT COUNT(* WHERE false) FROM UNNEST([1]))
            \\)
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TEMP FUNCTION TemplatedUdfContainingWhereFilterReturnsCount(arg ANY TYPE) AS (
            \\  (SELECT COUNT(arg WHERE true) FROM UNNEST([1]))
            \\)
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TABLE FUNCTION NoArgumentTvfContainingFilterReturnsOne() AS (
            \\  (SELECT COUNT(* WHERE x > 2) AS result FROM UNNEST([1,2,3]) AS x)
            \\)
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TABLE FUNCTION TemplatedTvfContainingFilterReturnsCountStar(arg_t ANY TABLE) AS (
            \\  SELECT COUNT(* WHERE true) AS result FROM arg_t
            \\)
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TEMP FUNCTION NullaryUdfContainingHavingFilterReturnsOne() AS (
            \\  (
            \\    SELECT
            \\      COUNT(* GROUP BY key HAVING SUM(value) = 2)
            \\    FROM UNNEST([
            \\      STRUCT(1 AS key, 2 AS value),
            \\      STRUCT(2 AS key, 1 AS value),
            \\      STRUCT(2 AS key, 0 AS value)
            \\    ])
            \\  )
            \\)
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TEMP AGGREGATE FUNCTION MaxPlusOne(value INT64) AS (
            \\  MAX(value) + 1
            \\)
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TEMP AGGREGATE FUNCTION FilteredMaxPlusOne(value INT64, filter_key INT64) AS (
            \\  MAX(value where filter_key < 40) + 1
            \\)
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TEMP AGGREGATE FUNCTION OnePlusSumOfMaxValuePerKey(value INT64, group_by_key INT64) AS (
            \\  SUM(MAX(value) + 1 GROUP BY group_by_key)
            \\)
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TEMP AGGREGATE FUNCTION NativeMax(value INT64) AS (
            \\  MAX(value)
            \\)
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TEMP AGGREGATE FUNCTION FilteredNativeMax(value INT64, filter_key INT64) AS (
            \\  MAX(value where filter_key < 40)
            \\)
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TEMP AGGREGATE FUNCTION DoubleFilteredMax(value INT64, filter_key INT64) AS (
            \\  NativeMax(value WHERE filter_key < 40) + FilteredNativeMax(value, filter_key)
            \\)
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TEMP FUNCTION TemplatedUdfContainingHavingFilterReturnsCount(arg ANY TYPE) AS (
            \\  (
            \\    SELECT
            \\      COUNT(arg GROUP BY key HAVING SUM(value) = 2)
            \\    FROM UNNEST([
            \\      STRUCT(1 AS key, 2 AS value),
            \\      STRUCT(2 AS key, 1 AS value)
            \\    ])
            \\  )
            \\)
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TEMP AGGREGATE FUNCTION KeysWithPositiveSumOfValues(key INT64, value INT64) AS (
            \\  ARRAY_AGG(key GROUP BY key HAVING SUM(value) > 0)
            \\)
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TEMP AGGREGATE FUNCTION TemplatedKeysWithPositiveSumOfValues(key ANY TYPE, value ANY TYPE) AS (
            \\  ARRAY_AGG(key GROUP BY key HAVING SUM(value) > 0)
            \\)
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TABLE FUNCTION NoArgumentTvfContainingHavingFilterReturnsOne() AS (
            \\  (
            \\    SELECT
            \\      COUNT(* GROUP BY key HAVING SUM(value) = 2) AS one
            \\    FROM UNNEST([
            \\      STRUCT(1 AS key, 2 AS value),
            \\      STRUCT(2 AS key, 1 AS value)
            \\    ])
            \\  )
            \\)
            ,
        },
        .{
            .desc = "prepare_database",
            .sql =
            \\CREATE TABLE FUNCTION TemplatedTvfContainingHavingFilterReturnsSumofSalaryValuesForEmployeesFiveAndSix(arg_t ANY TABLE) AS (
            \\  (
            \\    SELECT
            \\      SUM(SUM(arg_t.salary) GROUP BY arg_t.emp_id HAVING arg_t.emp_id >= 5) AS sum_salary
            \\    FROM arg_t
            \\  )
            \\)
            ,
        },
        .{
            .desc = "simple_filter",
            .unsupported_in_bigquery = "Aggregate function $COUNT_STAR/MAX contains a where clause and this is not supported (recidiviz-bigquery-sandbox, 2026-08-23)",
            .sql =
            \\# Filter is additional on top of the shared WHERE clause
            \\SELECT
            \\  dept_id,
            \\  count(* WHERE job = "Analyst") AS cnt_star_analyst,
            \\  count(salary WHERE job = "Analyst") AS cnt_analyst,
            \\  count(* WHERE job = "Manager") AS cnt_star_mgr,
            \\  count(salary WHERE job = "Manager") AS cnt_mgr,
            \\  count(*) AS cnt_star,
            \\  count(salary) AS cnt_salary,
            \\FROM Employees
            \\WHERE age < 40
            \\GROUP BY dept_id
            ,
            .unordered = true,
            .rows = .{
                .{ 101, 1, 1, 1, 1, 2, 2 },
                .{ 102, 2, 2, 0, 0, 2, 2 },
            },
        },
        .{
            .desc = "filter_with_mla",
            .sql =
            \\# Filter with multi-level aggregation
            \\SELECT
            \\  SUM(AVG(salary WHERE age < 40) GROUP BY dept_id),
            \\  SUM(AVG(salary WHERE age < 30) WHERE job = "Analyst" GROUP BY dept_id)
            \\FROM Employees
            ,
            .rows = .{
                .{ 190000, 150000 },
            },
        },
        .{
            .desc = "filter_with_having_min_max",
            .unsupported_in_bigquery = "Unsupported having modifier in the aggregate function array_agg (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  dept_id,
            \\  ARRAY_AGG(emp_id HAVING MIN age) AS unfiltered,
            \\  ARRAY_AGG(emp_id WHERE salary > 100000 HAVING MIN age) AS codes,
            \\FROM Employees
            \\WHERE age < 40
            \\GROUP BY dept_id
            ,
            .unordered = true,
            .rows = .{
                .{ 101, .{3}, .{3} },
                .{ 102, .{4}, null },
            },
        },
        .{
            .desc = "error_in_filter",
            .unsupported_in_bigquery = "Aggregate function $COUNT_STAR contains a where clause and this is not supported (recidiviz-bigquery-sandbox, 2026-08-23)",
            .sql =
            \\# Error: There's no way to escape this error: the filter needs to be evaluated
            \\# to even tell if the row is going to count in the aggregation:
            \\SELECT
            \\  dept_id,
            \\  count(* WHERE 1.0/(emp_id - 1) > 0) AS cnt,
            \\  max(salary) AS max_salary
            \\FROM Employees
            \\GROUP BY dept_id
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "escaped_error_in_filter",
            .unsupported_in_bigquery = "Aggregate function $COUNT_STAR contains a where clause and this is not supported (recidiviz-bigquery-sandbox, 2026-08-23)",
            .sql =
            \\# Error: There's no way to escape this calculation: the filter needs to be
            \\# evaluated to even tell if the row is going to count in the aggregation.
            \\# But we use SAFE_DIVIDE, so the query shouldn't fail.
            \\SELECT
            \\  dept_id,
            \\  count(* WHERE SAFE_DIVIDE(1.0, (emp_id - 1)) > 0) AS cnt,
            \\  max(salary) AS max_salary
            \\FROM Employees
            \\GROUP BY dept_id
            ,
            .unordered = true,
            .rows = .{
                .{ 101, 2, 200000 },
                .{ 102, 3, 180000 },
            },
        },
        .{
            .desc = "filter_with_multilevel",
            .sql =
            \\SELECT
            \\  dept_id,
            \\  ARRAY_AGG(MIN(emp_id) WHERE salary < 80000 GROUP BY job) AS arr,
            \\FROM Employees
            \\WHERE age < 40
            \\GROUP BY dept_id
            ,
            .unordered = true,
            .rows = .{
                .{ 101, .{5} },
                .{ 102, null },
            },
        },
        .{
            .desc = "filter_with_conditional_evaluation_error_in_chosen_branch",
            .unsupported_in_bigquery = "Aggregate function ARRAY_AGG contains a where clause and this is not supported, even nested inside an IF branch (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\# Ensure the branch with an error does fail the query
            \\SELECT
            \\  dept_id,
            \\  IF (SUM(salary) < 0,
            \\    [],
            \\    ARRAY_AGG(emp_id WHERE salary < cast('xyz' AS INT64))) AS arr,
            \\FROM Employees
            \\WHERE age < 40
            \\GROUP BY dept_id
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "filter_on_uda_1",
            .unsupported_in_bigquery = "BigQuery rejects any WHERE clause on an aggregate function call (\"Aggregate function <NAME> contains a where clause and this is not supported\", confirmed on COUNT_STAR/SUM/ARRAY_AGG, applies regardless of callee) (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  dept_id,
            \\  CountStar(WHERE job = "Analyst"),
            \\  SumOfAggregateArgs(age WHERE job = "Analyst"),
            \\  MaxMinusMin(age WHERE salary > 70000)
            \\FROM Employees
            \\GROUP BY 1
            \\ORDER BY 1, 2, 3, 4
            ,
            .rows = .{
                .{ 101, 1, 29, 17 },
                .{ 102, 2, 62, 17 },
            },
        },
        .{
            .desc = "filter_on_uda_2",
            .unsupported_in_bigquery = "BigQuery rejects any WHERE clause on an aggregate function call (\"Aggregate function <NAME> contains a where clause and this is not supported\", confirmed on COUNT_STAR/SUM/ARRAY_AGG, applies regardless of callee) (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  dept_id,
            \\  CountStar(WHERE true),
            \\  CountStar(WHERE false),
            \\  CountStar(WHERE job = "Analyst"),
            \\  CountStar(WHERE CAST(NULL as BOOL)),
            \\FROM Employees
            \\GROUP BY 1
            \\ORDER BY 1, 2, 3, 4, 5
            ,
            .rows = .{
                .{ 101, 3, 0, 1, 0 },
                .{ 102, 3, 0, 2, 0 },
            },
        },
        .{
            .desc = "filter_on_uda_containing_filter_in_body",
            .unsupported_in_bigquery = "BigQuery rejects any WHERE clause on an aggregate function call (\"Aggregate function <NAME> contains a where clause and this is not supported\", confirmed on COUNT_STAR/SUM/ARRAY_AGG, applies regardless of callee) (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  dept_id,
            \\  SumArg1BiggerThanArg2(salary, 75000 WHERE job = "Analyst"),
            \\  SumArg1BiggerThanArg2TimesTwo(salary, 75000 WHERE job = "Analyst")
            \\FROM Employees
            \\GROUP BY 1
            \\ORDER BY 1, 2, 3
            ,
            .rows = .{
                .{ 101, null, null },
                .{ 102, 160000, 320000 },
            },
        },
        .{
            .desc = "filter_on_templated_uda_containing_filter_in_body",
            .unsupported_in_bigquery = "BigQuery rejects any WHERE clause on an aggregate function call (\"Aggregate function <NAME> contains a where clause and this is not supported\", confirmed on COUNT_STAR/SUM/ARRAY_AGG, applies regardless of callee) (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  dept_id,
            \\  TemplatedSumArg1BiggerThanArg2TimesTwo(salary, 75000 WHERE job = "Analyst")
            \\FROM Employees
            \\GROUP BY 1
            \\ORDER BY 1, 2
            ,
            .rows = .{
                .{ 101, null },
                .{ 102, 320000 },
            },
        },
        .{
            .desc = "filter_inside_udf",
            .unsupported_in_bigquery = "\"Aggregate function $COUNT_STAR contains a where clause and this is not supported\" on the UDF's own COUNT(* WHERE false) body (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql = "SELECT NullaryUdfContainingWhereFilterReturnsZero()",
            .rows = .{
                .{0},
            },
        },
        .{
            .desc = "filter_inside_templated_udf",
            .unsupported_in_bigquery = "\"Aggregate function COUNT contains a where clause and this is not supported\" on the UDF's own COUNT(arg WHERE true) body (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql = "SELECT TemplatedUdfContainingWhereFilterReturnsCount(1)",
            .rows = .{
                .{1},
            },
        },
        .{
            .desc = "filter_inside_tvf",
            .unsupported_in_bigquery = "\"Aggregate function $COUNT_STAR contains a where clause and this is not supported\" on the TVF's own COUNT(* WHERE x > 2) body (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql = "SELECT * FROM NoArgumentTvfContainingFilterReturnsOne()",
            .rows = .{
                .{1},
            },
        },
        .{
            .desc = "filter_inside_templated_tvf",
            .unsupported_in_bigquery = "\"Aggregate function $COUNT_STAR contains a where clause and this is not supported\" on the TVF's own COUNT(* WHERE true) body (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql = "SELECT * FROM TemplatedTvfContainingFilterReturnsCountStar(TABLE Employees)",
            .rows = .{
                .{6},
            },
        },
        .{
            .desc = "having_filter",
            .sql =
            \\SELECT
            \\  dept_id,
            \\  SUM(COUNT(*) GROUP BY job HAVING job = "Manager"),
            \\  SUM(COUNT(*) GROUP BY job HAVING AVG(salary) > 100000),
            \\  SUM(COUNT(* WHERE age < 40) GROUP BY job HAVING AVG(salary) > 100000)
            \\FROM Employees
            \\GROUP BY 1
            \\ORDER BY 1, 2, 3, 4
            ,
            .rows = .{
                .{ 101, 2, 2, 1 },
                .{ 102, 1, 1, 0 },
            },
        },
        .{
            .desc = "having_filter_with_aggregate_clauses",
            .sql =
            \\SELECT
            \\  dept_id,
            \\  ARRAY_CONCAT_AGG(
            \\    ARRAY_AGG(emp_id ORDER BY emp_id)
            \\    GROUP BY job
            \\    HAVING AVG(salary) > 100000
            \\  )
            \\FROM Employees
            \\GROUP BY 1
            \\ORDER BY 1
            ,
            .rows = .{
                .{ 101, .{ 1, 3 } },
                .{ 102, .{2} },
            },
        },
        .{
            .desc = "having_filter_inside_udf",
            .unsupported_in_bigquery = "\"Function $count_star has both having expression and group by list. This is not supported in multi-level aggregation.\" on the UDF's own body (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql = "SELECT NullaryUdfContainingHavingFilterReturnsOne()",
            .rows = .{
                .{1},
            },
        },
        .{
            .desc = "having_filter_inside_templated_udf",
            .unsupported_in_bigquery = "\"Function count has both having expression and group by list. This is not supported in multi-level aggregation.\" on the UDF's own body (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql = "SELECT TemplatedUdfContainingHavingFilterReturnsCount(x) FROM UNNEST([1, 2]) AS x",
            .unordered = true,
            .rows = .{
                .{1},
                .{1},
            },
        },
        .{
            .desc = "having_filter_inside_uda",
            .unsupported_in_bigquery = "\"Function array_agg has both having expression and group by list. This is not supported in multi-level aggregation.\" on the UDA's own ARRAY_AGG(key GROUP BY key HAVING ...) body (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  KeysWithPositiveSumOfValues(key, value)
            \\FROM UNNEST([
            \\  STRUCT(1 AS key, -1 AS value), STRUCT(2 AS key, 1 AS value)
            \\])
            ,
            .rows = .{
                .{.{2}},
            },
        },
        .{
            .desc = "having_filter_inside_templated_uda",
            .unsupported_in_bigquery = "\"Function array_agg has both having expression and group by list. This is not supported in multi-level aggregation.\" on the UDA's own ARRAY_AGG(key GROUP BY key HAVING ...) body (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  TemplatedKeysWithPositiveSumOfValues(key, value)
            \\FROM UNNEST([
            \\  STRUCT(1 AS key, -1 AS value), STRUCT(2 AS key, 1 AS value)
            \\])
            ,
            .rows = .{
                .{.{2}},
            },
        },
        .{
            .desc = "having_filter_inside_tvf",
            .unsupported_in_bigquery = "\"Function $count_star has both having expression and group by list. This is not supported in multi-level aggregation.\" on the TVF's own body (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql = "SELECT * FROM NoArgumentTvfContainingHavingFilterReturnsOne()",
            .rows = .{
                .{1},
            },
        },
        .{
            .desc = "having_filter_inside_templated_tvf",
            .unsupported_in_bigquery = "\"Function sum has both having expression and group by list. This is not supported in multi-level aggregation.\" on the TVF's own SUM(SUM(...) GROUP BY ... HAVING ...) body (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql = "SELECT * FROM TemplatedTvfContainingHavingFilterReturnsSumofSalaryValuesForEmployeesFiveAndSix(TABLE Employees)",
            .rows = .{
                .{150000},
            },
        },
        .{
            .desc = "mla_with_uda_containing_filter",
            .sql =
            \\SELECT SUM(MaxPlusOne(salary WHERE age < 40 ) GROUP BY status_code)
            \\FROM Employees
            ,
            .rows = .{
                .{310003},
            },
        },
        .{
            .desc = "filtered_mla_with_uda",
            .sql =
            \\SELECT
            \\  SUM(FilteredMaxPlusOne(salary, age) GROUP BY status_code),
            \\  SUM(FilteredMaxPlusOne(salary, age WHERE dept_id = 101) GROUP BY status_code)
            \\FROM Employees
            ,
            .rows = .{
                .{ 310003, 150001 },
            },
        },
        .{
            .desc = "uda_with_filter_calling_mla",
            .unsupported_in_bigquery = "BigQuery rejects any WHERE clause on an aggregate function call (\"Aggregate function <NAME> contains a where clause and this is not supported\", confirmed on COUNT_STAR/SUM/ARRAY_AGG, applies regardless of callee) (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  OnePlusSumOfMaxValuePerKey(salary, status_code),
            \\  OnePlusSumOfMaxValuePerKey(salary, status_code WHERE age < 40)
            \\FROM Employees
            ,
            .rows = .{
                .{ 530003, 310003 },
            },
        },
        .{
            .desc = "nested_udas",
            .unsupported_in_bigquery = "BigQuery rejects any WHERE clause on an aggregate function call (\"Aggregate function <NAME> contains a where clause and this is not supported\", confirmed on COUNT_STAR/SUM/ARRAY_AGG, applies regardless of callee) (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql =
            \\SELECT
            \\  DoubleFilteredMax(salary, age),
            \\  DoubleFilteredMax(salary, age WHERE status_code = 1)
            \\FROM Employees
            ,
            .rows = .{
                .{ 300000, 160000 },
            },
        },
    },
}
