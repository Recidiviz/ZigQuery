// Imported from GoogleSQL's own compliance-testdata suite
// (third_party/googlesql/googlesql/compliance/testdata, Apache-2.0).
.{
    .spec = "googlesql/compliance/orderby_collate_queries",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/googlesql/compliance/testdata/orderby_collate_queries.test",
    .cases = .{
        .{
            .desc = "prepare_database",
            .sql =
            \\# For more information on COLLATE semantics in GoogleSQL,
            \\# see (broken link).
            \\# Base tables for order by collate test.
            \\CREATE TABLE StringTable AS
            \\SELECT 1 primary_Key, "" col UNION ALL
            \\SELECT 2, "hello" UNION ALL
            \\SELECT 3, "Case sensitive" UNION ALL
            \\SELECT 4, "@" UNION ALL
            \\SELECT 5, "\u205Fabc" UNION ALL
            \\SELECT 6, "B" UNION ALL
            \\SELECT 7, NULL UNION ALL
            \\SELECT 8, "aa" UNION ALL
            \\SELECT 9, "@" UNION ALL
            \\SELECT 10, "" UNION ALL
            \\SELECT 11, "a" UNION ALL
            \\SELECT 12, "case sensitive" UNION ALL
            \\SELECT 13, NULL UNION ALL
            \\SELECT 14, "hello" UNION ALL
            \\select 15, "\u0413"
            ,
        },
        .{
            .desc = "orderby_without_collate",
            .sql = "select primary_key, col from StringTable ORDER BY col",
            .unordered = true,
            .rows = .{
                .{ 7, null },
                .{ 13, null },
                .{ 10, "" },
                .{ 1, "" },
                .{ 4, "@" },
                .{ 9, "@" },
                .{ 6, "B" },
                .{ 3, "Case sensitive" },
                .{ 11, "a" },
                .{ 8, "aa" },
                .{ 12, "case sensitive" },
                .{ 2, "hello" },
                .{ 14, "hello" },
                .{ 15, "Г" },
                .{ 5, " abc" },
            },
        },
        .{
            .desc = "orderby_collate_binary",
            .unsupported_in_bigquery = "\"COLLATE is not supported\" in ORDER BY (recidiviz-bigquery-sandbox, 2026-08-23)",
            .sql =
            \\# Unicode binary (codepoint) collation. Results are same as the label
            \\# orderby_without_collate.
            \\select primary_key, col from StringTable ORDER BY col COLLATE "binary"
            ,
            .unordered = true,
            .rows = .{
                .{ 7, null },
                .{ 13, null },
                .{ 10, "" },
                .{ 1, "" },
                .{ 4, "@" },
                .{ 9, "@" },
                .{ 6, "B" },
                .{ 3, "Case sensitive" },
                .{ 11, "a" },
                .{ 8, "aa" },
                .{ 12, "case sensitive" },
                .{ 2, "hello" },
                .{ 14, "hello" },
                .{ 15, "Г" },
                .{ 5, " abc" },
            },
        },
        .{
            .desc = "order_by_collate_english",
            .unsupported_in_bigquery = "\"COLLATE is not supported\" in ORDER BY (recidiviz-bigquery-sandbox, 2026-08-23)",
            .sql =
            \\# NOTE: In the default UTF-8 ascii comparison (see label
            \\# orderby_without_collate) upper case comes first (i.e. 'B' < 'a') whereas in
            \\# the collation defined order lower case comes first (i.e. 'B' > 'a').
            \\select primary_key, col from StringTable ORDER BY col COLLATE "en", 1 ASC
            ,
            .rows = .{
                .{ 7, null },
                .{ 13, null },
                .{ 1, "" },
                .{ 10, "" },
                .{ 5, " abc" },
                .{ 4, "@" },
                .{ 9, "@" },
                .{ 11, "a" },
                .{ 8, "aa" },
                .{ 6, "B" },
                .{ 12, "case sensitive" },
                .{ 3, "Case sensitive" },
                .{ 2, "hello" },
                .{ 14, "hello" },
                .{ 15, "Г" },
            },
        },
        .{
            .desc = "orderby_collate_english_US",
            .unsupported_in_bigquery = "\"COLLATE is not supported\" in ORDER BY (recidiviz-bigquery-sandbox, 2026-08-23)",
            .sql =
            \\select primary_key, col
            \\from StringTable
            \\ORDER BY col COLLATE "en_US" DESC, primary_key ASC
            ,
            .rows = .{
                .{ 15, "Г" },
                .{ 2, "hello" },
                .{ 14, "hello" },
                .{ 3, "Case sensitive" },
                .{ 12, "case sensitive" },
                .{ 6, "B" },
                .{ 8, "aa" },
                .{ 11, "a" },
                .{ 4, "@" },
                .{ 9, "@" },
                .{ 5, " abc" },
                .{ 1, "" },
                .{ 10, "" },
                .{ 7, null },
                .{ 13, null },
            },
        },
        .{
            .desc = "orderby_collate_english_US_case_sensitive_ascending",
            .unsupported_in_bigquery = "\"COLLATE is not supported\" in ORDER BY (recidiviz-bigquery-sandbox, 2026-08-23)",
            .sql =
            \\# All of aa/aA/Aa/AA orders before all of ab/aB/Ab/AB regardless of case.
            \\# Within aa/aA/Aa/AA, lower case 'a' orders before upper case 'A'.
            \\# Test ASC.
            \\SELECT s.str, s.int
            \\FROM
            \\UNNEST(ARRAY<STRUCT<str STRING, int INT64>>[
            \\       ("aB", 6),
            \\       ("AB", 11),
            \\       ("AC", 2),
            \\       ("aA", 3),
            \\       ("a", 8),
            \\       ("ac", 4),
            \\       ("ab", 9),
            \\       ("Ac", 12),
            \\       ("Aa", 5),
            \\       ("Ab", 1),
            \\       ("aC", 7),
            \\       ("aa", 13),
            \\       ("AA", 10)]) AS s
            \\ORDER BY 1 COLLATE "en_US:cs" ASC, 2 ASC
            ,
            .rows = .{
                .{ "a", 8 },
                .{ "aa", 13 },
                .{ "aA", 3 },
                .{ "Aa", 5 },
                .{ "AA", 10 },
                .{ "ab", 9 },
                .{ "aB", 6 },
                .{ "Ab", 1 },
                .{ "AB", 11 },
                .{ "ac", 4 },
                .{ "aC", 7 },
                .{ "Ac", 12 },
                .{ "AC", 2 },
            },
        },
        .{
            .desc = "orderby_collate_english_US_case_sensitive_descending",
            .unsupported_in_bigquery = "\"COLLATE is not supported\" in ORDER BY (recidiviz-bigquery-sandbox, 2026-08-23)",
            .sql =
            \\# Test DESC.
            \\SELECT s.str, s.int
            \\FROM
            \\UNNEST(ARRAY<STRUCT<str STRING, int INT64>>[
            \\       ("aB", 6),
            \\       ("AB", 11),
            \\       ("AC", 2),
            \\       ("aA", 3),
            \\       ("a", 8),
            \\       ("ac", 4),
            \\       ("ab", 9),
            \\       ("Ac", 12),
            \\       ("Aa", 5),
            \\       ("Ab", 1),
            \\       ("aC", 7),
            \\       ("aa", 13),
            \\       ("AA", 10)]) AS s
            \\ORDER BY 1 COLLATE "en_US:cs" DESC, 2 ASC
            ,
            .rows = .{
                .{ "AC", 2 },
                .{ "Ac", 12 },
                .{ "aC", 7 },
                .{ "ac", 4 },
                .{ "AB", 11 },
                .{ "Ab", 1 },
                .{ "aB", 6 },
                .{ "ab", 9 },
                .{ "AA", 10 },
                .{ "Aa", 5 },
                .{ "aA", 3 },
                .{ "aa", 13 },
                .{ "a", 8 },
            },
        },
        .{
            .desc = "orderby_collate_english_US_default_is_case_sensitive_ascending",
            .unsupported_in_bigquery = "\"COLLATE is not supported\" in ORDER BY (recidiviz-bigquery-sandbox, 2026-08-23)",
            .sql =
            \\# The default "en_US" in this test is the same as "en_US:cs" in the previous
            \\# tests.
            \\# Test ASC.
            \\SELECT s.str, s.int
            \\FROM
            \\UNNEST(ARRAY<STRUCT<str STRING, int INT64>>[
            \\       ("aB", 6),
            \\       ("AB", 11),
            \\       ("AC", 2),
            \\       ("aA", 3),
            \\       ("a", 8),
            \\       ("ac", 4),
            \\       ("ab", 9),
            \\       ("Ac", 12),
            \\       ("Aa", 5),
            \\       ("Ab", 1),
            \\       ("aC", 7),
            \\       ("aa", 13),
            \\       ("AA", 10)]) AS s
            \\ORDER BY 1 COLLATE "en_US" ASC, 2 ASC
            ,
            .rows = .{
                .{ "a", 8 },
                .{ "aa", 13 },
                .{ "aA", 3 },
                .{ "Aa", 5 },
                .{ "AA", 10 },
                .{ "ab", 9 },
                .{ "aB", 6 },
                .{ "Ab", 1 },
                .{ "AB", 11 },
                .{ "ac", 4 },
                .{ "aC", 7 },
                .{ "Ac", 12 },
                .{ "AC", 2 },
            },
        },
        .{
            .desc = "orderby_collate_english_US_default_is_case_sensitive_descending",
            .unsupported_in_bigquery = "\"COLLATE is not supported\" in ORDER BY (recidiviz-bigquery-sandbox, 2026-08-23)",
            .sql =
            \\# Test DESC.
            \\SELECT s.str, s.int
            \\FROM
            \\UNNEST(ARRAY<STRUCT<str STRING, int INT64>>[
            \\       ("aB", 6),
            \\       ("AB", 11),
            \\       ("AC", 2),
            \\       ("aA", 3),
            \\       ("a", 8),
            \\       ("ac", 4),
            \\       ("ab", 9),
            \\       ("Ac", 12),
            \\       ("Aa", 5),
            \\       ("Ab", 1),
            \\       ("aC", 7),
            \\       ("aa", 13),
            \\       ("AA", 10)]) AS s
            \\ORDER BY 1 COLLATE "en_US" DESC, 2 ASC
            ,
            .rows = .{
                .{ "AC", 2 },
                .{ "Ac", 12 },
                .{ "aC", 7 },
                .{ "ac", 4 },
                .{ "AB", 11 },
                .{ "Ab", 1 },
                .{ "aB", 6 },
                .{ "ab", 9 },
                .{ "AA", 10 },
                .{ "Aa", 5 },
                .{ "aA", 3 },
                .{ "aa", 13 },
                .{ "a", 8 },
            },
        },
        .{
            .desc = "orderby_collate_english_US_case_insensitive_ascending",
            .unsupported_in_bigquery = "\"COLLATE is not supported\" in ORDER BY (recidiviz-bigquery-sandbox, 2026-08-23)",
            .sql =
            \\SELECT s.str, s.int
            \\FROM
            \\UNNEST(ARRAY<STRUCT<str STRING, int INT64>>[
            \\       ("aB", 6),
            \\       ("AB", 11),
            \\       ("AC", 2),
            \\       ("aA", 3),
            \\       ("a", 8),
            \\       ("ac", 4),
            \\       ("ab", 9),
            \\       ("Ac", 12),
            \\       ("Aa", 5),
            \\       ("Ab", 1),
            \\       ("aC", 7),
            \\       ("aa", 13),
            \\       ("AA", 10)]) AS s
            \\ORDER BY 1 COLLATE "en_US:ci" ASC, 2 ASC
            ,
            .rows = .{
                .{ "a", 8 },
                .{ "aA", 3 },
                .{ "Aa", 5 },
                .{ "AA", 10 },
                .{ "aa", 13 },
                .{ "Ab", 1 },
                .{ "aB", 6 },
                .{ "ab", 9 },
                .{ "AB", 11 },
                .{ "AC", 2 },
                .{ "ac", 4 },
                .{ "aC", 7 },
                .{ "Ac", 12 },
            },
        },
        .{
            .desc = "orderby_collate_english_US_case_insensitive_descending",
            .unsupported_in_bigquery = "\"COLLATE is not supported\" in ORDER BY (recidiviz-bigquery-sandbox, 2026-08-23)",
            .sql =
            \\SELECT s.str, s.int
            \\FROM
            \\UNNEST(ARRAY<STRUCT<str STRING, int INT64>>[
            \\       ("Ab", 1),
            \\       ("aA", 3),
            \\       ("Ac", 12),
            \\       ("AB", 11),
            \\       ("a", 8),
            \\       ("ac", 4),
            \\       ("Aa", 5),
            \\       ("aC", 7),
            \\       ("aB", 6),
            \\       ("AC", 2),
            \\       ("aa", 13),
            \\       ("ab", 9),
            \\       ("AA", 10)]) AS s
            \\ORDER BY 1 COLLATE "en_US:ci" DESC, 2 ASC
            ,
            .rows = .{
                .{ "AC", 2 },
                .{ "ac", 4 },
                .{ "aC", 7 },
                .{ "Ac", 12 },
                .{ "Ab", 1 },
                .{ "aB", 6 },
                .{ "ab", 9 },
                .{ "AB", 11 },
                .{ "aA", 3 },
                .{ "Aa", 5 },
                .{ "AA", 10 },
                .{ "aa", 13 },
                .{ "a", 8 },
            },
        },
        .{
            .desc = "orderby_collate_czech",
            .unsupported_in_bigquery = "\"COLLATE is not supported\" in ORDER BY (recidiviz-bigquery-sandbox, 2026-08-23)",
            .sql =
            \\select primary_key, col
            \\from (select 1 primary_key, "c" col UNION ALL
            \\      select 2, "cg" UNION ALL
            \\      select 3, "ch" UNION ALL
            \\      select 4, "ci" UNION ALL
            \\      select 5, "h")
            \\ORDER BY col COLLATE "cs"
            ,
            .rows = .{
                .{ 1, "c" },
                .{ 2, "cg" },
                .{ 4, "ci" },
                .{ 5, "h" },
                .{ 3, "ch" },
            },
        },
        .{
            .desc = "orderby_collate_german",
            .unsupported_in_bigquery = "\"COLLATE is not supported\" in ORDER BY (recidiviz-bigquery-sandbox, 2026-08-23)",
            .sql =
            \\# In german language 'ss' is equal to 'ß'.
            \\select primary_key, col
            \\from (select 1 primary_key, "ßd" col UNION ALL
            \\      select 2, "ssc" UNION ALL
            \\      select 3, "ßb" UNION ALL
            \\      select 4, "ssa")
            \\ORDER BY col COLLATE "de"
            ,
            .rows = .{
                .{ 4, "ssa" },
                .{ 3, "ßb" },
                .{ 2, "ssc" },
                .{ 1, "ßd" },
            },
        },
        .{
            .desc = "orderby_collate_german_english",
            .unsupported_in_bigquery = "\"COLLATE is not supported\" in ORDER BY (recidiviz-bigquery-sandbox, 2026-08-23)",
            .sql =
            \\select primary_key, col
            \\from (select 1 primary_key, "ßß" col UNION ALL
            \\      select 2, "ßss" UNION ALL
            \\      select 3, "ssß" UNION ALL
            \\      select 4, "ssss")
            \\ORDER BY col COLLATE "de", col COLLATE "en"
            ,
            .rows = .{
                .{ 4, "ssss" },
                .{ 3, "ssß" },
                .{ 2, "ßss" },
                .{ 1, "ßß" },
            },
        },
        .{
            .desc = "orderby_collate_und_ci",
            .unsupported_in_bigquery = "\"COLLATE is not supported\" in ORDER BY (recidiviz-bigquery-sandbox, 2026-08-23)",
            .sql =
            \\select primary_key, col
            \\from (select 1 primary_key, "Ca" col UNION ALL
            \\      select 2, "ca" UNION ALL
            \\      select 3, "Cb" UNION ALL
            \\      select 4, "cb")
            \\ORDER BY col COLLATE "und:ci"
            ,
            .unordered = true,
            .rows = .{
                .{ 2, "ca" },
                .{ 1, "Ca" },
                .{ 4, "cb" },
                .{ 3, "Cb" },
            },
        },
        .{
            .desc = "orderby_collate_binary_cs_is_an_error",
            .unsupported_in_bigquery = "\"COLLATE is not supported\" in ORDER BY (recidiviz-bigquery-sandbox, 2026-08-23)",
            .sql =
            \\select primary_key, col
            \\from (select 1 primary_key, "Ca" col UNION ALL
            \\      select 2, "ca" UNION ALL
            \\      select 3, "Cb" UNION ALL
            \\      select 4, "cb")
            \\ORDER BY col COLLATE "binary:cs"
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "orderby_collate_und_cs_cs_is_an_error",
            .unsupported_in_bigquery = "\"COLLATE is not supported\" in ORDER BY (recidiviz-bigquery-sandbox, 2026-08-23)",
            .sql =
            \\select primary_key, col
            \\from (select 1 primary_key, "Ca" col UNION ALL
            \\      select 2, "ca" UNION ALL
            \\      select 3, "Cb" UNION ALL
            \\      select 4, "cb")
            \\ORDER BY col COLLATE "und:cs:cs"
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "orderby_collate_disallow_legacy_unicode_collation_with_feature",
            .unsupported_in_bigquery = "\"COLLATE is not supported\" in ORDER BY (recidiviz-bigquery-sandbox, 2026-08-23)",
            .sql =
            \\select primary_key, col
            \\from (select 1 primary_key, "Ca" col UNION ALL
            \\      select 2, "ca" UNION ALL
            \\      select 3, "Cb" UNION ALL
            \\      select 4, "cb")
            \\ORDER BY col COLLATE "unicode:ci"
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "orderby_collate_disallow_legacy_unicode_collation_without_feature",
            .unsupported_in_bigquery = "\"COLLATE is not supported\" in ORDER BY (recidiviz-bigquery-sandbox, 2026-08-23)",
            .sql =
            \\select primary_key, col
            \\from (select 1 primary_key, "Ca" col UNION ALL
            \\      select 2, "ca" UNION ALL
            \\      select 3, "Cb" UNION ALL
            \\      select 4, "cb")
            \\ORDER BY col COLLATE "unicode:ci"
            ,
            .unordered = true,
            .rows = .{
                .{ 2, "ca" },
                .{ 1, "Ca" },
                .{ 4, "cb" },
                .{ 3, "Cb" },
            },
        },
        .{
            .desc = "collation_does_not_cause_nondeterminism_for_identical_strings",
            .unsupported_in_bigquery = "\"COLLATE is not supported\" in ORDER BY (recidiviz-bigquery-sandbox, 2026-08-23)",
            .sql =
            \\SELECT count(*)
            \\FROM (
            \\  SELECT s
            \\  FROM UNNEST(["a", "a", "b"]) AS s
            \\  ORDER BY s COLLATE "und:ci"
            \\)
            ,
            .rows = .{
                .{3},
            },
        },
        .{
            .desc = "nondeterminism_detected_with_collation",
            .unsupported_in_bigquery = "\"COLLATE is not supported\" in ORDER BY (recidiviz-bigquery-sandbox, 2026-08-23)",
            .sql =
            \\SELECT count(*)
            \\FROM (
            \\  SELECT s
            \\  FROM UNNEST(["a", "A", "b"]) AS s
            \\  ORDER BY s COLLATE "und:ci"
            \\)
            ,
            .rows = .{
                .{3},
            },
        },
    },
}
