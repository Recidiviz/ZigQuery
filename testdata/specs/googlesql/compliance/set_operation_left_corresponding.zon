            ,
            .rows = .{},
        },
        .{
            .desc = "left_corresponding_second_input_padded_null_except_all_2row_different_row",
            .unsupported_in_bigquery = "only DISTINCT mode is supported for EXCEPT/INTERSECT with CORRESPONDING (recidiviz-bigquery-sandbox, 2026-08-23)",
            .sql =
