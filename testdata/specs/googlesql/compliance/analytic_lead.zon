                .{ 3, null },
                .{ 4, null },
                .{ 5, null },
                .{ 6, null },
                .{ 7, null },
                .{ 8, null },
                .{ 9, null },
                .{ 10, null },
            },
        },
        .{
            .desc = "lead_bool",
            .sql =
            \\SELECT row_id, bool_val,
            \\       LEAD(bool_val, 1, false) OVER test_window,
            \\       LEAD(bool_val, 2) OVER test_window
            \\FROM TestTable
            \\WINDOW test_window AS (ORDER BY row_id)
            ,
            .unordered = true,
            .rows = .{
                .{ 1, null, true, false },
                .{ 2, true, false, true },
                .{ 3, false, true, false },
                .{ 4, true, false, true },
                .{ 5, false, true, false },
                .{ 6, true, false, true },
                .{ 7, false, true, false },
                .{ 8, true, false, true },
                .{ 9, false, true, null },
                .{ 10, true, false, null },
            },
        },
        .{
            .desc = "lead_int32_uint32",
            .sql =
            \\SELECT row_id, int32_val,
            \\       LEAD(int32_val, 5, -1) OVER test_window,
            \\       LEAD(CAST(int32_val as uint32), 2, 100000) OVER test_window
            \\FROM TestTable
            \\WINDOW test_window AS (ORDER BY row_id DESC)
            \\ORDER BY row_id DESC
            ,
            .rows = .{
                .{ 10, 1, 3, 2 },
                .{ 9, 3, 2, 5 },
                .{ 8, 2, 6, 2 },
                .{ 7, 5, null, 3 },
                .{ 6, 2, null, 2 },
                .{ 5, 3, -1, 6 },
                .{ 4, 2, -1, null },
                .{ 3, 6, -1, null },
                .{ 2, null, -1, 100000 },
                .{ 1, null, -1, 100000 },
            },
        },
        .{
            .desc = "lead_int64_uint64",
            .sql =
            \\SELECT row_id, int64_val,
            \\       LEAD(int64_val * 2, 6, 9223372036854775807) OVER test_window,
