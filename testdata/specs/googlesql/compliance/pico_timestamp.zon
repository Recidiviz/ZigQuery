// Imported from GoogleSQL's own compliance-testdata suite
// (third_party/googlesql/googlesql/compliance/testdata, Apache-2.0).
.{
    .spec = "googlesql/compliance/pico_timestamp",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/googlesql/compliance/testdata/pico_timestamp.test",
    .unsupported_in_bigquery = "picosecond-precision TIMESTAMP literals error \"Invalid TIMESTAMP literal\"; PARSE_TIMESTAMP's `precision` named argument and the STRUCT braced-constructor syntax are also rejected (recidiviz-bigquery-sandbox, 2026-08-23)",
    .cases = .{
        .{
            .desc = "select_pico",
            .sql = "SELECT TIMESTAMP '2123-01-02 04:05:06.123456789123+00'",
            .rows = .{
                .{"2123-01-02 04:05:06.123456789123+00"},
            },
        },
        .{
            .desc = "select_pico_with_timezone",
            .sql = "SELECT TIMESTAMP '2123-01-02 04:05:06.123456789123+07:30'",
            .rows = .{
                .{"2123-01-01 20:35:06.123456789123+00"},
            },
        },
        .{
            .desc = "select_nested_pico",
            .sql = "SELECT STRUCT{f1: TIMESTAMP '2123-01-02 04:05:06.123456789123+00', f2: [TIMESTAMP '2123-01-02 04:05:06.123456789123+00']}",
            .rows = .{
                .{.{ "2123-01-02 04:05:06.123456789123+00", .{"2123-01-02 04:05:06.123456789123+00"} }},
            },
        },
        .{
            .desc = "to_json_pico",
            .sql =
            \\SELECT TO_JSON(TIMESTAMP '2020-03-22 12:00:29.123456789012-07:00'),
            \\       TO_JSON(TIMESTAMP '2020-03-22 12:00:29.123456789012Z'),
            \\       TO_JSON(TIMESTAMP '2020-03-22 12:00:29.12345678Z'),
            ,
            .rows = .{
                .{ "2020-03-22T19:00:29.123456789012Z", "2020-03-22T12:00:29.123456789012Z", "2020-03-22T12:00:29.123456780Z" },
            },
        },
        .{
            .desc = "timestamp_add_sub_picos",
            .sql =
            \\SELECT TIMESTAMP_ADD(TIMESTAMP '2020-03-22 12:00:29.123456789012Z', INTERVAL 1 DAY),
            \\       TIMESTAMP_ADD(TIMESTAMP '2020-03-22 12:00:29.123456789012Z', INTERVAL 1 SECOND),
            \\       TIMESTAMP_ADD(TIMESTAMP '2020-03-22 12:00:29.123456789012Z', INTERVAL 1 MICROSECOND),
            \\       TIMESTAMP_SUB(TIMESTAMP '2020-03-22 12:00:29.123456789012Z', INTERVAL 1 DAY),
            \\       TIMESTAMP_SUB(TIMESTAMP '2020-03-22 12:00:29.123456789012Z', INTERVAL 1 SECOND),
            \\       TIMESTAMP_SUB(TIMESTAMP '2020-03-22 12:00:29.123456789012Z', INTERVAL 1 MICROSECOND),
            ,
            .rows = .{
                .{ "2020-03-23 12:00:29.123456789012+00", "2020-03-22 12:00:30.123456789012+00", "2020-03-22 12:00:29.123457789012+00", "2020-03-21 12:00:29.123456789012+00", "2020-03-22 12:00:28.123456789012+00", "2020-03-22 12:00:29.123455789012+00" },
            },
        },
        .{
            .desc = "timestamp_diff_picos",
            .sql =
            \\SELECT TIMESTAMP_DIFF(t1, t2, DAY),
            \\       TIMESTAMP_DIFF(t1, t2, MICROSECOND),
            \\       TIMESTAMP_DIFF(t1, t2, PICOSECOND)
            \\FROM (SELECT TIMESTAMP '2020-03-22 12:00:29.123456789012Z' AS t1,
            \\             TIMESTAMP '2020-03-21 12:00:29.123456789012Z' AS t2)
            ,
            .rows = .{
                .{ 1, 86400000000, 86400000000000000 },
            },
        },
        .{
            .desc = "timestamp_diff_picos_overflow",
            .sql =
            \\SELECT TIMESTAMP_DIFF(t1, t2, PICOSECOND),
            \\FROM (SELECT TIMESTAMP '9999-12-31 12:31:59.999999999999Z' AS t1,
            \\             TIMESTAMP '0001-01-01 01:00:00.123456789012Z' AS t2)
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "timestamp_trunc_picos",
            .sql =
            \\SELECT TIMESTAMP_TRUNC(t1, PICOSECOND),
            \\       TIMESTAMP_TRUNC(t1, NANOSECOND),
            \\       TIMESTAMP_TRUNC(t1, MICROSECOND),
            \\       TIMESTAMP_TRUNC(t1, MILLISECOND),
            \\       TIMESTAMP_TRUNC(t1, SECOND)
            \\FROM (SELECT TIMESTAMP '2020-03-22 12:00:29.123456789012Z' AS t1)
            ,
            .rows = .{
                .{ "2020-03-22 12:00:29.123456789012+00", "2020-03-22 12:00:29.123456789+00", "2020-03-22 12:00:29.123456+00", "2020-03-22 12:00:29.123+00", "2020-03-22 12:00:29+00" },
            },
        },
        .{
            .desc = "parse_timestamp_truncates_beyond_precision",
            .sql =
            \\# Here picos is part of the required features, and there's no engine override
            \\# to the default, so it's set to 12. Any digits beyond that are truncated.
            \\select parse_timestamp("%Y-%m-%dT%H:%M:%E*S%Ez", "2017-01-01T13:54:59.123456789012345Z")
            ,
            .rows = .{
                .{"2017-01-01 13:54:59.123456789012+00"},
            },
        },
        .{
            .desc = "parse_timestamp_with_explicit_precision",
            .sql = "select parse_timestamp(\"%Y-%m-%dT%H:%M:%E*S%Ez\", \"2017-01-01T13:54:59.123Z\", precision => 3)",
            .rows = .{
                .{"2017-01-01 13:54:59.123+00"},
            },
        },
        .{
            .desc = "parse_timestamp_with_explicit_precision_too_many_digits",
            .sql =
            \\# Truncates because of E*S
            \\select parse_timestamp("%Y-%m-%dT%H:%M:%E*S%Ez", "2017-01-01T13:54:59.123456Z", precision => 3)
            ,
            .rows = .{
                .{"2017-01-01 13:54:59.123+00"},
            },
        },
        .{
            .desc = "parse_timestamp_with_explicit_precision_too_many_digits_strict",
            .sql =
            \\# Error because of the specific precision %E3S
            \\select parse_timestamp("%Y-%m-%dT%H:%M:%E3S%Ez", "2017-01-01T13:54:59.123456Z", precision => 6)
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "parse_timestamp_with_explicit_precision_too_many_digits_strict_with_safe",
            .sql =
            \\# Error because of the specific precision, but SAFE returns NULL
            \\select safe.parse_timestamp("%Y-%m-%dT%H:%M:%E3S%Ez", "2017-01-01T13:54:59.123456Z", precision => 6)
            ,
            .rows = .{
                .{null},
            },
        },
        .{
            .desc = "parse_timestamp_with_explicit_precision_fewer_digits",
            .sql = "select parse_timestamp(\"%Y-%m-%dT%H:%M:%E*S%Ez\", \"2017-01-01T13:54:59.1Z\", precision => 3)",
            .rows = .{
                .{"2017-01-01 13:54:59.100+00"},
            },
        },
        .{
            .desc = "parse_timestamp_with_explicit_precision_format_string_requires_too_many",
            .sql = "select parse_timestamp(\"%Y-%m-%dT%H:%M:%E6S%Ez\", \"2017-01-01T13:54:59.123Z\", precision => 3)",
            .expect_error_any = true,
        },
        .{
            .desc = "parse_timestamp_with_explicit_precision_format_string_requires_too_many_with_safe",
            .sql = "select safe.parse_timestamp(\"%Y-%m-%dT%H:%M:%E6S%Ez\", \"2017-01-01T13:54:59.123Z\", precision => 3)",
            .rows = .{
                .{null},
            },
        },
        .{
            .desc = "parse_timestamp_with_invalid_time_zone",
            .sql = "select parse_timestamp(\"%Y-%m-%dT%H:%M:%E*S%Ez\", \"2017-01-01T13:54:59.123456789012Z\", precision => 12, timezone => \"invalid_time_zone\")",
            .expect_error_any = true,
        },
        .{
            .desc = "parse_timestamp_with_invalid_empty_time_zone",
            .sql = "select parse_timestamp(\"%Y-%m-%dT%H:%M:%E*S%Ez\", \"2017-01-01T13:54:59.123456789012Z\", precision => 12, timezone => \"\")",
            .expect_error_any = true,
        },
        .{
            .desc = "timestamp_parse_format_picos_roundtrip",
            .sql =
            \\select format_timestamp("%Y-%m-%dT%H:%M:%E12S%Ez", parse_timestamp("%Y-%m-%dT%H:%M:%E12S%Ez", "2000-01-01T00:00:00.123456789012Z", precision => 12)),
            \\       format_timestamp("%Y-%m-%dT%H:%M:%E*S%Ez", parse_timestamp("%Y-%m-%dT%H:%M:%E*S%Ez", "2000-01-01T00:00:00.123456789012Z", precision => 12)),
            \\       format_timestamp("%Y-%m-%dT%H:%M:%E12S%Ez", parse_timestamp("%Y-%m-%dT%H:%M:%E12S%Ez", "1969-01-01T00:00:00.123456789012Z", precision => 12)),
            \\       format_timestamp("%Y-%m-%dT%H:%M:%E*S%Ez", parse_timestamp("%Y-%m-%dT%H:%M:%E*S%Ez", "1969-01-01T00:00:00.123456789012Z", precision => 12)),
            \\       # With trailing zeroes, precision => 12
            \\       format_timestamp("%Y-%m-%dT%H:%M:%E12S%Ez", parse_timestamp("%Y-%m-%dT%H:%M:%E12S%Ez", "1969-01-01T00:00:00.123456789000Z", precision => 12)),
            \\       format_timestamp("%Y-%m-%dT%H:%M:%E*S%Ez", parse_timestamp("%Y-%m-%dT%H:%M:%E*S%Ez", "1969-01-01T00:00:00.123456789100Z", precision => 12))
            ,
            .rows = .{
                .{ "1999-12-31T16:00:00.123456789012-08:00", "1999-12-31T16:00:00.123456789012-08:00", "1968-12-31T16:00:00.123456789012-08:00", "1968-12-31T16:00:00.123456789012-08:00", "1968-12-31T16:00:00.123456789000-08:00", "1968-12-31T16:00:00.1234567891-08:00" },
            },
        },
        .{
            .desc = "timestamp_parse_format_picos_roundtrip_with_timezone",
            .sql =
            \\select format_timestamp("%Y-%m-%dT%H:%M:%E12S%Ez", parse_timestamp("%Y-%m-%dT%H:%M:%E12S%Ez", "2000-01-01T00:00:00.123456789012Z", precision => 12, timezone => "UTC")),
            \\       format_timestamp("%Y-%m-%dT%H:%M:%E*S%Ez", parse_timestamp("%Y-%m-%dT%H:%M:%E*S%Ez", "2000-01-01T00:00:00.123456789012Z", precision => 12, timezone => "UTC")),
            \\       format_timestamp("%Y-%m-%dT%H:%M:%E12S%Ez", parse_timestamp("%Y-%m-%dT%H:%M:%E12S%Ez", "1969-01-01T00:00:00.123456789012Z", precision => 12, timezone => "UTC")),
            \\       format_timestamp("%Y-%m-%dT%H:%M:%E*S%Ez", parse_timestamp("%Y-%m-%dT%H:%M:%E*S%Ez", "1969-01-01T00:00:00.123456789012Z", precision => 12, timezone => "UTC")),
            \\       # With trailing zeroes, precision => 12
            \\       format_timestamp("%Y-%m-%dT%H:%M:%E12S%Ez", parse_timestamp("%Y-%m-%dT%H:%M:%E12S%Ez", "1969-01-01T00:00:00.123456789000Z", precision => 12, timezone => "UTC")),
            \\       format_timestamp("%Y-%m-%dT%H:%M:%E*S%Ez", parse_timestamp("%Y-%m-%dT%H:%M:%E*S%Ez", "1969-01-01T00:00:00.123456789100Z", precision => 12, timezone => "UTC"))
            ,
            .rows = .{
                .{ "1999-12-31T16:00:00.123456789012-08:00", "1999-12-31T16:00:00.123456789012-08:00", "1968-12-31T16:00:00.123456789012-08:00", "1968-12-31T16:00:00.123456789012-08:00", "1968-12-31T16:00:00.123456789000-08:00", "1968-12-31T16:00:00.1234567891-08:00" },
            },
        },
        .{
            .desc = "timestamp_extract_boundary_cases_picos",
            .sql =
            \\SELECT
            \\  EXTRACT(YEAR FROM timestamp),
            \\  EXTRACT(WEEK FROM timestamp),
            \\  FORMAT_TIMESTAMP('%Y-W%U', timestamp),
            \\  EXTRACT(YEAR FROM timestamp AT TIME ZONE '-14'),
            \\  EXTRACT(WEEK FROM timestamp AT TIME ZONE '-14'),
            \\  FORMAT_TIMESTAMP('%Y-W%U', timestamp, '-14'),
            \\  EXTRACT(YEAR FROM timestamp AT TIME ZONE '+14'),
            \\  EXTRACT(WEEK FROM timestamp AT TIME ZONE '+14'),
            \\  FORMAT_TIMESTAMP('%Y-W%U', timestamp, '+14'),
            \\  EXTRACT(ISOYEAR FROM timestamp),
            \\  EXTRACT(ISOWEEK FROM timestamp),
            \\  FORMAT_TIMESTAMP('%G-W%V', timestamp),
            \\  EXTRACT(ISOYEAR FROM timestamp AT TIME ZONE '-14'),
            \\  EXTRACT(ISOWEEK FROM timestamp AT TIME ZONE '-14'),
            \\  FORMAT_TIMESTAMP('%G-W%V', timestamp, '-14'),
            \\  EXTRACT(ISOYEAR FROM timestamp AT TIME ZONE '+14'),
            \\  EXTRACT(ISOWEEK FROM timestamp AT TIME ZONE '+14'),
            \\  FORMAT_TIMESTAMP('%G-W%V', timestamp, '+14')
            \\FROM UNNEST([
            \\  TIMESTAMP '0001-01-01 00:00:00.000000000001Z',
            \\  TIMESTAMP '9999-12-31 23:59:59.999999999999Z'
            \\]) AS timestamp WITH OFFSET
            \\ORDER BY OFFSET
            ,
            .rows = .{
                .{ 0, 53, "0-W53", 0, 53, "0-W53", 1, 0, "1-W00", 0, 52, "0-W52", 0, 52, "0-W52", 1, 1, "1-W01" },
                .{ 9999, 52, "9999-W52", 9999, 52, "9999-W52", 10000, 0, "10000-W00", 9999, 52, "9999-W52", 9999, 52, "9999-W52", 9999, 52, "9999-W52" },
            },
        },
        .{
            .desc = "timestamp_extract_picos_part",
            .sql =
            \\SELECT
            \\  EXTRACT(PICOSECOND FROM timestamp)
            \\FROM UNNEST([
            \\  TIMESTAMP '0001-01-01 00:00:00.000000000001Z',
            \\  TIMESTAMP '9999-12-31 23:59:59.999999999999Z',
            \\  TIMESTAMP '0001-01-01 00:00:00Z'
            \\]) AS timestamp WITH OFFSET
            ,
            .unordered = true,
            .rows = .{
                .{999999999999},
                .{1},
                .{0},
            },
        },
        .{
            .desc = "extract_date_from_timestamp_with_picos",
            .sql =
            \\# Use a timezone that would advance the day in the result.
            \\SELECT EXTRACT(DATE FROM ts_col AT TIME ZONE 'UTC+14')
            \\FROM UNNEST([TIMESTAMP '2020-03-22 12:00:29.123456789012Z']) AS ts_col
            ,
            .rows = .{
                .{"2020-03-23"},
            },
        },
        .{
            .desc = "cast_timestamp_with_picos_to_date",
            .sql =
            \\SELECT CAST(ts_col AS DATE)
            \\FROM UNNEST([TIMESTAMP '2020-03-22 12:00:29.123456789012Z']) AS ts_col
            ,
            .rows = .{
                .{"2020-03-22"},
            },
        },
        .{
            .desc = "date_from_timestamp_with_picos",
            .sql =
            \\SELECT DATE(ts_col)
            \\FROM UNNEST([TIMESTAMP '2020-03-22 12:00:29.123456789012Z']) AS ts_col
            ,
            .rows = .{
                .{"2020-03-22"},
            },
        },
        .{
            .desc = "generate_timestamp_array",
            .sql =
            \\SELECT GENERATE_TIMESTAMP_ARRAY(t_start, t_end, INTERVAL 1 NANOSECOND),
            \\FROM (SELECT TIMESTAMP '2020-03-22 12:00:29.000000000001Z' AS t_start,
            \\             TIMESTAMP '2020-03-22 12:00:29.000000002Z' AS t_end)
            \\UNION ALL
            \\SELECT GENERATE_TIMESTAMP_ARRAY(t_start, t_end, INTERVAL 1 MICROSECOND),
            \\FROM (SELECT TIMESTAMP '2020-03-22 12:00:29.000000000001Z' AS t_start,
            \\             TIMESTAMP '2020-03-22 12:00:29.000002Z' AS t_end)
            \\UNION ALL
            \\SELECT GENERATE_TIMESTAMP_ARRAY(t_start, t_end, INTERVAL 1 MILLISECOND),
            \\FROM (SELECT TIMESTAMP '2020-03-22 12:00:29.000000000001Z' AS t_start,
            \\             TIMESTAMP '2020-03-22 12:00:29.002Z' AS t_end)
            \\UNION ALL
            \\SELECT GENERATE_TIMESTAMP_ARRAY(t_start, t_end, INTERVAL 1 SECOND),
            \\FROM (SELECT TIMESTAMP '2020-03-22 12:00:29.000000000001Z' AS t_start,
            \\             TIMESTAMP '2020-03-22 12:00:31Z' AS t_end)
            ,
            .unordered = true,
            .rows = .{
                .{.{ "2020-03-22 12:00:29.000000000001+00", "2020-03-22 12:00:29.000000001001+00" }},
                .{.{ "2020-03-22 12:00:29.000000000001+00", "2020-03-22 12:00:29.000001000001+00" }},
                .{.{ "2020-03-22 12:00:29.000000000001+00", "2020-03-22 12:00:29.001000000001+00" }},
                .{.{ "2020-03-22 12:00:29.000000000001+00", "2020-03-22 12:00:30.000000000001+00" }},
            },
        },
        .{
            .desc = "generate_timestamp_array_start_is_after_end",
            .sql =
            \\SELECT GENERATE_TIMESTAMP_ARRAY(t_start, t_end, INTERVAL 1 NANOSECOND),
            \\FROM (SELECT TIMESTAMP '2020-03-22 12:00:30.000000000001Z' AS t_start,
            \\             TIMESTAMP '2020-03-22 12:00:29.000000000001Z' AS t_end)
            ,
            .rows = .{
                .{.{}},
            },
        },
        .{
            .desc = "generate_timestamp_array_delta_smaller_than_step",
            .sql =
            \\SELECT GENERATE_TIMESTAMP_ARRAY(t_start, t_end, INTERVAL 1 DAY),
            \\FROM (SELECT TIMESTAMP '2020-03-22 12:00:29.000000000001Z' AS t_start,
            \\             TIMESTAMP '2020-03-22 12:00:30.000000000001Z' AS t_end)
            ,
            .rows = .{
                .{.{"2020-03-22 12:00:29.000000000001+00"}},
            },
        },
        .{
            .desc = "generate_timestamp_array_out_of_range",
            .sql =
            \\SELECT GENERATE_TIMESTAMP_ARRAY(t_start, t_end, INTERVAL 1 NANOSECOND),
            \\FROM (SELECT TIMESTAMP '2020-03-22 12:00:29.000000000001Z' AS t_start,
            \\             TIMESTAMP '2020-03-22 12:00:30.000000000001Z' AS t_end)
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "generate_timestamp_array_zero_step",
            .sql =
            \\SELECT GENERATE_TIMESTAMP_ARRAY(t_start, t_end, INTERVAL 0 NANOSECOND),
            \\FROM (SELECT TIMESTAMP '2020-03-22 12:00:29.000000000001Z' AS t_start,
            \\             TIMESTAMP '2020-03-22 12:00:30.000000000001Z' AS t_end)
            ,
            .expect_error_any = true,
        },
        .{
            .desc = "unix_seconds_and_fractions_with_pico_input",
            .sql =
            \\SELECT
            \\  unix_seconds(ts_micros),
            \\  unix_seconds(ts_picos),
            \\  unix_millis(ts_micros),
            \\  unix_millis(ts_picos),
            \\  unix_micros(ts_micros),
            \\  unix_micros(ts_picos)
            \\FROM (SELECT
            \\        TIMESTAMP '2020-03-22 12:00:29.123456Z' AS ts_micros,
            \\        TIMESTAMP '2020-03-22 12:00:29.123456789012Z' AS ts_picos)
            ,
            .rows = .{
                .{ 1584878429, 1584878429, 1584878429123, 1584878429123, 1584878429123456, 1584878429123456 },
            },
        },
        .{
            .desc = "timestamp_picos_in_datetime_bucket",
            .sql =
            \\# We do not yet support intervals with picosecond. When we do, we should add a
            \\# test case where the interval step itself also has picos.
            \\select
            \\  datetime_bucket(ts, INTERVAL 7 DAY),
            \\  datetime_bucket(ts, INTERVAL 7 DAY, timestamp '2150-12-11 07:00:00.123456789012')
            \\from (select timestamp '2020-02-15 14:57:39.123456789012' ts)
            ,
            .rows = .{
                .{ "2020-02-09 08:00:00+00", "2020-02-14 15:00:00.123456789012+00" },
            },
        },
        .{
            .desc = "picos_to_proto",
            .sql = "SELECT TO_PROTO(TIMESTAMP \"2025-11-05 20:07:24.123456789012+00\")",
            .rows = .{
                .{.{"seconds: 1762373244 nanos: 123456789"}},
            },
        },
        .{
            .desc = "in_array",
            .sql =
            \\WITH tbl as (
            \\  SELECT TIMESTAMP '2000-01-01 1:2:3.123456789123Z' ts1,
            \\         TIMESTAMP '2000-01-01 1:2:3.123456789124Z' ts2,
            \\         TIMESTAMP '2000-01-01 1:2:3.123456789125Z' ts3
            \\)
            \\SELECT
            \\  ts1 IN UNNEST([ts1, ts2]) as is_in_true,
            \\  ts3 IN UNNEST([ts1, ts2]) as is_in_false,
            \\  ts1 NOT IN UNNEST([ts1, ts2]) as not_in_false,
            \\  ts3 NOT IN UNNEST([ts1, ts2]) as not_in_true,
            \\FROM tbl
            ,
            .rows = .{
                .{ true, false, false, true },
            },
        },
        .{
            .desc = "in_array_string_literal",
            .sql =
            \\WITH tbl as (
            \\  SELECT TIMESTAMP '2000-01-01 1:2:3.123456789123Z' ts1,
            \\         TIMESTAMP '2000-01-01 1:2:3.123456789124Z' ts2,
            \\         TIMESTAMP '2000-01-01 1:2:3.123456789125Z' ts3
            \\)
            \\SELECT
            \\  '2000-01-01 1:2:3.123456789123Z' IN UNNEST([ts1, ts2]) as string_is_in_true,
            \\  '2000-01-01 1:2:3.123456789123Z' NOT IN UNNEST([ts1, ts2]) as string_not_in_false
            \\FROM tbl
            ,
            .rows = .{
                .{ true, false },
            },
        },
        .{
            .desc = "in_array_of_struct",
            .sql =
            \\WITH tbl as (
            \\  SELECT TIMESTAMP '2000-01-01 1:2:3.123456789123Z' ts1,
            \\         TIMESTAMP '2000-01-01 1:2:3.123456789124Z' ts2,
            \\         TIMESTAMP '2000-01-01 1:2:3.123456789125Z' ts3
            \\)
            \\SELECT
            \\  STRUCT(ts1, ts2) IN UNNEST([STRUCT(ts1, ts2), STRUCT(ts1, ts3)]) as is_in_true,
            \\  STRUCT(ts2, ts3) IN UNNEST([STRUCT(ts1, ts2), STRUCT(ts1, ts3)]) as is_in_false,
            \\  STRUCT(ts1, ts2) NOT IN UNNEST([STRUCT(ts1, ts2), STRUCT(ts1, ts3)]) as not_in_false,
            \\  STRUCT(ts2, ts3) NOT IN UNNEST([STRUCT(ts1, ts2), STRUCT(ts1, ts3)]) as not_in_true
            \\FROM tbl
            ,
            .rows = .{
                .{ true, false, false, true },
            },
        },
    },
}
