// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/syntax/query/qualify",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/query-syntax.md#qualify_clause",
    .cases = .{
        .{
            .desc = "top-1 per partition via QUALIFY",
            .sql =
            \\SELECT k, v
            \\FROM UNNEST([STRUCT('a' AS k, 1 AS v), ('a', 2), ('b', 3), ('b', 0)])
            \\QUALIFY RANK() OVER (PARTITION BY k ORDER BY v DESC) = 1
            \\ORDER BY k
            ,
            .rows = .{
                .{ "a", 2 },
                .{ "b", 3 },
            },
        },
    },
}
