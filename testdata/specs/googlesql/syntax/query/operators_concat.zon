// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/syntax/query/operators_concat",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/query-syntax.md",
    .cases = .{
        .{
            .desc = "STRING concatenation with ||",
            .sql = "SELECT 'a' || 'b' || 'c' AS r",
            .rows = .{
                .{"abc"},
            },
        },
        .{
            .desc = "NULL propagates in concat",
            .sql = "SELECT 'a' || CAST(NULL AS STRING) AS r",
            .rows = .{
                .{null},
            },
        },
    },
}
