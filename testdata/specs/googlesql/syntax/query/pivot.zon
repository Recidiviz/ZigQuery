// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/syntax/query/pivot",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/query-syntax.md#pivot_operator",
    .cases = .{
        .{
            .desc = "pivot by category, sum values",
            .sql =
            \\SELECT * FROM (
            \\  SELECT 'a' AS k, 1 AS v UNION ALL
            \\  SELECT 'b', 2 UNION ALL
            \\  SELECT 'a', 3
            \\)
            \\PIVOT (SUM(v) FOR k IN ('a', 'b'))
            ,
            .rows = .{
                .{ 4, 2 },
            },
        },
    },
}
