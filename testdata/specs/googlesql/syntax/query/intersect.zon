// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/syntax/query/intersect",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/query-syntax.md",
    .cases = .{
        .{
            .desc = "INTERSECT DISTINCT keeps the shared values",
            .sql =
            \\(SELECT 1 AS x UNION ALL SELECT 2 UNION ALL SELECT 3)
            \\INTERSECT DISTINCT
            \\(SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4)
            ,
            .rows = .{
                .{2},
                .{3},
            },
        },
    },
}
