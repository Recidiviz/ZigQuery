// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/syntax/query/union",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/query-syntax.md",
    .cases = .{
        .{
            .desc = "UNION ALL retains duplicates",
            .sql = "(SELECT 1 AS x) UNION ALL (SELECT 1)",
            .rows = .{
                .{1},
                .{1},
            },
        },
        .{
            .desc = "UNION DISTINCT deduplicates",
            .sql = "(SELECT 1 AS x UNION ALL SELECT 2) UNION DISTINCT (SELECT 2 UNION ALL SELECT 3)",
            .rows = .{
                .{1},
                .{2},
                .{3},
            },
        },
    },
}
