// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/syntax/query/operators_arith",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/query-syntax.md",
    .cases = .{
        .{
            .desc = "integer addition / subtraction / multiplication",
            .sql = "SELECT 1 + 2 AS s, 10 - 4 AS d, 3 * 5 AS m",
            .rows = .{
                .{ 3, 6, 15 },
            },
        },
        .{
            .desc = "integer / float division and MOD",
            .sql = "SELECT 10 / 3 AS div, MOD(7, 3) AS rem",
            .rows = .{
                .{ 3.3333333333333335, 1 },
            },
        },
        .{
            .desc = "unary minus",
            .sql = "SELECT -5 AS r",
            .rows = .{
                .{-5},
            },
        },
    },
}
