// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/syntax/query/with_cte",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/query-syntax.md",
    .cases = .{
        .{
            .desc = "single CTE referenced in the outer SELECT",
            .sql =
            \\WITH t AS (SELECT 1 AS x, 'a' AS y)
            \\SELECT x, y FROM t
            ,
            .rows = .{
                .{ 1, "a" },
            },
        },
        .{
            .desc = "multiple CTEs referenced together",
            .sql =
            \\WITH t1 AS (SELECT 1 AS x), t2 AS (SELECT 2 AS y)
            \\SELECT t1.x + t2.y AS r FROM t1, t2
            ,
            .rows = .{
                .{3},
            },
        },
    },
}
