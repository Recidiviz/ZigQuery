// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/syntax/query/window_clause",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/window-function-calls.md#def_use_named_window",
    .cases = .{
        .{
            .desc = "named window via WINDOW clause",
            .sql =
            \\SELECT x, SUM(x) OVER w AS running
            \\FROM UNNEST([1, 2, 3]) AS x
            \\WINDOW w AS (ORDER BY x ROWS UNBOUNDED PRECEDING)
            \\ORDER BY x
            ,
            .rows = .{
                .{ 1, 1 },
                .{ 2, 3 },
                .{ 3, 6 },
            },
        },
    },
}
