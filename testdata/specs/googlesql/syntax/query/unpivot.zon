// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/syntax/query/unpivot",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/query-syntax.md#unpivot_operator",
    .cases = .{
        .{
            .desc = "unpivot two columns into value/column-name rows",
            .sql =
            \\SELECT * FROM (SELECT 1 AS a, 2 AS b)
            \\UNPIVOT (val FOR col IN (a, b))
            \\ORDER BY col
            ,
            .rows = .{
                .{ 1, "a" },
                .{ 2, "b" },
            },
        },
    },
}
