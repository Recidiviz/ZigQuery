// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/syntax/query/grouping_sets",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/query-syntax.md#group_by_grouping_sets",
    .cases = .{
        .{
            .desc = "per-key total plus grand total via GROUPING SETS",
            .sql =
            \\SELECT k, SUM(v) AS total
            \\FROM UNNEST([STRUCT('a' AS k, 1 AS v), ('a', 2), ('b', 3)])
            \\GROUP BY GROUPING SETS (k, ())
            \\ORDER BY k NULLS LAST
            ,
            .rows = .{
                .{ "a", 3 },
                .{ "b", 3 },
                .{ null, 6 },
            },
        },
    },
}
