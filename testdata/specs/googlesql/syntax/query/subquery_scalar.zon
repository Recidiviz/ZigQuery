// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/syntax/query/subquery_scalar",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/query-syntax.md",
    .cases = .{
        .{
            .desc = "scalar subquery returning one row",
            .sql = "SELECT (SELECT 42) AS r",
            .rows = .{
                .{42},
            },
        },
        .{
            .desc = "scalar subquery used inside an expression",
            .sql = "SELECT 1 + (SELECT 10) AS r",
            .rows = .{
                .{11},
            },
        },
    },
}
