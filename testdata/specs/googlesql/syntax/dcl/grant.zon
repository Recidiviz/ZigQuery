// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/syntax/dcl/grant",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/data-control-language.md",
    .cases = .{
        .{
            .desc = "GRANT SELECT on a table to a user",
            .setup = .{
                "CREATE TABLE grant_ds.t1 (a INT64)",
                "GRANT SELECT ON TABLE grant_ds.t1 TO 'user:alice@example.com'",
            },
            .sql = "SELECT 1 AS r",
            .rows = .{
                .{1},
            },
        },
        .{
            .desc = "GRANT multiple privileges to a group",
            .unsupported_in_bigquery = "\"Any Granting or Revoking of one of (INSERT, UPDATE, DELETE) must reference all three, because BigQuery does not distinguish between them.\" (recidiviz-bigquery-sandbox, 2026-08-25)",
            .setup = .{
                "CREATE TABLE grant_ds.t2 (a INT64)",
                "GRANT SELECT, UPDATE, DELETE ON TABLE grant_ds.t2 TO 'group:engineering@example.com'",
            },
            .sql = "SELECT 1 AS r",
            .rows = .{
                .{1},
            },
        },
    },
}
