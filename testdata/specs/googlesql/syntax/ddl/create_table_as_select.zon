// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/syntax/ddl/create_table_as_select",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/data-definition-language.md",
    .cases = .{
        .{
            .desc = "CTAS materialises the query result",
            .setup = .{
                "CREATE TABLE ctas_ds.t AS SELECT 10 AS a, 'b' AS b",
            },
            .sql = "SELECT a, b FROM ctas_ds.t",
            .rows = .{
                .{ 10, "b" },
            },
        },
    },
}
