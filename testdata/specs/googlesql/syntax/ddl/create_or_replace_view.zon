// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/syntax/ddl/create_or_replace_view",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/data-definition-language.md",
    .cases = .{
        .{
            .desc = "CREATE OR REPLACE VIEW substitutes the new definition",
            .setup = .{
                "CREATE VIEW corv_ds.v1 AS SELECT 1 AS x",
                "CREATE OR REPLACE VIEW corv_ds.v1 AS SELECT 200 AS x",
            },
            .sql = "SELECT x FROM corv_ds.v1",
            .rows = .{
                .{200},
            },
        },
    },
}
