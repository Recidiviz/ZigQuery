// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/syntax/ddl/drop_table",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/data-definition-language.md",
    .cases = .{
        .{
            .desc = "DROP TABLE removes the dropped table from INFORMATION_SCHEMA",
            .setup = .{
                "CREATE TABLE drop_ds.keep_tbl (k INT64)",
                "CREATE TABLE drop_ds.drop_tbl (a INT64)",
                "DROP TABLE drop_ds.drop_tbl",
            },
            .sql =
            \\SELECT table_name
            \\FROM drop_ds.INFORMATION_SCHEMA.TABLES
            \\ORDER BY table_name
            ,
            .rows = .{
                .{"keep_tbl"},
            },
        },
    },
}
