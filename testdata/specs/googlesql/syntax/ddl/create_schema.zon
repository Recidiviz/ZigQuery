// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/syntax/ddl/create_schema",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/data-definition-language.md",
    .cases = .{
        .{
            .desc = "CREATE SCHEMA executes without error",
            .setup = .{
                "CREATE SCHEMA cs_demo",
            },
            .sql = "SELECT 1 AS r",
            .rows = .{
                .{1},
            },
        },
        .{
            .desc = "CREATE SCHEMA with OPTIONS executes without error",
            .setup = .{
                "CREATE SCHEMA cs_demo2 OPTIONS(description='demo schema')",
            },
            .sql = "SELECT 1 AS r",
            .rows = .{
                .{1},
            },
        },
    },
}
