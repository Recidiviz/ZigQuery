// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/syntax/script/call_stmt",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/procedural-language.md",
    .cases = .{
        .{
            .desc = "CALL invokes a registered procedure",
            .setup = .{
                "CREATE PROCEDURE call_ds.p1() BEGIN SELECT 1; END",
                "CALL call_ds.p1()",
            },
            .sql = "SELECT 1 AS r",
            .rows = .{
                .{1},
            },
        },
    },
}
