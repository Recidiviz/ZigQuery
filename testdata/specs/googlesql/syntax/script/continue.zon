.{
    .spec = "googlesql/syntax/script/continue",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/procedural-language.md",
    .cases = .{
        .{
            .desc = "CONTINUE returns to the top of the loop",
            .setup = .{
                "WHILE 1 = 2 DO CONTINUE; END WHILE",
            },
            .sql = "SELECT 1 AS r",
            .rows = .{
                .{1},
            },
        },
    },
}
