// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/syntax/script/declare",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/procedural-language.md",
    .cases = .{
        .{
            .desc = "DECLARE with default value is visible in a SELECT",
            .setup = .{
                "DECLARE script_v INT64 DEFAULT 42",
            },
            .sql = "SELECT script_v AS v",
            .rows = .{
                .{42},
            },
        },
    },
}
