// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/syntax/pipe/where",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/pipe-syntax.md#where_pipe_operator",
    .cases = .{
        .{
            .desc = "filter integers above threshold",
            .sql =
            \\FROM (SELECT 1 AS x UNION ALL SELECT 2 UNION ALL SELECT 3)
            \\|> WHERE x > 1
            \\|> SELECT x
            \\|> ORDER BY x
            ,
            .rows = .{
                .{2},
                .{3},
            },
        },
        .{
            .desc = "chained WHERE acts as AND",
            .sql =
            \\FROM (SELECT 1 AS x UNION ALL SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4)
            \\|> WHERE x > 1
            \\|> WHERE x < 4
            \\|> SELECT x
            \\|> ORDER BY x
            ,
            .rows = .{
                .{2},
                .{3},
            },
        },
    },
}
