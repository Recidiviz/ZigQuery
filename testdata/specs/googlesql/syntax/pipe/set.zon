// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/syntax/pipe/set",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/pipe-syntax.md#set_pipe_operator",
    .cases = .{
        .{
            .desc = "set updates an existing column",
            .sql =
            \\FROM (SELECT 1 AS x)
            \\|> SET x = x * 10
            ,
            .rows = .{
                .{10},
            },
        },
        .{
            .desc = "set two columns in one operator",
            .sql =
            \\FROM (SELECT 1 AS x, 2 AS y)
            \\|> SET x = x + 5, y = y * 2
            ,
            .rows = .{
                .{ 6, 4 },
            },
        },
    },
}
