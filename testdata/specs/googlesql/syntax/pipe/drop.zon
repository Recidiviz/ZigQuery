// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/syntax/pipe/drop",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/pipe-syntax.md#drop_pipe_operator",
    .cases = .{
        .{
            .desc = "drop one column",
            .sql =
            \\FROM (SELECT 1 AS x, 2 AS y)
            \\|> DROP x
            ,
            .rows = .{
                .{2},
            },
        },
        .{
            .desc = "drop multiple columns",
            .sql =
            \\FROM (SELECT 1 AS x, 2 AS y, 3 AS z)
            \\|> DROP x, z
            ,
            .rows = .{
                .{2},
            },
        },
    },
}
