// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/syntax/pipe/as",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/pipe-syntax.md#as_pipe_operator",
    .cases = .{
        .{
            .desc = "AS names the table; columns are qualifiable",
            .sql =
            \\FROM (SELECT 1 AS x, 2 AS y)
            \\|> AS my_table
            \\|> SELECT my_table.x, my_table.y
            ,
            .rows = .{
                .{ 1, 2 },
            },
        },
    },
}
