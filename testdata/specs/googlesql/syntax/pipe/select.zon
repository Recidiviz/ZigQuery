// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/syntax/pipe/select",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/pipe-syntax.md#select_pipe_operator",
    .cases = .{
        .{
            .desc = "rename single column via pipe SELECT",
            .sql =
            \\FROM (SELECT 'apples' AS item, 2 AS sales)
            \\|> SELECT item AS fruit_name
            ,
            .rows = .{
                .{"apples"},
            },
        },
        .{
            .desc = "project two columns in declared order",
            .sql =
            \\FROM (SELECT 1 AS x, 2 AS y, 3 AS z)
            \\|> SELECT z, x
            ,
            .rows = .{
                .{ 3, 1 },
            },
        },
        .{
            .desc = "arithmetic expression in pipe SELECT",
            .sql =
            \\FROM (SELECT 5 AS a)
            \\|> SELECT a + 10 AS sum
            ,
            .rows = .{
                .{15},
            },
        },
    },
}
