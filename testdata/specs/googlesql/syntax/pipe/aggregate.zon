// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/syntax/pipe/aggregate",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/pipe-syntax.md#aggregate_pipe_operator",
    .cases = .{
        .{
            .desc = "count rows with no GROUP BY",
            .sql =
            \\FROM (SELECT 1 AS x UNION ALL SELECT 2 UNION ALL SELECT 3)
            \\|> AGGREGATE COUNT(*) AS n
            ,
            .rows = .{
                .{3},
            },
        },
        .{
            .desc = "aggregate with GROUP BY",
            .sql =
            \\FROM (
            \\  SELECT 'fruit' AS category, 2 AS sales UNION ALL
            \\  SELECT 'fruit', 7 UNION ALL
            \\  SELECT 'fruit', 5 UNION ALL
            \\  SELECT 'vegetable', 8
            \\)
            \\|> AGGREGATE SUM(sales) AS total GROUP BY category
            \\|> ORDER BY category
            ,
            .rows = .{
                .{ "fruit", 14 },
                .{ "vegetable", 8 },
            },
        },
    },
}
