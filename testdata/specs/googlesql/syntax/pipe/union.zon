// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/syntax/pipe/union",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/pipe-syntax.md#union_pipe_operator",
    .cases = .{
        .{
            .desc = "union all retains duplicates",
            .sql =
            \\FROM (SELECT 1 AS x)
            \\|> UNION ALL (SELECT 1)
            \\|> ORDER BY x
            ,
            .rows = .{
                .{1},
                .{1},
            },
        },
        .{
            .desc = "union distinct deduplicates",
            .sql =
            \\FROM (SELECT 1 AS x UNION ALL SELECT 2)
            \\|> UNION DISTINCT (SELECT 2 UNION ALL SELECT 3)
            \\|> ORDER BY x
            ,
            .rows = .{
                .{1},
                .{2},
                .{3},
            },
        },
    },
}
