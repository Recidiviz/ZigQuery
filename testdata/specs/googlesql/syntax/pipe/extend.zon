// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/syntax/pipe/extend",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/pipe-syntax.md#extend_pipe_operator",
    .cases = .{
        .{
            .desc = "extend with a doubled column",
            .sql =
            \\FROM (SELECT 1 AS x UNION ALL SELECT 2 UNION ALL SELECT 3)
            \\|> EXTEND x*2 AS doubled
            \\|> ORDER BY x
            ,
            .rows = .{
                .{ 1, 2 },
                .{ 2, 4 },
                .{ 3, 6 },
            },
        },
        .{
            .desc = "extend with multiple expressions",
            .sql =
            \\FROM (SELECT 4 AS x)
            \\|> EXTEND x+1 AS plus_one, x*x AS squared
            ,
            .rows = .{
                .{ 4, 5, 16 },
            },
        },
    },
}
