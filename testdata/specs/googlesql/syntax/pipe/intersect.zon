// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/syntax/pipe/intersect",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/pipe-syntax.md#intersect_pipe_operator",
    .cases = .{
        .{
            .desc = "intersect distinct",
            .sql =
            \\FROM (SELECT 1 AS x UNION ALL SELECT 2 UNION ALL SELECT 3)
            \\|> INTERSECT DISTINCT (SELECT 2 UNION ALL SELECT 3 UNION ALL SELECT 4)
            \\|> ORDER BY x
            ,
            .rows = .{
                .{2},
                .{3},
            },
        },
    },
}
