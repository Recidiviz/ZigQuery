// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/syntax/io/export_data",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/export-statements.md",
    .cases = .{
        .{
            .desc = "EXPORT DATA OPTIONS(...) AS SELECT writes to the URI and yields no rows",
            .sql =
            \\EXPORT DATA
            \\OPTIONS(uri = 'mem://specsuite/out.csv', format = 'CSV')
            \\AS SELECT 1 AS x, 'a' AS y
            ,
            .rows = .{},
        },
    },
}
