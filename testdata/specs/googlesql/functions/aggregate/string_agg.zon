// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/aggregate/string_agg",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/aggregate_functions.md#string_agg",
    .cases = .{
        .{
            .desc = "comma-join strings",
            .sql = "SELECT STRING_AGG(x, \",\" ORDER BY x) FROM UNNEST([\"c\", \"a\", \"b\"]) AS x",
            .rows = .{
                .{"a,b,c"},
            },
        },
        .{
            .desc = "empty input returns NULL",
            .sql = "SELECT STRING_AGG(x, \",\") FROM UNNEST(CAST([] AS ARRAY<STRING>)) AS x",
            .rows = .{
                .{null},
            },
        },
    },
}
