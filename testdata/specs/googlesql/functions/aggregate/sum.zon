// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/aggregate/sum",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/aggregate_functions.md#sum",
    .cases = .{
        .{
            .desc = "sum integers",
            .sql = "SELECT SUM(x) FROM UNNEST([1, 2, 3, 4]) AS x",
            .rows = .{
                .{10},
            },
        },
        .{
            .desc = "empty unnest sum is null",
            .sql = "SELECT SUM(x) FROM UNNEST(CAST([] AS ARRAY<INT64>)) AS x",
            .rows = .{
                .{null},
            },
        },
    },
}
