// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/aggregate/logical_or",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/aggregate_functions.md#logical_or",
    .cases = .{
        .{
            .desc = "one true",
            .sql = "SELECT LOGICAL_OR(x) FROM UNNEST([false, true, false]) AS x",
            .rows = .{
                .{true},
            },
        },
        .{
            .desc = "all false",
            .sql = "SELECT LOGICAL_OR(x) FROM UNNEST([false, false]) AS x",
            .rows = .{
                .{false},
            },
        },
        .{
            .desc = "empty input returns NULL",
            .sql = "SELECT LOGICAL_OR(x) FROM UNNEST(CAST([] AS ARRAY<BOOL>)) AS x",
            .rows = .{
                .{null},
            },
        },
    },
}
