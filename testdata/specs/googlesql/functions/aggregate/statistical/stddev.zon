    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/statistical_aggregate_functions.md#stddev",
    .cases = .{
        .{
            .desc = "stddev (alias for stddev_samp) of two values",
            .sql = "SELECT ROUND(STDDEV(x), 4) FROM UNNEST([1.0, 3.0]) AS x",
            .rows = .{
                .{1.4142},
            },
        },
    },
