// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/aggregate/differential_privacy/avg",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/aggregate-dp-functions.md#avg-differential_privacy",
    .cases = .{
        .{
            .desc = "DP AVG over clamped values is the clamp value (with small noise)",
            .sql = "SELECT ABS((SELECT WITH DIFFERENTIAL_PRIVACY OPTIONS(epsilon=1000, delta=0.01, privacy_unit_column=x) AVG(x, contribution_bounds_per_group=>(0.0, 10.0)) FROM UNNEST([10.0, 20.0, 30.0]) AS x) - 10.0) <= 1.0",
            .rows = .{
                .{true},
            },
        },
    },
}
