// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/aggregate/approximate/approx_count_distinct",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/approximate_aggregate_functions.md#approx_count_distinct",
    .cases = .{
        .{
            .desc = "approx_count_distinct returns positive value",
            .sql = "SELECT APPROX_COUNT_DISTINCT(x) > 0 FROM UNNEST([1, 2, 3, 4]) AS x",
            .rows = .{
                .{true},
            },
        },
    },
}
