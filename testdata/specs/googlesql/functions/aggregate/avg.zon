// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/aggregate/avg",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/aggregate_functions.md#avg",
    .cases = .{
        .{
            .desc = "avg of three",
            .sql = "SELECT AVG(x) FROM UNNEST([1.0, 2.0, 3.0]) AS x",
            .rows = .{
                .{2.0},
            },
        },
        .{
            .desc = "empty input returns NULL",
            .sql = "SELECT AVG(x) FROM UNNEST(CAST([] AS ARRAY<FLOAT64>)) AS x",
            .rows = .{
                .{null},
            },
        },
    },
}
