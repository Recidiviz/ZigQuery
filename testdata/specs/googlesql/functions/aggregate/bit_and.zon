// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/aggregate/bit_and",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/aggregate_functions.md#bit_and",
    .cases = .{
        .{
            .desc = "bit_and over integers",
            .sql = "SELECT BIT_AND(x) FROM UNNEST([7, 3, 5]) AS x",
            .rows = .{
                .{1},
            },
        },
        .{
            .desc = "empty input returns NULL",
            .sql = "SELECT BIT_AND(x) FROM UNNEST(CAST([] AS ARRAY<INT64>)) AS x",
            .rows = .{
                .{null},
            },
        },
    },
}
