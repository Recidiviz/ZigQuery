// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/aggregate/bit_or",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/aggregate_functions.md#bit_or",
    .cases = .{
        .{
            .desc = "bit_or over integers",
            .sql = "SELECT BIT_OR(x) FROM UNNEST([1, 2, 4]) AS x",
            .rows = .{
                .{7},
            },
        },
        .{
            .desc = "empty input returns NULL",
            .sql = "SELECT BIT_OR(x) FROM UNNEST(CAST([] AS ARRAY<INT64>)) AS x",
            .rows = .{
                .{null},
            },
        },
    },
}
