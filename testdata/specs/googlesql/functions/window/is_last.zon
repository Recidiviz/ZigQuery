// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/window/is_last",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/numbering_functions.md#is_last",
    .cases = .{
        .{
            .desc = "IS_LAST returns BOOL via numbering rewrite",
            .sql = "SELECT TYPEOF(IS_LAST(2) OVER (ORDER BY x)) FROM UNNEST([1,2,3]) AS x LIMIT 1",
            .rows = .{
                .{"BOOL"},
            },
        },
    },
}
