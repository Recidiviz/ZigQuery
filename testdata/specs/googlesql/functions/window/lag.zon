// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/window/lag",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/navigation_functions.md#lag",
    .cases = .{
        .{
            .desc = "lag returns prior row",
            .sql =
            \\SELECT x, LAG(x) OVER (ORDER BY x) AS prev
            \\FROM UNNEST([10, 20, 30]) AS x
            \\ORDER BY x
            ,
            .rows = .{
                .{ 10, null },
                .{ 20, 10 },
                .{ 30, 20 },
            },
        },
    },
}
