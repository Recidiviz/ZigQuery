// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/window/nth_value",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/navigation_functions.md#nth_value",
    .cases = .{
        .{
            .desc = "NTH_VALUE retrieves the second ordered element",
            .sql = "SELECT NTH_VALUE(x, 2) OVER (ORDER BY x RANGE BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) FROM UNNEST([10,20,30]) AS x LIMIT 1",
            .rows = .{
                .{20},
            },
        },
    },
}
