// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/window/first_value",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/navigation_functions.md#first_value",
    .cases = .{
        .{
            .desc = "first_value over ordered window",
            .sql =
            \\SELECT x, FIRST_VALUE(x) OVER (ORDER BY x) AS fv
            \\FROM UNNEST([10, 20, 30]) AS x
            \\ORDER BY x
            ,
            .rows = .{
                .{ 10, 10 },
                .{ 20, 10 },
                .{ 30, 10 },
            },
        },
    },
}
