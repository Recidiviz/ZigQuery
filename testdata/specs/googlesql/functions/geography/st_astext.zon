// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/geography/st_astext",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/geography_functions.md#st_astext",
    .cases = .{
        .{
            .desc = "format a point as WKT",
            .sql = "SELECT ST_ASTEXT(ST_GEOGPOINT(1, 2))",
            // ST_ASTEXT has no space between the geometry keyword and its
            // coordinate list: "POINT(1 2)". (recidiviz-bigquery-sandbox, 2026-08-25)
            .rows = .{
                .{"POINT(1 2)"},
            },
        },
    },
}
