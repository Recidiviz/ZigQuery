// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/geography/st_makepolygon",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/geography_functions.md#st_makepolygon",
    .cases = .{
        .{
            .desc = "Build polygon from outer ring",
            .sql = "SELECT ST_ASGEOJSON(ST_MAKEPOLYGON(ST_GEOGFROMTEXT('LINESTRING(0 0, 1 0, 1 1, 0 1, 0 0)')))",
            .rows = .{
                .{"{\"type\":\"Polygon\",\"coordinates\":[[[0,0],[1,0],[1,1],[0,1],[0,0]]]}"},
            },
        },
    },
}
