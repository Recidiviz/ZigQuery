.{
    .spec = "googlesql/functions/geography/st_azimuth",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/geography_functions.md#st_azimuth",
    .cases = .{
        .{
            .desc = "northward bearing is 0 radians",
            .sql = "SELECT ST_AZIMUTH(ST_GEOGFROMTEXT('POINT(0 0)'), ST_GEOGFROMTEXT('POINT(0 1)'))",
            .rows = .{
                .{0.0},
            },
        },
    },
}
