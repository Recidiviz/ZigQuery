// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/geography/st_contains",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/geography_functions.md#st_contains",
    .cases = .{
        .{
            .desc = "Polygon contains interior point",
            .sql = "SELECT ST_CONTAINS(ST_GEOGFROMTEXT('POLYGON((0 0, 1 0, 1 1, 0 1, 0 0))'), ST_GEOGFROMTEXT('POINT(0.5 0.5)'))",
            .rows = .{
                .{true},
            },
        },
    },
}
