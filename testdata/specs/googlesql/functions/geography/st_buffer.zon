// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/geography/st_buffer",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/geography_functions.md#st_buffer",
    .cases = .{
        .{
            .desc = "upstream example 1",
            .sql =
            \\SELECT
            \\  -- num_seg_quarter_circle=2
            \\  ST_NUMPOINTS(ST_BUFFER(ST_GEOGFROMTEXT('POINT(1 2)'), 50, 2)) AS eight_sides,
            \\  -- num_seg_quarter_circle=8, since 8 is the default
            \\  ST_NUMPOINTS(ST_BUFFER(ST_GEOGFROMTEXT('POINT(100 2)'), 50)) AS thirty_two_sides
            ,
            .rows = .{
                .{ "9", "33" },
            },
        },
    },
}
