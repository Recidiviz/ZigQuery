.{
    .spec = "googlesql/functions/geography/st_pointn",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/geography_functions.md#st_pointn",
    .cases = .{
        .{
            .desc = "Middle vertex",
            .sql = "SELECT ST_ASGEOJSON(ST_POINTN(ST_GEOGFROMTEXT('LINESTRING(0 0, 1 0, 2 0)'), 2))",
            .rows = .{
                .{"{\"type\":\"Point\",\"coordinates\":[1,0]}"},
            },
        },
    },
}
