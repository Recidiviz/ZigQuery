.{
    .spec = "googlesql/functions/geography/st_asbinary",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/geography_functions.md#st_asbinary",
    .cases = .{
        .{
            .desc = "WKB encoding of POINT(0 0)",
            .sql = "SELECT TO_HEX(ST_ASBINARY(ST_GEOGFROMTEXT('POINT(0 0)'))) AS h",
            .rows = .{
                .{"010100000000000000000000000000000000000000"},
            },
        },
    },
}
