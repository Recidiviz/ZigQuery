.{
    .spec = "googlesql/functions/geography/st_lineinterpolatepoint",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/geography_functions.md#st_lineinterpolatepoint",
    .cases = .{
        .{
            .desc = "midpoint of equator segment",
            .sql = "SELECT ST_ASGEOJSON(ST_LINEINTERPOLATEPOINT(ST_GEOGFROMTEXT('LINESTRING(0 0, 2 0)'), 0.5))",
            .rows = .{
                .{"{\"type\":\"Point\",\"coordinates\":[1,0]}"},
            },
        },
    },
}
