// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/geography/st_dimension",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/geography_functions.md#st_dimension",
    .cases = .{
        .{
            .desc = "Polygon -> 2",
            .sql = "SELECT ST_DIMENSION(ST_GEOGFROMTEXT('POLYGON((0 0, 1 0, 1 1, 0 1, 0 0))'))",
            .rows = .{
                .{2},
            },
        },
        .{
            .desc = "LineString -> 1",
            .sql = "SELECT ST_DIMENSION(ST_GEOGFROMTEXT('LINESTRING(0 0, 1 0)'))",
            .rows = .{
                .{1},
            },
        },
        .{
            .desc = "Point -> 0",
            .sql = "SELECT ST_DIMENSION(ST_GEOGFROMTEXT('POINT(0 0)'))",
            .rows = .{
                .{0},
            },
        },
    },
}
