.{
    .spec = "googlesql/functions/geography/st_geogfromgeojson",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/geography_functions.md#st_geogfromgeojson",
    .cases = .{
        .{
            .desc = "Roundtrip via GeoJSON",
            .sql = "SELECT ST_ASGEOJSON(ST_GEOGFROMGEOJSON('{\"type\":\"Point\",\"coordinates\":[3,4]}'))",
            .rows = .{
                .{"{\"type\":\"Point\",\"coordinates\":[3,4]}"},
            },
        },
    },
}
