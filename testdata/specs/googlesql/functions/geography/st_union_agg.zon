// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/geography/st_union_agg",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/geography_functions.md#st_union_agg",
    .cases = .{
        .{
            .desc = "upstream example 1",
            .sql =
            \\SELECT ST_UNION_AGG(items) AS results
            \\FROM UNNEST([
            \\  ST_GEOGFROMTEXT('LINESTRING(-122.12 47.67, -122.19 47.69)'),
            \\  ST_GEOGFROMTEXT('LINESTRING(-122.12 47.67, -100.19 47.69)'),
            \\  ST_GEOGFROMTEXT('LINESTRING(-122.12 47.67, -122.19 47.69)')]) as items
            ,
            .rows = .{
                .{"LINESTRING(-100.19 47.69, -122.12 47.67, -122.19 47.69)"},
            },
        },
    },
}
