// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/geography/st_makeline",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/geography_functions.md#st_makeline",
    .cases = .{
        .{
            .desc = "Two points to LineString",
            .sql = "SELECT ST_ASGEOJSON(ST_MAKELINE(ST_GEOGFROMTEXT('POINT(0 0)'), ST_GEOGFROMTEXT('POINT(1 0)')))",
            .rows = .{
                .{"{\"type\":\"LineString\",\"coordinates\":[[0,0],[1,0]]}"},
            },
        },
    },
}
