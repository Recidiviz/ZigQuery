// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/geography/st_intersectsbox",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/geography_functions.md#st_intersectsbox",
    .cases = .{
        .{
            .desc = "point inside box",
            .sql = "SELECT ST_INTERSECTSBOX(ST_GEOGFROMTEXT('POINT(0.5 0.5)'), 0.0, 0.0, 1.0, 1.0)",
            .rows = .{
                .{true},
            },
        },
        .{
            .desc = "point outside box",
            .sql = "SELECT ST_INTERSECTSBOX(ST_GEOGFROMTEXT('POINT(2 2)'), 0.0, 0.0, 1.0, 1.0)",
            .rows = .{
                .{false},
            },
        },
    },
}
