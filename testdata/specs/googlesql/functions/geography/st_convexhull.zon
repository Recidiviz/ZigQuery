// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/geography/st_convexhull",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/geography_functions.md#st_convexhull",
    .cases = .{
        .{
            .desc = "triangle hull from 3 points",
            .sql = "SELECT ST_ASGEOJSON(ST_CONVEXHULL(ST_GEOGFROMTEXT('MULTIPOINT(0 0, 1 0, 0.5 1)')))",
            // ST_ASGEOJSON spaces every punctuation mark and trails a space
            // after the closing brace. (recidiviz-bigquery-sandbox, 2026-08-25)
            .rows = .{
                .{"{ \"type\": \"Polygon\", \"coordinates\": [ [ [0, 0], [1, 0], [0.5, 1], [0, 0] ] ] } "},
            },
        },
    },
}
