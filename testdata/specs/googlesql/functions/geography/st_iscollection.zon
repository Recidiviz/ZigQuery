// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/geography/st_iscollection",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/geography_functions.md#st_iscollection",
    .cases = .{
        .{
            .desc = "MULTIPOINT is a collection",
            .sql = "SELECT ST_ISCOLLECTION(ST_GEOGFROMTEXT('MULTIPOINT(0 0, 1 0)'))",
            .rows = .{
                .{true},
            },
        },
        .{
            .desc = "POINT is not",
            .sql = "SELECT ST_ISCOLLECTION(ST_GEOGFROMTEXT('POINT(0 0)'))",
            .rows = .{
                .{false},
            },
        },
    },
}
