// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/geography/st_simplify",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/geography_functions.md#st_simplify",
    .cases = .{
        .{
            .desc = "collapse near-collinear midpoint",
            .sql = "SELECT ST_ASGEOJSON(ST_SIMPLIFY(ST_GEOGFROMTEXT('LINESTRING(0 0, 0.5 0.0001, 1 0)'), 1000))",
            .rows = .{
                .{"{\"type\":\"LineString\",\"coordinates\":[[0,0],[1,0]]}"},
            },
        },
    },
}
