// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/geography/st_boundary",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/geography_functions.md#st_boundary",
    .cases = .{
        .{
            .desc = "boundary of two-point linestring",
            .sql = "SELECT ST_ASTEXT(ST_BOUNDARY(ST_GEOGFROMTEXT('LINESTRING(0 0, 1 1)'))) AS s",
            // ST_ASTEXT has no space between the geometry keyword and its
            // coordinate list: "MULTIPOINT(0 0, 1 1)". (recidiviz-bigquery-sandbox, 2026-08-25)
            .rows = .{
                .{"MULTIPOINT(0 0, 1 1)"},
            },
        },
    },
}
