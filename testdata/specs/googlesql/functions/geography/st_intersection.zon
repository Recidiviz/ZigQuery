.{
    .spec = "googlesql/functions/geography/st_intersection",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/geography_functions.md#st_intersection",
    .cases = .{
        .{
            .desc = "disjoint points -> NULL",
            .sql = "SELECT ST_INTERSECTION(ST_GEOGFROMTEXT('POINT(1 1)'), ST_GEOGFROMTEXT('POINT(2 2)')) IS NULL AS r",
            .rows = .{
                .{true},
            },
        },
    },
}
