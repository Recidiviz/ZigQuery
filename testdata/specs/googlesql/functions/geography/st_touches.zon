.{
    .spec = "googlesql/functions/geography/st_touches",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/geography_functions.md#st_touches",
    .cases = .{
        .{
            .desc = "line touches its endpoint",
            .sql = "SELECT ST_TOUCHES(ST_GEOGFROMTEXT('LINESTRING(0 0, 1 1)'), ST_GEOGFROMTEXT('POINT(1 1)')) AS r",
            .rows = .{
                .{true},
            },
        },
    },
}
