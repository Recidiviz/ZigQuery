.{
    .spec = "googlesql/functions/geography/st_equals",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/geography_functions.md#st_equals",
    .cases = .{
        .{
            .desc = "a point equals itself",
            .sql = "SELECT ST_EQUALS(ST_GEOGPOINT(1,2), ST_GEOGPOINT(1,2))",
            .rows = .{
                .{true},
            },
        },
    },
