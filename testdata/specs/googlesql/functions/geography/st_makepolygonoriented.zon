.{
    .spec = "googlesql/functions/geography/st_makepolygonoriented",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/geography_functions.md#st_makepolygonoriented",
    .cases = .{
        .{
            .desc = "simple ring constructs a polygon",
            .sql = "SELECT ST_MAKEPOLYGONORIENTED([ST_GEOGFROMTEXT('LINESTRING(0 0, 1 0, 1 1, 0 1, 0 0)')]) IS NOT NULL AS r",
            .rows = .{
                .{true},
            },
        },
    },
}
