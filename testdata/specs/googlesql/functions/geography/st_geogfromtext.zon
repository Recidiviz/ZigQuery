// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/geography/st_geogfromtext",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/geography_functions.md#st_geogfromtext",
    .cases = .{
        .{
            .desc = "parse WKT and format back",
            .sql = "SELECT ST_ASTEXT(ST_GEOGFROMTEXT('POINT(3 4)'))",
            .rows = .{
                // ST_ASTEXT has no space before the coordinate list
                // (recidiviz-bigquery-sandbox, 2026-08-25).
                .{"POINT(3 4)"},
            },
        },
    },
}
