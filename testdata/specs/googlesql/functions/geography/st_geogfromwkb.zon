// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/geography/st_geogfromwkb",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/geography_functions.md#st_geogfromwkb",
    .cases = .{
        .{
            .desc = "upstream example 1",
            .sql =
            \\WITH wkb_data AS (
            \\  SELECT '010200000002000000feffffffffffef3f000000000000f03f01000000000008400000000000000040' geo
            \\)
            \\SELECT
            \\  ST_GeogFromWkb(geo, planar=>TRUE) AS from_planar,
            \\  ST_GeogFromWkb(geo, planar=>FALSE) AS from_geodesic,
            \\FROM wkb_data
            ,
            .rows = .{
                .{ "LINESTRING(1 1, 2 1.5, 2.5 1.75, 3 2)", "LINESTRING(1 1, 3 2)" },
            },
        },
    },
}
