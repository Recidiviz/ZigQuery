// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/geography/st_closestpoint",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/geography_functions.md#st_closestpoint",
    .cases = .{
        .{
            .desc = "closest point of single-point geometry",
            .sql = "SELECT ST_ASTEXT(ST_CLOSESTPOINT(ST_GEOGFROMTEXT('POINT(0 0)'), ST_GEOGFROMTEXT('POINT(3 4)'))) AS s",
            // ST_ASTEXT has no space between the geometry keyword and its
            // coordinate list: "POINT(0 0)". (recidiviz-bigquery-sandbox, 2026-08-25)
            .rows = .{
                .{"POINT(0 0)"},
            },
        },
    },
}
