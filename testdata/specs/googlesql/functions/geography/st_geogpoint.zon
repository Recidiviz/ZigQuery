// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/geography/st_geogpoint",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/geography_functions.md#st_geogpoint",
    .cases = .{
        .{
            .desc = "construct a POINT from lon/lat",
            .sql = "SELECT ST_ASTEXT(ST_GEOGPOINT(1.5, 2.5))",
            .rows = .{
                // ST_ASTEXT has no space before the coordinate list
                // (recidiviz-bigquery-sandbox, 2026-08-25).
                .{"POINT(1.5 2.5)"},
            },
        },
    },
}
