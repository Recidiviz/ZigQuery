// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/proto/proto_modify_map",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/protocol_buffer_functions.md#proto_modify_map",
    .cases = .{
        .{
            .desc = "upstream example 1",
            .sql =
            \\SELECT
            \\  PROTO_MODIFY_MAP(m.purchased, 'A', NULL, 'B', 4, 'C', 6) AS result_map
            \\FROM
            \\  (SELECT AS VALUE CAST("purchased { key: 'A' value: 2 } purchased { key: 'B' value: 3}" AS Item)) AS m
            ,
            .skip = "register_protos: the driver has no RegisterProto",
            .rows = .{
                .{"{ key: 'B' value: 4 } { key: 'C' value: 6 }"},
            },
        },
    },
}
