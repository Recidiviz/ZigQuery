// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/debug/error",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/debugging_functions.md#error",
    .cases = .{
        // The five `|> IF` cases below assert the refusal rather than a result.
        // Pipe IF is GoogleSQL syntax BigQuery does not have: real BigQuery answers
        // `Pipe IF not supported` (bq CLI, 2026-08-04) — the same message this
        // engine gives, since FEATURE_PIPE_IF is off for that reason. Enabling it
        // resolves them correctly here, so this is scope, not a gap; see
        // shim/analyzer_shim.cc. The other cases in this file are ordinary ERROR()
        // coverage and are unaffected.
        .{
            .desc = "assertion_succeeded_with_multiple_payloads",
            .unsupported_in_bigquery = "\"Pipe ASSERT not supported\" (recidiviz-bigquery-sandbox, 2026-08-25)",
            .setup = .{
                "CREATE TABLE KeyValue AS SELECT 1 AS key, \"value1\" AS value UNION ALL SELECT 2 AS key, \"value2\" AS value",
            },
            .sql =
            \\FROM KeyValue
            \\|> ASSERT key > 0, value, ERROR("This should not trigger")
            \\|> ORDER BY key
            ,
            .rows = .{
                .{ 1, "value1" },
                .{ 2, "value2" },
            },
        },
        .{
            .desc = "default_error_no_rows",
            .sql = "SELECT ERROR(\"message\") FROM UNNEST([])",
        },
        .{
            .desc = "if_no_error",
            .sql = "SELECT IF(FALSE, ERROR(\"message\"), \"foo\")",
            .rows = .{
                .{"foo"},
            },
        },
        .{
            .desc = "run_else",
            .setup = .{
                "CREATE TABLE KeyValue AS SELECT 1 AS key, \"value1\" AS value UNION ALL SELECT 2 AS key, \"value2\" AS value",
            },
            .sql =
            \\FROM KeyValue
            \\|> IF false THEN ( |> SELECT error("1") )
            \\   ELSEIF false THEN ( |> SELECT error("2"), 'xxx' )
            \\   ELSEIF false THEN ( |> SELECT key, key, key, error("3") )
            \\   ELSEIF false THEN ( |> SELECT error("4") )
            \\   ELSE ( |> SELECT key, "selected" )
            ,
            .expect_error = "Pipe IF not supported",
        },
        .{
            .desc = "run_elseif",
            .setup = .{
                "CREATE TABLE KeyValue AS SELECT 1 AS key, \"value1\" AS value UNION ALL SELECT 2 AS key, \"value2\" AS value",
            },
            .sql =
            \\FROM KeyValue
            \\|> IF false THEN ( |> SELECT error("1") )
            \\   ELSEIF false THEN ( |> SELECT error("2"), 'xxx' )
            \\   ELSEIF true THEN ( |> SELECT key, key, key )
            \\   ELSEIF false THEN ( |> SELECT error("4") )
            \\   ELSE ( |> SELECT error("5") )
            ,
            .expect_error = "Pipe IF not supported",
        },
        .{
            .desc = "run_if_with_elses",
            .setup = .{
                "CREATE TABLE KeyValue AS SELECT 1 AS key, \"value1\" AS value UNION ALL SELECT 2 AS key, \"value2\" AS value",
            },
            .sql =
            \\FROM KeyValue
            \\|> IF true THEN ( |> SELECT key+10 )
            \\   ELSEIF false THEN ( |> SELECT key/0 )
            \\   ELSEIF false THEN ( |> SELECT bad )
            \\   ELSE ( |> SELECT error('abc') )
            ,
            .expect_error = "Pipe IF not supported",
        },
        .{
            .desc = "run_no_case",
            .setup = .{
                "CREATE TABLE KeyValue AS SELECT 1 AS key, \"value1\" AS value UNION ALL SELECT 2 AS key, \"value2\" AS value",
            },
            .sql =
            \\FROM KeyValue
            \\|> IF false THEN ( |> SELECT error("1") )
            \\   ELSEIF false THEN ( |> SELECT error("2"), 'xxx' )
            \\   ELSEIF false THEN ( |> SELECT key, key, key, error("3") )
            \\   ELSEIF false THEN ( |> SELECT error("4") )
            ,
            .expect_error = "Pipe IF not supported",
        },
        .{
            .desc = "typeof_error_function",
            .sql = "SELECT TYPEOF(ERROR('abc'))",
            .rows = .{
                .{"INT64"},
            },
        },
        .{
            .desc = "unselected_cases_dont_run",
            .setup = .{
                "CREATE TABLE KeyValue AS SELECT 1 AS key, \"value1\" AS value UNION ALL SELECT 2 AS key, \"value2\" AS value",
            },
            .sql =
            \\FROM KeyValue
            \\|> IF false THEN ( |> EXTEND ERROR("oops") )
            \\   ELSEIF false THEN ( |> EXTEND bad_column )
            ,
            .expect_error = "Pipe IF not supported",
        },
    },
}
