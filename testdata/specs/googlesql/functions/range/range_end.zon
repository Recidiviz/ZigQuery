.{
    .spec = "googlesql/functions/range/range_end",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/range-functions.md#range_end",
    .cases = .{
        .{
            .desc = "upstream example 1",
            .sql = "SELECT RANGE_END(RANGE<DATE> '[2022-12-01, 2022-12-31)') AS results",
            .rows = .{
                .{"2022-12-31"},
            },
        },
        .{
            .desc = "upstream example 2",
            .sql = "SELECT RANGE_END(RANGE<DATE> '[2022-12-01, UNBOUNDED)') AS results",
            .rows = .{
                .{null},
            },
        },
    },
}
