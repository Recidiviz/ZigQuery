// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/date/date_add",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/date_functions.md#date_add",
    .cases = .{
        .{
            .desc = "add 5 days",
            .sql = "SELECT FORMAT_DATE('%Y-%m-%d', DATE_ADD(DATE '2020-01-01', INTERVAL 5 DAY))",
            .rows = .{
                .{"2020-01-06"},
            },
        },
    },
}
