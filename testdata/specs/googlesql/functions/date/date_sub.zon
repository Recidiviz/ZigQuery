// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/date/date_sub",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/date_functions.md#date_sub",
    .cases = .{
        .{
            .desc = "subtract 5 days",
            .sql = "SELECT FORMAT_DATE('%Y-%m-%d', DATE_SUB(DATE '2020-01-10', INTERVAL 5 DAY))",
            .rows = .{
                .{"2020-01-05"},
            },
        },
    },
}
