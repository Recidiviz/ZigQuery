// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/string/lower",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/string_functions.md#lower",
    .cases = .{
        .{
            .desc = "ascii lowercase",
            .sql = "SELECT LOWER('HELLO')",
            .rows = .{
                .{"hello"},
            },
        },
        .{
            .desc = "already lowercase is unchanged",
            .sql = "SELECT LOWER('abc')",
            .rows = .{
                .{"abc"},
            },
        },
        .{
            .desc = "empty string",
            .sql = "SELECT LOWER('')",
            .rows = .{
                .{""},
            },
        },
        .{
            .desc = "null propagates",
            .sql = "SELECT LOWER(NULL)",
            .rows = .{
                .{null},
            },
        },
    },
}
