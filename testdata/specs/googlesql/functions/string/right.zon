.{
    .spec = "googlesql/functions/string/right",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/string_functions.md#right",
    .cases = .{
        .{
            .desc = "rightmost three chars",
            .sql = "SELECT RIGHT('hello', 3)",
            .rows = .{
                .{"llo"},
            },
        },
    },
}
