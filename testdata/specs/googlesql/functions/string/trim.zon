// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/string/trim",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/string_functions.md#trim",
    .cases = .{
        .{
            .desc = "trim spaces",
            .sql = "SELECT TRIM('  hi  ')",
            .rows = .{
                .{"hi"},
            },
        },
        .{
            .desc = "no whitespace",
            .sql = "SELECT TRIM('hi')",
            .rows = .{
                .{"hi"},
            },
        },
    },
}
