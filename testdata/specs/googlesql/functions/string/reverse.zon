// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/string/reverse",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/string_functions.md#reverse",
    .cases = .{
        .{
            .desc = "reverse ascii",
            .sql = "SELECT REVERSE('abc')",
            .rows = .{
                .{"cba"},
            },
        },
        .{
            .desc = "empty string",
            .sql = "SELECT REVERSE('')",
            .rows = .{
                .{""},
            },
        },
    },
}
