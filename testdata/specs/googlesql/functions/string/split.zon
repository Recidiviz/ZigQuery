// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/string/split",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/string_functions.md#split",
    .cases = .{
        .{
            .desc = "split on comma",
            .sql = "SELECT SPLIT(\"a,b,c\", \",\")",
            .rows = .{
                .{.{ "a", "b", "c" }},
            },
        },
        .{
            .desc = "split on space",
            .sql = "SELECT SPLIT(\"hello world foo\", \" \")",
            .rows = .{
                .{.{ "hello", "world", "foo" }},
            },
        },
    },
}
