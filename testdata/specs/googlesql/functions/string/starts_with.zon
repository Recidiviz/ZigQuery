// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/string/starts_with",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/string_functions.md#starts_with",
    .cases = .{
        .{
            .desc = "matches prefix",
            .sql = "SELECT STARTS_WITH('hello', 'he')",
            .rows = .{
                .{true},
            },
        },
        .{
            .desc = "does not match",
            .sql = "SELECT STARTS_WITH('hello', 'lo')",
            .rows = .{
                .{false},
            },
        },
    },
}
