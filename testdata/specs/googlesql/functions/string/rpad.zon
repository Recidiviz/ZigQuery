// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/string/rpad",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/string_functions.md#rpad",
    .cases = .{
        .{
            .desc = "pad to length 5",
            .sql = "SELECT RPAD('hi', 5, '*')",
            .rows = .{
                .{"hi***"},
            },
        },
    },
}
