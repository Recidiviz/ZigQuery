.{
    .spec = "googlesql/functions/string/regexp_replace",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/string_functions.md#regexp_replace",
    .cases = .{
        .{
            .desc = "replace digits",
            .sql = "SELECT REGEXP_REPLACE(\"a1b2c3\", \"[0-9]\", \"X\")",
            .rows = .{
                .{"aXbXcX"},
            },
        },
    },
}
