// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/string/length",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/string_functions.md#length",
    .cases = .{
        .{
            .desc = "ascii string length",
            .sql = "SELECT LENGTH('abc')",
            .rows = .{
                .{3},
            },
        },
        .{
            .desc = "empty string is zero",
            .sql = "SELECT LENGTH('')",
            .rows = .{
                .{0},
            },
        },
        .{
            .desc = "null propagates",
            .sql = "SELECT LENGTH(NULL)",
            .rows = .{
                .{null},
            },
        },
    },
}
