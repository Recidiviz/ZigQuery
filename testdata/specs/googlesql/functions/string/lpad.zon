// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/string/lpad",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/string_functions.md#lpad",
    .cases = .{
        .{
            .desc = "pad to length 5",
            .sql = "SELECT LPAD('hi', 5, '*')",
            .rows = .{
                .{"***hi"},
            },
        },
        .{
            .desc = "same length is unchanged",
            .sql = "SELECT LPAD('hi', 2, '*')",
            .rows = .{
                .{"hi"},
            },
        },
    },
}
