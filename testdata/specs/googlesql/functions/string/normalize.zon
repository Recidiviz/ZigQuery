.{
    .spec = "googlesql/functions/string/normalize",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/string_functions.md#normalize",
    .cases = .{
        .{
            .desc = "NFC normalization is idempotent on ASCII",
            .sql = "SELECT NORMALIZE(\"hello\")",
            .rows = .{
                .{"hello"},
            },
        },
    },
}
