// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/string/concat",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/string_functions.md#concat",
    .cases = .{
        .{
            .desc = "two strings",
            .sql = "SELECT CONCAT('a', 'b')",
            .rows = .{
                .{"ab"},
            },
        },
        .{
            .desc = "three strings",
            .sql = "SELECT CONCAT('a', 'b', 'c')",
            .rows = .{
                .{"abc"},
            },
        },
        .{
            .desc = "with empty string",
            .sql = "SELECT CONCAT('a', '', 'b')",
            .rows = .{
                .{"ab"},
            },
        },
        .{
            .desc = "single argument",
            .sql = "SELECT CONCAT('only')",
            .rows = .{
                .{"only"},
            },
        },
    },
}
