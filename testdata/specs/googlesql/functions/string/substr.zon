// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/string/substr",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/string_functions.md#substr",
    .cases = .{
        .{
            .desc = "extract from middle",
            .sql = "SELECT SUBSTR('hello', 2, 3)",
            .rows = .{
                .{"ell"},
            },
        },
        .{
            .desc = "from position to end",
            .sql = "SELECT SUBSTR('hello', 3)",
            .rows = .{
                .{"llo"},
            },
        },
        .{
            .desc = "length zero returns empty string",
            .sql = "SELECT SUBSTR('hello', 1, 0)",
            .rows = .{
                .{""},
            },
        },
        .{
            .desc = "null source propagates",
            .sql = "SELECT SUBSTR(NULL, 1, 1)",
            .rows = .{
                .{null},
            },
        },
    },
}
