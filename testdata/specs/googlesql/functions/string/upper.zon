// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/string/upper",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/string_functions.md#upper",
    .cases = .{
        .{
            .desc = "ascii uppercase",
            .sql = "SELECT UPPER('hello')",
            .rows = .{
                .{"HELLO"},
            },
        },
        .{
            .desc = "already uppercase is unchanged",
            .sql = "SELECT UPPER('ABC')",
            .rows = .{
                .{"ABC"},
            },
        },
        .{
            .desc = "empty string",
            .sql = "SELECT UPPER('')",
            .rows = .{
                .{""},
            },
        },
        .{
            .desc = "null propagates",
            .sql = "SELECT UPPER(NULL)",
            .rows = .{
                .{null},
            },
        },
    },
}
