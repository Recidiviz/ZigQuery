// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/string/repeat",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/string_functions.md#repeat",
    .cases = .{
        .{
            .desc = "repeat thrice",
            .sql = "SELECT REPEAT('ab', 3)",
            .rows = .{
                .{"ababab"},
            },
        },
        .{
            .desc = "zero repetitions",
            .sql = "SELECT REPEAT('ab', 0)",
            .rows = .{
                .{""},
            },
        },
    },
}
