// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/string/collate",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/string_functions.md#collate",
    .cases = .{
        .{
            .desc = "upstream example 1",
            .sql =
            \\WITH Words AS (
            \\  SELECT
            \\    COLLATE('a', 'und:ci') AS char1,
            \\    COLLATE('Z', 'und:ci') AS char2
            \\)
            \\SELECT ( Words.char1 < Words.char2 ) AS a_less_than_Z
            \\FROM Words
            ,
            .rows = .{
                .{true},
            },
        },
        .{
            .desc = "upstream example 2",
            .sql =
            \\WITH Words AS (
            \\  SELECT
            \\    'a' AS char1,
            \\    'Z' AS char2
            \\)
            \\SELECT ( Words.char1 < Words.char2 ) AS a_less_than_Z
            \\FROM Words
            ,
            .rows = .{
                .{false},
            },
        },
    },
}
