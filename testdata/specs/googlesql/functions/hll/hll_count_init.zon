.{
    .spec = "googlesql/functions/hll/hll_count_init",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/hll_functions.md#hll_countinit",
    .cases = .{
        .{
            .desc = "HLL_COUNT.INIT produces a non-empty sketch",
            .sql = "SELECT BYTE_LENGTH(HLL_COUNT.INIT(x)) > 0 FROM UNNEST([1, 2, 3]) AS x",
            .rows = .{
                .{true},
            },
        },
    },
}
