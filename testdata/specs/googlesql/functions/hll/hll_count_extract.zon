// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/hll/hll_count_extract",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/hll_functions.md#hll_countextract",
    .cases = .{
        .{
            .desc = "HLL_COUNT.EXTRACT through INIT pipeline returns approximate cardinality",
            .sql = "SELECT HLL_COUNT.EXTRACT(HLL_COUNT.INIT(x)) >= 0 FROM UNNEST([1, 2, 3]) AS x",
            .rows = .{
                .{true},
            },
        },
    },
}
