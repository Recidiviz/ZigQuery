// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/math/trunc",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/mathematical_functions.md#trunc",
    .cases = .{
        .{
            .desc = "truncate positive fraction",
            .sql = "SELECT TRUNC(1.7)",
            .rows = .{
                .{1.0},
            },
        },
        .{
            .desc = "truncate negative fraction",
            .sql = "SELECT TRUNC(-1.7)",
            .rows = .{
                .{-1.0},
            },
        },
    },
}
