// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/math/abs",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/mathematical_functions.md#abs",
    .cases = .{
        .{
            .desc = "negative integer",
            .sql = "SELECT ABS(-5)",
            .rows = .{
                .{5},
            },
        },
        .{
            .desc = "positive integer is unchanged",
            .sql = "SELECT ABS(5)",
            .rows = .{
                .{5},
            },
        },
        .{
            .desc = "zero",
            .sql = "SELECT ABS(0)",
            .rows = .{
                .{0},
            },
        },
        .{
            .desc = "negative float",
            .sql = "SELECT ABS(-2.5)",
            .rows = .{
                .{2.5},
            },
        },
        .{
            .desc = "null propagates",
            .sql = "SELECT ABS(NULL)",
            .rows = .{
                .{null},
            },
        },
    },
}
