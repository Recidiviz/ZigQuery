// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/math/euclidean_distance",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/mathematical_functions.md#euclidean_distance",
    .cases = .{
        .{
            .desc = "distance between two vectors",
            .sql = "SELECT EUCLIDEAN_DISTANCE([1.0, 2.0], [4.0, 6.0])",
            .rows = .{
                .{5.0},
            },
        },
        .{
            .desc = "zero distance for identical vectors",
            .sql = "SELECT EUCLIDEAN_DISTANCE([1.0, 2.0, 3.0], [1.0, 2.0, 3.0])",
            .rows = .{
                .{0.0},
            },
        },
    },
}
