// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/math/mod",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/mathematical_functions.md#mod",
    .cases = .{
        .{
            .desc = "positive mod",
            .sql = "SELECT MOD(10, 3)",
            .rows = .{
                .{1},
            },
        },
        .{
            .desc = "zero mod is the dividend",
            .sql = "SELECT MOD(0, 5)",
            .rows = .{
                .{0},
            },
        },
    },
}
