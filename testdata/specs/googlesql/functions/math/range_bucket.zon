// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/math/range_bucket",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/mathematical_functions.md#range_bucket",
    .cases = .{
        .{
            .desc = "bucket index when value falls between boundaries",
            .sql = "SELECT RANGE_BUCKET(2, [1, 3, 5])",
            .rows = .{
                .{1},
            },
        },
        .{
            .desc = "bucket 0 when value is below all boundaries",
            .sql = "SELECT RANGE_BUCKET(0, [1, 3, 5])",
            .rows = .{
                .{0},
            },
        },
    },
}
