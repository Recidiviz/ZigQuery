// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/math/ceil",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/mathematical_functions.md#ceil",
    .cases = .{
        .{
            .desc = "rounds up positive fraction",
            .sql = "SELECT CEIL(1.2)",
            .rows = .{
                .{2.0},
            },
        },
        .{
            .desc = "rounds toward zero on negative fraction",
            .sql = "SELECT CEIL(-1.2)",
            .rows = .{
                .{-1.0},
            },
        },
        .{
            .desc = "integer value is unchanged",
            .sql = "SELECT CEIL(3.0)",
            .rows = .{
                .{3.0},
            },
        },
        .{
            .desc = "null propagates",
            .sql = "SELECT CEIL(NULL)",
            .rows = .{
                .{null},
            },
        },
    },
}
