// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/math/ieee_divide",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/mathematical_functions.md#ieee_divide",
    .cases = .{
        .{
            .desc = "division by zero returns +Infinity",
            .sql = "SELECT IS_INF(IEEE_DIVIDE(1.0, 0.0))",
            .rows = .{
                .{true},
            },
        },
        .{
            .desc = "regular division",
            .sql = "SELECT IEEE_DIVIDE(10.0, 2.0)",
            .rows = .{
                .{5.0},
            },
        },
    },
}
