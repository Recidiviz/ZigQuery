// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/net/net_ip_trunc",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/net_functions.md#netip_trunc",
    .cases = .{
        .{
            .desc = "NET.IP_TRUNC of an IPv4 to /24 returns the network bytes",
            .sql = "SELECT NET.IP_TO_STRING(NET.IP_TRUNC(NET.IP_FROM_STRING('192.168.1.10'), 24))",
            .rows = .{
                .{"192.168.1.0"},
            },
        },
    },
}
