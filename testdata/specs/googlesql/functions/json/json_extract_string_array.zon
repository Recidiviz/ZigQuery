.{
    .spec = "googlesql/functions/json/json_extract_string_array",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/json_functions.md#json_extract_string_array",
    .cases = .{
        .{
            .desc = "json_extract_string_array basic behaviour",
