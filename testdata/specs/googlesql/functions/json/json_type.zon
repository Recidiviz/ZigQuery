// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/json/json_type",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/json_functions.md#json_type",
    .cases = .{
        .{
            .desc = "object type",
            .sql =
            \\SELECT JSON_TYPE(JSON '{"a": 1}')
            ,
            .rows = .{
                .{"object"},
            },
        },
        .{
            .desc = "array type",
            .sql =
            \\SELECT JSON_TYPE(JSON '[1, 2, 3]')
            ,
            .rows = .{
                .{"array"},
            },
        },
        .{
            .desc = "number type",
            .sql =
            \\SELECT JSON_TYPE(JSON '42')
            ,
            .rows = .{
                .{"number"},
            },
        },
    },
}
