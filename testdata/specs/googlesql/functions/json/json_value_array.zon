.{
    .spec = "googlesql/functions/json/json_value_array",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/json_functions.md#json_value_array",
    .cases = .{
        .{
            .desc = "json_value_array basic behaviour",
            .sql = "SELECT TO_JSON_STRING(JSON_VALUE_ARRAY(JSON '[\"a\",\"b\"]'))",
            .rows = .{
                .{"[\"a\",\"b\"]"},
            },
        },
    },
}
