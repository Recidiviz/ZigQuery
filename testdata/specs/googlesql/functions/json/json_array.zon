// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/json/json_array",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/json_functions.md#json_array",
    .cases = .{
        .{
            .desc = "build a heterogeneous JSON array",
            .sql = "SELECT TO_JSON_STRING(JSON_ARRAY(1, 2, 'three'))",
            .rows = .{
                .{"[1,2,\"three\"]"},
            },
        },
    },
}
