// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/json/json_value",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/json_functions.md#json_value",
    .cases = .{
        .{
            .desc = "extract string by JSONPath",
            .sql =
            \\SELECT JSON_VALUE('{"name": "alice"}', "$.name")
            ,
            .rows = .{
                .{"alice"},
            },
        },
    },
}
