.{
    .spec = "googlesql/functions/json/json_extract",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/json_functions.md#json_extract",
    .cases = .{
        .{
            .desc = "extract object subtree",
            .sql =
            \\SELECT JSON_EXTRACT('{"a": 1, "b": 2}', "$.a")
            ,
            .rows = .{
                .{"1"},
            },
        },
    },
}
