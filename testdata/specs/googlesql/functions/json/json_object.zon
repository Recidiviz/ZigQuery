// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/json/json_object",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/json_functions.md#json_object",
    .cases = .{
        .{
            .desc = "build a single-key JSON object",
            .sql = "SELECT TO_JSON_STRING(JSON_OBJECT('k', 1))",
            .rows = .{
                .{"{\"k\":1}"},
            },
        },
    },
}
