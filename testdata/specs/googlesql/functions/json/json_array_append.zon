.{
    .spec = "googlesql/functions/json/json_array_append",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/json_functions.md#json_array_append",
    .cases = .{
        .{
            .desc = "append to top-level array",
            .sql = "SELECT JSON_ARRAY_APPEND(PARSE_JSON('[1,2]'), '$', 3)",
            .rows = .{
                .{"[1,2,3]"},
            },
        },
    },
}
