.{
    .spec = "googlesql/functions/conversion/parse_numeric",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/conversion_functions.md#parse_numeric",
    .cases = .{
        .{
            .desc = "parse plain decimal",
            .sql = "SELECT CAST(PARSE_NUMERIC(\"1.5\") AS STRING)",
            .rows = .{
                .{"1.5"},
            },
        },
    },
}
