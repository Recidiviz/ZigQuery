// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/conversion/cast",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/conversion_functions.md#cast",
    .cases = .{
        .{
            .desc = "int to string",
            .sql = "SELECT CAST(42 AS STRING)",
            .rows = .{
                .{"42"},
            },
        },
        .{
            .desc = "string to int",
            .sql = "SELECT CAST(\"123\" AS INT64)",
            .rows = .{
                .{123},
            },
        },
        .{
            .desc = "int to float",
            .sql = "SELECT CAST(7 AS FLOAT64)",
            .rows = .{
                .{7.0},
            },
        },
    },
}
