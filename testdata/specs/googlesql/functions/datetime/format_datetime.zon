// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/datetime/format_datetime",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/datetime_functions.md#format_datetime",
    .cases = .{
        .{
            .desc = "ISO-style formatting",
            .sql = "SELECT FORMAT_DATETIME(\"%Y-%m-%dT%H:%M:%S\", DATETIME \"2024-03-15T12:30:45\")",
            .rows = .{
                .{"2024-03-15T12:30:45"},
            },
        },
    },
}
