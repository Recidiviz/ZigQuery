// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/timestamp/format_timestamp",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/timestamp_functions.md#format_timestamp",
    .cases = .{
        .{
            .desc = "ISO format with explicit UTC",
            .sql =
            \\SELECT FORMAT_TIMESTAMP("%Y-%m-%dT%H:%M:%S", TIMESTAMP "2024-03-15 12:30:45+00", "UTC")
            ,
            .rows = .{
                .{"2024-03-15T12:30:45"},
            },
        },
    },
}
