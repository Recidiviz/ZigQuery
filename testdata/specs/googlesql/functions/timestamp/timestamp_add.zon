// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "googlesql/functions/timestamp/timestamp_add",
    .dialect = .googlesql,
    .upstream = "https://github.com/google/googlesql/blob/master/docs/timestamp_functions.md#timestamp_add",
    .cases = .{
        .{
            .desc = "add 1 hour and check via unix seconds",
            .sql =
            \\SELECT UNIX_SECONDS(TIMESTAMP_ADD(TIMESTAMP "2024-03-15 12:00:00+00", INTERVAL 1 HOUR))
            ,
            .rows = .{
                .{1710507600},
            },
        },
    },
}
