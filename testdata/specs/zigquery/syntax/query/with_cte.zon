.{
    .spec = "zigquery/syntax/query/with_cte",
    .dialect = .zigquery,
    .typed = true,
    .cases = .{
        .{
            .desc = "with clause",
            .sql =
            \\
            \\WITH sub1 AS (SELECT ["a", "b"]),
            \\     sub2 AS (SELECT ["c", "d"])
            \\SELECT * FROM sub1
            \\UNION ALL
            \\SELECT * FROM sub2
            ,
            .rows = .{
                .{.{ "a", "b" }},
                .{.{ "c", "d" }},
            },
        },
        .{
            .desc = "subquery with",
            .sql =
            \\
            \\WITH tmp as (
            \\  SELECT * FROM (
            \\    WITH A AS (
            \\      SELECT * FROM (SELECT 1 AS id)
            \\    )  SELECT * FROM A
            \\  )
            \\) SELECT id FROM tmp
            ,
            .rows = .{
                .{1},
            },
        },
        .{
            .desc = "nested with",
            .sql = "WITH output AS ( WITH sub AS ( SELECT val FROM UNNEST([1, 2, 3]) as val ) SELECT * FROM sub WHERE val > 1 ) SELECT * FROM output",
            .rows = .{
                .{2},
                .{3},
            },
        },
        .{
            .desc = "nested with 2",
            .sql =
            \\
            \\WITH tmp as (
            \\  WITH A AS (
            \\    SELECT * FROM (SELECT 1 AS id)
            \\  ), B AS (
            \\    SELECT * FROM (SELECT "hello" AS name)
            \\  ) SELECT * FROM A CROSS JOIN B
            \\) SELECT * FROM tmp
            ,
            .rows = .{
                .{ 1, "hello" },
            },
        },
        .{
            .desc = "with ref scan maps column aliases correctly",
            .sql =
            \\CREATE TEMPORARY TABLE events (ID STRING, DT STRING);
            \\WITH events_cte AS (
            \\    SELECT
            \\        CAST(ID AS string) as event_id,
            \\        EXTRACT(DATE FROM PARSE_DATETIME("%m/%d/%y %H:%M", NULLIF(DT, "09/17/25 00:00"))) as event_date
            \\    FROM events
            \\)
            \\SELECT
            \\    event_id,
            \\    event_date as occurrence_date,
            \\FROM events_cte
            \\WHERE EXTRACT(YEAR from event_date) = 2025
            ,
            .rows = .{},
        },
    },
}
