.{
    .spec = "zigquery/syntax/query/predicates",
    .dialect = .zigquery,
    .typed = true,
    .cases = .{
        .{
            .desc = "like operator",
            .sql = "SELECT \"abcd\" LIKE \"a%d\"",
            .rows = .{
                .{true},
            },
        },
        .{
            .desc = "like operator - special regex characters",
            .sql = "SELECT 'my*string' LIKE '%%*%%', 'my*string' LIKE '%%([][%';",
            .rows = .{
                .{ true, false },
            },
        },
        .{
            .desc = "like operator2",
            .sql = "SELECT \"abcd\" LIKE \"%a%\"",
            .rows = .{
                .{true},
            },
        },
        .{
            .desc = "like operator3",
            .sql = "SELECT \"abcd\" LIKE \"%b%\"",
            .rows = .{
                .{true},
            },
        },
        .{
            .desc = "like operator4",
            .sql = "SELECT \"dog\" LIKE \"o%\"",
            .rows = .{
                .{false},
            },
        },
        .{
            .desc = "not like operator",
            .sql = "SELECT \"abcd\" NOT LIKE \"a%d\"",
            .rows = .{
                .{false},
            },
        },
        .{
            .desc = "between operator",
            .sql = "SELECT DATE \"2022-09-10\" BETWEEN \"2022-09-01\" and \"2022-10-01\", (SELECT NULL) BETWEEN 0 AND 2",
            .rows = .{
                .{ true, null },
            },
        },
        .{
            .desc = "not between operator",
            .sql = "SELECT DATE \"2020-09-10\" NOT BETWEEN \"2022-09-01\" and \"2022-10-01\", (SELECT NULL) BETWEEN 0 AND 2",
            .rows = .{
                .{ true, null },
            },
        },
        // BETWEEN is `x >= lo AND x <= hi` under three-valued logic, so a FALSE
        // from one bound wins over a NULL from the other: 5 is in no range
        // starting at 10, whatever the upper bound holds.
        // operators.md#comparison_operators
        .{
            .desc = "between operator with a null bound",
            .sql = "SELECT 5 BETWEEN 10 AND NULL, 5 BETWEEN 1 AND NULL, 5 BETWEEN NULL AND 1, 5 BETWEEN NULL AND 10",
            .rows = .{
                .{ false, null, false, null },
            },
        },
        .{
            .desc = "between operator with a null bound, over columns",
            .sql = "SELECT x BETWEEN lo AND hi, x BETWEEN 1 AND hi FROM (SELECT 5 AS x, 10 AS lo, CAST(NULL AS INT64) AS hi)",
            .rows = .{
                .{ false, null },
            },
        },
        .{
            .desc = "in operator",
            .sql = "SELECT 3 IN (1, 2, 3, 4), null IN (1), null IN (null)",
            .rows = .{
                .{ true, null, null },
            },
        },
        // A NULL list element is an unknown value: it blocks a FALSE but never
        // a TRUE (operators.md#in_operators). Each case runs twice because the
        // two evaluation paths must agree — a NULL literal operand keeps the
        // UDF, columns lower to SQLite's IN.
        .{
            .desc = "in operator with a null in the list",
            .sql = "SELECT 1 IN (1, NULL), 2 IN (1, NULL)",
            .rows = .{
                .{ true, null },
            },
        },
        .{
            .desc = "in operator with a null in the list, over columns",
            .sql = "SELECT hit IN (a, b), miss IN (a, b) FROM (SELECT 1 AS hit, 2 AS miss, 1 AS a, CAST(NULL AS INT64) AS b)",
            .rows = .{
                .{ true, null },
            },
        },
        .{
            .desc = "in operator with a null in a longer list",
            .sql = "SELECT 5 IN (1, 5, 10, NULL), 6 IN (1, 5, 10, NULL)",
            .rows = .{
                .{ true, null },
            },
        },
        .{
            .desc = "in operator with function",
            .sql = "SELECT NOT(RIGHT('apple', 3) IN (SELECT DISTINCT c FROM (select 'ple' as c)))",
            .rows = .{
                .{false},
            },
        },
        .{
            .desc = "not in operator",
            .sql = "SELECT 5 NOT IN (1, 2, 3, 4), null NOT IN (1), null NOT IN (null)",
            .rows = .{
                .{ true, null, null },
            },
        },
        .{
            .desc = "is null operator",
            .sql = "SELECT NULL IS NULL",
            .rows = .{
                .{true},
            },
        },
        .{
            .desc = "is not null operator",
            .sql = "SELECT 1 IS NOT NULL",
            .rows = .{
                .{true},
            },
        },
        .{
            .desc = "is true operator",
            .sql = "SELECT true IS TRUE",
            .rows = .{
                .{true},
            },
        },
        .{
            .desc = "is not true operator",
            .sql = "SELECT false IS NOT TRUE",
            .rows = .{
                .{true},
            },
        },
        .{
            .desc = "is false operator",
            .sql = "SELECT false IS FALSE",
            .rows = .{
                .{true},
            },
        },
        .{
            .desc = "is not false operator",
            .sql = "SELECT true IS NOT FALSE",
            .rows = .{
                .{true},
            },
        },
        // IS TRUE and IS FALSE are total: TRUE or FALSE for every input, NULL
        // included (operators.md#is_operators). A NULL operand is the only one
        // where `x IS TRUE` differs from plain `x`.
        .{
            .desc = "is true and is false over a null are false, not null",
            .sql = "SELECT CAST(NULL AS BOOL) IS TRUE, CAST(NULL AS BOOL) IS FALSE",
            .rows = .{
                .{ false, false },
            },
        },
        .{
            .desc = "is not true and is not false over a null are true, not null",
            .sql = "SELECT CAST(NULL AS BOOL) IS NOT TRUE, CAST(NULL AS BOOL) IS NOT FALSE",
            .rows = .{
                .{ true, true },
            },
        },
        .{
            .desc = "is true over a null column, where nothing folds",
            .sql = "SELECT b IS TRUE, b IS FALSE, b IS NOT TRUE, b IS NOT FALSE FROM (SELECT CAST(NULL AS BOOL) AS b)",
            .rows = .{
                .{ false, false, true, true },
            },
        },
        .{
            .desc = "exists",
            .sql = "SELECT EXISTS ( SELECT val FROM UNNEST([1, 2, 3]) AS val WHERE val = 1 )",
            .rows = .{
                .{true},
            },
        },
        .{
            .desc = "not exists",
            .sql = "SELECT EXISTS ( SELECT val FROM UNNEST([1, 2, 3]) AS val WHERE val = 4 )",
            .rows = .{
                .{false},
            },
        },
        .{
            .desc = "is distinct from with 1 and 2",
            .sql = "SELECT 1 IS DISTINCT FROM 2",
            .rows = .{
                .{true},
            },
        },
        .{
            .desc = "is distinct from with 1 and null",
            .sql = "SELECT 1 IS DISTINCT FROM NULL",
            .rows = .{
                .{true},
            },
        },
        .{
            .desc = "is not distinct from with 1 and 1",
            .sql = "SELECT 1 IS NOT DISTINCT FROM 1",
            .rows = .{
                .{true},
            },
        },
        .{
            .desc = "is not distinct from with null and null",
            .sql = "SELECT NULL IS NOT DISTINCT FROM NULL",
            .rows = .{
                .{true},
            },
        },
        .{
            .desc = "is distinct from with null and null",
            .sql = "SELECT NULL IS DISTINCT FROM NULL",
            .rows = .{
                .{false},
            },
        },
        .{
            .desc = "is distinct from with 1 and 1",
            .sql = "SELECT 1 IS DISTINCT FROM 1",
            .rows = .{
                .{false},
            },
        },
        .{
            .desc = "is not distinct from with 1 and 2",
            .sql = "SELECT 1 IS NOT DISTINCT FROM 2",
            .rows = .{
                .{false},
            },
        },
        .{
            .desc = "is not distinct from with 1 and null",
            .sql = "SELECT 1 IS NOT DISTINCT FROM NULL",
            .rows = .{
                .{false},
            },
        },
    },
}
