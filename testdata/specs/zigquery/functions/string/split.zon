.{
    .spec = "zigquery/functions/string/split",
    .dialect = .zigquery,
    .typed = true,
    .cases = .{
        .{
            .desc = "split",
            .sql =
            \\
            \\WITH letters AS (
            \\  SELECT '' as letter_group UNION ALL
            \\  SELECT 'a' as letter_group UNION ALL
            \\  SELECT 'b c d' as letter_group UNION ALL
            \\  SELECT NULL as letter_group
            \\) SELECT SPLIT(letter_group, ' ') FROM letters
            ,
            .rows = .{
                .{.{""}},
                .{.{"a"}},
                .{.{ "b", "c", "d" }},
                .{null},
            },
        },
        .{
            .desc = "split null delimiter",
            .sql = "SELECT SPLIT('abc', NULL), SPLIT(b'\\xab\\xcd\\xef\\xaa\\xbb', NULL)",
            .rows = .{
                .{ null, null },
            },
        },
        // Any NULL argument gives a NULL ARRAY, so OFFSET(0) is NULL and IS NULL is true.
        // Query results render a NULL array as [] (data-types.md#array_nulls).
        .{
            .desc = "split null argument is a null array inside the query",
            .sql =
            \\SELECT SPLIT(CAST(NULL AS STRING), '=')[OFFSET(0)],
            \\  SPLIT(CAST(NULL AS STRING), '=') IS NULL,
            \\  SPLIT(b'x', NULL) IS NULL
            ,
            .rows = .{
                .{ null, true, true },
            },
        },
    },
}
