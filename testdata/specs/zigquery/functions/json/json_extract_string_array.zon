.{
    .spec = "zigquery/functions/json/json_extract_string_array",
    .dialect = .zigquery,
    .typed = true,
    .cases = .{
        .{
            .desc = "json_extract_string_array",
            .sql = "SELECT JSON_EXTRACT_STRING_ARRAY(JSON '{\"fruits\":[\"apples\",\"oranges\",\"grapes\"]}','$.fruits')",
            .rows = .{
                .{.{ "apples", "oranges", "grapes" }},
            },
        },
        .{
            .desc = "json_extract_string_array with root only",
            .sql = "SELECT JSON_EXTRACT_STRING_ARRAY('[\"foo\",\"bar\",\"baz\"]','$')",
            .rows = .{
                .{.{ "foo", "bar", "baz" }},
            },
        },
        .{
            .desc = "json_extract_string_array with integer cast",
            .sql = "SELECT ARRAY(SELECT CAST(integer_element AS INT64) FROM UNNEST(JSON_EXTRACT_STRING_ARRAY('[1,2,3]','$')) AS integer_element)",
            .rows = .{
                .{.{ 1, 2, 3 }},
            },
        },
        .{
            .desc = "json_extract_string_array with escape",
            .sql = "SELECT JSON_EXTRACT_STRING_ARRAY('{\"a.b\": {\"c\": [\"world\"]}}', \"$['a.b'].c\")",
            .rows = .{
                .{.{"world"}},
            },
        },
        .{
            .desc = "json_extract_string_array with null",
            .sql =
            \\
            \\SELECT
            \\  JSON_EXTRACT_STRING_ARRAY('}}','$'),
            \\  JSON_EXTRACT_STRING_ARRAY(NULL,'$'),
            \\  JSON_EXTRACT_STRING_ARRAY('{"a":["foo","bar","baz"]}','$.b'),
            \\  JSON_EXTRACT_STRING_ARRAY('{"a":"foo"}','$'),
            \\  JSON_EXTRACT_STRING_ARRAY('{"a":[{"b":"foo","c":1},{"b":"bar","c":2}],"d":"baz"}','$.a'),
            \\  JSON_EXTRACT_STRING_ARRAY('{"a":[10, {"b": 20}]','$.a'),
            \\  JSON_EXTRACT_STRING_ARRAY(JSON 'null', '$')
            ,
            .rows = .{
                .{ null, null, null, null, null, null, null },
            },
        },
        .{
            .desc = "json_extract_string_array with empty array",
            .sql = "SELECT JSON_EXTRACT_STRING_ARRAY('{\"a\":\"foo\",\"b\":[]}','$.b')",
            .rows = .{
                .{.{}},
            },
        },
    },
}
