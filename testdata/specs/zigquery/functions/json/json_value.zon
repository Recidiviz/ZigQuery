.{
    .spec = "zigquery/functions/json/json_value",
    .dialect = .zigquery,
    .typed = true,
    .cases = .{
        .{
            .desc = "json value subscript operator",
            .sql =
            \\
            \\SELECT json_value.class.students[0]['name'] AS first_student
            \\FROM
            \\  UNNEST(
            \\    [
            \\      JSON '{"class" : {"students" : [{"name" : "Jane"}]}}',
            \\      JSON '{"class" : {"students" : []}}',
            \\      JSON '{"class" : {"students" : [{"name" : "John"}, {"name": "Jamie"}]}}'])
            \\    AS json_value
            ,
            .rows = .{
                .{"\"Jane\""},
                .{null},
                .{"\"John\""},
            },
        },
        .{
            .desc = "json_value with number",
            .sql = "SELECT JSON_VALUE(JSON '{ \"name\" : \"Jakob\", \"age\" : \"6\" }', '$.age')",
            .rows = .{
                .{"6"},
            },
        },
        .{
            .desc = "json_value with string",
            .sql = "SELECT JSON_VALUE('{ \"name\" : \"Jakob\", \"age\" : \"6\" }', '$.name')",
            .rows = .{
                .{"Jakob"},
            },
        },
        .{
            .desc = "json_value with array",
            .sql = "SELECT JSON_VALUE('{\"fruits\": [\"apple\", \"banana\"]}', '$.fruits')",
            .rows = .{
                .{null},
            },
        },
        .{
            .desc = "json_value with escape",
            .sql = "SELECT JSON_VALUE('{\"a.b\": {\"c\": \"world\"}}', '$.\"a.b\".c')",
            .rows = .{
                .{"world"},
            },
        },
        .{
            .desc = "json_value with null",
            .sql = "SELECT JSON_VALUE(JSON 'null'), JSON_VALUE(NULL), JSON_VALUE(JSON '{}', '$.does_not_exist')",
            .rows = .{
                .{ null, null, null },
            },
        },
    },
}
