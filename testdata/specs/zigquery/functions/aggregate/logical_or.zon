.{
    .spec = "zigquery/functions/aggregate/logical_or",
    .dialect = .zigquery,
    .typed = true,
    .cases = .{
        .{
            .desc = "logical_or",
            .sql = "SELECT LOGICAL_OR(x) AS logical_or FROM UNNEST([true, false, true]) AS x",
            .rows = .{
                .{true},
            },
        },
        .{
            .desc = "logical_or null",
            .sql =
            \\ WITH toks AS (SELECT FALSE AS x UNION ALL SELECT FALSE UNION ALL SELECT NULL)
            \\SELECT LOGICAL_OR(x) AS logical_or FROM toks
            ,
            .rows = .{
                .{false},
            },
        },
        .{
            .desc = "logical_or window default",
            .sql =
            \\SELECT LOGICAL_OR(a) OVER (ORDER BY b), a, b
            \\FROM (
            \\  SELECT CAST(a AS BOOL) AS a, b FROM UNNEST([
            \\      STRUCT(False AS a, 1 AS b),
            \\      STRUCT(False AS a, 2 AS b),
            \\      STRUCT(True AS a, 3 AS b),
            \\      STRUCT(False AS a, 4 AS b)
            \\  ])
            \\);
            ,
            .rows = .{
                .{ false, false, 1 },
                .{ false, false, 2 },
                .{ true, true, 3 },
                .{ true, false, 4 },
            },
        },
        .{
            .desc = "logical_or window no rows",
            .sql = "SELECT LOGICAL_OR(a) OVER (ORDER BY a) FROM ( SELECT CAST(a AS BOOL) AS a FROM UNNEST([]) a );",
            .rows = .{},
        },
        .{
            .desc = "logical_or with window",
            .sql =
            \\WITH toks AS ( SELECT true AS x UNION ALL SELECT false UNION ALL SELECT true)
            \\                            SELECT LOGICAL_OR(x) OVER (ORDER BY x) FROM toks
            ,
            .rows = .{
                .{false},
                .{true},
                .{true},
            },
        },
    },
}
