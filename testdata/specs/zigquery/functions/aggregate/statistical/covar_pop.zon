.{
    .spec = "zigquery/functions/aggregate/statistical/covar_pop",
    .dialect = .zigquery,
    .typed = true,
    .cases = .{
        .{
            .desc = "covar_pop window",
            .sql =
            \\
            \\SELECT COVAR_POP(y, x) OVER () FROM
            \\  UNNEST([STRUCT(1.0 AS y, 1.0 AS x),
            \\      (2.0, 6.0),
            \\      (9.0, 3.0),
            \\      (2.0, 6.0),
            \\      (9.0, 3.0)])
            ,
            .rows = .{
                .{-2.1},
                .{-2.1},
                .{-2.1},
                .{-2.1},
                .{-2.1},
            },
        },
    },
}
