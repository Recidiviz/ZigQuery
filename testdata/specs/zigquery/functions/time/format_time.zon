.{
    .spec = "zigquery/functions/time/format_time",
    .dialect = .zigquery,
    .typed = true,
    .cases = .{
        .{
            .desc = "format_time with %k %l",
            .sql = "SELECT FORMAT_TIME(\"%k\", TIME \"15:30:00\"), FORMAT_TIME(\"%l\", TIME \"15:30:00\");",
            .rows = .{
                .{ "15", " 3" },
            },
        },
        .{
            .desc = "format_time with %R",
            .sql = "SELECT FORMAT_TIME(\"%R\", TIME \"15:30:00\")",
            .rows = .{
                .{"15:30"},
            },
        },
        .{
            .desc = "format_time with %E3S",
            .sql = "SELECT FORMAT_TIME(\"%E3S\", TIME \"15:30:12.345678\")",
            .rows = .{
                .{"12.345"},
            },
        },
        .{
            .desc = "format_time with %E*S",
            .sql = "SELECT FORMAT_TIME(\"%E*S\", TIME \"15:30:12.345678\")",
            .rows = .{
                .{"12.345678"},
            },
        },

        // %I and %l are one 12-hour reading in two paddings. Midnight and noon
        // are the whole test: %I answered the raw 24-hour number and %l answered
        // hour%12, so both said 0 where the clock reads 12.
        .{
            .desc = "format_time %I is the 12-hour clock, zero-padded 01-12",
            .sql =
            \\SELECT
            \\  FORMAT_TIME("%I", TIME "00:30:00"), FORMAT_TIME("%I", TIME "01:05:00"),
            \\  FORMAT_TIME("%I", TIME "12:00:00"), FORMAT_TIME("%I", TIME "13:05:00"),
            \\  FORMAT_TIME("%I", TIME "23:30:00")
            ,
            .rows = .{
                .{ "12", "01", "12", "01", "11" },
            },
        },
        .{
            .desc = "format_time %l is the same 12-hour clock, space-padded 1-12",
            .sql =
            \\SELECT
            \\  FORMAT_TIME("[%l]", TIME "00:30:00"), FORMAT_TIME("[%l]", TIME "01:05:00"),
            \\  FORMAT_TIME("[%l]", TIME "12:00:00"), FORMAT_TIME("[%l]", TIME "13:05:00"),
            \\  FORMAT_TIME("[%l]", TIME "23:30:00")
            ,
            .rows = .{
                .{ "[12]", "[ 1]", "[12]", "[ 1]", "[11]" },
            },
        },
        .{
            .desc = "format_time %P and %p straddle noon",
            .sql =
            \\SELECT
            \\  FORMAT_TIME("%P|%p", TIME "09:20:00"), FORMAT_TIME("%P|%p", TIME "12:00:00"),
            \\  FORMAT_TIME("%P|%p", TIME "13:05:00")
            ,
            .rows = .{
                .{ "am|AM", "pm|PM", "pm|PM" },
            },
        },
        .{
            .desc = "format_time %k is the 24-hour clock, space-padded",
            .sql = "SELECT FORMAT_TIME(\"[%k]\", TIME \"09:20:00\"), FORMAT_TIME(\"[%k]\", TIME \"23:30:00\")",
            .rows = .{
                .{ "[ 9]", "[23]" },
            },
        },
        .{
            .desc = "format_time with %E4S",
            .sql = "SELECT FORMAT_TIME(\"%E4S\", TIME \"15:30:12.345678\")",
            .rows = .{
                .{"12.3456"},
            },
        },
        .{
            .desc = "format_time %r is the 12-hour clock with a meridiem",
            // Measured against BigQuery; absent from
            // (format-elements.md#format_elements_date_time).
            .sql = "SELECT FORMAT_TIME(\"%r\", TIME \"09:20:30\"), FORMAT_TIME(\"%r\", TIME \"13:05:09\"), FORMAT_TIME(\"%r\", TIME \"00:30:00\")",
            .rows = .{
                .{ "09:20:30 AM", "01:05:09 PM", "12:30:00 AM" },
            },
        },
        .{
            .desc = "format_time copies through an element no TIME can answer",
            // Date elements, plus %s, which needs a date to count an epoch offset from.
            .sql = "SELECT FORMAT_TIME(\"[%A][%B][%j][%Q][%G][%s][%E4Y][%x]\", TIME \"09:20:30\")",
            .rows = .{
                .{"[%A][%B][%j][%Q][%G][%s][%E4Y][%x]"},
            },
        },
    },
}
