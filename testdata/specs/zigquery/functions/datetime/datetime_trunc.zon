.{
    .spec = "zigquery/functions/datetime/datetime_trunc",
    .dialect = .zigquery,
    .typed = true,
    .cases = .{
        .{
            .desc = "datetime_trunc with quarter",
            .sql = "SELECT DATETIME_TRUNC(DATETIME \"2017-01-05\", QUARTER), DATETIME_TRUNC(DATETIME \"2017-02-05\", QUARTER), DATETIME_TRUNC(DATETIME \"2017-08-05\", QUARTER), DATETIME_TRUNC(DATETIME \"2017-11-05\", QUARTER), DATETIME_TRUNC(DATETIME \"2017-12-31\", QUARTER)",
            .rows = .{
                .{ "2017-01-01T00:00:00", "2017-01-01T00:00:00", "2017-07-01T00:00:00", "2017-10-01T00:00:00", "2017-10-01T00:00:00" },
            },
        },
        .{
            .desc = "datetime_trunc with day weekday",
            .sql = "SELECT DATETIME_TRUNC(DATETIME \"2024-03-29\", WEEK(MONDAY))",
            .rows = .{
                .{"2024-03-25T00:00:00"},
            },
        },
        .{
            .desc = "datetime_trunc isoyear",
            .sql =
            \\SELECT
            \\  DATETIME_TRUNC('2015-06-15', ISOYEAR) AS isoyear_boundary,
            \\  EXTRACT(ISOYEAR FROM DATE '2015-06-15') AS isoyear_number;
            ,
            .rows = .{
                .{ "2014-12-29T00:00:00", 2015 },
            },
        },
        .{
            .desc = "datetime_trunc with day",
            .sql = "SELECT DATETIME_TRUNC(DATETIME \"2008-12-25 15:30:00\", DAY)",
            .rows = .{
                .{"2008-12-25T00:00:00"},
            },
        },
        .{
            .desc = "datetime_trunc with weekday(monday)",
            .sql = "SELECT DATETIME_TRUNC(DATETIME \"2017-11-05 00:00:00\", WEEK(MONDAY))",
            .rows = .{
                .{"2017-10-30T00:00:00"},
            },
        },
        .{
            .desc = "datetime_trunc with isoyear",
            .sql = "SELECT DATETIME_TRUNC('2015-06-15 00:00:00', ISOYEAR)",
            .rows = .{
                .{"2014-12-29T00:00:00"},
            },
        },
        .{
            .desc = "datetime_trunc keeps the unit it is asked for",
            .sql =
            \\SELECT
            \\  DATETIME_TRUNC(DATETIME "2024-03-15 10:20:30.123456", MICROSECOND),
            \\  DATETIME_TRUNC(DATETIME "2024-03-15 10:20:30.123456", MILLISECOND),
            \\  DATETIME_TRUNC(DATETIME "2024-03-15 10:20:30.123456", SECOND),
            \\  DATETIME_TRUNC(DATETIME "2024-03-15 10:20:30.123456", MINUTE)
            ,
            .rows = .{
                .{ "2024-03-15T10:20:30.123456", "2024-03-15T10:20:30.123", "2024-03-15T10:20:30", "2024-03-15T10:20:00" },
            },
        },
        .{
            .desc = "datetime_trunc rejects a part it cannot express",
            // NANOSECOND passes the analyzer because FEATURE_TIMESTAMP_NANOS is on, but
            // this engine stores microseconds.
            .sql = "SELECT DATETIME_TRUNC(DATETIME '2024-03-15 10:20:30.123456', NANOSECOND)",
            .expect_error = "unexpected part value NANOSECOND",
            .rows = .{},
        },
    },
}
