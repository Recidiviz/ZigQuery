.{
    .spec = "zigquery/functions/datetime/datetime",
    .dialect = .zigquery,
    .typed = true,
    .cases = .{
        .{
            .desc = "datetime",
            .sql = "SELECT DATETIME(2008, 12, 25, 05, 30, 00), DATETIME(TIMESTAMP \"2008-12-25 05:30:00+00\", \"America/Los_Angeles\")",
            .rows = .{
                .{ "2008-12-25T05:30:00", "2008-12-24T21:30:00" },
            },
        },
        .{
            .desc = "datetime literal",
            .sql = "SELECT DATETIME '2023-01-01 12:01:00'",
            .rows = .{
                .{"2023-01-01T12:01:00"},
            },
        },
        .{
            .desc = "datetime from a DATE, with and without a TIME",
            .sql = "SELECT DATETIME(DATE \"2008-12-25\", TIME \"15:30:00\"), DATETIME(DATE \"2008-12-25\")",
            .rows = .{
                .{ "2008-12-25T15:30:00", "2008-12-25T00:00:00" },
            },
        },
        .{
            .desc = "datetime of a DATETIME is the identity",
            .sql = "SELECT DATETIME(DATETIME \"2008-12-25 15:30:00\")",
            .rows = .{
                .{"2008-12-25T15:30:00"},
            },
        },

        // A numeric time zone is (+|-)H[H][:M[M]], and the colon may be dropped. All the
        // spellings of nine hours ahead agree, and a lone hour digit is enough. Measured
        // (recidiviz-bigquery-sandbox, 2026-08-07); the grammar itself is at
        // (timestamp_functions.md#timestamp_definition).
        .{
            .desc = "datetime takes every spelling of a numeric zone offset",
            .sql =
            \\SELECT
            \\  DATETIME(TIMESTAMP '2024-03-14 12:00:00+00', '+09:00'),
            \\  DATETIME(TIMESTAMP '2024-03-14 12:00:00+00', '+9:00'),
            \\  DATETIME(TIMESTAMP '2024-03-14 12:00:00+00', '+0900'),
            \\  DATETIME(TIMESTAMP '2024-03-14 12:00:00+00', '+090'),
            \\  DATETIME(TIMESTAMP '2024-03-14 12:00:00+00', '+9')
            ,
            .rows = .{
                .{
                    "2024-03-14T21:00:00", "2024-03-14T21:00:00", "2024-03-14T21:00:00",
                    "2024-03-14T21:00:00", "2024-03-14T21:00:00",
                },
            },
        },
        .{
            .desc = "datetime reads a single-digit minute field, and a zero offset either way",
            .sql =
            \\SELECT
            \\  DATETIME(TIMESTAMP '2024-03-14 12:00:00+00', '+09:5'),
            \\  DATETIME(TIMESTAMP '2024-03-14 12:00:00+00', '-07'),
            \\  DATETIME(TIMESTAMP '2024-03-14 12:00:00+00', '-0')
            ,
            .rows = .{
                .{ "2024-03-14T21:05:00", "2024-03-14T05:00:00", "2024-03-14T12:00:00" },
            },
        },
        .{
            .desc = "datetime accepts the offset bounds, which are plus and minus 14 hours",
            .sql =
            \\SELECT
            \\  DATETIME(TIMESTAMP '2024-03-14 12:00:00+00', '+14:00'),
            \\  DATETIME(TIMESTAMP '2024-03-14 12:00:00+00', '-14:00')
            ,
            .rows = .{
                .{ "2024-03-15T02:00:00", "2024-03-13T22:00:00" },
            },
        },
        .{
            .desc = "datetime rejects an offset past 14 hours",
            .sql = "SELECT DATETIME(TIMESTAMP '2024-03-14 12:00:00+00', '+15:00')",
            .expect_error = "Invalid time zone: +15:00",
            .rows = .{},
        },
        .{
            .desc = "datetime rejects an hour field of 24",
            .sql = "SELECT DATETIME(TIMESTAMP '2024-03-14 12:00:00+00', '+24:00')",
            .expect_error = "Invalid time zone: +24:00",
            .rows = .{},
        },
        .{
            .desc = "datetime rejects a minute field of 60",
            .sql = "SELECT DATETIME(TIMESTAMP '2024-03-14 12:00:00+00', '+09:60')",
            .expect_error = "Invalid time zone: +09:60",
            .rows = .{},
        },
        .{
            .desc = "datetime rejects a seconds field on a zone offset",
            .sql = "SELECT DATETIME(TIMESTAMP '2024-03-14 12:00:00+00', '+09:00:00')",
            .expect_error = "Invalid time zone: +09:00:00",
            .rows = .{},
        },
        .{
            .desc = "datetime rejects three colon-free digits whose first two are not an hour",
            // '+900' reads as 90 hours and 0 minutes, where '+090' is 09 hours and 0.
            .sql = "SELECT DATETIME(TIMESTAMP '2024-03-14 12:00:00+00', '+900')",
            .expect_error = "Invalid time zone: +900",
            .rows = .{},
        },
        .{
            .desc = "datetime rejects a signed zone that is not digits",
            .sql = "SELECT DATETIME(TIMESTAMP '2024-03-14 12:00:00+00', '+ab')",
            .expect_error = "Invalid time zone: +ab",
            .rows = .{},
        },

        // Daylight saving for the named zones this engine carries. Every instant below is
        // a few days clear of the transition, which is where a day-granularity rule and
        // real tzdata agree. Measured (recidiviz-bigquery-sandbox, 2026-08-07).
        .{
            .desc = "datetime follows US daylight saving into November",
            // US DST ends on the first Sunday of November, which in 2024 is the 3rd.
            .sql =
            \\SELECT
            \\  DATETIME(TIMESTAMP '2024-11-01 12:00:00+00', 'America/Los_Angeles'),
            \\  DATETIME(TIMESTAMP '2024-11-05 12:00:00+00', 'America/Los_Angeles')
            ,
            .rows = .{
                .{ "2024-11-01T05:00:00", "2024-11-05T04:00:00" },
            },
        },
        .{
            .desc = "datetime reads New York on the same US rule, five hours further east",
            .sql =
            \\SELECT
            \\  DATETIME(TIMESTAMP '2024-07-04 12:00:00+00', 'America/New_York'),
            \\  DATETIME(TIMESTAMP '2024-01-15 12:00:00+00', 'America/New_York')
            ,
            .rows = .{
                .{ "2024-07-04T08:00:00", "2024-01-15T07:00:00" },
            },
        },
        .{
            .desc = "datetime follows New Zealand daylight saving, which runs the other half of the year",
            // NZ summer time ends on the first Sunday of April, the 7th in 2024, and
            // resumes on the last Sunday of September, the 29th.
            .sql =
            \\SELECT
            \\  DATETIME(TIMESTAMP '2024-04-05 12:00:00+00', 'Pacific/Auckland'),
            \\  DATETIME(TIMESTAMP '2024-04-08 12:00:00+00', 'Pacific/Auckland'),
            \\  DATETIME(TIMESTAMP '2024-09-25 12:00:00+00', 'Pacific/Auckland'),
            \\  DATETIME(TIMESTAMP '2024-09-30 12:00:00+00', 'Pacific/Auckland')
            ,
            .rows = .{
                .{
                    "2024-04-06T01:00:00", "2024-04-09T00:00:00",
                    "2024-09-26T00:00:00", "2024-10-01T01:00:00",
                },
            },
        },
    },
}
