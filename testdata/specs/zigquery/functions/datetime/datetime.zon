.{
    .spec = "zigquery/functions/datetime/datetime",
    .dialect = .zigquery,
    .typed = true,
    .cases = .{
        .{
            .desc = "datetime",
            .sql = "SELECT DATETIME(2008, 12, 25, 05, 30, 00), DATETIME(TIMESTAMP \"2008-12-25 05:30:00+00\", \"America/Los_Angeles\")",
            .rows = .{
                .{ "2008-12-25T05:30:00", "2008-12-24T21:30:00" },
            },
        },
        .{
            .desc = "datetime literal",
            .sql = "SELECT DATETIME '2023-01-01 12:01:00'",
            .rows = .{
                .{"2023-01-01T12:01:00"},
            },
        },
        .{
            .desc = "datetime from a DATE, with and without a TIME",
            .sql = "SELECT DATETIME(DATE \"2008-12-25\", TIME \"15:30:00\"), DATETIME(DATE \"2008-12-25\")",
            .rows = .{
                .{ "2008-12-25T15:30:00", "2008-12-25T00:00:00" },
            },
        },
        .{
            .desc = "datetime of a DATETIME is the identity",
            .sql = "SELECT DATETIME(DATETIME \"2008-12-25 15:30:00\")",
            .rows = .{
                .{"2008-12-25T15:30:00"},
            },
        },
    },
}
