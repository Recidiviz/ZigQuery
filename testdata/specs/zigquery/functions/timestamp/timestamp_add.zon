.{
    .spec = "zigquery/functions/timestamp/timestamp_add",
    .dialect = .zigquery,
    .typed = true,
    .cases = .{
        .{
            .desc = "timestamp_add",
            .sql = "SELECT TIMESTAMP_ADD(TIMESTAMP \"2008-12-25 15:30:00+00\", INTERVAL 10 MINUTE)",
            .rows = .{
                .{"1230219600.0"},
            },
        },
        .{
            .desc = "timestamp_add by DAY",
            .sql =
            \\SELECT FORMAT_TIMESTAMP(
            \\  "%Y-%m-%d %H:%M:%S",
            \\  TIMESTAMP_ADD(TIMESTAMP "2008-12-25 15:30:00+00", INTERVAL 2 DAY))
            ,
            .rows = .{
                .{"2008-12-27 15:30:00"},
            },
        },
        .{
            .desc = "timestamp_add rejects a part it cannot express",
            .sql = "SELECT TIMESTAMP_ADD(TIMESTAMP \"2008-12-25 15:30:00+00\", INTERVAL 1 NANOSECOND)",
            .expect_error = "TIMESTAMP_ADD: unexpected part value NANOSECOND",
            .rows = .{},
        },
    },
}
