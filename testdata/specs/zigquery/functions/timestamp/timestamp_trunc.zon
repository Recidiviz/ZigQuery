.{
    .spec = "zigquery/functions/timestamp/timestamp_trunc",
    .dialect = .zigquery,
    .typed = true,
    .cases = .{
        .{
            .desc = "timestamp_trunc with quarter",
            .sql = "SELECT TIMESTAMP_TRUNC(TIMESTAMP \"2017-01-05\", QUARTER, \"Pacific/Auckland\"), TIMESTAMP_TRUNC(TIMESTAMP \"2017-02-05\", QUARTER), TIMESTAMP_TRUNC(TIMESTAMP \"2024-02-29\", QUARTER), TIMESTAMP_TRUNC(TIMESTAMP \"2017-08-05\", QUARTER), TIMESTAMP_TRUNC(TIMESTAMP \"2017-12-31\", QUARTER)",
            .rows = .{
                .{ "1483182000.0", "1483228800.0", "1704067200.0", "1498867200.0", "1506816000.0" },
            },
        },
        .{
            .desc = "timestamp_trunc with day",
            .sql = "SELECT TIMESTAMP_TRUNC(TIMESTAMP \"2008-12-25 15:30:00+00\", DAY, \"UTC\"), TIMESTAMP_TRUNC(TIMESTAMP \"2008-12-25 15:30:00+00\", DAY, \"America/Los_Angeles\")",
            .rows = .{
                .{ "1230163200.0", "1230192000.0" },
            },
        },
        .{
            .desc = "timestamp_trunc with week",
            .sql =
            \\SELECT timestamp_value AS timestamp_value,
            \\                                        TIMESTAMP_TRUNC(timestamp_value, WEEK(MONDAY), "UTC"),
            \\                                        TIMESTAMP_TRUNC(timestamp_value, WEEK(MONDAY), "Pacific/Auckland")
            \\                                        FROM (SELECT TIMESTAMP("2017-11-06 00:00:00+12") AS timestamp_value)
            ,
            .rows = .{
                .{ "1509883200.0", "1509321600.0", "1509879600.0" },
            },
        },
        .{
            .desc = "timestamp_trunc with year",
            .sql = "SELECT TIMESTAMP_TRUNC(\"2015-06-15 00:00:00+00\", ISOYEAR)",
            .rows = .{
                .{"1419811200.0"},
            },
        },
        .{
            .desc = "timestamp_trunc keeps the unit it is asked for",
            .sql =
            \\SELECT
            \\  FORMAT_TIMESTAMP("%H:%M:%E*S", TIMESTAMP_TRUNC(TIMESTAMP "2024-03-15 10:20:30.123456+00", MICROSECOND)),
            \\  FORMAT_TIMESTAMP("%H:%M:%E*S", TIMESTAMP_TRUNC(TIMESTAMP "2024-03-15 10:20:30.123456+00", MILLISECOND)),
            \\  FORMAT_TIMESTAMP("%H:%M:%E*S", TIMESTAMP_TRUNC(TIMESTAMP "2024-03-15 10:20:30.123456+00", SECOND)),
            \\  FORMAT_TIMESTAMP("%H:%M:%E*S", TIMESTAMP_TRUNC(TIMESTAMP "2024-03-15 10:20:30.123456+00", MINUTE)),
            \\  FORMAT_TIMESTAMP("%H:%M:%E*S", TIMESTAMP_TRUNC(TIMESTAMP "2024-03-15 10:20:30.123456+00", HOUR))
            ,
            .rows = .{
                .{ "10:20:30.123456", "10:20:30.123000", "10:20:30.000000", "10:20:00.000000", "10:00:00.000000" },
            },
        },
        .{
            .desc = "timestamp_trunc truncates in the zone it is given",
            // 2024-03-15 00:30 UTC is 09:30 on the same day in Tokyo, so a DAY
            // truncation there lands at 2024-03-15 00:00 +09:00 = 14th 15:00Z.
            .sql =
            \\SELECT FORMAT_TIMESTAMP(
            \\  "%Y-%m-%d %H:%M:%S",
            \\  TIMESTAMP_TRUNC(TIMESTAMP "2024-03-15 00:30:00+00", DAY, "Asia/Tokyo"))
            ,
            .rows = .{
                .{"2024-03-14 15:00:00"},
            },
        },
    },
}
