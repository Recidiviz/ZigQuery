.{
    .spec = "zigquery/functions/date/date",
    .dialect = .zigquery,
    .typed = true,
    .cases = .{
        .{
            .desc = "date operator",
            .sql = "SELECT DATE \"2020-09-22\" + 1 AS day_later, DATE \"2020-09-22\" - 7 AS week_ago",
            .rows = .{
                .{ "2020-09-23", "2020-09-15" },
            },
        },
        .{
            .desc = "date from a TIMESTAMP in a named zone",
            // 2008-12-25 15:30 UTC is still the 25th in Los Angeles (07:30),
            // but already the 26th in Tokyo (00:30).
            .sql =
            \\SELECT
            \\  DATE(TIMESTAMP "2008-12-25 15:30:00+00", "America/Los_Angeles"),
            \\  DATE(TIMESTAMP "2008-12-25 15:30:00+00", "Asia/Tokyo")
            ,
            .rows = .{
                .{ "2008-12-25", "2008-12-26" },
            },
        },
    },
}
