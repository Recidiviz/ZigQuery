.{
    .spec = "zigquery/functions/date/date_add",
    .dialect = .zigquery,
    .typed = true,
    .cases = .{
        .{
            .desc = "date_add",
            .sql = "SELECT DATE_ADD('2023-01-29', INTERVAL 1 MONTH)",
            .rows = .{
                .{"2023-02-28"},
            },
        },
        .{
            .desc = "date_add year clamps February 29th to the 28th",
            // A year shift keeps the day of month unless the target month is shorter, the
            // same clamp the MONTH arm applies. Measured
            // (recidiviz-bigquery-sandbox, 2026-08-07).
            .sql =
            \\SELECT
            \\  DATE_ADD(DATE '2024-02-29', INTERVAL 1 YEAR),
            \\  DATE_ADD(DATE '2024-02-29', INTERVAL 4 YEAR),
            \\  DATE_ADD(DATE '2024-03-14', INTERVAL 3 YEAR)
            ,
            // 2028 is a leap year, so the four-year shift needs no clamp.
            .rows = .{
                .{ "2025-02-28", "2028-02-29", "2027-03-14" },
            },
        },
        .{
            .desc = "date_add week is seven days",
            .sql = "SELECT DATE_ADD(DATE '2024-03-14', INTERVAL 2 WEEK)",
            .rows = .{
                .{"2024-03-28"},
            },
        },
        .{
            .desc = "date_add quarter",
            .sql = "SELECT DATE_ADD('2023-01-01', INTERVAL 1 QUARTER), DATE_ADD('2023-11-30', INTERVAL 1 QUARTER)",
            .rows = .{
                .{ "2023-04-01", "2024-02-29" },
            },
        },
        .{
            .desc = "date_add on a DATETIME answers a DATETIME",
            // date_functions.md#date_add takes DATETIME and TIMESTAMP arguments too, and answers
            // in the argument's own type.
            // Measured (recidiviz-bigquery-sandbox, 2026-09-03).
            .sql =
            \\SELECT
            \\  DATE_ADD(DATETIME '2024-02-28 10:20:30', INTERVAL 1 DAY),
            \\  DATE_ADD(DATETIME '2024-02-28 10:20:30', INTERVAL 1 DAY) = DATETIME '2024-02-29 10:20:30'
            ,
            .rows = .{
                .{ "2024-02-29T10:20:30", true },
            },
        },
        .{
            .desc = "date_add on a DATETIME by every calendar part",
            // Adding a month to January 31st lands on the last day of February.
            // Measured (recidiviz-bigquery-sandbox, 2026-09-03).
            .sql =
            \\SELECT
            \\  DATE_ADD(DATETIME '2024-01-31 10:20:30', INTERVAL 1 DAY),
            \\  DATE_ADD(DATETIME '2024-01-31 10:20:30', INTERVAL 1 WEEK),
            \\  DATE_ADD(DATETIME '2024-01-31 10:20:30', INTERVAL 1 MONTH),
            \\  DATE_ADD(DATETIME '2024-01-31 10:20:30', INTERVAL 1 QUARTER),
            \\  DATE_ADD(DATETIME '2024-01-31 10:20:30', INTERVAL 1 YEAR)
            ,
            .rows = .{
                .{ "2024-02-01T10:20:30", "2024-02-07T10:20:30", "2024-02-29T10:20:30", "2024-04-30T10:20:30", "2025-01-31T10:20:30" },
            },
        },
        .{
            .desc = "date_add on a DATETIME by every clock part",
            // Measured (recidiviz-bigquery-sandbox, 2026-09-03).
            .sql =
            \\SELECT
            \\  DATE_ADD(DATETIME '2024-02-28 23:30:15.250500', INTERVAL 1 HOUR),
            \\  DATE_ADD(DATETIME '2024-02-28 23:30:15.250500', INTERVAL 45 MINUTE),
            \\  DATE_ADD(DATETIME '2024-02-28 23:30:15.250500', INTERVAL 50 SECOND),
            \\  DATE_ADD(DATETIME '2024-02-28 23:30:15.250500', INTERVAL 800 MILLISECOND),
            \\  DATE_ADD(DATETIME '2024-02-28 23:30:15.250500', INTERVAL 9500 MICROSECOND)
            ,
            .rows = .{
                .{ "2024-02-29T00:30:15.2505", "2024-02-29T00:15:15.2505", "2024-02-28T23:31:05.2505", "2024-02-28T23:30:16.0505", "2024-02-28T23:30:15.26" },
            },
        },
        .{
            .desc = "date_add on a DATETIME by a negative interval",
            // Measured (recidiviz-bigquery-sandbox, 2026-09-03).
            .sql =
            \\SELECT
            \\  DATE_ADD(DATETIME '2024-03-31 00:00:00', INTERVAL -1 MONTH),
            \\  DATE_ADD(DATETIME '2024-03-01 12:00:00', INTERVAL -36 HOUR)
            ,
            .rows = .{
                .{ "2024-02-29T00:00:00", "2024-02-29T00:00:00" },
            },
        },
        .{
            .desc = "date_add on a TIMESTAMP answers a TIMESTAMP",
            // Measured (recidiviz-bigquery-sandbox, 2026-09-03).
            .sql =
            \\SELECT
            \\  DATE_ADD(TIMESTAMP '2008-12-25 15:30:00+00', INTERVAL 10 MINUTE),
            \\  DATE_ADD(TIMESTAMP '2008-12-25 15:30:00+00', INTERVAL 1 DAY) = TIMESTAMP '2008-12-26 15:30:00+00'
            ,
            .rows = .{
                .{ "1230219600.0", true },
            },
        },
        .{
            .desc = "date_add on a TIMESTAMP by every fixed-length part",
            // Measured (recidiviz-bigquery-sandbox, 2026-09-03).
            .sql =
            \\SELECT
            \\  FORMAT_TIMESTAMP('%Y-%m-%d %H:%M:%E6S', DATE_ADD(TIMESTAMP '2024-02-28 23:30:15.250500+00', INTERVAL 1 DAY)),
            \\  FORMAT_TIMESTAMP('%Y-%m-%d %H:%M:%E6S', DATE_ADD(TIMESTAMP '2024-02-28 23:30:15.250500+00', INTERVAL 1 HOUR)),
            \\  FORMAT_TIMESTAMP('%Y-%m-%d %H:%M:%E6S', DATE_ADD(TIMESTAMP '2024-02-28 23:30:15.250500+00', INTERVAL 45 MINUTE)),
            \\  FORMAT_TIMESTAMP('%Y-%m-%d %H:%M:%E6S', DATE_ADD(TIMESTAMP '2024-02-28 23:30:15.250500+00', INTERVAL 50 SECOND)),
            \\  FORMAT_TIMESTAMP('%Y-%m-%d %H:%M:%E6S', DATE_ADD(TIMESTAMP '2024-02-28 23:30:15.250500+00', INTERVAL 800 MILLISECOND)),
            \\  FORMAT_TIMESTAMP('%Y-%m-%d %H:%M:%E6S', DATE_ADD(TIMESTAMP '2024-02-28 23:30:15.250500+00', INTERVAL 9500 MICROSECOND))
            ,
            .rows = .{
                .{ "2024-02-29 23:30:15.250500", "2024-02-29 00:30:15.250500", "2024-02-29 00:15:15.250500", "2024-02-28 23:31:05.250500", "2024-02-28 23:30:16.050500", "2024-02-28 23:30:15.260000" },
            },
        },
        .{
            .desc = "date_add on a TIMESTAMP rejects a calendar part",
            .sql = "SELECT DATE_ADD(TIMESTAMP '2024-02-28 10:20:30+00', INTERVAL 1 MONTH)",
            .expect_error = "DATE_ADD does not support the MONTH date part when the argument is TIMESTAMP type",
            .rows = .{},
        },
        .{
            .desc = "date_add on a DATE rejects a clock part",
            .sql = "SELECT DATE_ADD(DATE '2024-02-28', INTERVAL 1 HOUR)",
            .expect_error = "DATE_ADD does not support the HOUR date part when the argument is DATE type",
            .rows = .{},
        },
        .{
            .desc = "date_add of a NULL DATETIME or TIMESTAMP is NULL",
            // Measured (recidiviz-bigquery-sandbox, 2026-09-03).
            .sql = "SELECT DATE_ADD(CAST(NULL AS DATETIME), INTERVAL 1 DAY), DATE_ADD(CAST(NULL AS TIMESTAMP), INTERVAL 1 DAY)",
            .rows = .{
                .{ null, null },
            },
        },
        .{
            .desc = "safe.date_add on a DATETIME",
            // Measured (recidiviz-bigquery-sandbox, 2026-09-03).
            .sql = "SELECT SAFE.DATE_ADD(DATETIME '2024-02-28 10:20:30', INTERVAL 1 DAY)",
            .rows = .{
                .{"2024-02-29T10:20:30"},
            },
        },
    },
}
