.{
    .spec = "zigquery/functions/date/date_add",
    .dialect = .zigquery,
    .typed = true,
    .cases = .{
        .{
            .desc = "date_add",
            .sql = "SELECT DATE_ADD('2023-01-29', INTERVAL 1 MONTH)",
            .rows = .{
                .{"2023-02-28"},
            },
        },
        .{
            .desc = "date_add quarter",
            .sql = "SELECT DATE_ADD('2023-01-01', INTERVAL 1 QUARTER), DATE_ADD('2023-11-30', INTERVAL 1 QUARTER)",
            .rows = .{
                .{ "2023-04-01", "2024-02-29" },
            },
        },
    },
}
