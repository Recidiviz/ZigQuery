.{
    .spec = "zigquery/functions/date/last_day",
    .dialect = .zigquery,
    .typed = true,
    .cases = .{
        .{
            .desc = "last_day",
            .sql = "SELECT LAST_DAY(DATE '2008-11-25') AS last_day",
            .rows = .{
                .{"2008-11-30"},
            },
        },
        .{
            .desc = "last_day with month",
            .sql = "SELECT LAST_DAY(DATE '2008-11-25', MONTH) AS last_day",
            .rows = .{
                .{"2008-11-30"},
            },
        },
        .{
            .desc = "last_day with year",
            .sql = "SELECT LAST_DAY(DATE '2008-11-25', YEAR) AS last_day",
            .rows = .{
                .{"2008-12-31"},
            },
        },
        .{
            .desc = "last_day with week(sunday)",
            .sql = "SELECT LAST_DAY(DATE '2008-11-10', WEEK(SUNDAY)) AS last_day",
            .rows = .{
                .{"2008-11-15"},
            },
        },
        .{
            .desc = "last_day with week(monday)",
            .sql = "SELECT LAST_DAY(DATE '2008-11-10', WEEK(MONDAY)) AS last_day",
            .rows = .{
                .{"2008-11-16"},
            },
        },
        .{
            .desc = "last_day with the remaining WEEK(<weekday>) start days",
            // 2008-11-10 is a Monday. A week starting on <weekday> ends the day
            // before the next <weekday>, so each start day shifts the answer by
            // one from the last. The analyzer normalises WEEK(TUESDAY) to the
            // part name WEEK_TUESDAY, which is what the engine matches on.
            .sql =
            \\SELECT
            \\  LAST_DAY(DATE '2008-11-10', WEEK(TUESDAY)),
            \\  LAST_DAY(DATE '2008-11-10', WEEK(WEDNESDAY)),
            \\  LAST_DAY(DATE '2008-11-10', WEEK(THURSDAY)),
            \\  LAST_DAY(DATE '2008-11-10', WEEK(FRIDAY)),
            \\  LAST_DAY(DATE '2008-11-10', WEEK(SATURDAY))
            ,
            .rows = .{
                .{ "2008-11-10", "2008-11-11", "2008-11-12", "2008-11-13", "2008-11-14" },
            },
        },
        .{
            .desc = "last_day week start days wrap rather than skipping a week",
            // 2008-11-09 is a Sunday, so under WEEK(MONDAY) it is the *last*
            // day of the week that began Monday the 3rd — not a week later.
            // This is the case the missing wrap got wrong.
            .sql =
            \\SELECT
            \\  LAST_DAY(DATE '2008-11-09', WEEK(SUNDAY)),
            \\  LAST_DAY(DATE '2008-11-09', WEEK(MONDAY)),
            \\  LAST_DAY(DATE '2008-11-09', ISOWEEK)
            ,
            // ISO weeks begin on Monday, so ISOWEEK tracks WEEK(MONDAY) and not
            // the Sunday-based default WEEK.
            .rows = .{
                .{ "2008-11-15", "2008-11-09", "2008-11-09" },
            },
        },
        .{
            .desc = "last_day with quarter",
            .sql = "SELECT LAST_DAY(DATE '2024-02-15', QUARTER), LAST_DAY(DATE '2024-11-15', QUARTER)",
            .rows = .{
                .{ "2024-03-31", "2024-12-31" },
            },
        },
    },
}
