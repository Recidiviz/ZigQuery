.{
    .spec = "zigquery/functions/date/extract",
    .dialect = .zigquery,
    .typed = true,
    .cases = .{
        .{
            .desc = "extract date",
            .sql =
            \\
            \\SELECT date, EXTRACT(ISOYEAR FROM date), EXTRACT(YEAR FROM date), EXTRACT(MONTH FROM date),
            \\       EXTRACT(ISOWEEK FROM date), EXTRACT(WEEK FROM date), EXTRACT(DAY FROM date) FROM UNNEST([DATE '2015-12-23']) AS date
            ,
            .rows = .{
                .{ "2015-12-23", 2015, 2015, 12, 52, 51, 23 },
            },
        },
        // WEEK counts from the year's first Sunday and WEEK(<weekday>) from the year's
        // first of that weekday, with the days before it in week 00. ISOWEEK is the
        // separate ISO quantity, which belongs to the ISO year. The three dates are where
        // they disagree. Measured (recidiviz-bigquery-sandbox, 2026-08-07).
        .{
            .desc = "extract WEEK counts from the year's first Sunday, not the ISO week",
            .sql =
            \\SELECT d,
            \\  EXTRACT(WEEK FROM d), EXTRACT(WEEK(MONDAY) FROM d),
            \\  EXTRACT(WEEK(SATURDAY) FROM d), EXTRACT(ISOWEEK FROM d)
            \\FROM UNNEST([DATE '2023-01-01', DATE '2024-03-14', DATE '2024-12-30']) AS d
            \\ORDER BY d
            ,
            // 2023-01-01 is a Sunday, so it opens week 01 while both Monday- and
            // Saturday-started counts still call it week 00.
            .rows = .{
                .{ "2023-01-01", 1, 0, 0, 52 },
                .{ "2024-03-14", 10, 11, 10, 11 },
                .{ "2024-12-30", 52, 53, 52, 1 },
            },
        },
        .{
            .desc = "extract DAYOFYEAR and DAYOFWEEK",
            // 2024 is a leap year, so it has 366 days; DAYOFWEEK is Sunday=1, and
            // 2024-03-14 is a Thursday.
            .sql = "SELECT EXTRACT(DAYOFYEAR FROM DATE '2024-12-31'), EXTRACT(DAYOFWEEK FROM DATE '2024-03-14')",
            .rows = .{
                .{ 366, 5 },
            },
        },
        .{
            .desc = "extract rejects a part an INTERVAL has no field for",
            // The analyzer whitelists parts for DATE and TIME arguments but not
            // for INTERVAL, so the rejection has to come from the engine.
            .sql = "SELECT EXTRACT(QUARTER FROM INTERVAL '1-2 3 4:5:6' YEAR TO SECOND)",
            .expect_error = "EXTRACT: unexpected part QUARTER for interval",
            .rows = .{},
        },
    },
}
