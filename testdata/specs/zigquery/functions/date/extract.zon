.{
    .spec = "zigquery/functions/date/extract",
    .dialect = .zigquery,
    .typed = true,
    .cases = .{
        .{
            .desc = "extract date",
            .sql =
            \\
            \\SELECT date, EXTRACT(ISOYEAR FROM date), EXTRACT(YEAR FROM date), EXTRACT(MONTH FROM date),
            \\       EXTRACT(ISOWEEK FROM date), EXTRACT(WEEK FROM date), EXTRACT(DAY FROM date) FROM UNNEST([DATE '2015-12-23']) AS date
            ,
            .rows = .{
                .{ "2015-12-23", 2015, 2015, 12, 52, 51, 23 },
            },
        },
        .{
            .desc = "extract rejects a part an INTERVAL has no field for",
            // The analyzer whitelists parts for DATE and TIME arguments but not
            // for INTERVAL, so the rejection has to come from the engine.
            .sql = "SELECT EXTRACT(QUARTER FROM INTERVAL '1-2 3 4:5:6' YEAR TO SECOND)",
            .expect_error = "EXTRACT: unexpected part QUARTER for interval",
            .rows = .{},
        },
    },
}
