.{
    .spec = "zigquery/functions/array/array_slice",
    .dialect = .zigquery,
    .typed = true,
    .cases = .{
        .{
            .desc = "array_slice basic",
            .sql = "SELECT ARRAY_SLICE(['a', 'b', 'c', 'd', 'e'], 1, 3)",
            .rows = .{
                .{.{ "b", "c", "d" }},
            },
        },
        .{
            .desc = "array_slice negative indices",
            .sql = "SELECT ARRAY_SLICE([1, 2, 3, 4, 5], -3, -1)",
            .rows = .{
                .{.{ 3, 4, 5 }},
            },
        },
        .{
            .desc = "array_slice start from beginning",
            .sql = "SELECT ARRAY_SLICE(['a', 'b', 'c', 'd', 'e'], 0, 2)",
            .rows = .{
                .{.{ "a", "b", "c" }},
            },
        },
        .{
            .desc = "array_slice to end",
            .sql = "SELECT ARRAY_SLICE([1, 2, 3, 4, 5], 2, 10)",
            .rows = .{
                .{.{ 3, 4, 5 }},
            },
        },
        .{
            .desc = "array_slice out of bounds negative",
            .sql = "SELECT ARRAY_SLICE(['a', 'b', 'c', 'd', 'e'], -30, 2)",
            .rows = .{
                .{.{ "a", "b", "c" }},
            },
        },
        .{
            .desc = "array_slice out of bounds start",
            .sql = "SELECT ARRAY_SLICE(['a', 'b', 'c', 'd', 'e'], 5, 30)",
            .rows = .{
                .{.{}},
            },
        },
        .{
            .desc = "array_slice start after end",
            .sql = "SELECT ARRAY_SLICE([1, 2, 3, 4, 5], 3, 1)",
            .rows = .{
                .{.{}},
            },
        },
        .{
            .desc = "array_slice null array",
            .sql = "SELECT ARRAY_SLICE(NULL, 0, 2)",
            .rows = .{
                .{null},
            },
        },
        .{
            .desc = "array_slice null start",
            .sql = "SELECT ARRAY_SLICE([1, 2, 3], NULL, 2)",
            .rows = .{
                .{null},
            },
        },
        .{
            .desc = "array_slice null end",
            .sql = "SELECT ARRAY_SLICE([1, 2, 3], 0, NULL)",
            .rows = .{
                .{null},
            },
        },
        .{
            .desc = "array_slice empty array",
            .sql = "SELECT ARRAY_SLICE(ARRAY<INT64>[], 0, 2)",
            .rows = .{
                .{.{}},
            },
        },
        .{
            .desc = "array_slice mixed negative positive",
            .sql = "SELECT ARRAY_SLICE(['a', 'b', 'c', 'd', 'e'], -4, 3)",
            .rows = .{
                .{.{ "b", "c", "d" }},
            },
        },
        .{
            .desc = "array_slice single element",
            .sql = "SELECT ARRAY_SLICE([10, 20, 30, 40, 50], 2, 2)",
            .rows = .{
                .{.{30}},
            },
        },
    },
}
