.{
    .spec = "zigquery/functions/array/array_last",
    .dialect = .zigquery,
    .typed = true,
    .cases = .{
        .{
            .desc = "array_last function",
            .sql = "SELECT ARRAY_LAST([1, 2, 3, 4]), ARRAY_LAST(null)",
            .rows = .{
                .{ 4, null },
            },
        },
        .{
            .desc = "array_last function empty",
            .sql = "SELECT ARRAY_LAST(ARRAY<STRING>[])",
            .expect_error = "ARRAY_LAST: cannot get the first element of an empty array",
            .rows = .{},
        },
    },
}
