.{
    .spec = "zigquery/functions/array/array",
    .dialect = .zigquery,
    .typed = true,
    .cases = .{
        .{
            .desc = "make_array",
            .sql = "SELECT a, b FROM UNNEST([STRUCT(DATE(2022, 1, 1) AS a, 1 AS b)])",
            .rows = .{
                .{ "2022-01-01", 1 },
            },
        },
        .{
            .desc = "array function",
            .sql = "SELECT ARRAY (SELECT 1 UNION ALL SELECT 2 UNION ALL SELECT 3) AS new_array",
            .rows = .{
                .{.{ 1, 2, 3 }},
            },
        },
        .{
            .desc = "array scan left outer join",
            .sql =
            \\WITH produce AS (select 'lettuce' AS item UNION ALL SELECT 'banana')
            \\SELECT item, in_stock_items is not null AS item_in_stock FROM produce
            \\LEFT OUTER JOIN unnest(['lettuce']) in_stock_items ON in_stock_items = item;
            ,
            .rows = .{
                .{ "lettuce", true },
                .{ "banana", false },
            },
        },
        .{
            .desc = "array scan inner join",
            .sql =
            \\WITH produce AS (select 'lettuce' AS item UNION ALL SELECT 'banana')
            \\SELECT item, in_stock_items is not null AS item_in_stock FROM produce
            \\INNER JOIN unnest(['lettuce']) in_stock_items ON in_stock_items = item;
            ,
            .rows = .{
                .{ "lettuce", true },
            },
        },
        .{
            .desc = "array function with struct",
            .sql = "SELECT ARRAY (SELECT AS STRUCT 1, 2, 3 UNION ALL SELECT AS STRUCT 4, 5, 6) AS new_array",
            .skip = "expected_rows keys a STRUCT by field name, which cannot express the anonymous fields of SELECT AS STRUCT; go-zetasqlite named them _field_<n> only because its StructValue is a Go map",
            .rows = .{
                .{.{ .{ ._field_1 = 1, ._field_2 = 2, ._field_3 = 3 }, .{ ._field_1 = 4, ._field_2 = 5, ._field_3 = 6 } }},
            },
        },
        .{
            .desc = "array function with multiple array",
            .sql = "SELECT ARRAY (SELECT AS STRUCT [1, 2, 3] UNION ALL SELECT AS STRUCT [4, 5, 6]) AS new_array",
            .skip = "expected_rows keys a STRUCT by field name, which cannot express the anonymous fields of SELECT AS STRUCT; go-zetasqlite named them _field_<n> only because its StructValue is a Go map",
            .rows = .{
                .{.{ .{ ._field_1 = .{ 1, 2, 3 } }, .{ ._field_1 = .{ 4, 5, 6 } } }},
            },
        },
        .{
            .desc = "array function with other column",
            .sql =
            \\
            \\SELECT ARRAY (
            \\    SELECT 1
            \\) AS new_array,
            \\1 as new_column
            ,
            .rows = .{
                .{ .{1}, 1 },
            },
        },
    },
}
