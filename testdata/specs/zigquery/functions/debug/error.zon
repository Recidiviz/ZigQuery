.{
    .spec = "zigquery/functions/debug/error",
    .dialect = .zigquery,
    .typed = true,
    .cases = .{
        .{
            .desc = "error",
            .sql =
            \\
            \\SELECT
            \\  CASE
            \\    WHEN value = 'foo' THEN 'Value is foo.'
            \\    WHEN value = 'bar' THEN 'Value is bar.'
            \\    ELSE ERROR(CONCAT('Found unexpected value: ', value))
            \\  END AS new_value
            \\FROM (
            \\  SELECT 'foo' AS value UNION ALL
            \\  SELECT 'bar' AS value UNION ALL
            \\  SELECT 'baz' AS value)
            ,
            .expect_error = "SQL logic error: Found unexpected value: baz (1)",
            .rows = .{
                .{"Value is foo."},
                .{"Value is bar."},
            },
        },
    },
}
