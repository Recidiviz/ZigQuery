.{
    .spec = "zigquery/types/timestamp",
    .dialect = .zigquery,
    .typed = true,
    .cases = .{
        .{
            .desc = "minimum / maximum timestamp value uses microsecond precision and range",
            .sql = "SELECT TIMESTAMP '0001-01-01 00:00:00.000000+00', TIMESTAMP '9999-12-31 23:59:59.999999+00'",
            .rows = .{
                .{ "-62135596800.0", "253402300799.999999" },
            },
        },
        .{
            .desc = "a literal with no zone is read as UTC",
            .sql =
            \\SELECT UNIX_SECONDS(TIMESTAMP '2016-10-18 2:51:45'),
            \\  UNIX_SECONDS(TIMESTAMP '2016-10-18 2:51:45+00'),
            \\  UNIX_SECONDS(TIMESTAMP '2016-10-18 2:51:45 UTC'),
            \\  CAST(TIMESTAMP '2016-10-18 2:51:45' AS STRING)
            ,
            .rows = .{
                .{ 1476759105, 1476759105, 1476759105, "2016-10-18 02:51:45+00" },
            },
        },
        .{
            .desc = "a literal with no zone equals the same string cast at run time",
            .sql =
            \\WITH t AS (SELECT '2016-10-18 2:51:45' AS s)
            \\SELECT TIMESTAMP '2016-10-18 2:51:45' = CAST(s AS TIMESTAMP) FROM t
            ,
            .rows = .{
                .{true},
            },
        },
    },
}
