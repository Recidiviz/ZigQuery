.{
    .spec = "zigquery/types/interval",
    .dialect = .zigquery,
    .typed = true,
    .cases = .{
        .{
            .desc = "interval operator",
            .sql = "SELECT DATE \"2020-09-22\" + val FROM UNNEST([INTERVAL 1 DAY,INTERVAL -1 DAY,INTERVAL 2 YEAR,CAST('1-2 3 18:1:55' AS INTERVAL)]) as val",
            .rows = .{
                .{"2020-09-23T00:00:00"},
                .{"2020-09-21T00:00:00"},
                .{"2022-09-22T00:00:00"},
                .{"2021-11-25T18:01:55"},
            },
        },
        .{
            .desc = "interval from sub operator",
            .sql =
            \\
            \\SELECT
            \\  DATE "2021-05-20" - DATE "2020-04-19",
            \\  DATETIME "2021-06-01 12:34:56.789" - DATETIME "2021-05-31 00:00:00",
            \\  TIMESTAMP "2021-06-01 12:34:56.789" - TIMESTAMP "2021-05-31 00:00:00"
            ,
            .rows = .{
                .{ "0-0 396 0:0:0", "0-0 1 12:34:56.789", "0-0 0 36:34:56.789" },
            },
        },
        .{
            .desc = "datetime sub splits whole days out with the sign of the difference",
            .sql =
            \\
            \\SELECT
            \\  DATETIME "2021-05-31 00:00:00" - DATETIME "2021-06-01 12:34:56.789",
            \\  DATETIME "2021-06-03 00:00:00" - DATETIME "2021-06-01 00:00:00",
            \\  DATETIME "2021-06-01 12:00:00" - DATETIME "2021-06-01 01:30:00",
            \\  DATETIME "9999-12-31 23:59:59.999999" - DATETIME "0001-01-01 00:00:00"
            ,
            .rows = .{
                .{ "0-0 -1 -12:34:56.789", "0-0 2 0:0:0", "0-0 0 10:30:0", "0-0 3652058 23:59:59.999999" },
            },
        },
    },
}
