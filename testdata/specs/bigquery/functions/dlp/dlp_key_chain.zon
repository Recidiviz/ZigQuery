.{
    .spec = "bigquery/functions/dlp/dlp_key_chain",
    .dialect = .bigquery,
    .upstream = "https://cloud.google.com/bigquery/docs/reference/standard-sql/dlp_functions#dlp_key_chain",
    .cases = .{
        .{
            .desc = "chain with literal wrapped keyset is non-NULL",
            .sql = "SELECT DLP_KEY_CHAIN('projects/p/locations/l/keyRings/r/cryptoKeys/k', b'\\x00\\x01') IS NOT NULL AS r",
            .rows = .{
                .{true},
            },
        },
    },
}
