// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "bigquery/functions/text_analysis/text_analyze",
    .dialect = .bigquery,
    .upstream = "https://cloud.google.com/bigquery/docs/reference/standard-sql/text-analysis-functions#text_analyze",
    .cases = .{
        .{
            .desc = "LOG_ANALYZER lowercases and splits on punctuation/whitespace",
            .sql = "SELECT TO_JSON_STRING(TEXT_ANALYZE('The quick brown FOX'))",
            .rows = .{
                .{"[\"the\",\"quick\",\"brown\",\"fox\"]"},
            },
        },
        .{
            .desc = "LOG_ANALYZER drops punctuation and keeps digits",
            .sql = "SELECT TO_JSON_STRING(TEXT_ANALYZE('Hello, World! 123'))",
            .rows = .{
                .{"[\"hello\",\"world\",\"123\"]"},
            },
        },
        .{
            .desc = "NO_OP_ANALYZER preserves the entire input verbatim",
            // analyzer is named-only, not positional: "Positional argument at 2 is
            // invalid because argument `analyzer` can only be referred to by name"
            // (recidiviz-bigquery-sandbox, 2026-08-25).
            .unsupported_in_bigquery = "analyzer is named-only (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql = "SELECT TO_JSON_STRING(TEXT_ANALYZE('Foo Bar', 'NO_OP_ANALYZER'))",
            .rows = .{
                .{"[\"Foo Bar\"]"},
            },
        },
        .{
            .desc = "CJK characters merge into a single token",
            // LOG_ANALYZER only splits on its fixed delimiter set (space, punctuation,
            // etc); CJK ideographs aren't delimiters, so a run of them stays one term.
            // cloud.google.com/bigquery/docs/reference/standard-sql/text-analysis#log_analyzer
            // (recidiviz-bigquery-sandbox, 2026-08-25).
            .sql = "SELECT TO_JSON_STRING(TEXT_ANALYZE('日本語'))",
            .rows = .{
                .{"[\"日本語\"]"},
            },
        },
        .{
            .desc = "mixed CJK and Latin",
            // The space delimiter splits off "hello"; the CJK run before it stays one
            // term (LOG_ANALYZER's delimiter set, recidiviz-bigquery-sandbox, 2026-08-25).
            .sql = "SELECT TO_JSON_STRING(TEXT_ANALYZE('混合 hello'))",
            .rows = .{
                .{"[\"混合\",\"hello\"]"},
            },
        },
        .{
            .desc = "NULL input propagates",
            .sql = "SELECT TEXT_ANALYZE(CAST(NULL AS STRING))",
            .rows = .{
                .{null},
            },
        },
    },
}
