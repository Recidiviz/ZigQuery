// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "bigquery/functions/string/contains_substr",
    .dialect = .bigquery,
    .upstream = "https://cloud.google.com/bigquery/docs/reference/standard-sql/string_functions#contains_substr",
    .cases = .{
        .{
            .desc = "simple substring match returns TRUE",
            .sql = "SELECT CONTAINS_SUBSTR('Hello, world!', 'world')",
            .rows = .{
                .{true},
            },
        },
        .{
            .desc = "case-insensitive match",
            .sql = "SELECT CONTAINS_SUBSTR('Hello, World!', 'hello')",
            .rows = .{
                .{true},
            },
        },
        .{
            .desc = "substring absent",
            .sql = "SELECT CONTAINS_SUBSTR('Hello', 'goodbye')",
            .rows = .{
                .{false},
            },
        },
    },
}
