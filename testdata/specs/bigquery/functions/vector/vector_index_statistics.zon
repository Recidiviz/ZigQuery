// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "bigquery/functions/vector/vector_index_statistics",
    .dialect = .bigquery,
    .upstream = "https://cloud.google.com/bigquery/docs/reference/standard-sql/vectorindex_functions#vector_indexstatistics",
    .cases = .{
        .{
            .desc = "VECTOR_INDEX.STATISTICS lowers to an empty subquery",
            .sql =
            \\CREATE TABLE IF NOT EXISTS vec_stats_t (id INT64);
            \\SELECT COALESCE((SELECT tfdv_drift FROM VECTOR_INDEX.STATISTICS(TABLE vec_stats_t) LIMIT 1), -1.0) AS placeholder
            ,
            // The column is tfdv_drift, not drift (recidiviz-bigquery-sandbox, 2026-08-25).
            .rows = .{
                .{-1.0},
            },
        },
    },
}
