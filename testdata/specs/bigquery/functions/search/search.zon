// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "bigquery/functions/search/search",
    .dialect = .bigquery,
    .upstream = "https://cloud.google.com/bigquery/docs/reference/standard-sql/search_functions#search",
    .cases = .{
        .{
            .desc = "every query token present in data",
            .sql = "SELECT SEARCH('foo bar baz', 'bar')",
            .rows = .{
                .{true},
            },
        },
        .{
            .desc = "missing query token",
            .sql = "SELECT SEARCH('foo bar baz', 'qux')",
            .rows = .{
                .{false},
            },
        },
        .{
            .desc = "case-insensitive match via LOG_ANALYZER normalisation",
            .sql = "SELECT SEARCH('Hello World', 'world')",
            .rows = .{
                .{true},
            },
        },
        .{
            .desc = "partial match — one query term missing returns FALSE",
            .sql = "SELECT SEARCH('foo bar', 'foo bar baz')",
            .rows = .{
                .{false},
            },
        },
        .{
            // SEARCH(NULL, ...) propagates NULL rather than returning FALSE
            // (recidiviz-bigquery-sandbox, 2026-08-25).
            .desc = "NULL data is treated as no tokens",
            .sql = "SELECT SEARCH(CAST(NULL AS STRING), 'bar')",
            .rows = .{
                .{null},
            },
        },
        .{
            .desc = "STRUCT input flattens every string field",
            .sql = "SELECT SEARCH(STRUCT('foo' AS a, 'bar baz' AS b), 'baz')",
            .rows = .{
                .{true},
            },
        },
        .{
            .desc = "ARRAY<STRING> input tokenises every element",
            .sql = "SELECT SEARCH(['alpha', 'beta gamma'], 'gamma')",
            .rows = .{
                .{true},
            },
        },
        .{
            // Each JSON value is tokenized separately: a multi-token query must
            // match within a single value, not across the object's values
            // (recidiviz-bigquery-sandbox, 2026-08-25).
            .desc = "JSON input scans values by default",
            .sql = "SELECT SEARCH(JSON '{\"a\":\"hello\",\"b\":\"world\"}', 'hello world')",
            .rows = .{
                .{false},
            },
        },
        .{
            .desc = "json_scope JSON_KEYS scans keys only",
            // json_scope, analyzer, and analyzer_options are named-only past search_query:
            // "argument `json_scope` can only be referred to by name".
            .unsupported_in_bigquery = "json_scope is named-only (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql = "SELECT SEARCH(JSON '{\"alpha\":\"x\",\"beta\":\"y\"}', 'alpha', 'LOG_ANALYZER', NULL, 'JSON_KEYS')",
            .rows = .{
                .{true},
            },
        },
        .{
            .desc = "NO_OP_ANALYZER keeps original case + spaces",
            // The 3rd positional argument binds to json_scope, not analyzer: "argument
            // `json_scope` can only be referred to by name".
            .unsupported_in_bigquery = "analyzer is named-only (recidiviz-bigquery-sandbox, 2026-08-25)",
            .sql = "SELECT SEARCH('Hello World', 'Hello World', 'NO_OP_ANALYZER')",
            .rows = .{
                .{true},
            },
        },
    },
}
