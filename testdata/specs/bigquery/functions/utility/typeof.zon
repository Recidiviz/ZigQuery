// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "bigquery/functions/utility/typeof",
    .dialect = .bigquery,
    .upstream = "https://cloud.google.com/bigquery/docs/reference/standard-sql/utility-functions#typeof",
    .cases = .{
        .{
            .desc = "integer literal reports INT64",
            .sql = "SELECT TYPEOF(123)",
            .rows = .{
                .{"INT64"},
            },
        },
        .{
            .desc = "string literal reports STRING",
            .sql = "SELECT TYPEOF('hello')",
            .rows = .{
                .{"STRING"},
            },
        },
        .{
            .desc = "floating-point literal reports DOUBLE",
            .sql = "SELECT TYPEOF(4.7)",
            .rows = .{
                .{"DOUBLE"},
            },
        },
        .{
            .desc = "NULL collapses to INT64 supertype",
            .sql = "SELECT TYPEOF(NULL)",
            .rows = .{
                .{"INT64"},
            },
        },
    },
}
