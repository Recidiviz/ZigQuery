// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "bigquery/functions/aead/deterministic_decrypt_string",
    .dialect = .bigquery,
    .upstream = "https://cloud.google.com/bigquery/docs/reference/standard-sql/aead_encryption_functions#deterministic_decrypt_string",
    .cases = .{
        .{
            .desc = "deterministic AEAD round-trip recovers plaintext STRING",
            .sql =
            \\WITH k AS (SELECT KEYS.NEW_KEYSET('DETERMINISTIC_AEAD_AES_SIV_CMAC_256') AS ks)
            \\SELECT DETERMINISTIC_DECRYPT_STRING(ks, DETERMINISTIC_ENCRYPT(ks, 'pt', 'aad'), 'aad') AS s
            \\FROM k
            ,
            .rows = .{
                .{"pt"},
            },
        },
    },
}
