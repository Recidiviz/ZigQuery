// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "bigquery/functions/aead/deterministic_decrypt_bytes",
    .dialect = .bigquery,
    .upstream = "https://cloud.google.com/bigquery/docs/reference/standard-sql/aead_encryption_functions#deterministic_decrypt_bytes",
    .cases = .{
        .{
            .desc = "deterministic AEAD round-trip recovers plaintext BYTES",
            .sql =
            \\WITH k AS (SELECT KEYS.NEW_KEYSET('DETERMINISTIC_AEAD_AES_SIV_CMAC_256') AS ks)
            \\SELECT TO_HEX(DETERMINISTIC_DECRYPT_BYTES(ks, DETERMINISTIC_ENCRYPT(ks, b'hi', b'aad'), b'aad')) AS s
            \\FROM k
            ,
            .rows = .{
                .{"6869"},
            },
        },
    },
}
