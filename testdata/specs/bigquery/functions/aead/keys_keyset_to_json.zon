// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "bigquery/functions/aead/keys_keyset_to_json",
    .dialect = .bigquery,
    .upstream = "https://cloud.google.com/bigquery/docs/reference/standard-sql/aead_encryption_functions#keys.keyset_to_json",
    .cases = .{
        .{
            .desc = "JSON form mentions key type",
            // The JSON has no "algorithm" field; the key's Tink type URL is
            // type.googleapis.com/google.crypto.tink.AesGcmKey.
            // (recidiviz-bigquery-sandbox, 2026-08-25)
            .sql = "SELECT KEYS.KEYSET_TO_JSON(KEYS.NEW_KEYSET('AEAD_AES_GCM_256')) LIKE '%AesGcmKey%' AS r",
            .rows = .{
                .{true},
            },
        },
    },
}
