// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "bigquery/functions/aead/aead_encrypt",
    .dialect = .bigquery,
    .upstream = "https://cloud.google.com/bigquery/docs/reference/standard-sql/aead_encryption_functions#aeadencrypt",
    .cases = .{
        .{
            .desc = "encrypt + decrypt round-trip",
            // Each (SELECT k FROM ks) scalar subquery re-evaluates NEW_KEYSET
            // independently, so the two references saw different keysets and
            // DECRYPT_STRING failed. FROM ks materializes the keyset once.
            // (recidiviz-bigquery-sandbox, 2026-08-25)
            .sql =
            \\WITH ks AS (
            \\  SELECT KEYS.NEW_KEYSET('AEAD_AES_GCM_256') AS k
            \\)
            \\SELECT AEAD.DECRYPT_STRING(k, AEAD.ENCRYPT(k, 'hello world', 'aad'), 'aad')
            \\FROM ks
            ,
            .rows = .{
                .{"hello world"},
            },
        },
    },
}
