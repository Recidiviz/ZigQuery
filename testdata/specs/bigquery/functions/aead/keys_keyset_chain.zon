.{
    .spec = "bigquery/functions/aead/keys_keyset_chain",
    .dialect = .bigquery,
    .upstream = "https://cloud.google.com/bigquery/docs/reference/standard-sql/aead_encryption_functions#keyskeyset_chain",
    .cases = .{
        .{
            .desc = "chain with literal wrapped keyset is non-NULL",
            .sql = "SELECT KEYS.KEYSET_CHAIN('projects/p/locations/l/keyRings/r/cryptoKeys/k', b'\\x00\\x01\\x02') IS NOT NULL AS r",
            .rows = .{
                .{true},
            },
        },
    },
}
