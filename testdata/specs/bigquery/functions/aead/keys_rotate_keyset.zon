.{
    .spec = "bigquery/functions/aead/keys_rotate_keyset",
    .dialect = .bigquery,
    .upstream = "https://cloud.google.com/bigquery/docs/reference/standard-sql/aead_encryption_functions#keysrotate_keyset",
    .cases = .{
        .{
            .desc = "rotated keyset is non-NULL",
            .sql = "SELECT KEYS.ROTATE_KEYSET(KEYS.NEW_KEYSET('AEAD_AES_GCM_256'), 'AEAD_AES_GCM_256') IS NOT NULL AS r",
            .rows = .{
                .{true},
            },
        },
    },
}
