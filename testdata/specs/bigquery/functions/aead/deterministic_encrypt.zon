// Derived from the GoogleSQL reference docs (Apache-2.0).
.{
    .spec = "bigquery/functions/aead/deterministic_encrypt",
    .dialect = .bigquery,
    .upstream = "https://cloud.google.com/bigquery/docs/reference/standard-sql/aead_encryption_functions#deterministic_encrypt",
    .cases = .{
        .{
            .desc = "deterministic encrypt is reproducible",
            // Each (SELECT k FROM ks) scalar subquery re-evaluates NEW_KEYSET
            // independently, so the two calls used different keys and the
            // comparison was false. FROM ks materializes the keyset once.
            // (recidiviz-bigquery-sandbox, 2026-08-25)
            .sql =
            \\WITH ks AS (
            \\  SELECT KEYS.NEW_KEYSET('DETERMINISTIC_AEAD_AES_SIV_CMAC_256') AS k
            \\)
            \\SELECT
            \\  DETERMINISTIC_ENCRYPT(k, 'plain', 'aad')
            \\  = DETERMINISTIC_ENCRYPT(k, 'plain', 'aad')
            \\FROM ks
            ,
            .rows = .{
                .{true},
            },
        },
    },
}
